---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  { id: 'all', label: t('gallery.all') },
  { id: 'landscape', label: t('gallery.landscape') },
  { id: 'portrait', label: t('gallery.portrait') },
  { id: 'food', label: t('gallery.food') },
];

const galleryItems = [
  {
    id: 1,
    category: 'landscape',
    title: 'Mountain Morning Mist',
    image: '/img/gallery/landscape-1.jpg',
  },
  {
    id: 2,
    category: 'landscape',
    title: 'Coastal Sunset',
    image: '/img/gallery/landscape-2.jpg',
  },
  {
    id: 3,
    category: 'portrait',
    title: 'Street Portrait',
    image: '/img/gallery/portrait-1.jpg',
  },
  {
    id: 4,
    category: 'food',
    title: 'Delicate Dessert',
    image: '/img/gallery/food-1.jpg',
  },
  {
    id: 5,
    category: 'landscape',
    title: 'City Skyline',
    image: '/img/gallery/landscape-3.jpg',
  },
  {
    id: 6,
    category: 'food',
    title: 'Traditional Cuisine',
    image: '/img/gallery/food-2.jpg',
  },
  {
    id: 7,
    category: 'portrait',
    title: 'Natural Light Portrait',
    image: '/img/gallery/portrait-2.jpg',
  },
  {
    id: 8,
    category: 'landscape',
    title: 'Starry Milky Way',
    image: '/img/gallery/landscape-4.jpg',
  },
];
---

<BaseLayout title={t('gallery.title')}>
  <section class="pt-32 pb-16 bg-mesh-gradient">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <h1
        class="text-5xl md:text-6xl font-display font-bold mb-6 gradient-text"
      >
        {t('gallery.title')}
      </h1>
      <p
        class="text-xl text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto"
      >
        Explore my photography collection, capturing beautiful moments in life
      </p>
    </div>
  </section>

  <section class="py-16 container mx-auto px-4 lg:px-8">
    <div class="flex flex-wrap justify-center gap-4 mb-12" id="filter-tabs">
      {
        categories.map((cat) => (
          <button
            class="px-6 py-3 rounded-full font-medium transition-all duration-300 filter-btn"
            class:list={{
              'bg-gradient-to-r from-primary-500 to-accent-500 text-white':
                cat.id === 'all',
              'bg-[rgb(var(--color-bg-secondary))] hover:bg-[rgb(var(--color-bg-accent))]':
                cat.id !== 'all',
            }}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <div
      class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4"
      id="gallery-grid"
    >
      {
        galleryItems.map((item) => (
          <article
            class="break-inside-avoid mb-4 gallery-item group cursor-pointer"
            data-category={item.category}
          >
            <div class="glass-card overflow-hidden transform transition-all duration-300 hover:scale-[1.02]">
              <div class="aspect-[4/3] bg-gradient-to-br from-primary-500 to-accent-500 relative overflow-hidden">
                <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                  <div class="text-white text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <svg
                      class="w-12 h-12 mx-auto mb-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                      />
                    </svg>
                    <p class="font-medium">View Full Size</p>
                  </div>
                </div>
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-lg">{item.title}</h3>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script src="../../scripts/en-gallery.ts"></script>
