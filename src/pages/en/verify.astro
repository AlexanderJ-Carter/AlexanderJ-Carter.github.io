---
import BaseLayout from '../../layouts/BaseLayout.astro';
// import { getLangFromUrl, useTranslations } from '../../i18n/ui';

/**
 * Security Verification Page (Hidden Page)
 * This is a hidden verification page for accessing protected content
 * Not shown in navigation menus, only accessible via direct link
 * Route: /en/verify
 */

// const lang = getLangFromUrl(Astro.url);
---

<BaseLayout
  title="Security Verification | Alexander James Carter"
  showHeader={false}
  showFooter={false}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-mesh-gradient">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <h1
        class="text-5xl md:text-6xl font-display font-bold mb-6 gradient-text"
      >
        🔐 Security Verification
      </h1>
      <p
        class="text-xl text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto"
      >
        Please complete the verification below to access protected content
      </p>
    </div>
  </section>

  <!-- Auth Section -->
  <section
    class="py-16 container mx-auto px-4 lg:px-8 flex justify-center items-center min-h-[60vh]"
  >
    <div class="max-w-md w-full">
      <!-- Cloudflare Turnstile Verification -->
      <div
        class="glass-card p-8 mb-8 flex flex-col items-center justify-center min-h-[360px] relative overflow-hidden"
      >
        <!-- Background Decoration -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-primary-500/5 to-accent-500/5 pointer-events-none"
        >
        </div>

        <div class="relative z-10 flex flex-col items-center w-full">
          <div
            class="w-16 h-16 mb-6 rounded-full bg-[rgb(var(--color-bg-secondary))] flex items-center justify-center shadow-inner"
          >
            <svg
              class="w-8 h-8 text-primary-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>

          <h2 class="text-2xl font-bold mb-2">Security Check</h2>
          <p
            class="text-[rgb(var(--color-text-secondary))] text-sm mb-8 text-center"
          >
            Please complete the security check to continue<br />
            <span class="text-xs opacity-75"
              >Protected by Cloudflare Turnstile</span
            >
          </p>

          <div class="mb-6 w-full flex justify-center min-h-[65px]">
            <!-- Cloudflare Turnstile Widget (only in production) -->
            <div id="turnstile-container">
              {
                import.meta.env.PROD ? (
                  <div
                    class="cf-turnstile"
                    data-sitekey="0x4AAAAAABdh_m4Oroh5Egsy"
                    data-callback="onTurnstileSuccess"
                    data-error-callback="onTurnstileError"
                    data-expired-callback="onTurnstileExpired"
                    data-theme="auto"
                  ></div>
                ) : (
                  <div class="text-center">
                    <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-2">
                      Development mode: Skip verification
                    </p>
                    <button
                      onclick="skipVerification()"
                      class="px-6 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
                    >
                      Continue
                    </button>
                  </div>
                )
              }
            </div>
          </div>

          <div
            id="verification-status"
            class="text-center hidden transition-all duration-500"
          >
            <div
              class="inline-flex items-center gap-2 text-green-500 font-bold text-lg mb-2"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path></svg
              >
              <span>Verified Successfully</span>
            </div>
            <p
              class="text-[rgb(var(--color-text-secondary))] text-sm animate-pulse"
            >
              Redirecting...
            </p>
          </div>
        </div>

        <div
          class="absolute bottom-4 text-xs text-[rgb(var(--color-text-tertiary))] flex items-center gap-1.5 opacity-60 hover:opacity-100 transition-opacity"
        >
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
            ></path></svg
          >
          Secured by Cloudflare Turnstile
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

{
  import.meta.env.PROD && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script is:inline>
  // Cloudflare Turnstile Callback
  window.onTurnstileSuccess = function (token) {
    if (!token) {
      console.error('Turnstile verification failed: no token received');
      showError();
      return;
    }

    const statusEl = document.getElementById('verification-status');
    if (statusEl) {
      statusEl.classList.remove('hidden');
      statusEl.classList.add('animate-in');
    }

    // Set verification flag
    try {
      sessionStorage.setItem('is_verified', 'true');
      sessionStorage.setItem('verification_token', token);
      sessionStorage.setItem('verification_time', Date.now().toString());
    } catch (e) {
      console.warn('Failed to save verification to sessionStorage:', e);
    }

    // Get redirect URL from query params
    const urlParams = new URLSearchParams(window.location.search);
    const redirectUrl = urlParams.get('redirect') || '/en/';

    // Redirect after short delay
    setTimeout(() => {
      try {
        window.location.href = redirectUrl;
      } catch (e) {
        console.error('Failed to redirect:', e);
        window.location.href = '/en/';
      }
    }, 1000);
  };

  // Error callback
  window.onTurnstileError = function (error) {
    console.error('Turnstile error:', error);
    showError();
  };

  // Expired callback
  window.onTurnstileExpired = function () {
    console.warn('Turnstile token expired');
    // Optionally reload the widget
    if (window.turnstile) {
      window.turnstile.reset();
    }
  };

  function showError() {
    const statusEl = document.getElementById('verification-status');
    if (statusEl) {
      // const isZh = document.documentElement.lang === 'zh-CN';
      statusEl.innerHTML = `
        <div class="inline-flex items-center gap-2 text-red-500 font-bold text-lg mb-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span>Verification failed, please retry</span>
        </div>
        <p class="text-[rgb(var(--color-text-secondary))] text-sm">
          Please refresh the page and try again
        </p>
      `;
      statusEl.classList.remove('hidden');
    }
  }

  // Skip verification in development
  function skipVerification() {
    try {
      sessionStorage.setItem('is_verified', 'true');
      sessionStorage.setItem('verification_time', Date.now().toString());
      const urlParams = new URLSearchParams(window.location.search);
      const redirectUrl = urlParams.get('redirect') || '/en/';
      window.location.href = redirectUrl;
    } catch (e) {
      console.error('Failed to skip verification:', e);
    }
  }

  // Make function global
  window.skipVerification = skipVerification;

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function () {
    // Check if already verified
    try {
      const isVerified = sessionStorage.getItem('is_verified');
      const verifyTime = parseInt(
        sessionStorage.getItem('verification_time') || '0'
      );
      const now = Date.now();
      // Token valid for 5 minutes
      if (isVerified === 'true' && now - verifyTime < 5 * 60 * 1000) {
        const urlParams = new URLSearchParams(window.location.search);
        const redirectUrl = urlParams.get('redirect') || '/en/';
        window.location.href = redirectUrl;
      }
    } catch (e) {
      console.warn('Failed to check verification status:', e);
    }
  });
</script>

<style>
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .glass-card {
    animation: slideDown 0.5s ease-out;
  }

  .animate-in {
    animation: fadeIn 0.5s ease-out forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
