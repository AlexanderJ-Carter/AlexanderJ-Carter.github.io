---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Typewriter from '../../components/Typewriter.astro';
import StatsCounter from '../../components/StatsCounter.astro';
import MusicPlayer from '../../components/MusicPlayer.astro';
import HolidayGreeting from '../../components/HolidayGreeting.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Typewriter texts
const typewriterTexts = [
  'Photography Enthusiast',
  'Code Creator',
  'Design Lover',
  'Tech Explorer',
  'Life Observer',
];

// Stats for counter
const stats = [
  { label: 'Works', end: 1000, suffix: '+', icon: '📸' },
  { label: 'Fields', end: 5, suffix: '+', icon: '🎨' },
  { label: 'Dedication', end: 100, suffix: '%', icon: '💝' },
  { label: 'Experience', end: 3, suffix: ' Years', icon: '⏱️' },
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
  >
    <!-- Animated Mesh Gradient Background -->
    <div class="absolute inset-0 bg-mesh-gradient"></div>

    <!-- Floating Particles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="particle" style="left: 10%; animation-delay: 0s;"></div>
      <div class="particle" style="left: 20%; animation-delay: 2s;"></div>
      <div class="particle" style="left: 30%; animation-delay: 4s;"></div>
      <div class="particle" style="left: 40%; animation-delay: 1s;"></div>
      <div class="particle" style="left: 50%; animation-delay: 3s;"></div>
      <div class="particle" style="left: 60%; animation-delay: 5s;"></div>
      <div class="particle" style="left: 70%; animation-delay: 2.5s;"></div>
      <div class="particle" style="left: 80%; animation-delay: 1.5s;"></div>
      <div class="particle" style="left: 90%; animation-delay: 4.5s;"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-4 lg:px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <!-- Greeting Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[rgb(var(--color-bg-accent))]/50 backdrop-blur-sm border border-[rgb(var(--color-border))] mb-6 fade-in"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-3 w-3 bg-primary-500"
            ></span>
          </span>
          <span class="text-sm font-medium">Welcome to my world</span>
        </div>

        <!-- Name with Gradient -->
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-display font-bold mb-6 fade-in-delay-1"
        >
          <span class="gradient-text"> Alexander Carter </span>
        </h1>

        <!-- Typewriter Effect -->
        <div
          class="text-2xl md:text-4xl font-semibold mb-4 fade-in-delay-2 text-balance min-h-[3rem] flex items-center justify-center"
        >
          <Typewriter texts={typewriterTexts} speed={100} />
        </div>

        <p
          class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] mb-12 fade-in-delay-3 text-balance max-w-2xl mx-auto"
        >
          Capturing moments, creating beauty, coding dreams into reality
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center fade-in-delay-3"
        >
          <a href="/en/gallery/" class="btn-primary glow-on-hover">
            <span>Explore Gallery</span>
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a href="/en/about/" class="btn-secondary">
            <span>About Me</span>
          </a>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
        <div class="scroll-indicator"></div>
      </div>
    </div>
  </section>

  <!-- Stats Counter Section -->
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <StatsCounter stats={stats} />
  </section>

  <!-- Featured Work Section -->
  <section class="py-20 container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-4">
        {t('home.featured')}
      </h2>
      <p class="text-xl text-[rgb(var(--color-text-secondary))]">
        {t('home.featured.desc')}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="bento-grid max-w-7xl mx-auto">
      <!-- Large Featured Item -->
      <div
        class="bento-item bento-large bg-gradient-to-br from-primary-500 to-accent-500 p-8 flex items-end"
      >
        <div class="text-white">
          <h3 class="text-3xl font-bold mb-2">Landscape</h3>
          <p class="text-white/80">Capturing nature's grandeur</p>
        </div>
      </div>

      <!-- Medium Items -->
      <div
        class="bento-item bg-gradient-to-br from-purple-400 to-pink-400 p-6 flex items-center justify-center"
      >
        <div class="text-center text-white">
          <div class="text-5xl font-bold mb-2">1200+</div>
          <div class="text-white/80">{t('home.stats.photos')}</div>
        </div>
      </div>

      <div
        class="bento-item bg-gradient-to-br from-orange-400 to-red-400 p-6 flex items-center justify-center"
      >
        <div class="text-center text-white">
          <div class="text-5xl font-bold mb-2">50+</div>
          <div class="text-white/80">{t('home.stats.projects')}</div>
        </div>
      </div>

      <!-- Tall Item -->
      <div
        class="bento-item bento-tall bg-gradient-to-br from-teal-400 to-blue-400 p-6 flex flex-col justify-between"
      >
        <div>
          <h3 class="text-2xl font-bold text-white mb-2">Design</h3>
          <p class="text-white/80">UI/UX & Graphics</p>
        </div>
        <div class="text-white/60 text-sm">Explore more →</div>
      </div>

      <!-- Regular Items -->
      <div
        class="bento-item bg-gradient-to-br from-indigo-400 to-purple-400 p-6 flex items-center justify-center"
      >
        <div class="text-center text-white">
          <div class="text-4xl mb-2">📸</div>
          <div class="font-semibold">Photography</div>
        </div>
      </div>

      <div
        class="bento-item bg-gradient-to-br from-green-400 to-emerald-400 p-6 flex items-center justify-center"
      >
        <div class="text-center text-white">
          <div class="text-4xl mb-2">💻</div>
          <div class="font-semibold">Coding</div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-20 bg-[rgb(var(--color-bg-secondary))]">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="glass-card p-8 md:p-12">
          <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">
            {t('home.about.title')}
          </h2>
          <p
            class="text-lg text-[rgb(var(--color-text-secondary))] mb-8 leading-relaxed"
          >
            {t('home.about.desc')}
          </p>

          <!-- Skills -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            {
              [
                { icon: '🎨', label: 'Design' },
                { icon: '📷', label: 'Photography' },
                { icon: '💻', label: 'Development' },
                { icon: '✍️', label: 'Writing' },
              ].map((skill) => (
                <div class="text-center p-4 rounded-lg bg-[rgb(var(--color-bg-primary))] hover:scale-105 transition-transform duration-300">
                  <div class="text-4xl mb-2">{skill.icon}</div>
                  <div class="font-medium">{skill.label}</div>
                </div>
              ))
            }
          </div>

          <a href="/en/about/" class="btn-primary inline-block">
            Learn More About Me
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Updates Section -->
  <section class="py-20 container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-4">
        Latest Updates
      </h2>
      <p class="text-xl text-[rgb(var(--color-text-secondary))]">
        Explore recent projects and ideas
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {
        [
          {
            title: 'Spring Blossoms',
            category: 'Photography',
            image: '/img/gallery/flowers-1.jpg',
            date: '2025-03-15',
          },
          {
            title: 'City Nights',
            category: 'Photography',
            image: '/img/gallery/city-night.jpg',
            date: '2025-03-10',
          },
          {
            title: 'Food Journey',
            category: 'Lifestyle',
            image: '/img/gallery/food-1.jpg',
            date: '2025-03-05',
          },
        ].map((item) => (
          <article class="glass-card overflow-hidden group cursor-pointer transform hover:scale-105 transition-all duration-300">
            <div class="aspect-video bg-gradient-to-br from-primary-500 to-accent-500 relative overflow-hidden">
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300" />
            </div>
            <div class="p-6">
              <div class="text-sm text-primary-500 font-medium mb-2">
                {item.category}
              </div>
              <h3 class="text-xl font-bold mb-2">{item.title}</h3>
              <p class="text-sm text-[rgb(var(--color-text-tertiary))]">
                {item.date}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Music Player Widget -->
  <MusicPlayer />

  <!-- Holiday Greeting Modal -->
  <HolidayGreeting />
</BaseLayout>
