---
import FunTemplate from '../../components/templates/FunTemplate.astro';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  const paths = Object.keys(languages).map((lang) => ({ params: { lang } }));
  paths.push({ params: { lang: 'en' } });
  return paths;
}

const { lang: urlLang } = Astro.params;
const lang = urlLang === 'en' ? 'en-GB' : urlLang;
---

<FunTemplate lang={lang} />
