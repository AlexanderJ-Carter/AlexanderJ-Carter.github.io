---
import SecurityAcknowledgmentsTemplate from '../../../components/templates/SecurityAcknowledgmentsTemplate.astro';
import { getLangStaticPaths, resolveRouteLang } from '../../../i18n/routing';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang: urlLang } = Astro.params;
const lang = resolveRouteLang(urlLang);
const pathPrefix = lang === 'en-GB' ? '/en' : `/${lang}`;
---

<SecurityAcknowledgmentsTemplate lang={lang} pathPrefix={pathPrefix} />
