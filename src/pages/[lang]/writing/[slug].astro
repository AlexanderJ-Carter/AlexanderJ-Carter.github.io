---
import { getCollection, render } from 'astro:content';
import WritingPostTemplate from '../../../components/templates/WritingPostTemplate.astro';

export async function getStaticPaths() {
  const langMap: Record<string, string> = {
    'zh-TW': 'zh-TW',
    en: 'en-GB',
    fr: 'fr',
    ru: 'ru',
  };
  const posts = await getCollection('writing');
  const paths = [];

  for (const [urlLang, dataLang] of Object.entries(langMap)) {
    const langPosts = posts.filter((post) => post.data.lang === dataLang);
    for (const post of langPosts) {
      paths.push({
        params: { lang: urlLang, slug: post.id },
        props: { post, lang: dataLang, fallback: false },
      });
    }

    // Fallback: for essays missing this locale, serve the zh-CN original under
    // the locale URL with a "translation unavailable" notice. Prevents hard 404s.
    const zhCnPosts = posts.filter((post) => post.data.lang === 'zh-CN');
    const nativeBaseIds = new Set(
      langPosts.map((p) => p.id.replace(/-(zh-tw|en-gb|fr|ru)$/i, ''))
    );
    for (const cnPost of zhCnPosts) {
      // Skip if a native translation already exists for this base slug.
      if (nativeBaseIds.has(cnPost.id)) continue;
      paths.push({
        params: { lang: urlLang, slug: cnPost.id },
        props: { post: cnPost, lang: 'zh-CN', fallback: true },
      });
    }
  }

  return paths;
}

const { post, lang, fallback } = Astro.props;
const { Content } = await render(post);
---

<WritingPostTemplate
  lang={lang}
  postId={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  timeToRead={post.data.timeToRead}
  fallback={fallback}
>
  <Content />
</WritingPostTemplate>
