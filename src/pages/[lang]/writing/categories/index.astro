---
import { getCollection } from 'astro:content';
import WritingIndexTemplate from '../../../../components/templates/WritingIndexTemplate.astro';
import { getLangStaticPaths, resolveRouteLang } from '../../../../i18n/routing';
import { postsForLang, uniqueTaxonomy } from '../../../../lib/writing';

export function getStaticPaths() {
  return getLangStaticPaths().map(({ params }) => ({
    params,
    props: { lang: resolveRouteLang(params.lang) },
  }));
}

const { lang } = Astro.props;
const posts = postsForLang(await getCollection('writing'), lang);
const items = uniqueTaxonomy(posts, 'category').map((c) => ({
  name: c.name,
  slug: c.slug,
  count: c.count,
}));
---

<WritingIndexTemplate lang={lang} kind="categories" items={items} />
