---
import { getCollection } from 'astro:content';
import WritingCollectionTemplate from '../../../../components/templates/WritingCollectionTemplate.astro';
import { writingCopy } from '../../../../i18n/pages/writing';
import { getLangStaticPaths, resolveRouteLang } from '../../../../i18n/routing';
import type { Lang } from '../../../../i18n/types';
import {
  postsByCategorySlug,
  postsForLang,
  uniqueTaxonomy,
} from '../../../../lib/writing';

export async function getStaticPaths() {
  const all = await getCollection('writing');
  const paths: Array<{
    params: { lang: string; category: string };
    props: { lang: Lang; name: string; slug: string };
  }> = [];

  for (const { params } of getLangStaticPaths()) {
    const lang = resolveRouteLang(params.lang);
    for (const cat of uniqueTaxonomy(postsForLang(all, lang), 'category')) {
      paths.push({
        params: { lang: params.lang, category: cat.slug },
        props: { lang, name: cat.name, slug: cat.slug },
      });
    }
  }

  return paths;
}

const { lang, name, slug } = Astro.props;
const t = writingCopy[lang] ?? writingCopy['zh-CN'];
const posts = postsByCategorySlug(
  postsForLang(await getCollection('writing'), lang),
  slug
);
---

<WritingCollectionTemplate
  lang={lang}
  kind="category"
  title={t.categoryTitle(name)}
  description={t.categoryDescription(name)}
  posts={posts}
  crumb={name}
/>
