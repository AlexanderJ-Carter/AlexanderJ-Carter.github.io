---
import WritingListTemplate from '../../../components/templates/WritingListTemplate.astro';
import { getLangStaticPaths, resolveRouteLang } from '../../../i18n/routing';

export function getStaticPaths() {
  return getLangStaticPaths().map(({ params }) => ({
    params,
    props: { lang: resolveRouteLang(params.lang) },
  }));
}

const { lang } = Astro.props;
---

<WritingListTemplate lang={lang} />
