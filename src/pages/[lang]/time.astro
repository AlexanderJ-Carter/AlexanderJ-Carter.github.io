---
import TimeTemplate from '../../components/templates/TimeTemplate.astro';
import { getLangStaticPaths, resolveRouteLang } from '../../i18n/routing';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang: urlLang } = Astro.params;
const lang = resolveRouteLang(urlLang);
---

<TimeTemplate lang={lang} />
