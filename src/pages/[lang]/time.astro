---
import TimeTemplate from '../../components/templates/TimeTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en-US' } },
    { params: { lang: 'en-GB' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params;
---

<TimeTemplate lang={lang} />
