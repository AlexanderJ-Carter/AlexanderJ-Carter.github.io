---
import { getCollection } from 'astro:content';
import WritingCollectionTemplate from '../../../components/templates/WritingCollectionTemplate.astro';
import { writingCopy } from '../../../i18n/pages/writing';
import {
  postsByTagSlug,
  postsForLang,
  uniqueTaxonomy,
} from '../../../lib/writing';

export async function getStaticPaths() {
  const posts = postsForLang(await getCollection('writing'), 'zh-CN');
  return uniqueTaxonomy(posts, 'tags').map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, slug: tag.slug },
  }));
}

const { name, slug } = Astro.props;
const t = writingCopy['zh-CN'];
const posts = postsByTagSlug(
  postsForLang(await getCollection('writing'), 'zh-CN'),
  slug
);
---

<WritingCollectionTemplate
  lang="zh-CN"
  kind="tag"
  title={t.tagTitle(name)}
  description={t.tagDescription(name)}
  posts={posts}
  crumb={name}
/>
