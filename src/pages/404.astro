---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getLangPath, type Lang } from '../i18n/types';

const lang = getLangFromUrl(Astro.url) as Lang;
const home = getLangPath(lang, '/');
const requested = Astro.url.pathname;

const copy: Record<
  Lang,
  {
    title: string;
    kicker: string;
    frame: string;
    message: string;
    pathLabel: string;
    home: string;
    gallery: string;
    writing: string;
    sitemap: string;
    support: string;
  }
> = {
  'zh-CN': {
    title: '这格是空的',
    kicker: 'Frame 404',
    frame: 'NEG · EMPTY',
    message:
      '取景框里没有对上的画面。地址可能写错了，或这页已经从册子里抽走。',
    pathLabel: '请求路径',
    home: '回首页',
    gallery: '画廊',
    writing: '写作',
    sitemap: '目录',
    support: '支持本站',
  },
  'zh-TW': {
    title: '這格是空的',
    kicker: 'Frame 404',
    frame: 'NEG · EMPTY',
    message:
      '取景框裡沒有對上的畫面。位址可能寫錯了，或這頁已經從冊子裡抽走。',
    pathLabel: '請求路徑',
    home: '回首頁',
    gallery: '畫廊',
    writing: '寫作',
    sitemap: '目錄',
    support: '支持本站',
  },
  'en-GB': {
    title: 'Blank frame',
    kicker: 'Frame 404',
    frame: 'NEG · EMPTY',
    message:
      'Nothing exposed at this address. The link may be wrong, or the page has left the book.',
    pathLabel: 'Requested path',
    home: 'Home',
    gallery: 'Gallery',
    writing: 'Writing',
    sitemap: 'Contents',
    support: 'Support',
  },
  fr: {
    title: 'Cadre vide',
    kicker: 'Frame 404',
    frame: 'NEG · EMPTY',
    message:
      'Rien n’est exposé à cette adresse. Le lien est peut-être faux, ou la page a quitté le cahier.',
    pathLabel: 'Chemin demandé',
    home: 'Accueil',
    gallery: 'Galerie',
    writing: 'Écrits',
    sitemap: 'Sommaire',
    support: 'Soutenir',
  },
  ru: {
    title: 'Пустой кадр',
    kicker: 'Frame 404',
    frame: 'NEG · EMPTY',
    message:
      'По этому адресу нет кадра. Ссылка могла устареть, или страница выпала из тетради.',
    pathLabel: 'Запрошенный путь',
    home: 'Главная',
    gallery: 'Галерея',
    writing: 'Статьи',
    sitemap: 'Оглавление',
    support: 'Поддержать',
  },
};

const t = copy[lang] || copy['zh-CN'];

const exits = [
  { href: home, label: t.home, n: '01' },
  { href: getLangPath(lang, '/gallery'), label: t.gallery, n: '02' },
  { href: getLangPath(lang, '/writing'), label: t.writing, n: '03' },
  { href: getLangPath(lang, '/sitemap'), label: t.sitemap, n: '04' },
  { href: getLangPath(lang, '/support'), label: t.support, n: '05' },
];
---

<BaseLayout title={`404 · ${t.title}`} description={t.message}>
  <section class="not-found relative min-h-[78vh] flex items-center overflow-hidden">
    <div class="page-shell-wide py-24 md:py-32 w-full relative z-10">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16 items-center">
        <!-- Blank negative / viewfinder -->
        <div class="not-found-plate relative aspect-[4/3] max-w-xl mx-auto lg:mx-0 w-full">
          <div class="viewfinder-corners" aria-hidden="true">
            <span class="tl"></span>
            <span class="tr"></span>
            <span class="bl"></span>
            <span class="br"></span>
          </div>
          <div class="not-found-plate__inner absolute inset-4 md:inset-5 flex flex-col justify-between border border-[rgb(var(--color-border))]">
            <div class="flex items-center justify-between px-4 py-3 border-b border-[rgb(var(--color-border))]">
              <span class="meta-mono">{t.frame}</span>
              <span class="meta-mono text-[rgb(var(--color-accent))]">ISO —</span>
            </div>
            <div class="flex-1 flex items-center justify-center px-4">
              <p
                class="not-found-num font-heading font-bold tracking-tighter text-[rgb(var(--color-text-primary))] select-none"
                aria-hidden="true"
              >
                404
              </p>
            </div>
            <div class="flex items-center justify-between px-4 py-3 border-t border-[rgb(var(--color-border))]">
              <span class="meta-mono">F/—</span>
              <span class="meta-mono not-found-blink">● REC</span>
              <span class="meta-mono">1/—</span>
            </div>
          </div>
        </div>

        <!-- Copy + exits -->
        <div>
          <p class="meta-mono mb-3 text-[rgb(var(--color-accent))]">{t.kicker}</p>
          <h1
            class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[rgb(var(--color-text-primary))] mb-5 text-balance"
          >
            {t.title}
          </h1>
          <p
            class="text-lg text-[rgb(var(--color-text-secondary))] leading-relaxed mb-6 max-w-md"
          >
            {t.message}
          </p>

          {
            requested && requested !== '/404' && (
              <p class="mb-8 text-sm text-[rgb(var(--color-text-tertiary))]">
                <span class="meta-mono mr-2">{t.pathLabel}</span>
                <code class="font-mono text-[rgb(var(--color-text-secondary))] break-all">
                  {requested}
                </code>
              </p>
            )
          }

          <ul class="border-t border-[rgb(var(--color-border))] max-w-md">
            {
              exits.map((item) => (
                <li class="border-b border-[rgb(var(--color-border))]">
                  <a
                    href={item.href}
                    class="list-row group flex items-baseline gap-4 py-3.5 px-1 hover:pl-2"
                  >
                    <span class="meta-mono text-[rgb(var(--color-text-tertiary))] group-hover:text-[rgb(var(--color-accent))] transition-colors">
                      {item.n}
                    </span>
                    <span class="font-heading font-semibold text-[rgb(var(--color-text-primary))] group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors flex-1">
                      {item.label}
                    </span>
                    <span
                      class="meta-mono text-[rgb(var(--color-text-tertiary))] opacity-0 group-hover:opacity-100 transition-opacity"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-plate {
    background: linear-gradient(
      165deg,
      rgb(var(--color-bg-primary)) 0%,
      rgb(var(--color-bg-secondary) / 0.85) 100%
    );
  }

  .not-found-plate .viewfinder-corners {
    inset: 0.65rem;
    z-index: 2;
  }

  .not-found-plate .viewfinder-corners span {
    border-color: rgb(var(--color-text-primary) / 0.55);
  }

  .dark .not-found-plate .viewfinder-corners span {
    border-color: rgb(var(--color-text-primary) / 0.45);
  }

  .not-found-plate__inner {
    background: rgb(var(--color-bg-secondary) / 0.4);
  }

  .not-found-num {
    font-size: clamp(4.5rem, 18vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    opacity: 0.92;
    animation: not-found-breathe 5.5s ease-in-out infinite;
  }

  .not-found-blink {
    color: rgb(var(--color-accent));
    animation: not-found-rec 1.6s steps(1, end) infinite;
  }

  @keyframes not-found-breathe {
    0%,
    100% {
      opacity: 0.72;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.015);
    }
  }

  @keyframes not-found-rec {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-num,
    .not-found-blink {
      animation: none !important;
    }
  }
</style>
