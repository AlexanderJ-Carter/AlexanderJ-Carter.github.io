---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import {
  getHreflangAlternates,
  getLangPath,
  toOgLocale,
} from '../i18n/types';
import { ADSENSE_ACCOUNT, originForPath, skipVerify } from '../config/site';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import ThemeScript from '../components/chrome/ThemeScript.astro';
import AdsScript from '../components/chrome/AdsScript.astro';
import BackToTop from '../components/chrome/BackToTop.astro';
import QuickActions from '../components/chrome/QuickActions.astro';
import ReadingProgress from '../components/chrome/ReadingProgress.astro';
import Toast from '../components/chrome/Toast.astro';
import KeyboardShortcuts from '../components/chrome/KeyboardShortcuts.astro';
import ServiceWorkerRegister from '../components/chrome/ServiceWorkerRegister.astro';
import StructuredData from '../components/chrome/StructuredData.astro';
import MusicPlayer from '../components/chrome/MusicPlayer.astro';
import HolidayGreeting from '../components/chrome/HolidayGreeting.astro';
import SiteNotice from '../components/chrome/SiteNotice.astro';
import WebMcp from '../components/chrome/WebMcp.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  protectedPage?: boolean;
  /** 附加到 <main> 的 class，用于全宽或间距等 */
  mainClass?: string;
  /** Open Graph type */
  ogType?: 'website' | 'article';
  /** ISO date for articles */
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra JSON-LD graph nodes (e.g. BlogPosting) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Search indexing policy for utility and thin aggregate pages */
  robots?: 'noindex, follow' | 'noindex, nofollow';
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('site.title'),
  description = t('site.description'),
  image = '/img/branding/og-image.webp',
  showHeader = true,
  showFooter = true,
  protectedPage = false,
  mainClass = '',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  robots,
} = Astro.props;

const needsVerify = protectedPage && !skipVerify;

const pageOrigin = originForPath(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, pageOrigin);
const fullTitle =
  title === t('site.title') ? title : `${title} | ${t('site.title')}`;
const ogLocale = toOgLocale(lang);
const hreflangs = getHreflangAlternates(Astro.url.pathname, pageOrigin);
// Real OG image dimensions — only declare when the page uses the canonical
// 1200×630 social card (the default). Page-specific images should pass their own.
const ogImageWidth =
  image === '/img/branding/og-image.webp' ? '1200' : undefined;
const ogImageHeight =
  image === '/img/branding/og-image.webp' ? '630' : undefined;

const fontCss =
  'https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Noto+Serif+SC:wght@400;600&display=swap';

const skipLabel =
  lang === 'zh-CN'
    ? '跳到主内容'
    : lang === 'zh-TW'
      ? '跳到主內容'
      : lang === 'fr'
        ? 'Aller au contenu'
        : lang === 'ru'
          ? 'К основному содержимому'
          : 'Skip to main content';

const rssHref = getLangPath(lang, '/rss.xml');
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/img/branding/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/img/branding/favicon.ico" />
    <link rel="apple-touch-icon" href="/img/branding/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="author" href="/humans.txt" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#3d7382" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Alexander James Carter" />
    <meta
      name="google-adsense-account"
      content={ADSENSE_ACCOUNT}
    />
    {robots && <meta name="robots" content={robots} />}

    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={rssHref}
    />
    <ClientRouter />

    {
      hreflangs.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    <script is:inline define:vars={{ needsVerify }}>
      (function () {
        if (!needsVerify) return;
        try {
          const isVerified = sessionStorage.getItem('is_verified');
          if (isVerified !== 'true') {
            const currentPath = window.location.pathname;
            window.location.href =
              `/verify?redirect=${encodeURIComponent(currentPath)}`;
          }
        } catch (e) {
          console.error('Auth check failed', e);
        }
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, pageOrigin)} />
    <meta property="og:image:alt" content={title} />
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && (
      <meta property="og:image:height" content={ogImageHeight} />
    )}
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:locale" content={ogLocale} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, pageOrigin)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={fontCss}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={fontCss} />
    </noscript>

    <ThemeScript />
    <StructuredData description={description} extra={jsonLd} />
    <AdsScript />
  </head>
  <body class="antialiased font-sans">
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    {showHeader && <Header />}
    <SiteNotice />

    <main id="main-content" tabindex="-1" class={mainClass}>
      <slot />
    </main>

    {showFooter && <Footer />}

    <MusicPlayer />
    <HolidayGreeting />
    <BackToTop />
    <Toast />
    <QuickActions />
    <ReadingProgress />
    <KeyboardShortcuts lang={lang} />

    <script src="../scripts/scroll-animations.ts"></script>

    <script is:inline>
      (function () {
        const initKonami = function () {
          const konami = [
            'ArrowUp',
            'ArrowUp',
            'ArrowDown',
            'ArrowDown',
            'ArrowLeft',
            'ArrowRight',
            'ArrowLeft',
            'ArrowRight',
            'b',
            'a',
          ];
          let index = 0;
          document.addEventListener('keydown', function (e) {
            index = e.key === konami[index] ? index + 1 : 0;
            if (index === konami.length) {
              index = 0;
              for (let i = 0; i < 50; i++) {
                setTimeout(function () {
                  const el = document.createElement('div');
                  el.textContent = ['*', '+', 'o', '.', '·', '◇'][
                    Math.floor(Math.random() * 6)
                  ];
                  el.style.cssText =
                    'position:fixed;pointer-events:none;font-size:1.5rem;color:rgb(61 115 130);left:' +
                    Math.random() * 100 +
                    '%;top:' +
                    Math.random() * 100 +
                    '%;animation:konami-float 2.5s ease-out forwards;z-index:9999;';
                  document.body.appendChild(el);
                  setTimeout(function () {
                    el.remove();
                  }, 2500);
                }, i * 40);
              }
              const style = document.createElement('style');
              style.textContent =
                '@keyframes konami-float{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-80px) scale(1.5)}}';
              document.head.appendChild(style);
              setTimeout(function () {
                style.remove();
              }, 3000);
            }
          });
        };
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(initKonami, { timeout: 2000 });
        } else {
          setTimeout(initKonami, 800);
        }
      })();
    </script>
    <WebMcp />
    <ServiceWorkerRegister lang={lang} />
  </body>
</html>
