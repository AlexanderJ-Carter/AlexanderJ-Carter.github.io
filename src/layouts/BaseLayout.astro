---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { skipVerify } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import AdsScript from '../components/AdsScript.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieConsent from '../components/CookieConsent.astro';
import QuickActions from '../components/QuickActions.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Toast from '../components/Toast.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import ServiceWorkerRegister from '../components/ServiceWorkerRegister.astro';
import StructuredData from '../components/StructuredData.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import HolidayGreeting from '../components/HolidayGreeting.astro';
import SiteNotice from '../components/SiteNotice.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  protectedPage?: boolean;
  /** 附加到 <main> 的 class，用于全宽或间距等 */
  mainClass?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('site.title'),
  description = t('site.description'),
  image = '/img/branding/logo.png',
  showHeader = true,
  showFooter = true,
  protectedPage = false,
  mainClass = '',
} = Astro.props;

const needsVerify = protectedPage && !skipVerify;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === t('site.title') ? title : `${title} | ${t('site.title')}`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/img/branding/favicon.ico" />
    <link rel="apple-touch-icon" href="/img/branding/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="author" href="/humans.txt" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#3d7382" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Alexander James Carter" />

    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="zh-CN" href={new URL('/', Astro.site)} />
    <link
      rel="alternate"
      hreflang="zh-TW"
      href={new URL('/zh-TW/', Astro.site)}
    />
    <link rel="alternate" hreflang="en-GB" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL('/fr/', Astro.site)} />
    <link rel="alternate" hreflang="ru" href={new URL('/ru/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <script is:inline define:vars={{ needsVerify }}>
      (function () {
        if (!needsVerify) return;
        try {
          const isVerified = sessionStorage.getItem('is_verified');
          if (isVerified !== 'true') {
            const currentPath = window.location.pathname;
            window.location.href =
              `/verify?redirect=${encodeURIComponent(currentPath)}`;
          }
        } catch (e) {
          console.error('Auth check failed', e);
        }
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content={lang} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ThemeScript />
    <StructuredData description={description} />
    <AdsScript />

    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "YOUR_CLOUDFLARE_ANALYTICS_TOKEN"}'></script>
  </head>
  <body class="antialiased font-sans">
    <a href="#main-content" class="skip-link"
      >{lang === 'zh-CN' ? '跳到主内容' : 'Skip to main content'}</a
    >
    {showHeader && <Header />}
    <SiteNotice />

    <main id="main-content" tabindex="-1" class={mainClass}>
      <slot />
    </main>

    {showFooter && <Footer />}

    <MusicPlayer />
    <HolidayGreeting />
    <BackToTop />
    <CookieConsent />
    <Toast />
    <QuickActions />
    <ReadingProgress />
    <KeyboardShortcuts lang={lang} />

    <script src="../scripts/scroll-animations.ts"></script>

    <script is:inline>
      (function () {
        const initKonami = function () {
          const konami = [
            'ArrowUp',
            'ArrowUp',
            'ArrowDown',
            'ArrowDown',
            'ArrowLeft',
            'ArrowRight',
            'ArrowLeft',
            'ArrowRight',
            'b',
            'a',
          ];
          let index = 0;
          document.addEventListener('keydown', function (e) {
            index = e.key === konami[index] ? index + 1 : 0;
            if (index === konami.length) {
              index = 0;
              for (let i = 0; i < 50; i++) {
                setTimeout(function () {
                  const el = document.createElement('div');
                  el.textContent = ['🎉', '🎊', '✨', '⭐', '💫', '🌟'][
                    Math.floor(Math.random() * 6)
                  ];
                  el.style.cssText =
                    'position:fixed;pointer-events:none;font-size:1.5rem;left:' +
                    Math.random() * 100 +
                    '%;top:' +
                    Math.random() * 100 +
                    '%;animation:konami-float 2.5s ease-out forwards;z-index:9999;';
                  document.body.appendChild(el);
                  setTimeout(function () {
                    el.remove();
                  }, 2500);
                }, i * 40);
              }
              const style = document.createElement('style');
              style.textContent =
                '@keyframes konami-float{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-80px) scale(1.5)}}';
              document.head.appendChild(style);
              setTimeout(function () {
                style.remove();
              }, 3000);
            }
          });
        };
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(initKonami, { timeout: 2000 });
        } else {
          setTimeout(initKonami, 800);
        }
      })();
    </script>
    <ServiceWorkerRegister lang={lang} />
  </body>
</html>
