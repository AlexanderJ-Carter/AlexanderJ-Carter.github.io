---
// 诗词和历史上的今天组件
const lang = Astro.props.lang || 'zh-CN';
const isZh = lang === 'zh-CN' || lang === 'zh-TW';

// Curated quotes for non-Chinese visitors (grouped by language for variety)
const internationalQuotes: Record<string, { text: string; author: string; source?: string }[]> = {
  'en-GB': [
    { text: 'A photograph is a certificate of presence.', author: 'Roland Barthes', source: 'Camera Lucida' },
    { text: 'Photography is the art of frozen time — the ability to store emotion and feelings within a frame.', author: 'Meshack Otieno' },
    { text: 'Light makes photography. Embrace light. Admire it. Love it. But above all, know light.', author: 'George Eastman' },
    { text: 'The best camera is the one you have with you.', author: 'Chase Jarvis' },
    { text: 'Simplicity is the ultimate sophistication.', author: 'Leonardo da Vinci' },
    { text: 'Perfection is achieved not when there is nothing more to add, but when there is nothing left to take away.', author: 'Antoine de Saint-Exupéry' },
    { text: 'The purpose of art is washing the dust of daily life off our souls.', author: 'Pablo Picasso' },
    { text: 'In photography there is a reality so subtle that it becomes more real than reality.', author: 'Alfred Stieglitz' },
  ],
  fr: [
    { text: "Une photographie, c'est un certificat de présence.", author: 'Roland Barthes', source: 'La chambre claire' },
    { text: 'La perfection est atteinte, non pas lorsqu\'il n\'y a plus rien à ajouter, mais lorsqu\'il n\'y a plus rien à enlever.', author: 'Antoine de Saint-Exupéry' },
    { text: 'La simplicité est la sophistication suprême.', author: 'Léonard de Vinci' },
    { text: "L'imagination est plus importante que le savoir.", author: 'Albert Einstein' },
    { text: "La lumière est la matière première de la photographie.", author: 'Ansel Adams' },
    { text: "Chaque image est une histoire.", author: 'Henri Cartier-Bresson' },
  ],
  ru: [
    { text: 'Совершенство достигается не тогда, когда нечего добавить, а тогда, когда нечего убрать.', author: 'Антуан де Сент-Экзюпери' },
    { text: 'Воображение важнее знания.', author: 'Альберт Эйнштейн' },
    { text: 'Простота — это высшая степень изощрённости.', author: 'Леонардо да Винчи' },
    { text: 'Фотография — это сертификат присутствия.', author: 'Ролан Барт' },
    { text: 'Свет — это живопись, написанная мгновением.', author: 'Man Ray' },
  ],
};

const sectionTitle = isZh
  ? '每日灵感'
  : (lang === 'fr' ? 'Inspiration du jour' : (lang === 'ru' ? 'Вдохновение дня' : 'Daily Inspiration'));

const sectionSubtitle = isZh
  ? '诗词与历史的交织，为生活注入文化气息'
  : (lang === 'fr' ? 'Citations et histoire se croisent pour enrichir le quotidien'
    : (lang === 'ru' ? 'Цитаты и история переплетаются, привнося культуру в жизнь'
      : 'Quotes and history intertwined, enriching life with culture'));

const poemTitle = isZh
  ? '今日诗词'
  : (lang === 'fr' ? 'Citation du jour' : (lang === 'ru' ? 'Цитата дня' : 'Quote of the Day'));

const historyTitle = isZh
  ? '历史上的今天'
  : (lang === 'fr' ? 'Ce jour dans l\'histoire' : (lang === 'ru' ? 'В этот день' : 'On This Day'));

const poemLoadingText = isZh ? '载入诗词中...' : '...';
const historyLoadingText = isZh ? '载入中...' : '...';
const historyEventLoadingText = isZh ? '正在获取历史事件...' : '...';

// Pass quotes to client script as JSON
const intlQuotesJson = JSON.stringify(internationalQuotes[lang] || internationalQuotes['en-GB']);
---

<section
  class="py-20 bg-gradient-to-br from-primary-500/10 via-accent-500/10 to-primary-500/10 relative overflow-hidden"
>
  <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-4">
        {sectionTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))]">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- 诗词/Quote部分 -->
      <div class="glass-card p-8 h-full">
        <div class="flex items-center justify-center mb-6">
          <div
            class="w-16 h-16 rounded-full bg-primary-500/10 flex items-center justify-center"
          >
            <svg
              class="w-8 h-8 text-primary-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              ></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-center mb-6">
          {poemTitle}
        </h3>
        <div class="text-center min-h-[120px] flex flex-col justify-center">
          {isZh ? (
            <>
              <div
                id="poem_sentence"
                class="text-xl md:text-2xl font-medium mb-4 text-[rgb(var(--color-text-primary))] leading-relaxed"
              >
                {poemLoadingText}
              </div>
              <div
                class="h-px bg-gradient-to-r from-transparent via-[rgb(var(--color-border))] to-transparent my-4"
              >
              </div>
              <div
                id="poem_info"
                class="text-sm text-[rgb(var(--color-text-secondary))]"
              >
              </div>
            </>
          ) : (
            <div id="intl-quote-block" class="text-center">
              <p
                id="intl-quote-text"
                class="text-lg md:text-xl font-medium mb-4 text-[rgb(var(--color-text-primary))] leading-relaxed italic"
              >
                ...
              </p>
              <div
                class="h-px bg-gradient-to-r from-transparent via-[rgb(var(--color-border))] to-transparent my-4"
              >
              </div>
              <p
                id="intl-quote-author"
                class="text-sm text-[rgb(var(--color-text-secondary))]"
              >
              </p>
            </div>
          )}
        </div>
      </div>

      <!-- 历史上的今天 -->
      <div class="glass-card p-8 h-full">
        <div class="flex items-center justify-center mb-6">
          <div
            class="w-16 h-16 rounded-full bg-accent-500/10 flex items-center justify-center"
          >
            <svg
              class="w-8 h-8 text-accent-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-center mb-6">
          {historyTitle}
        </h3>
        <div
          id="history-today"
          class="text-center min-h-[120px] flex flex-col justify-center"
        >
          <div
            class="history-date text-lg font-semibold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {historyLoadingText}
          </div>
          <div class="history-event text-[rgb(var(--color-text-secondary))]">
            {historyEventLoadingText}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // jinrishici is global

  function initPoemAndHistory() {
    const lang = document.documentElement.lang || 'zh-CN';
    const isZh = lang.startsWith('zh');

    // 加载诗词（只在中文环境下）
    if (isZh) {
      if (typeof jinrishici !== 'undefined') {
        jinrishici.load(function (result) {
          const sentence = document.querySelector('#poem_sentence');
          const info = document.querySelector('#poem_info');

          if (sentence && info && result && result.data) {
            sentence.innerHTML = result.data.content;
            info.innerHTML = `【${result.data.origin.dynasty}】${result.data.origin.author}《${result.data.origin.title}》`;

            sentence.style.opacity = '0';
            info.style.opacity = '0';

            setTimeout(() => {
              sentence.style.transition = 'opacity 0.8s ease';
              sentence.style.opacity = '1';
            }, 300);

            setTimeout(() => {
              info.style.transition = 'opacity 0.8s ease';
              info.style.opacity = '1';
            }, 600);
          }
        });
      }
    } else {
      // 非中文：从全局注入的引言库随机选一条
      var all = window.__intlQuotes || [];
      if (Array.isArray(all) && all.length > 0) {
        var pick = all[Math.floor(Math.random() * all.length)];
        var textEl = document.getElementById('intl-quote-text');
        var authorEl = document.getElementById('intl-quote-author');
        if (textEl) {
          textEl.textContent = '\u201C' + pick.text + '\u201D';
          textEl.style.opacity = '0';
          setTimeout(function () { textEl.style.transition = 'opacity 0.8s ease'; textEl.style.opacity = '1'; }, 100);
        }
        if (authorEl) {
          var src = pick.source ? pick.author + ', ' + pick.source : pick.author;
          authorEl.textContent = '— ' + src;
          authorEl.style.opacity = '0';
          setTimeout(function () { authorEl.style.transition = 'opacity 0.8s ease'; authorEl.style.opacity = '1'; }, 400);
        }
      }
    }

    // 加载历史上的今天
    function getTodayInHistory() {
      const historyEl = document.querySelector('#history-today');
      if (!historyEl) return;

      const now = new Date();
      const monthNum = now.getMonth() + 1;
      const dayNum = now.getDate();

      const docLang = (document.documentElement.lang || 'zh-CN').toLowerCase();
      const apiLang = docLang.startsWith('en')
        ? 'en'
        : docLang.startsWith('ja')
          ? 'ja'
          : docLang.startsWith('it')
            ? 'it'
            : docLang.startsWith('fr')
              ? 'fr'
              : docLang.startsWith('ru')
                ? 'ru'
                : 'zh';

      const endpoint = (l) =>
        `https://${l}.wikipedia.org/api/rest_v1/feed/onthisday/events/${monthNum}/${dayNum}`;

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 6000);

      function render(items) {
        if (!historyEl) return;
        if (!Array.isArray(items) || items.length === 0) {
          const msg = isZh ? '今天暂无事件数据' : 'No events available today';
          historyEl.innerHTML = `<div class="history-event">${msg}</div>`;
          return;
        }
        const item = items[Math.floor(Math.random() * items.length)];
        const year = item.year || '';
        const text =
          item.text ||
          (item.pages && item.pages[0] && item.pages[0].displaytitle) ||
          (isZh ? '历史事件' : 'Historical event');
        const dateLabel = isZh
          ? `${year ? year + '年 ' : ''}${monthNum}/${dayNum}`
          : `${monthNum}/${dayNum}${year ? ' · ' + year : ''}`;

        historyEl.innerHTML = `
          <div class="history-date text-lg font-semibold mb-3 text-[rgb(var(--color-text-primary))]">${dateLabel}</div>
          <div class="history-event text-[rgb(var(--color-text-secondary))]">${text}</div>
        `;

        historyEl.style.opacity = '0';
        setTimeout(() => {
          if (historyEl) {
            historyEl.style.transition = 'opacity 0.8s ease';
            historyEl.style.opacity = '1';
          }
        }, 300);
      }

      // 尝试从缓存获取
      const cacheKey = `history:${apiLang}:${monthNum}-${dayNum}`;
      try {
        const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
        if (cached && Date.now() - cached.ts < 6 * 60 * 60 * 1000) {
          render(cached.events);
          return;
        }
      } catch {}

      // 从Wikipedia获取
      fetch(endpoint(apiLang), {
        signal: controller.signal,
        headers: { accept: 'application/json' },
      })
        .then((r) =>
          r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))
        )
        .then((data) => {
          render(data && data.events);
          try {
            localStorage.setItem(
              cacheKey,
              JSON.stringify({
                ts: Date.now(),
                events: (data && data.events) || [],
              })
            );
          } catch {}
        })
        .catch(() => {
          // 回退到英文
          fetch(endpoint('en'), {
            headers: { accept: 'application/json' },
          })
            .then((r) =>
              r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))
            )
            .then((data) => {
              render(data && data.events);
              try {
                localStorage.setItem(
                  cacheKey,
                  JSON.stringify({
                    ts: Date.now(),
                    events: (data && data.events) || [],
                  })
                );
              } catch {}
            })
            .catch((error) => {
              console.error('Error fetching historical event:', error);
              if (historyEl) {
                const errMsg = isZh
                  ? '历史数据获取失败'
                  : 'Failed to load historical data';
                historyEl.innerHTML = `<div class="history-event">${errMsg}</div>`;
              }
            })
            .finally(() => clearTimeout(timeoutId));
        });
    }

    getTodayInHistory();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPoemAndHistory);
  } else {
    initPoemAndHistory();
  }
</script>

{isZh && (
  <script
    is:inline
    src="https://sdk.jinrishici.com/v2/browser/jinrishici.js"
    async></script>
)}

{!isZh && (
  <script is:inline define:vars={{ intlQuotesJson }}>
    // Set global quotes array SYNCHRONOUSLY before main init
    window.__intlQuotes = JSON.parse(intlQuotesJson || '[]');
  </script>
)}
