---
// 诗词和历史上的今天组件
const lang = Astro.props.lang || 'zh-CN';
---

<section
  class="py-20 bg-gradient-to-br from-primary-500/10 via-accent-500/10 to-primary-500/10 relative overflow-hidden"
>
  <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-4">
        {lang === 'zh-CN' ? '每日灵感' : 'Daily Inspiration'}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))]">
        {
          lang === 'zh-CN'
            ? '诗词与历史的交织，为生活注入文化气息'
            : 'Poetry and history intertwine, bringing cultural richness to life'
        }
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- 诗词部分 -->
      <div class="glass-card p-8 h-full">
        <div class="flex items-center justify-center mb-6">
          <div
            class="w-16 h-16 rounded-full bg-primary-500/10 flex items-center justify-center"
          >
            <svg
              class="w-8 h-8 text-primary-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              ></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-center mb-6">
          {lang === 'zh-CN' ? '今日诗词' : 'Poem of the Day'}
        </h3>
        <div class="text-center min-h-[120px] flex flex-col justify-center">
          <div
            id="poem_sentence"
            class="text-xl md:text-2xl font-medium mb-4 text-[rgb(var(--color-text-primary))] leading-relaxed"
          >
            {lang === 'zh-CN' ? '载入诗词中...' : 'Loading poem...'}
          </div>
          <div
            class="h-px bg-gradient-to-r from-transparent via-[rgb(var(--color-border))] to-transparent my-4"
          >
          </div>
          <div
            id="poem_info"
            class="text-sm text-[rgb(var(--color-text-secondary))]"
          >
          </div>
        </div>
      </div>

      <!-- 历史上的今天 -->
      <div class="glass-card p-8 h-full">
        <div class="flex items-center justify-center mb-6">
          <div
            class="w-16 h-16 rounded-full bg-accent-500/10 flex items-center justify-center"
          >
            <svg
              class="w-8 h-8 text-accent-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-center mb-6">
          {lang === 'zh-CN' ? '历史上的今天' : 'On This Day'}
        </h3>
        <div
          id="history-today"
          class="text-center min-h-[120px] flex flex-col justify-center"
        >
          <div
            class="history-date text-lg font-semibold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {lang === 'zh-CN' ? '载入中...' : 'Loading...'}
          </div>
          <div class="history-event text-[rgb(var(--color-text-secondary))]">
            {
              lang === 'zh-CN'
                ? '正在获取历史事件...'
                : 'Fetching historical events...'
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // jinrishici is global

  function initPoemAndHistory() {
    const lang = document.documentElement.lang || 'zh-CN';
    const isZh = lang.startsWith('zh');

    // 加载诗词
    if (typeof jinrishici !== 'undefined') {
      jinrishici.load(function (result) {
        const sentence = document.querySelector('#poem_sentence');
        const info = document.querySelector('#poem_info');

        if (sentence && info && result && result.data) {
          sentence.innerHTML = result.data.content;
          info.innerHTML = `【${result.data.origin.dynasty}】${result.data.origin.author}《${result.data.origin.title}》`;

          sentence.style.opacity = '0';
          info.style.opacity = '0';

          setTimeout(() => {
            sentence.style.transition = 'opacity 0.8s ease';
            sentence.style.opacity = '1';
          }, 300);

          setTimeout(() => {
            info.style.transition = 'opacity 0.8s ease';
            info.style.opacity = '1';
          }, 600);
        }
      });
    }

    // 加载历史上的今天
    function getTodayInHistory() {
      const historyEl = document.querySelector('#history-today');
      if (!historyEl) return;

      const now = new Date();
      const monthNum = now.getMonth() + 1;
      const dayNum = now.getDate();

      const docLang = (document.documentElement.lang || 'zh-CN').toLowerCase();
      const apiLang = docLang.startsWith('en')
        ? 'en'
        : docLang.startsWith('ja')
          ? 'ja'
          : docLang.startsWith('it')
            ? 'it'
            : 'zh';

      const endpoint = (l) =>
        `https://${l}.wikipedia.org/api/rest_v1/feed/onthisday/events/${monthNum}/${dayNum}`;

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 6000);

      function render(items) {
        if (!historyEl) return;
        if (!Array.isArray(items) || items.length === 0) {
          const msg = isZh ? '今天暂无事件数据' : 'No events available today';
          historyEl.innerHTML = `<div class="history-event">${msg}</div>`;
          return;
        }
        const item = items[Math.floor(Math.random() * items.length)];
        const year = item.year || '';
        const text =
          item.text ||
          (item.pages && item.pages[0] && item.pages[0].displaytitle) ||
          (isZh ? '历史事件' : 'Historical event');
        const dateLabel = isZh
          ? `${year ? year + '年 ' : ''}${monthNum}/${dayNum}`
          : `${monthNum}/${dayNum}${year ? ' ' + year : ''}`;

        historyEl.innerHTML = `
          <div class="history-date text-lg font-semibold mb-3 text-[rgb(var(--color-text-primary))]">${dateLabel}</div>
          <div class="history-event text-[rgb(var(--color-text-secondary))]">${text}</div>
        `;

        historyEl.style.opacity = '0';
        setTimeout(() => {
          if (historyEl) {
            historyEl.style.transition = 'opacity 0.8s ease';
            historyEl.style.opacity = '1';
          }
        }, 300);
      }

      // 尝试从缓存获取
      const cacheKey = `history:${apiLang}:${monthNum}-${dayNum}`;
      try {
        const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
        if (cached && Date.now() - cached.ts < 6 * 60 * 60 * 1000) {
          render(cached.events);
          return;
        }
      } catch {}

      // 从Wikipedia获取
      fetch(endpoint(apiLang), {
        signal: controller.signal,
        headers: { accept: 'application/json' },
      })
        .then((r) =>
          r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))
        )
        .then((data) => {
          render(data && data.events);
          try {
            localStorage.setItem(
              cacheKey,
              JSON.stringify({
                ts: Date.now(),
                events: (data && data.events) || [],
              })
            );
          } catch {}
        })
        .catch(() => {
          // 回退到英文
          fetch(endpoint('en'), {
            headers: { accept: 'application/json' },
          })
            .then((r) =>
              r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))
            )
            .then((data) => {
              render(data && data.events);
              try {
                localStorage.setItem(
                  cacheKey,
                  JSON.stringify({
                    ts: Date.now(),
                    events: (data && data.events) || [],
                  })
                );
              } catch {}
            })
            .catch((error) => {
              console.error('Error fetching historical event:', error);
              if (historyEl) {
                const errMsg = isZh
                  ? '历史数据获取失败'
                  : 'Failed to load historical data';
                historyEl.innerHTML = `<div class="history-event">${errMsg}</div>`;
              }
            })
            .finally(() => clearTimeout(timeoutId));
        });
    }

    getTodayInHistory();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPoemAndHistory);
  } else {
    initPoemAndHistory();
  }
</script>

<script
  is:inline
  src="https://sdk.jinrishici.com/v2/browser/jinrishici.js"
  async></script>
