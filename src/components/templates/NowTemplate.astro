const text = t[lang as Lang] || t['zh-CN'];

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<BaseLayout title={text.title} description={text.subtitle}>
  <PageHero
    folio="Folio Now"
    kicker="Now"
    title={text.title}
    description={text.subtitle}
    narrow={false}
  />

  <section class="pb-20 md:pb-28">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <div class="mb-4">
        <WeatherWidget lang={lang} variant="panel" ambient={true} />
        <p class="mt-2 text-xs text-[rgb(var(--color-text-tertiary))]">
          {text.weatherNote}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <article class="border border-[rgb(var(--color-border))] p-6">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">
            {text.localTime}
          </p>
          <p
            id="now-local"
            class="text-2xl font-heading font-bold text-[rgb(var(--color-text-primary))] tabular-nums"
          >
            --:--:--
          </p>
        </article>
        <article class="border border-[rgb(var(--color-border))] p-6">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">
            {text.utcTime}
          </p>
          <p
            id="now-utc"
            class="text-2xl font-heading font-bold text-[rgb(var(--color-text-primary))] tabular-nums"
          >
            --:--:--
          </p>
        </article>
        <article class="border border-[rgb(var(--color-border))] p-6">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">
            {text.timezone}
          </p>
          <p
            id="now-tz"
            class="text-base font-medium text-[rgb(var(--color-text-primary))] break-all"
          >
            -
          </p>
        </article>
        <article class="border border-[rgb(var(--color-border))] p-6">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">
            {text.unix}
          </p>
          <div class="flex items-center gap-3">
            <p
              id="now-unix"
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))] tabular-nums flex-1"
            >
              -
            </p>
            <button
              id="copy-unix"
              type="button"
              class="px-3 py-1.5 border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] hover:border-[rgb(var(--color-text-tertiary))] transition-colors"
            >
              {text.copy}
            </button>
          </div>
        </article>
      </div>

      <div class="border border-[rgb(var(--color-border))] p-6 mt-4">
        <h2
          class="text-xl font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]"
        >
          {text.quick}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href={getLangPath('/time')} class="quick-link">{text.q1}</a>
          <a href={getLangPath('/currency')} class="quick-link">{text.q2}</a>
          <a
            href="https://tools.alexander.xin"
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link">{text.q3}</a
          >
          <a
            href="https://cook.alexander.xin"
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link">{text.q4}</a
          >
          <a
            href="https://linux-command.alexander.xin"
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link">{text.q5}</a
          >
          <a
            href="https://netq.alexander.xin"
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link">{text.q6}</a
          >
        </div>
      </div>

      <p class="mt-6 text-sm text-[rgb(var(--color-text-secondary))]">
        {text.note}
      </p>

      <div class="mt-8 pt-8 border-t border-[rgb(var(--color-border))]">
        <a
          href={getLangPath('/')}
          class="link-underline text-primary-500 hover:text-primary-600 font-medium inline-flex items-center gap-1"
        >
          ← {text.back}
        </a>
      </div>

      <RelatedTools lang={lang} current="now" />
    </div>
  </section>
</BaseLayout>

<script define:vars={{ copiedText: text.copied, copyText: text.copy }} is:inline
>
  (function () {
    const localEl = document.getElementById('now-local');
    const utcEl = document.getElementById('now-utc');
    const tzEl = document.getElementById('now-tz');
    const unixEl = document.getElementById('now-unix');
    const copyBtn = document.getElementById('copy-unix');

    if (!localEl || !utcEl || !tzEl || !unixEl) return;

    const localFmt = new Intl.DateTimeFormat(undefined, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const utcFmt = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
      timeZone: 'UTC',
    });

    function tick() {
      const now = new Date();
      localEl.textContent = localFmt.format(now);
      utcEl.textContent = `${utcFmt.format(now)} UTC`;
      unixEl.textContent = String(Math.floor(now.getTime() / 1000));
      tzEl.textContent =
        Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
    }

    tick();
    const timer = setInterval(tick, 1000);

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(unixEl.textContent || '');
        copyBtn.textContent = copiedText;
        window.setTimeout(() => {
          copyBtn.textContent = copyText;
        }, 1200);
      } catch {
        // ignore clipboard failures in restricted browsers
      }
    });

    window.addEventListener('beforeunload', () => clearInterval(timer));
  })();
</script>

<style>
  .quick-link {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 0.875rem;
    border: 1px solid rgb(var(--color-border));
    color: rgb(var(--color-text-primary));
    font-size: 0.875rem;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .quick-link:hover {
    border-color: rgb(var(--color-accent) / 0.55);
    color: rgb(var(--color-accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-link {
      transition: none;
    }
  }
</style>
