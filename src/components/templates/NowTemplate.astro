    bullet3: 'Organising photos and the gallery',
    bullet4: 'Picking up something new (language or tool)',
    updated: 'Last updated',
    back: 'Back to home',
  },
  fr: {
    title: 'Maintenant',
    subtitle: 'Ce que je fais en ce moment',
