---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../RelatedTools.astro';

const { lang } = Astro.props;
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

const t: Record<Lang, Record<string, string>> = {
  'zh-CN': {
    title: 'Now · 实时面板',
    subtitle: '给访客的当前时间与常用入口',
    badge: '⏱ 实时体验',
    localTime: '本地时间',
    utcTime: 'UTC 时间',
    timezone: '当前时区',
    unix: 'Unix 时间戳',
    copy: '复制',
    copied: '已复制',
    quick: '快捷入口',
    q1: '世界时间',
    q2: '汇率换算',
    q3: '工具中台',
    q4: '做饭菜谱',
    q5: 'Linux 指令',
    q6: 'NetQ 网络排查',
    note: '这个页面不再记录“我在做什么”，而是给你一个即时可用的时间与工具面板。',
    back: '返回首页',
  },
  'zh-TW': {
    title: 'Now · 即時面板',
    subtitle: '給訪客的目前時間與常用入口',
    badge: '⏱ 即時體驗',
    localTime: '本地時間',
    utcTime: 'UTC 時間',
    timezone: '目前時區',
    unix: 'Unix 時間戳',
    copy: '複製',
    copied: '已複製',
    quick: '快捷入口',
    q1: '世界時間',
    q2: '匯率換算',
    q3: '工具中台',
    q4: '做飯菜譜',
    q5: 'Linux 指令',
    q6: 'NetQ 網路排查',
    note: '這個頁面不再記錄「我在做什麼」，而是給你一個即時可用的時間與工具面板。',
    back: '返回首頁',
  },
  'en-GB': {
    title: 'Now · Live Panel',
    subtitle: 'Useful time info and quick links for visitors',
    badge: '⏱ Live utility',
    localTime: 'Local Time',
    utcTime: 'UTC Time',
    timezone: 'Current Time Zone',
    unix: 'Unix Timestamp',
    copy: 'Copy',
    copied: 'Copied',
    quick: 'Quick Links',
    q1: 'World Time',
    q2: 'Currency',
    q3: 'Tool Hub',
    q4: 'Cooking',
    q5: 'Linux Commands',
    q6: 'NetQ Lab',
    note: 'This page is now visitor-focused: live time and useful entry points.',
    back: 'Back to home',
  },
  fr: {
    title: 'Now · Panneau en direct',
    subtitle: 'Heure actuelle et liens utiles pour les visiteurs',
    badge: '⏱ Utilitaire en direct',
    localTime: 'Heure locale',
    utcTime: 'Heure UTC',
    timezone: 'Fuseau horaire',
    unix: 'Horodatage Unix',
    copy: 'Copier',
    copied: 'Copié',
    quick: 'Accès rapides',
    q1: 'Heure mondiale',
    q2: 'Devise',
    q3: 'Hub Outils',
    q4: 'Recettes',
    q5: 'Commandes Linux',
    q6: 'NetQ Lab',
    note: "Cette page est orientée visiteur : heure en direct et accès utiles.",
    back: "Retour à l'accueil",
  },
  ru: {
    title: 'Now · Живая панель',
    subtitle: 'Текущее время и полезные ссылки для посетителей',
    badge: '⏱ В реальном времени',
    localTime: 'Местное время',
    utcTime: 'Время UTC',
    timezone: 'Часовой пояс',
    unix: 'Unix timestamp',
    copy: 'Копировать',
    copied: 'Скопировано',
    quick: 'Быстрые ссылки',
    q1: 'Мировое время',
    q2: 'Валюты',
    q3: 'Хаб инструментов',
    q4: 'Рецепты',
    q5: 'Linux команды',
    q6: 'NetQ Lab',
    note: 'Эта страница теперь про удобство посетителя: время и быстрые входы.',
    back: 'На главную',
  },
};

const text = t[lang as Lang] || t['zh-CN'];

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<BaseLayout title={text.title} description={text.subtitle}>
  <section class="relative py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
    <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-4xl">
      <div class="text-center mb-10">
        <span class="inline-block px-4 py-2 rounded-full bg-primary-500/20 text-primary-600 dark:text-primary-400 text-sm font-medium mb-4">
          {text.badge}
        </span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4 gradient-text tracking-tight">
          {text.title}
        </h1>
        <p class="text-[rgb(var(--color-text-secondary))]">{text.subtitle}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <article class="glass-card p-6 rounded-2xl">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">{text.localTime}</p>
          <p id="now-local" class="text-2xl font-bold text-[rgb(var(--color-text-primary))] tabular-nums">--:--:--</p>
        </article>
        <article class="glass-card p-6 rounded-2xl">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">{text.utcTime}</p>
          <p id="now-utc" class="text-2xl font-bold text-[rgb(var(--color-text-primary))] tabular-nums">--:--:--</p>
        </article>
        <article class="glass-card p-6 rounded-2xl">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">{text.timezone}</p>
          <p id="now-tz" class="text-base font-medium text-[rgb(var(--color-text-primary))] break-all">-</p>
        </article>
        <article class="glass-card p-6 rounded-2xl">
          <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-2">{text.unix}</p>
          <div class="flex items-center gap-3">
            <p id="now-unix" class="text-xl font-bold text-[rgb(var(--color-text-primary))] tabular-nums flex-1">-</p>
            <button id="copy-unix" type="button" class="px-3 py-1.5 rounded-lg text-sm bg-primary-500/15 hover:bg-primary-500/25 text-primary-600 dark:text-primary-400">
              {text.copy}
            </button>
          </div>
        </article>
      </div>

      <div class="glass-card p-6 rounded-2xl mt-6">
        <h2 class="text-xl font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]">{text.quick}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href={getLangPath('/time')} class="quick-link">🕐 {text.q1}</a>
          <a href={getLangPath('/currency')} class="quick-link">💱 {text.q2}</a>
          <a href="https://tools.alexander.xin" target="_blank" rel="noopener noreferrer" class="quick-link">🧰 {text.q3}</a>
          <a href="https://cook.alexander.xin" target="_blank" rel="noopener noreferrer" class="quick-link">🍳 {text.q4}</a>
          <a href="https://linux-command.alexander.xin" target="_blank" rel="noopener noreferrer" class="quick-link">🐧 {text.q5}</a>
          <a href="https://netq.alexander.xin" target="_blank" rel="noopener noreferrer" class="quick-link">🧪 {text.q6}</a>
        </div>
      </div>

      <p class="mt-6 text-sm text-[rgb(var(--color-text-secondary))]">{text.note}</p>

      <div class="mt-8">
        <a href={getLangPath('/')} class="link-underline text-primary-500 hover:text-primary-600 font-medium inline-flex items-center gap-1">
          ← {text.back}
        </a>
      </div>

      <RelatedTools lang={lang} current="now" />
    </div>
  </section>
</BaseLayout>

<script define:vars={{ copiedText: text.copied, copyText: text.copy }} is:inline>
  (function () {
    const localEl = document.getElementById('now-local');
    const utcEl = document.getElementById('now-utc');
    const tzEl = document.getElementById('now-tz');
    const unixEl = document.getElementById('now-unix');
    const copyBtn = document.getElementById('copy-unix');

    if (!localEl || !utcEl || !tzEl || !unixEl) return;

    const localFmt = new Intl.DateTimeFormat(undefined, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const utcFmt = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
      timeZone: 'UTC',
    });

    function tick() {
      const now = new Date();
      localEl.textContent = localFmt.format(now);
      utcEl.textContent = `${utcFmt.format(now)} UTC`;
      unixEl.textContent = String(Math.floor(now.getTime() / 1000));
      tzEl.textContent = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
    }

    tick();
    const timer = setInterval(tick, 1000);

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(unixEl.textContent || '');
        copyBtn.textContent = copiedText;
        window.setTimeout(() => {
          copyBtn.textContent = copyText;
        }, 1200);
      } catch (_err) {
        // ignore clipboard failures in restricted browsers
      }
    });

    window.addEventListener('beforeunload', () => clearInterval(timer));
  })();
</script>

<style>
  .quick-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-bg-secondary));
    color: rgb(var(--color-text-primary));
    transition: all 0.2s ease;
  }

  .quick-link:hover {
    border-color: rgb(var(--color-primary));
    background: rgb(var(--color-bg-tertiary));
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-link {
      transition: none;
    }
    .quick-link:hover {
      transform: none;
    }
  }
</style>
