    sectionFocus: 'Сейчас в приоритете',
    focus:
      'Учёба, поддержка этого сайта, иногда блог. Без платной рекламы и фейков — просто личный уголок в сети.',
    sectionReading: 'Читаю',
    reading: 'Технические блоги и статьи о продуктах; иногда нон-фикшн и художественное.',
    sectionListening: 'Слушаю',
    listening: 'Фортепианную и лёгкую классическую музыку во время работы с кодом. На сайте есть встроенный плеер с несколькими любимыми треками.',
    sectionLearning: 'Изучаю',
    learning: 'Углублённую веб-разработку (производительность, инструменты сборки); продвинутые паттерны Verilog; и основы японского.',
    sectionBullets: 'В последнее время',
    bullet1: 'Постоянно улучшаю UX и контент сайта',
    bullet2: 'Поддерживаю несколько тренировок в неделю',
    bullet3: 'Разбираю фото и галерею',
    bullet4: 'Учу что-то новое (язык или инструмент)',
    updated: 'Обновлено',
    back: 'На главную',
  },
};

const text = t[lang as Lang] || t['zh-CN'];
const nowDate = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={text.title} description={text.subtitle}>
  <section class="relative py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
    <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
      <div class="text-center mb-12">
        <span
          class="inline-block px-4 py-2 rounded-full bg-primary-500/20 text-primary-600 dark:text-primary-400 text-sm font-medium mb-4"
        >
          📍 Now
        </span>
        <h1
          class="text-4xl md:text-5xl font-heading font-bold mb-4 gradient-text tracking-tight"
        >
          {text.title}
        </h1>
        <p class="text-[rgb(var(--color-text-secondary))]">
          {text.subtitle}
        </p>
      </div>

      <div class="space-y-8">
        <p class="text-[rgb(var(--color-text-secondary))] text-sm">
          {text.intro}
          <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-500 hover:underline"
          >
            {text.introLink}
          </a>
          {text.introEnd}
        </p>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionLife}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {text.life}
          </p>
        </div>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionFocus}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {text.focus}
          </p>
        </div>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionReading}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {text.reading}
          </p>
        </div>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionListening}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {text.listening}
          </p>
        </div>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionLearning}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {text.learning}
          </p>
        </div>

        <div class="glass-card p-8 reveal">
          <h2
            class="text-xl font-bold mb-4 text-[rgb(var(--color-text-primary))]"
          >
            {text.sectionBullets}
          </h2>
          <ul class="space-y-3">
            {[text.bullet1, text.bullet2, text.bullet3, text.bullet4].map((item) => (
              <li class="flex items-start gap-3 text-[rgb(var(--color-text-secondary))]">
                <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-primary-500/15 text-primary-500 flex items-center justify-center" aria-hidden="true">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex items-center justify-between text-sm text-[rgb(var(--color-text-tertiary))]">
          <p>{text.updated}: <time datetime={nowDate}>{nowDate}</time></p>
          <a
            href={lang === 'zh-CN' ? '/' : `/${lang === 'en-GB' ? 'en' : lang}/`}
            class="link-underline text-primary-500 hover:text-primary-600 font-medium inline-flex items-center gap-1"
          >
            ← {text.back}
          </a>
        </div>
      </div>

      <RelatedTools lang={lang} current="now" />
    </div>
  </section>
</BaseLayout>
