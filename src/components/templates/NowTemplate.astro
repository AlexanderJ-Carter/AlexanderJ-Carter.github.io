    q3: '工具中台',
    q4: '做飯菜譜',
    q5: 'Linux 指令',
    q6: 'NetQ 網路排查',
    note: '這個頁面不再記錄「我在做什麼」，而是給你一個即時可用的時間、天氣與工具面板。',
    back: '返回首頁',
    weatherNote: '允許定位則用當地天氣；否則預設北京（Open-Meteo）。',
  },
  'en-GB': {
    title: 'Now · Live Panel',
    subtitle: 'Useful time info and quick links for visitors',
    badge: '⏱ Live utility',
    localTime: 'Local Time',
    utcTime: 'UTC Time',
    timezone: 'Current Time Zone',
    unix: 'Unix Timestamp',
    copy: 'Copy',
    copied: 'Copied',
    quick: 'Quick Links',
    q1: 'World Time',
    q2: 'Currency',
    q3: 'Tool Hub',
    q4: 'Cooking',
    q5: 'Linux Commands',
    q6: 'NetQ Lab',
    note: 'Visitor-focused: live time, weather, and useful entry points.',
    back: 'Back to home',
    weatherNote:
      'Uses your location when allowed; otherwise Beijing (Open-Meteo).',
  },
  fr: {
    title: 'Now · Panneau en direct',
    subtitle: 'Heure actuelle et liens utiles pour les visiteurs',
    badge: '⏱ Utilitaire en direct',
    localTime: 'Heure locale',
    utcTime: 'Heure UTC',
    timezone: 'Fuseau horaire',
    unix: 'Horodatage Unix',
    copy: 'Copier',
    copied: 'Copié',
    quick: 'Accès rapides',
    q1: 'Heure mondiale',
    q2: 'Devise',
    q3: 'Hub Outils',
    q4: 'Recettes',
    q5: 'Commandes Linux',
    q6: 'NetQ Lab',
    note: 'Orientée visiteur : heure, météo et accès utiles.',
