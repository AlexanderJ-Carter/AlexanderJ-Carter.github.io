---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../chrome/AdSlot.astro';
import PoemHistory from '../widgets/PoemHistory.astro';
import ExposureMeter from '../widgets/ExposureMeter.astro';
import { getCollection } from 'astro:content';
import { homeCopy } from '../../i18n/pages/home';
import {
  gallerySrcFallback,
  gallerySrcSet,
  getLangPath,
  resolveLang,
} from '../../i18n/types';

const { lang: langProp } = Astro.props;
const lang = resolveLang(langProp);
const copy = homeCopy[lang];
const lp = (path: string) => getLangPath(lang, path);

const posts = (await getCollection('writing'))
  .filter(
    (post) => post.data.lang === lang || (lang === 'zh-CN' && !post.data.lang)
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateLocale =
  lang === 'zh-CN'
    ? 'zh-CN'
    : lang === 'zh-TW'
      ? 'zh-TW'
      : lang === 'fr'
        ? 'fr-FR'
        : lang === 'ru'
          ? 'ru-RU'
          : 'en-GB';

const heroImage = '/img/gallery-optimized/landscape-01-xl.webp';
const heroSrcSet = gallerySrcSet(heroImage);
const heroSrc = gallerySrcFallback(heroImage);
---

<BaseLayout mainClass="!p-0" image={heroImage}>
  <!-- Hero: one composition -->
  <section
    class="relative min-h-[100svh] flex items-end md:items-center overflow-hidden"
  >
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src={heroSrc}
        srcset={heroSrcSet}
        sizes="100vw"
        alt=""
        width="1920"
        height="1080"
        class="hero-photo h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/78 via-black/35 to-black/20"
      >
      </div>
      <div class="hero-grain"></div>
    </div>

    <div class="viewfinder-corners" aria-hidden="true">
      <span class="tl"></span>
      <span class="tr"></span>
      <span class="bl"></span>
      <span class="br"></span>
    </div>

    <div
      class="relative z-10 w-full container mx-auto px-4 lg:px-8 pb-20 pt-28 md:pb-28 md:pt-32"
    >
      <div class="max-w-3xl">
        <div class="mb-5 animate-fade-in">
          <ExposureMeter variant="on-dark" />
        </div>
        <p
          class="font-heading text-sm md:text-base tracking-[0.22em] uppercase text-white/70 mb-5 animate-fade-in"
        >
          Photography · Writing · Making
        </p>
        <h1
          class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-white mb-6 text-balance animate-fade-in-up drop-shadow-[0_2px_24px_rgba(0,0,0,0.35)]"
        >
          {copy.brand}
        </h1>
        <p
          class="text-lg md:text-xl text-white/85 max-w-xl mb-10 leading-relaxed animate-fade-in-up"
          style="animation-delay: 80ms"
        >
          {copy.tagline}
        </p>
        <div
          class="flex flex-col sm:flex-row gap-3 sm:gap-4 animate-fade-in-up"
          style="animation-delay: 140ms"
        >
          <a
            href={lp('/gallery')}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-stone-900 font-heading font-semibold tracking-wide hover:bg-white/90 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white shadow-[0_12px_40px_-12px_rgba(0,0,0,0.5)]"
          >
            {copy.ctaGallery}
          </a>
          <a
            href={lp('/writing')}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-white/45 bg-white/5 backdrop-blur-[2px] text-white font-heading font-semibold tracking-wide hover:bg-white/12 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {copy.ctaWriting}
          </a>
        </div>
      </div>
    </div>

    <a
      href="#featured"
      class="hero-scroll-hint hover:text-white/80 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      <span>{copy.scrollHint}</span>
      <i></i>
    </a>
  </section>

  <!-- Featured works -->
  <section id="featured" class="py-20 md:py-28 reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="flex items-end justify-between gap-4 mb-12 max-w-3xl">
        <div>
          <p class="folio-mark mb-3">Plate 01</p>
          <h2
            class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-3"
          >
            {copy.featuredTitle}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] text-lg">
            {copy.featuredSubtitle}
          </p>
        </div>
        <p
          class="meta-mono !text-[10px] text-[rgb(var(--color-text-tertiary))] hidden sm:block shrink-0 pb-1"
        >
          {copy.sheetCaption}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4 mb-10">
        {
          copy.featured.map((item, i) => (
            <a
              href={lp('/gallery')}
              class={`contact-sheet group relative block overflow-hidden aspect-[4/5] md:aspect-[3/4] media-zoom ${i === 0 ? 'md:aspect-[3/4]' : ''}`}
            >
              <span class="contact-sheet-frame">
                {String(i + 1).padStart(2, '0')}
              </span>
              <img
                src={gallerySrcFallback(item.image)}
                srcset={gallerySrcSet(item.image)}
                sizes="(min-width: 768px) 33vw, 100vw"
                alt={item.title}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent opacity-90 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity" />
              <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6">
                <p class="meta-mono !text-white/70 text-xs mb-1">
                  {item.category}
                </p>
                <h3 class="font-heading text-white text-xl font-semibold">
                  {item.title}
                </h3>
              </div>
            </a>
          ))
        }
      </div>

      <a
        href={lp('/gallery')}
        class="inline-flex items-center gap-2 font-heading font-semibold text-primary-600 dark:text-primary-400 hover:gap-3 transition-all"
      >
        {copy.featuredViewAll}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <div class="container mx-auto px-4 lg:px-8">
    <AdSlot slot="home" format="horizontal" />
  </div>

  <!-- Studio + paths -->
  <section
    class="py-20 md:py-24 border-y border-[rgb(var(--color-border))] reveal"
  >
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-end">
        <div class="max-w-2xl">
          <p class="folio-mark mb-3">Plate 02</p>
          <h2
            class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-5"
          >
            {copy.studioTitle}
          </h2>
          <p
            class="text-lg text-[rgb(var(--color-text-secondary))] leading-relaxed mb-8"
          >
            {copy.studioBody}
          </p>
          <a href={lp('/about')} class="btn-primary">{copy.studioCta}</a>
        </div>
        <aside
          class="border-l-2 border-[rgb(var(--color-accent)_/_0.45)] pl-6 py-1"
        >
          <p
            class="meta-mono !text-[10px] mb-3 text-[rgb(var(--color-text-tertiary))]"
          >
            {copy.pathsLabel}
          </p>
          <ul class="space-y-4">
            {
              copy.paths.map((item) => (
                <li>
                  <a
                    href={lp(item.href)}
                    class="group flex items-baseline justify-between gap-4 border-b border-[rgb(var(--color-border))] pb-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-500"
                  >
                    <span class="font-heading font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                      {item.title}
                    </span>
                    <span
                      class="text-sm text-[rgb(var(--color-text-tertiary))] group-hover:translate-x-0.5 transition-transform"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- Darkroom method -->
  <section class="py-16 md:py-20 reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-2xl mb-10">
        <p class="folio-mark mb-3">{copy.methodKicker}</p>
        <h2
          class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-3"
        >
          {copy.methodTitle}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] text-lg">
          {copy.methodLead}
        </p>
      </div>
      <div class="principle-grid shadow-[var(--shadow-sm)]">
        {
          copy.method.map((item, i) => (
            <article class="principle-item">
              <span class="principle-item__idx">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="principle-item__title">{item.title}</h3>
                <p class="principle-item__body">{item.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Research dossier strip -->
  <section class="py-16 md:py-20 reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="film-edge mb-10" aria-hidden="true"></div>
      <div class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-end py-2">
        <div class="max-w-2xl">
          <p class="folio-mark mb-3">{copy.researchKicker}</p>
          <h2
            class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-4"
          >
            {copy.researchTitle}
          </h2>
          <p
            class="text-[rgb(var(--color-text-secondary))] text-lg leading-relaxed"
          >
            {copy.researchBody}
          </p>
        </div>
        <a href={lp('/about')} class="btn-primary shrink-0">
          {copy.researchCta} →
        </a>
      </div>
    </div>
  </section>

  <!-- Elsewhere -->
  <section class="py-20 md:py-24 bg-[rgb(var(--color-bg-secondary))] reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10"
      >
        <div class="max-w-2xl">
          <p class="folio-mark mb-3">Plate 03</p>
          <h2
            class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-2"
          >
            {copy.elsewhereTitle}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] text-lg">
            {copy.elsewhereSubtitle}
          </p>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 shrink-0">
          <a
            href={lp('/tools')}
            class="font-heading font-semibold text-primary-600 dark:text-primary-400"
          >
            {copy.elsewhereTools} →
          </a>
          <a
            href={lp('/projects')}
            class="font-heading font-semibold text-[rgb(var(--color-text-secondary))] hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
          >
            {copy.elsewhereProjects} →
          </a>
        </div>
      </div>

      <div class="folio-directory shadow-[var(--shadow-sm)]">
        {
          copy.elsewhere.map((item, i) => {
            const host = new URL(item.href).hostname.replace(/^www\./, '');
            return (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="folio-directory-row !items-start sm:!items-baseline"
              >
                <span class="fd-index pt-0.5">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0">
                  <span class="fd-title !text-lg md:!text-xl">
                    {item.title}
                  </span>
                  <span class="fd-host fd-host-mobile">{host}</span>
                  <p class="mt-1.5 text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed max-w-xl">
                    {item.desc}
                  </p>
                </span>
                <span class="fd-host fd-host-desktop pt-1">{host}</span>
                <span class="fd-arrow pt-1" aria-hidden="true">
                  ↗
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Writing + reading -->
  <section class="py-20 md:py-28 reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-[1.5fr_1fr] gap-12 lg:gap-16">
        <div>
          <div
            class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12"
          >
            <div class="max-w-2xl">
              <p class="folio-mark mb-3">Plate 04</p>
              <h2
                class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-3"
              >
                {copy.writingTitle}
              </h2>
              <p class="text-[rgb(var(--color-text-secondary))] text-lg">
                {copy.writingSubtitle}
              </p>
            </div>
            <a
              href={lp('/writing')}
              class="font-heading font-semibold text-primary-600 dark:text-primary-400 shrink-0"
            >
              {copy.writingViewAll} →
            </a>
          </div>

          {
            posts.length === 0 ? (
              <p class="text-[rgb(var(--color-text-secondary))]">
                {copy.writingEmpty}
              </p>
            ) : (
              <ul class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))]">
                {posts.map((post, i) => (
                  <li>
                    <a
                      href={lp(`/writing/${post.id}`)}
                      class="group list-row flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-6 px-1 -mx-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
                    >
                      <span class="folio-mark sm:w-14 shrink-0">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="meta-mono text-sm text-[rgb(var(--color-text-tertiary))] sm:w-28 shrink-0"
                      >
                        {post.data.pubDate.toLocaleDateString(dateLocale, {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                      <div class="min-w-0">
                        <h3 class="font-heading text-xl font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-1">
                          {post.data.title}
                        </h3>
                        {post.data.description && (
                          <p class="text-[rgb(var(--color-text-secondary))] line-clamp-2">
                            {post.data.description}
                          </p>
                        )}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <aside class="lg:pt-14">
          <div class="lg:pl-2">
            <p class="folio-mark mb-3">Shelf</p>
            <h3 class="font-heading text-2xl font-bold tracking-tight mb-3">
              {copy.readingTitle}
            </h3>
            <p
              class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-6"
            >
              {copy.readingBody}
            </p>
            <a href={lp('/reading-list')} class="btn-secondary">
              {copy.readingCta}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Daily poem / on this day -->
  <PoemHistory lang={lang} />

  <!-- Connect -->
  <section class="py-20 md:py-24 bg-[rgb(var(--color-bg-secondary))] reveal">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-2xl">
        <p class="folio-mark mb-3">Plate 05</p>
        <h2
          class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-4"
        >
          {copy.connectTitle}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] text-lg mb-8">
          {copy.connectSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3">
          <a href={lp('/contact')} class="btn-primary">{copy.connectCta}</a>
          <a
            href="https://blog.alexander.xin"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            {copy.connectBlog} ↗
          </a>
          <a
            href="https://github.com/AlexanderJ-Carter"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            {copy.connectGithub} ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-photo {
    transform: scale(1.04);
    animation: hero-kenburns 28s ease-out forwards;
    filter: saturate(1.05) contrast(1.04);
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
      transform: none;
    }
  }
</style>
