  .orbit-ring-1 {
    width: min(700px, 90vw);
    height: min(700px, 90vw);
    animation: orbit-spin 30s linear infinite;
  }

  .orbit-ring-2 {
    width: min(500px, 65vw);
    height: min(500px, 65vw);
    animation: orbit-spin 24s linear infinite reverse;
  }

  .orbit-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(var(--color-text-tertiary));
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.06);
    /* Position on the ring using angle custom property */
    transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
      rotate(calc(-1 * var(--angle)));
    animation: orbit-counter-spin 30s linear infinite;
    animation-delay: var(--delay);
  }

  .orbit-ring-2 .orbit-icon {
    transform: rotate(var(--angle)) translateX(calc(min(250px, 32.5vw)))
      rotate(calc(-1 * var(--angle)));
    animation-direction: reverse;
    animation-duration: 24s;
  }

  @keyframes orbit-spin {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes orbit-counter-spin {
    from {
      transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
        rotate(calc(-1 * var(--angle) - 0deg));
    }
    to {
      transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
        rotate(calc(-1 * var(--angle) - 360deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
