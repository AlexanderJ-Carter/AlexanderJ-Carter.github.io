const introData: Record<Lang, any> = {
  'zh-CN': {
    lead: '在光影与代码之间，我寻找那些能触动心弦的瞬间。',
    paragraphs: [
      '每一张照片都是一段静默的旅程，像是从流逝中截取的呼吸。',
      '我用镜头记录光线的温度；用代码整理思绪的秩序。愿这些碎片，能在你的眼里汇成一条小小的河流。',
      '欢迎驻足，和我一起在这些影像与文字之间，发现平凡里的温柔。',
    ],
  },
  'en-US': {
    lead: 'Between light and code, I search for moments that touch the heart.',
    paragraphs: [
      'Each photograph is a quiet journey, a breath caught from the passing of time.',
      'I capture the warmth of light with a lens and the order of thought with code. May these fragments become a small river in your eyes.',
      'Stay a while — wander these images and words with me, and find tenderness in the ordinary.',
