const quotes = quoteData[lang as Lang] || quoteData['en-GB'];
const intro = introData[lang as Lang] || introData['en-GB'];
const focus = focusData[lang as Lang] || focusData['en-GB'];

// Language path helper (consistent with Header/Footer)
function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<BaseLayout>
  <!-- Music Player -->
  <MusicPlayer />

  <!-- Hero Section -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
  >
    <!-- Animated Mesh Gradient + Spotlight -->
    <div class="absolute inset-0 bg-mesh-gradient"></div>
    <div class="aurora" aria-hidden="true"></div>
    <div
      class="absolute inset-0 pointer-events-none opacity-100"
      style="background: var(--hero-spotlight);"
      aria-hidden="true"
    >
    </div>
    <!-- Subtle hero glow border -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div
        class="absolute inset-0 border-[1px] border-white/10 dark:border-white/5 rounded-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -inset-[1px] bg-gradient-to-r from-primary-500/20 via-accent-500/20 to-primary-500/20 blur-2xl opacity-40 animate-gradient bg-300% bg-[length:200%_200%]"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- Particles Effect -->
    <div class="absolute inset-0 opacity-30">
      <div class="particle" style="left: 10%; top: 20%; animation-delay: 0s;">
      </div>
      <div class="particle" style="left: 80%; top: 30%; animation-delay: 2s;">
      </div>
      <div class="particle" style="left: 50%; top: 50%; animation-delay: 4s;">
      </div>
      <div class="particle" style="left: 20%; top: 70%; animation-delay: 1s;">
      </div>
      <div class="particle" style="left: 90%; top: 60%; animation-delay: 3s;">
      </div>
    </div>

    <!-- Floating Tech Stack Orbit -->
    <div class="tech-orbit hidden lg:block" aria-hidden="true">
      <div class="orbit-ring orbit-ring-1">
        <span class="orbit-icon" style="--angle: 0deg; --delay: 0s;">C++</span>
        <span class="orbit-icon" style="--angle: 120deg; --delay: -4s;">Py</span
        >
        <span class="orbit-icon" style="--angle: 240deg; --delay: -8s;">JS</span
        >
      </div>
      <div class="orbit-ring orbit-ring-2">
        <span class="orbit-icon" style="--angle: 60deg; --delay: -2s;"
          >Astro</span
        >
        <span class="orbit-icon" style="--angle: 180deg; --delay: -6s;"
          >CSS</span
        >
        <span class="orbit-icon" style="--angle: 300deg; --delay: -10s;"
          >Git</span
        >
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-4 lg:px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <!-- Greeting Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 mb-6 fade-in"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-3 w-3 bg-primary-500"
            ></span>
          </span>
          <span class="text-sm font-medium">{t('hero.greeting')}</span>
        </div>

        <!-- Name with Gradient -->
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-heading font-bold tracking-tight mb-6 fade-in-delay-1"
        >
          <span class="gradient-text"> {t('hero.name')} </span>
