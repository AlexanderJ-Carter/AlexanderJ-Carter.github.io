---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import Typewriter from '../Typewriter.astro';
import StatsCounter from '../StatsCounter.astro';
import MusicPlayer from '../MusicPlayer.astro';
import HolidayGreeting from '../HolidayGreeting.astro';
import PoemHistory from '../PoemHistory.astro';

const { lang } = Astro.props;
const t = useTranslations(lang);

type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

