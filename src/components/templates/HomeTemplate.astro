const introData: Record<Lang, any> = {
  'zh-CN': {
    lead: '在光影与代码之间，我寻找那些能触动心弦的瞬间。',
    paragraphs: [
      '每一张照片都是一段静默的旅程，像是从流逝中截取的呼吸。',
      '我用镜头记录光线的温度；用代码整理思绪的秩序。愿这些碎片，能在你的眼里汇成一条小小的河流。',
      '欢迎驻足，和我一起在这些影像与文字之间，发现平凡里的温柔。',
    ],
  },
  'zh-TW': {
    lead: '在光影與代碼之間，我尋找那些能觸動心弦的瞬間。',
    paragraphs: [
      '每一張照片都是一段靜默的旅程，像是從流逝中截取的呼吸。',
      '我用鏡頭記錄光線的溫度；用代碼整理思緒的秩序。願這些碎片，能在你的眼裡匯成一條小小的河流。',
      '歡迎駐足，和我一起在這些影像與文字之間，發現平凡裡的溫柔。',
    ],
  },
  'en-GB': {
    lead: 'Between light and code, I search for moments that touch the heart.',
    paragraphs: [
      'Each photograph is a quiet journey, a breath caught from the passing of time.',
      'I capture the warmth of light with a lens and the order of thought with code. May these fragments become a small river in your eyes.',
      'Stay a while — wander these images and words with me, and find tenderness in the ordinary.',
    ],
  },
  fr: {
    lead: 'Entre lumière et code, je cherche des instants qui touchent le cœur.',
    paragraphs: [
      'Chaque photographie est un voyage silencieux, une respiration prise au passage du temps.',
      "J'explore la chaleur de la lumière avec l'objectif et l'ordre de la pensée avec le code. Que ces fragments forment une petite rivière dans vos yeux.",
      "Prenez un moment — parcourez ces images et ces mots avec moi, et découvrez la tendresse dans l'ordinaire.",
    ],
  },
  ru: {
    lead: 'Между светом и кодом я ищу мгновения, которые трогают сердце.',
    paragraphs: [
      'Каждая фотография — тихое путешествие, вздох, вырванный у течения времени.',
      'Я ловлю тепло света объективом и упорядочиваю мысли кодом. Пусть эти фрагменты сложатся в маленькую реку в ваших глазах.',
      'Останьтесь ненадолго — пройдитесь по этим образам и словам со мной и найдите нежность в обыденном.',
    ],
  },
};

const quoteData: Record<Lang, any[]> = {
  'zh-CN': [
    {
      text: '设计不仅仅是外观和感觉。设计就是它是如何工作的。',
      author: 'Steve Jobs',
    },
    {
      text: '完美不是无可增添，而是无可删减。',
      author: 'Antoine de Saint-Exupéry',
    },
    { text: '简单是终极的复杂。', author: 'Leonardo da Vinci' },
    { text: '每张照片都是一张时间的证书。', author: 'Susan Sontag' },
    { text: '想象力比知识更重要。', author: 'Albert Einstein' },
    { text: '光是我们感知的方式，也是我们表达的媒介。', author: 'Ansel Adams' },
  ],
  'zh-TW': [
    {
      text: '設計不僅僅是外觀和感覺。設計就是它是如何工作的。',
      author: 'Steve Jobs',
    },
    {
      text: '完美不是無可增添，而是無可刪減。',
      author: 'Antoine de Saint-Exupéry',
    },
    { text: '簡單是終極的複雜。', author: 'Leonardo da Vinci' },
    { text: '每張照片都是一張時間的證書。', author: 'Susan Sontag' },
    { text: '想像力比知識更重要。', author: 'Albert Einstein' },
    { text: '光是我們感知的方式，也是我們表達的媒介。', author: 'Ansel Adams' },
  ],
  'en-GB': [
    {
      text: 'Design is not just what it looks like and feels like. Design is how it works.',
      author: 'Steve Jobs',
    },
    {
      text: 'Perfection is achieved not when there is nothing more to add, but when there is nothing left to take away.',
      author: 'Antoine de Saint-Exupéry',
    },
    {
      text: 'Simplicity is the ultimate sophistication.',
      author: 'Leonardo da Vinci',
    },
    {
      text: 'A photograph is a certificate of presence.',
      author: 'Roland Barthes',
    },
    {
      text: 'Imagination is more important than knowledge.',
      author: 'Albert Einstein',
    },
    {
      text: 'Light makes photography. Embrace light. Admire it. Love it. But above all, know light.',
      author: 'George Eastman',
    },
  ],
  fr: [
    {
      text: "Le design n'est pas seulement ce à quoi il ressemble et ce qu'il ressent. Le design est comment cela fonctionne.",
      author: 'Steve Jobs',
    },
    {
      text: "La perfection est atteinte, non pas lorsqu'il n'y a plus rien à ajouter, mais lorsqu'il n'y a plus rien à enlever.",
      author: 'Antoine de Saint-Exupéry',
    },
    {
      text: 'La simplicité est la sophistication suprême.',
      author: 'Léonard de Vinci',
    },
    {
      text: "Une photographie, c'est un certificat de présence.",
      author: 'Roland Barthes',
    },
    {
      text: "L'imagination est plus importante que le savoir.",
      author: 'Albert Einstein',
    },
  ],
  ru: [
    {
      text: 'Дизайн — это не только то, как это выглядит и чувствуется. Дизайн — это то, как это работает.',
      author: 'Steve Jobs',
    },
    {
      text: 'Совершенство достигается не тогда, когда нечего добавить, а тогда, когда нечего убрать.',
      author: 'Антуан де Сент-Экзюпери',
    },
    {
      text: 'Простота — это высшая степень изощрённости.',
      author: 'Леонардо да Винчи',
    },
    { text: 'Воображение важнее знания.', author: 'Альберт Эйнштейн' },
    { text: 'Фотография — это сертификат присутствия.', author: 'Ролан Барт' },
  ],
};

const typewriterTexts = typewriterData[lang as Lang] || typewriterData['en-GB'];
const stats = statsData[lang as Lang] || statsData['en-GB'];
const featured = featuredWorksData[lang as Lang] || featuredWorksData['en-GB'];
const quotes = quoteData[lang as Lang] || quoteData['en-GB'];
const intro = introData[lang as Lang] || introData['en-GB'];

// Language path helper (consistent with Header/Footer)
function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<BaseLayout>
  <!-- Music Player -->
  <MusicPlayer />

  <!-- Hero Section -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
  >
    <!-- Animated Mesh Gradient + Spotlight -->
    <div class="absolute inset-0 bg-mesh-gradient"></div>
    <div class="aurora" aria-hidden="true"></div>
    <div
      class="absolute inset-0 pointer-events-none opacity-100"
      style="background: var(--hero-spotlight);"
      aria-hidden="true"
    >
    </div>
    <!-- Subtle hero glow border -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div
        class="absolute inset-0 border-[1px] border-white/10 dark:border-white/5 rounded-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -inset-[1px] bg-gradient-to-r from-primary-500/20 via-accent-500/20 to-primary-500/20 blur-2xl opacity-40 animate-gradient bg-300% bg-[length:200%_200%]"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- Particles Effect -->
    <div class="absolute inset-0 opacity-30">
      <div class="particle" style="left: 10%; top: 20%; animation-delay: 0s;">
      </div>
      <div class="particle" style="left: 80%; top: 30%; animation-delay: 2s;">
      </div>
      <div class="particle" style="left: 50%; top: 50%; animation-delay: 4s;">
      </div>
      <div class="particle" style="left: 20%; top: 70%; animation-delay: 1s;">
      </div>
      <div class="particle" style="left: 90%; top: 60%; animation-delay: 3s;">
      </div>
    </div>

    <!-- Floating Tech Stack Orbit -->
    <div class="tech-orbit hidden lg:block" aria-hidden="true">
      <div class="orbit-ring orbit-ring-1">
        <span class="orbit-icon" style="--angle: 0deg; --delay: 0s;">C++</span>
        <span class="orbit-icon" style="--angle: 120deg; --delay: -4s;">Py</span
        >
        <span class="orbit-icon" style="--angle: 240deg; --delay: -8s;">JS</span
        >
      </div>
      <div class="orbit-ring orbit-ring-2">
        <span class="orbit-icon" style="--angle: 60deg; --delay: -2s;"
          >Astro</span
        >
        <span class="orbit-icon" style="--angle: 180deg; --delay: -6s;"
          >CSS</span
        >
        <span class="orbit-icon" style="--angle: 300deg; --delay: -10s;"
          >Git</span
        >
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-4 lg:px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <!-- Greeting Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 mb-6 fade-in"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-3 w-3 bg-primary-500"
            ></span>
          </span>
          <span class="text-sm font-medium">{t('hero.greeting')}</span>
        </div>

        <!-- Name with Gradient -->
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-heading font-bold tracking-tight mb-6 fade-in-delay-1"
        >
          <span class="gradient-text"> {t('hero.name')} </span>
        </h1>

        <!-- Typewriter Effect -->
        <div
          class="text-2xl md:text-4xl font-semibold mb-4 fade-in-delay-2 text-balance min-h-[3rem] flex items-center justify-center"
        >
          <Typewriter texts={typewriterTexts} speed={100} />
        </div>

        <p
          class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] mb-8 fade-in-delay-3 text-balance max-w-2xl mx-auto"
        >
          {t('hero.subtitle')}
        </p>
        <p
          class="text-[rgb(var(--color-text-secondary))] max-w-xl mx-auto mb-10 fade-in-delay-4 lead font-medium"
        >
          {intro.lead}
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center fade-in-delay-4"
        >
          <a href={getLangPath('/gallery')} class="btn-primary glow-on-hover">
            <span>{t('hero.cta.primary')}</span>
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
          <a href={getLangPath('/about')} class="btn-secondary">
            <span>{t('hero.cta.secondary')}</span>
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div
      class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
    >
      <svg
        class="w-6 h-6 text-[rgb(var(--color-text-secondary))]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Stats Section -->
  <section
    class="py-20 bg-[rgb(var(--color-bg-secondary))] reveal relative perf-section"
  >
    <div class="section-divider" aria-hidden="true"></div>
    <div class="container mx-auto px-4 lg:px-8">
      <StatsCounter stats={stats} />
    </div>
  </section>

  <!-- Intro / About snippet -->
  <section class="py-16 reveal perf-section">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <div
        class="prose prose-lg dark:prose-invert max-w-none text-[rgb(var(--color-text-secondary))]"
      >
        {intro.paragraphs.map((p: string) => <p class="mb-4 last:mb-0">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Featured Works Section -->
  <section
    class="py-20 reveal bg-[rgb(var(--color-bg-secondary))] perf-section"
  >
    <div class="section-divider" aria-hidden="true"></div>
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
          {featured.title}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto">
          {featured.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {
          featured.items.map((item: any) => (
            <a
              href={getLangPath('/gallery')}
              class="group block relative overflow-hidden rounded-2xl aspect-[4/3] cursor-pointer card-3d hover:shadow-2xl hover:shadow-primary-500/10 dark:hover:shadow-primary-500/20"
            >
              <div class="absolute inset-0 bg-gray-200 dark:bg-gray-700 animate-pulse" />
              <img
                src={item.image}
                alt={item.title}
                class="object-cover w-full h-full transform transition-transform duration-500 group-hover:scale-110 relative z-10"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 flex flex-col justify-end p-6">
                <span class="text-primary-400 text-sm font-medium mb-1 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
                  {item.category}
                </span>
                <h3 class="text-white text-xl font-bold transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-100">
                  {item.title}
                </h3>
              </div>
              <div
                class="absolute inset-0 rounded-2xl ring-2 ring-transparent group-hover:ring-primary-400/50 transition-all duration-300 z-30 pointer-events-none"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>

      <div class="text-center">
        <a
          href={getLangPath('/gallery')}
          class="inline-flex items-center gap-2 text-primary-500 hover:text-primary-600 font-medium transition-colors group"
        >
          {featured.viewAll}
          <svg
            class="w-5 h-5 transform group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Quote Section -->
  <section
    class="py-20 bg-[rgb(var(--color-bg-primary))] relative overflow-hidden perf-section"
  >
    <div class="section-divider" aria-hidden="true"></div>
    <div
      class="absolute top-0 left-0 w-full h-full opacity-5 pointer-events-none"
    >
      <svg
        class="absolute top-10 left-10 w-32 h-32"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z"
        ></path>
      </svg>
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <blockquote
        class="quote-block max-w-3xl mx-auto text-left"
        id="home-quote"
        data-quotes={JSON.stringify(quotes)}
      >
        <p
          id="quote-text"
          class="text-2xl md:text-4xl font-serif italic mb-6 leading-relaxed text-[rgb(var(--color-text-primary))]"
        >
          "{quotes[0].text}"
        </p>
        <footer
          class="text-lg text-[rgb(var(--color-text-secondary))] font-medium not-italic"
        >
          — <span id="quote-author">{quotes[0].author}</span>
        </footer>
      </blockquote>
    </div>
    <script is:inline>
      (function () {
        const el = document.getElementById('home-quote');
        if (!el) return;
        try {
          const quotesRaw = el.getAttribute('data-quotes');
          if (!quotesRaw) return;
          const all = JSON.parse(quotesRaw);
          if (!Array.isArray(all) || all.length < 2) return;
          const pick = all[Math.floor(Math.random() * all.length)];
          const textEl = document.getElementById('quote-text');
          const authorEl = document.getElementById('quote-author');
          if (textEl) textEl.textContent = '\u201C' + pick.text + '\u201D';
          if (authorEl) authorEl.textContent = pick.author;
        } catch (_) {}
      })();
    </script>
  </section>

  <!-- Holiday Greeting -->
  <HolidayGreeting />

  <!-- Poem History Section -->
  <PoemHistory lang={lang} />
</BaseLayout>

<style>
  .perf-section {
    content-visibility: auto;
    contain-intrinsic-size: 900px;
  }

  /* Tech Stack Orbit */
  .tech-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px dashed rgba(14, 165, 233, 0.12);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit-ring-1 {
    width: min(700px, 90vw);
    height: min(700px, 90vw);
    animation: orbit-spin 30s linear infinite;
  }

  .orbit-ring-2 {
    width: min(500px, 65vw);
    height: min(500px, 65vw);
    animation: orbit-spin 24s linear infinite reverse;
  }

  .orbit-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(var(--color-text-tertiary));
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.06);
    /* Position on the ring using angle custom property */
    transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
      rotate(calc(-1 * var(--angle)));
    animation: orbit-counter-spin 30s linear infinite;
    animation-delay: var(--delay);
  }

  .orbit-ring-2 .orbit-icon {
    transform: rotate(var(--angle)) translateX(calc(min(250px, 32.5vw)))
      rotate(calc(-1 * var(--angle)));
    animation-direction: reverse;
    animation-duration: 24s;
  }

  @keyframes orbit-spin {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes orbit-counter-spin {
    from {
      transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
        rotate(calc(-1 * var(--angle) - 0deg));
    }
    to {
      transform: rotate(var(--angle)) translateX(calc(min(350px, 45vw)))
        rotate(calc(-1 * var(--angle) - 360deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring,
    .orbit-icon {
      animation: none !important;
    }
  }
</style>
