        </footer>
      </blockquote>
    </div>
    <script is:inline>
      (function () {
        const el = document.getElementById('home-quote');
        if (!el) return;
        try {
          const quotesRaw = el.getAttribute('data-quotes');
          if (!quotesRaw) return;
          const all = JSON.parse(quotesRaw);
          if (!Array.isArray(all) || all.length < 2) return;
          const pick = all[Math.floor(Math.random() * all.length)];
          const textEl = document.getElementById('quote-text');
          const authorEl = document.getElementById('quote-author');
          if (textEl) textEl.textContent = '\u201C' + pick.text + '\u201D';
          if (authorEl) authorEl.textContent = pick.author;
        } catch {}
      })();
