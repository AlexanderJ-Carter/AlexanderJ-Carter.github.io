---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../RelatedTools.astro';

const { lang } = Astro.props;
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

const t: Record<
  Lang,
  {
    title: string;
    subtitle: string;
    intro: string;
    builtWith: string;
    builtDesc: string;
    astro: string;
    tailwind: string;
    source: string;
    sourceDesc: string;
    back: string;
    features: string;
    feat1: string;
    feat2: string;
    feat3: string;
    feat4: string;
    perf: string;
    perfDesc: string;
  }
> = {
  'zh-CN': {
    title: '关于本站',
    subtitle: '本网站的技术与结构说明',
    intro: '本站为个人主页与工具集，无广告、无追踪脚本，力求简洁可用。',
    builtWith: '技术栈',
    builtDesc: '静态站点，由 Astro 生成，部署在 GitHub Pages。',
    astro: 'Astro',
    tailwind: 'Tailwind CSS',
    features: '站点特性',
    feat1: '支持中文简体、繁体、English、法语、俄语',
    feat2: '深色 / 浅色主题，跟随系统或手动切换',
    feat3: '无 cookie 追踪，无第三方广告脚本',
    feat4: '无障碍优化（WCAG 2.1 AA）',
    perf: '性能目标',
    perfDesc: '静态生成，首屏加载轻量；图片懒加载，字体按需引入。',
    source: '源代码',
    sourceDesc: '开源在 GitHub，可参考或复用。',
    back: '返回首页',
  },
  'zh-TW': {
    title: '關於本站',
    subtitle: '本網站的技術與結構說明',
    intro: '本站為個人主頁與工具集，無廣告、無追蹤腳本，力求簡潔可用。',
    builtWith: '技術棧',
    builtDesc: '靜態站點，由 Astro 生成，部署在 GitHub Pages。',
    astro: 'Astro',
    tailwind: 'Tailwind CSS',
    features: '站點特性',
    feat1: '支援繁體、簡體、English、法語、俄語',
    feat2: '深色 / 淺色主題，跟隨系統或手動切換',
    feat3: '無 cookie 追蹤，無第三方廣告腳本',
    feat4: '無障礙優化（WCAG 2.1 AA）',
    perf: '效能目標',
    perfDesc: '靜態生成，首屏載入輕量；圖片懶載入，字型按需引入。',
    source: '源代碼',
    sourceDesc: '開源在 GitHub，可參考或複用。',
    back: '返回首頁',
  },
  'en-GB': {
    title: 'About this site',
    subtitle: 'How this website is built',
    intro:
      'Personal site and small tools. No ads, no tracking — minimal and functional.',
    builtWith: 'Built with',
    builtDesc: 'Static site generated by Astro, hosted on GitHub Pages.',
    astro: 'Astro',
    tailwind: 'Tailwind CSS',
    features: 'Features',
    feat1:
      'Multilingual: Chinese (Simplified & Traditional), English, French, Russian',
    feat2: 'Dark / light theme — follows system or toggled manually',
    feat3: 'No cookie tracking, no third-party ad scripts',
    feat4: 'Accessibility optimised (WCAG 2.1 AA)',
    perf: 'Performance',
    perfDesc:
      'Statically generated for a lightweight first load; lazy-loaded images and on-demand fonts.',
    source: 'Source code',
    sourceDesc: 'Open source on GitHub. Feel free to reference or reuse.',
    back: 'Back to home',
  },
  fr: {
    title: 'À propos du site',
    subtitle: 'Comment ce site est construit',
    intro:
      'Site personnel et petits outils. Sans pub ni tracking — minimal et fonctionnel.',
    builtWith: 'Construit avec',
    builtDesc: 'Site statique généré par Astro, hébergé sur GitHub Pages.',
    astro: 'Astro',
    tailwind: 'Tailwind CSS',
    features: 'Caractéristiques',
    feat1:
      'Multilingue : chinois (simplifié & traditionnel), anglais, français, russe',
    feat2: 'Thème clair / sombre — système ou manuel',
    feat3: 'Pas de cookies de suivi ni de scripts publicitaires',
    feat4: 'Accessibilité optimisée (WCAG 2.1 AA)',
    perf: 'Performance',
    perfDesc:
      'Génération statique pour un premier chargement léger ; images différées et polices à la demande.',
    source: 'Code source',
    sourceDesc: "Open source sur GitHub. N'hésitez pas à réutiliser.",
    back: "Retour à l'accueil",
  },
  ru: {
    title: 'О сайте',
    subtitle: 'Как сделан этот сайт',
    intro:
      'Личный сайт и небольшие инструменты. Без рекламы и трекинга — минималистично и функционально.',
    builtWith: 'Сделано с',
    builtDesc: 'Статический сайт на Astro, хостинг на GitHub Pages.',
    astro: 'Astro',
    tailwind: 'Tailwind CSS',
    features: 'Возможности',
    feat1:
      'Мультиязычность: китайский (упрощённый и традиционный), английский, французский, русский',
    feat2: 'Тёмная / светлая тема — по системе или вручную',
    feat3: 'Без cookie-трекинга и рекламных скриптов',
    feat4: 'Оптимизация доступности (WCAG 2.1 AA)',
    perf: 'Производительность',
    perfDesc:
      'Статическая генерация для лёгкой загрузки; ленивая загрузка изображений и шрифтов.',
    source: 'Исходный код',
    sourceDesc: 'Открытый код на GitHub. Смотрите и используйте.',
    back: 'На главную',
  },
};

const text = t[lang as Lang] || t['en-GB'];
const repoUrl =
  'https://github.com/AlexanderJ-Carter/AlexanderJ-Carter.github.io';

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const siteGuideData: Record<Lang, any> = {
  'zh-CN': {
    title: '这里放什么',
    intro:
      '本站不是单纯的作品集，也不是完整博客，更像一个长期维护的个人操作台。',
    sections: [
      {
        title: '作品与照片',
        desc: '画廊承担视觉记录，后续会继续补地点、拍摄意图和系列说明。',
        href: '/gallery',
      },
      {
        title: '小工具',
        desc: '时间、单位、汇率、二维码等工具尽量轻量、本地优先、无需登录。',
        href: '/projects',
      },
      {
        title: '信任与边界',
        desc: '隐私、条款、许可证、无障碍和安全披露用于说明站点怎样运行。',
        href: '/privacy',
      },
    ],
  },
  'zh-TW': {
    title: '這裡放什麼',
    intro:
      '本站不是單純的作品集，也不是完整部落格，更像一個長期維護的個人操作台。',
    sections: [
      {
        title: '作品與照片',
        desc: '畫廊承擔視覺記錄，後續會繼續補地點、拍攝意圖和系列說明。',
        href: '/gallery',
      },
      {
        title: '小工具',
        desc: '時間、單位、匯率、二維碼等工具盡量輕量、本地優先、無需登入。',
        href: '/projects',
      },
      {
        title: '信任與邊界',
        desc: '隱私、條款、許可證、無障礙和安全披露用於說明站點怎樣運行。',
        href: '/privacy',
      },
    ],
  },
  'en-GB': {
    title: 'What Belongs Here',
    intro:
      'This is not only a portfolio and not quite a full blog. It is a maintained personal workbench.',
    sections: [
      {
        title: 'Works & Photos',
        desc: 'The gallery carries visual notes; locations, intent and series notes can grow around it over time.',
        href: '/gallery',
      },
      {
        title: 'Small Tools',
        desc: 'Time, units, currency and QR tools aim to stay lightweight, local-first and login-free.',
        href: '/projects',
      },
      {
        title: 'Trust & Boundaries',
        desc: 'Privacy, terms, licence, accessibility and security disclosure explain how the site operates.',
        href: '/privacy',
      },
    ],
  },
  fr: {
    title: 'Ce qui vit ici',
    intro:
      'Ce n’est pas seulement un portfolio ni un blog complet : c’est un atelier personnel maintenu.',
    sections: [
      {
        title: 'Œuvres et photos',
        desc: 'La galerie porte les notes visuelles ; lieux, intentions et séries pourront s’y ajouter.',
        href: '/gallery',
      },
      {
        title: 'Petits outils',
        desc: 'Heure, unités, devises et QR restent légers, locaux d’abord et sans connexion.',
        href: '/projects',
      },
      {
        title: 'Confiance et cadre',
        desc: 'Confidentialité, conditions, licence, accessibilité et sécurité expliquent le fonctionnement du site.',
        href: '/privacy',
      },
    ],
  },
  ru: {
    title: 'Что здесь находится',
    intro:
      'Это не только портфолио и не полноценный блог, а поддерживаемый личный рабочий стол.',
    sections: [
      {
        title: 'Работы и фото',
        desc: 'Галерея хранит визуальные заметки; позже вокруг них могут появляться места, замыслы и серии.',
        href: '/gallery',
      },
      {
        title: 'Малые инструменты',
        desc: 'Время, единицы, валюты и QR остаются лёгкими, локальными и без входа.',
        href: '/projects',
      },
      {
        title: 'Доверие и границы',
        desc: 'Приватность, условия, лицензия, доступность и безопасность объясняют работу сайта.',
        href: '/privacy',
      },
    ],
  },
};

const siteGuide = siteGuideData[lang as Lang] || siteGuideData['en-GB'];
---

<BaseLayout title={text.title} description={text.subtitle}>
  <section class="relative py-16 md:py-24 overflow-hidden">
    <div
      class="absolute inset-0 bg-mesh-gradient opacity-50"
      aria-hidden="true"
    >
    </div>
    <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-2xl">
      <div class="text-center mb-10">
        <span
          class="inline-block px-4 py-2 rounded-full glass-card text-sm font-medium mb-4"
        >
          🌐 {text.title}
        </span>
        <h1
          class="text-3xl md:text-4xl font-heading font-bold mb-3 gradient-text tracking-tight"
        >
          {text.title}
        </h1>
        <p class="text-[rgb(var(--color-text-secondary))]">
          {text.subtitle}
        </p>
      </div>

      <p
        class="text-[rgb(var(--color-text-secondary))] text-sm mb-8 leading-relaxed"
      >
        {text.intro}
      </p>

      <div class="space-y-5">
        <!-- Tech stack -->
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2
            class="text-lg font-heading font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {text.builtWith}
          </h2>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {text.builtDesc}
          </p>
          <ul class="flex flex-wrap gap-2">
            {
              [text.astro, text.tailwind, 'GitHub Pages', 'TypeScript'].map(
                (tech) => (
                  <li>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm font-medium">
                      {tech}
                    </span>
                  </li>
                )
              )
            }
          </ul>
        </div>

        <!-- Features -->
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2
            class="text-lg font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]"
          >
            {text.features}
          </h2>
          <ul class="space-y-3">
            {
              [text.feat1, text.feat2, text.feat3, text.feat4].map((feat) => (
                <li class="flex items-start gap-3 text-sm text-[rgb(var(--color-text-secondary))]">
                  <span
                    class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-primary-500/15 text-primary-500 flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </span>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Performance -->
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2
            class="text-lg font-heading font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {text.perf}
          </h2>
          <p
            class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed"
          >
            {text.perfDesc}
          </p>
        </div>

        <!-- Site guide -->
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2
            class="text-lg font-heading font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {siteGuide.title}
          </h2>
          <p
            class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed mb-5"
          >
            {siteGuide.intro}
          </p>
          <div class="grid gap-3">
            {
              siteGuide.sections.map((section: any) => (
                <a
                  href={getLangPath(section.href)}
                  class="group flex items-start justify-between gap-4 rounded-xl bg-[rgb(var(--color-bg-primary))] border border-[rgb(var(--color-border))] p-4 hover:border-primary-500/40 transition-colors focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  <span>
                    <span class="block font-semibold text-[rgb(var(--color-text-primary))] group-hover:text-primary-500 transition-colors">
                      {section.title}
                    </span>
                    <span class="block text-sm text-[rgb(var(--color-text-secondary))] mt-1 leading-relaxed">
                      {section.desc}
                    </span>
                  </span>
                  <svg
                    class="w-4 h-4 mt-1 text-[rgb(var(--color-text-tertiary))] group-hover:text-primary-500 group-hover:translate-x-1 transition-all flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Source code -->
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2
            class="text-lg font-heading font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {text.source}
          </h2>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-3">
            {text.sourceDesc}
          </p>
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-2 text-primary-500 hover:text-primary-600 font-medium text-sm"
          >
            <svg
              class="w-4 h-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            GitHub → AlexanderJ-Carter.github.io
          </a>
        </div>
      </div>

      <RelatedTools lang={lang} current="uses" />
    </div>
  </section>
</BaseLayout>
