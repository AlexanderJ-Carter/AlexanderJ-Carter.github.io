const L = labels[lang];

const ui = {
  'zh-CN': {
    description: '站点主题蓝图：点击节点或使用列表导航。',
    lead: '同一条信号链摊开成图。键盘可走列表；图上节点可点。',
    list: '等价列表导航',
    panel: '节点说明',
    empty: '点选一个节点，或从左侧列表进入。',
    continue: room.continueHint,
  },
  'zh-TW': {
    description: '站點主題藍圖：點擊節點或使用列表導航。',
    lead: '同一條信號鏈攤開成圖。鍵盤可走列表；圖上節點可點。',
    list: '等價列表導航',
    panel: '節點說明',
    empty: '點選一個節點，或從左側列表進入。',
    continue: room.continueHint,
  },
  'en-GB': {
    description: 'Blueprint of site themes — click nodes or use the list.',
    lead: 'The signal chain laid flat. Use the list by keyboard; nodes are clickable.',
    list: 'List navigation',
    panel: 'Node notes',
    empty: 'Select a node, or enter from the list.',
    continue: room.continueHint,
  },
  fr: {
    description: 'Plan bleu des thèmes — cliquez ou utilisez la liste.',
    lead: 'La chaîne à plat. Clavier via la liste ; nœuds cliquables.',
    list: 'Navigation liste',
    panel: 'Notes de nœud',
    empty: 'Choisissez un nœud, ou entrez via la liste.',
    continue: room.continueHint,
  },
  ru: {
    description: 'Чертёж тем сайта — клик по узлам или список.',
    lead: 'Цепь сигнала на плоскости. Клавиатура — через список; узлы кликабельны.',
    list: 'Список навигации',
    panel: 'Заметки узла',
    empty: 'Выберите узел или войдите из списка.',
    continue: room.continueHint,
  },
}[lang];

const edges: [string, string][] = [
  ['signal', 'exposure'],
  ['exposure', 'echo'],
  ['signal', 'gallery'],
  ['exposure', 'writing'],
  ['echo', 'fun'],
  ['gallery', 'tools'],
  ['writing', 'tools'],
  ['tools', 'lab'],
  ['echo', 'lab'],
];

function nodePos(id: string) {
  return atlasNodes.find((n) => n.id === id)!;
}
---

<BaseLayout
  title={room.title}
  description={ui.description}
  showHeader={false}
  showFooter={false}
  mainClass="!p-0 next-shell next-shell--atlas"
  robots="noindex, follow"
>
  <div class="atlas" data-atlas>
    <NextChrome lang={lang} roomId="atlas" />

    <div class="atlas__layout">
      <header class="atlas__intro">
        <p class="atlas__id">03 · atlas</p>
        <h1>{room.title}</h1>
        <p>{ui.lead}</p>
      </header>

      <div class="atlas__map-wrap">
        <svg
          class="atlas__map"
          viewBox="0 0 100 100"
          role="img"
          aria-label={room.title}
        >
          {
            edges.map(([a, b]) => {
              const A = nodePos(a);
              const B = nodePos(b);
              return (
                <line
                  x1={A.x}
                  y1={A.y}
                  x2={B.x}
                  y2={B.y}
                  class="atlas__edge"
                />
              );
            })
          }
          {
            atlasNodes.map((n) => (
              <a
                href={n.external ? n.href : lp(n.href)}
                class="atlas__node"
                data-node={n.id}
                {...(n.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <circle cx={n.x} cy={n.y} r="2.2" class="atlas__dot" />
                <text x={n.x} y={n.y - 3.2} text-anchor="middle" class="atlas__label">
                  {L[n.id]?.title ?? n.id}
                </text>
              </a>
            ))
          }
        </svg>
      </div>

      <aside class="atlas__side">
        <h2 class="atlas__side-title">{ui.list}</h2>
        <ul class="atlas__list">
          {
            atlasNodes.map((n) => (
              <li>
                <a
                  href={n.external ? n.href : lp(n.href)}
                  data-node={n.id}
                  {...(n.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  <span class="atlas__list-title">{L[n.id]?.title ?? n.id}</span>
                  <span class="atlas__list-blurb">{L[n.id]?.blurb ?? ''}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="atlas__panel" data-atlas-panel aria-live="polite">
          <h3 class="sr-only">{ui.panel}</h3>
          <p data-atlas-empty>{ui.empty}</p>
          <p data-atlas-detail hidden></p>
        </div>
        <a class="atlas__continue" href={lp(adj.next.path)}>{ui.continue}</a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .next-shell--atlas {
    --next-ink: 4 12 28;
    --next-line: 90 210 230;
    --next-bg: #06101c;
    --next-fg: #c9e8f2;
    background: var(--next-bg);
    color: var(--next-fg);
    min-height: 100svh;
  }

  .atlas__layout {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 960px) {
    .atlas__layout {
      grid-template-columns: 1.4fr 0.9fr;
      grid-template-rows: auto 1fr;
    }

    .atlas__intro {
      grid-column: 1 / -1;
    }
  }

  .atlas__intro h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0 0 0.5rem;
  }

  .atlas__id {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 0.6rem;
  }

  .atlas__intro p:last-child {
    margin: 0;
    opacity: 0.75;
    max-width: 40rem;
    line-height: 1.55;
  }

  .atlas__map-wrap {
    border: 1px solid color-mix(in oklab, rgb(var(--next-line)) 30%, transparent);
    background:
      linear-gradient(rgba(90, 210, 230, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(90, 210, 230, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    min-height: 22rem;
  }

  .atlas__map {
    width: 100%;
    height: min(70vh, 34rem);
    display: block;
  }

  .atlas__edge {
    stroke: color-mix(in oklab, rgb(var(--next-line)) 35%, transparent);
    stroke-width: 0.25;
  }

  .atlas__node {
    cursor: pointer;
    outline: none;
  }

  .atlas__dot {
    fill: rgb(var(--next-line));
    stroke: #06101c;
    stroke-width: 0.35;
    transition: r 160ms ease;
  }

  .atlas__node:hover .atlas__dot,
  .atlas__node:focus-visible .atlas__dot,
  .atlas__node.is-hot .atlas__dot {
    r: 3;
  }

  .atlas__label {
    fill: color-mix(in oklab, var(--next-fg) 85%, white);
    font-size: 2.4px;
    font-family: ui-monospace, Menlo, monospace;
    pointer-events: none;
  }

  .atlas__side-title {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 0.75rem;
  }

  .atlas__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .atlas__list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.65rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
  }

  .atlas__list a:hover,
  .atlas__list a:focus-visible,
  .atlas__list a.is-hot {
    outline: none;
    border-color: color-mix(in oklab, rgb(var(--next-line)) 45%, transparent);
    background: color-mix(in oklab, rgb(var(--next-line)) 8%, transparent);
  }

  .atlas__list-title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .atlas__list-blurb {
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .atlas__panel {
    min-height: 3.5rem;
    padding: 0.75rem 0.65rem;
    border-top: 1px solid color-mix(in oklab, rgb(var(--next-line)) 25%, transparent);
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  .atlas__continue {
    display: inline-block;
    padding: 0.65rem 0.9rem;
    border: 1px solid color-mix(in oklab, rgb(var(--next-line)) 40%, transparent);
    text-decoration: none;
    color: inherit;
    font-size: 0.9rem;
  }

  .atlas__continue:hover,
  .atlas__continue:focus-visible {
    outline: none;
    border-color: rgb(var(--next-line));
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas__dot {
      transition: none;
    }
  }
</style>

<script>
  function initAtlas() {
    const root = document.querySelector('[data-atlas]');
    if (!(root instanceof HTMLElement)) return;

    const detail = root.querySelector('[data-atlas-detail]');
    const empty = root.querySelector('[data-atlas-empty]');
    if (!(detail instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;

    const blurbs = new Map<string, string>();
    root.querySelectorAll('.atlas__list a').forEach((a) => {
      if (!(a instanceof HTMLAnchorElement)) return;
      const id = a.dataset.node;
      const blurb = a.querySelector('.atlas__list-blurb')?.textContent ?? '';
      if (id) blurbs.set(id, blurb);
    });

    const setHot = (id: string | null) => {
      root.querySelectorAll('[data-node]').forEach((el) => {
        el.classList.toggle('is-hot', id != null && el.getAttribute('data-node') === id);
      });
      if (!id) {
        empty.hidden = false;
        detail.hidden = true;
        detail.textContent = '';
        return;
      }
      empty.hidden = true;
      detail.hidden = false;
      detail.textContent = blurbs.get(id) ?? '';
    };

    root.querySelectorAll('[data-node]').forEach((el) => {
      el.addEventListener('mouseenter', () => setHot(el.getAttribute('data-node')));
      el.addEventListener('focus', () => setHot(el.getAttribute('data-node')));
      el.addEventListener('mouseleave', () => setHot(null));
      el.addEventListener('blur', () => setHot(null));
    });
  }

  initAtlas();
  document.addEventListener('astro:page-load', initAtlas);
</script>
