    echo: { title: '回聲台', blurb: '終端暗號與路由' },
    network: { title: '站群目錄', blurb: '公開節點統一索引' },
    gallery: { title: '畫廊', blurb: '攝影作品主展' },
    writing: { title: '寫作', blurb: '工程與觀察' },
    fun: { title: '彩蛋', blurb: '小工具與驚喜' },
    tools: { title: '工具', blurb: '站內與外部工具索引' },
    lab: { title: 'Lab', blurb: '外部 Git/CI 教學站' },
    cook: { title: '食譜', blurb: 'cook.alexander.xin' },
    paste: { title: '加密貼上', blurb: 'PrivateBin' },
  },
  'en-GB': {
    signal: { title: 'Signal', blurb: 'Phosphor play · chain start' },
    exposure: { title: 'Exposure', blurb: 'Long note on waiting for light' },
    echo: { title: 'Echo', blurb: 'Terminal phrases and routes' },
    network: { title: 'Network', blurb: 'Public fleet directory' },
    gallery: { title: 'Gallery', blurb: 'Main photography show' },
    writing: { title: 'Writing', blurb: 'Engineering and observation' },
    fun: { title: 'Play', blurb: 'Widgets and surprises' },
    tools: { title: 'Tools', blurb: 'On-site and external index' },
    lab: { title: 'Lab', blurb: 'External Git/CI courses' },
    cook: { title: 'Recipes', blurb: 'cook.alexander.xin' },
    paste: { title: 'Encrypted paste', blurb: 'PrivateBin' },
  },
  fr: {
    signal: { title: 'Signal', blurb: 'Jeu phosphore · début de chaîne' },
    exposure: { title: 'Exposition', blurb: 'Note longue sur la lumière' },
    echo: { title: 'Écho', blurb: 'Phrases terminal et routes' },
    network: { title: 'Réseau', blurb: 'Annuaire de la flotte' },
    gallery: { title: 'Galerie', blurb: 'Exposition photo' },
    writing: { title: 'Écrits', blurb: 'Ingénierie et observation' },
    fun: { title: 'Surprises', blurb: 'Widgets et œufs de Pâques' },
    tools: { title: 'Outils', blurb: 'Index interne et externe' },
    lab: { title: 'Lab', blurb: 'Cours Git/CI externes' },
    cook: { title: 'Recettes', blurb: 'cook.alexander.xin' },
    paste: { title: 'Collage chiffré', blurb: 'PrivateBin' },
  },
  ru: {
    signal: { title: 'Сигнал', blurb: 'Фосфор · начало цепи' },
    exposure: { title: 'Экспозиция', blurb: 'Длинная заметка о свете' },
    echo: { title: 'Эхо', blurb: 'Фразы терминала и маршруты' },
    network: { title: 'Сеть', blurb: 'Каталог публичных узлов' },
    gallery: { title: 'Галерея', blurb: 'Основная фотовыставка' },
