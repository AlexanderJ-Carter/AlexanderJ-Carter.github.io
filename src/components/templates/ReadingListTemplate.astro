    intro:
      'Вот несколько книг, которые я прочитал или читаю сейчас. Надеюсь, они помогут и вам.',
    currentlyReading: 'Читаю сейчас',
    recommended: 'Рекомендую',
    wantToRead: 'Хочу прочитать',
    back: 'На главную',
