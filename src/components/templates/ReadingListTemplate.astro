---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import RelatedTools from '../chrome/RelatedTools.astro';
import { readingCopy } from '../../i18n/pages/reading-list';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const t = readingCopy[lang];
const lp = (path: string) => getLangPath(lang, path);

function statusLabel(status: string) {
  if (status === 'reading') return t.currently;
  if (status === 'queued') return t.queued;
  return t.finished;
}
---

<BaseLayout title={t.title} description={t.subtitle}>
  <PageHero
    folio="Folio Read"
    kicker={t.kicker}
    title={t.title}
    description={t.intro}
    backHref={lp('/')}
    backLabel={t.back}
  />

  <section class="pb-16 md:pb-20">
    <div class="page-shell">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
      >
        {t.pathsTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-10 leading-relaxed">
        {t.pathsIntro}
      </p>

      <div
        class="space-y-0 border-y border-[rgb(var(--color-border))] divide-y divide-[rgb(var(--color-border))]"
      >
        {
          t.paths.map((path) => (
            <article class="py-8">
              <h3 class="font-heading text-xl font-semibold mb-2">
                {path.title}
              </h3>
              <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-4">
                {path.desc}
              </p>
              <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-4 leading-relaxed">
                {path.why}
              </p>
              <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-heading">
                {path.picks.map((pick) => (
                  <li class="text-primary-600 dark:text-primary-400">{pick}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-20 bg-[rgb(var(--color-bg-secondary))]">
    <div class="page-shell py-16 md:py-20">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
      >
        {t.booksTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-10 leading-relaxed">
        {t.booksIntro}
      </p>

      <ul
        class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))]"
      >
        {
          t.books.map((book) => (
            <li>
              <article class="py-10">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-3">
                  <span class="text-xs tracking-wide uppercase text-[rgb(var(--color-text-tertiary))] font-heading">
                    {statusLabel(book.status)}
                  </span>
                  {book.tags.map((tag) => (
                    <span class="text-xs text-[rgb(var(--color-text-tertiary))]">
                      #{tag}
                    </span>
                  ))}
                </div>

                <h3 class="text-2xl font-heading font-bold mb-1">
                  {book.title}
                </h3>
                <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-5">
                  {book.author}
                </p>

                <blockquote class="pl-5 border-l-2 border-primary-500/40 mb-5">
                  <p class="text-lg italic font-serif text-[rgb(var(--color-text-primary))] leading-relaxed">
                    “{book.quote}”
                  </p>
                </blockquote>

                <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-5 text-[15px] md:text-base">
                  {book.thought}
                </p>

                <p class="text-sm border border-[rgb(var(--color-border))] px-4 py-3 bg-[rgb(var(--color-bg-primary))]">
                  <span class="font-heading font-semibold text-primary-600 dark:text-primary-400 mr-2">
                    {t.takeawayLabel}
                  </span>
                  <span class="text-[rgb(var(--color-text-secondary))]">
                    {book.takeaway}
                  </span>
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="page-shell pt-4">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
      >
        {t.essaysTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-10 leading-relaxed">
        {t.essaysIntro}
      </p>

      <ul
        class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))]"
      >
        {
          t.essays.map((essay) => (
            <li>
              <a
                href={essay.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group block py-6 list-row focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
                  <h3 class="font-heading text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors sm:min-w-[12rem]">
                    {essay.title}
                  </h3>
                  <div class="min-w-0">
                    <p class="text-xs uppercase tracking-wide text-[rgb(var(--color-text-tertiary))] font-heading mb-1">
                      {essay.source}
                    </p>
                    <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed">
                      {essay.note}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <RelatedTools lang={lang} current="reading-list" />
    </div>
  </section>
</BaseLayout>
