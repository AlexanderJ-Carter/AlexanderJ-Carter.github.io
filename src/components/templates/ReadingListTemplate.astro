---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.props;
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

const t: Record<Lang, Record<string, string>> = {
