---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../chrome/AdSlot.astro';
import CopyPermalink from '../widgets/CopyPermalink.astro';
import type { Lang } from '../../i18n/types';

interface Props {
  lang?: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  timeToRead?: string;
}

const {
  lang = 'zh-CN',
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  timeToRead,
} = Astro.props;

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const i18n = {
  'zh-CN': {
    backToList: '返回写作',
    publishedOn: '发布于',
    updatedOn: '更新于',
    shareText: '分享',
  },
  'zh-TW': {
    backToList: '返回寫作',
    publishedOn: '發布於',
    updatedOn: '更新於',
    shareText: '分享',
  },
  'en-GB': {
    backToList: 'Back to Writing',
    publishedOn: 'Published',
    updatedOn: 'Updated',
    shareText: 'Share',
  },
  fr: {
    backToList: 'Retour aux écrits',
    publishedOn: 'Publié',
    updatedOn: 'Mis à jour',
    shareText: 'Partager',
  },
  ru: {
    backToList: 'К статьям',
    publishedOn: 'Опубликовано',
    updatedOn: 'Обновлено',
    shareText: 'Поделиться',
  },
};

const t = i18n[lang as Lang] || i18n['zh-CN'];

const formatDate = (date: Date) => {
  const locale =
    lang === 'zh-CN'
      ? 'zh-CN'
      : lang === 'zh-TW'
        ? 'zh-TW'
        : lang === 'fr'
          ? 'fr-FR'
          : lang === 'ru'
            ? 'ru-RU'
            : 'en-GB';
  return date.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  jsonLd={{
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: 'Alexander James Carter',
      url: 'https://alexander.xin',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': Astro.url.href,
    },
    inLanguage: lang,
  }}
>
  <article class="essay">
    <header class="essay-head">
      <div class="essay-head__wash" aria-hidden="true"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-3xl relative">
        <a href={getLangPath('/writing')} class="essay-back">{t.backToList}</a>
        <p class="essay-kicker">{category}</p>
        <h1 class="essay-title">{title}</h1>
        <p class="essay-deck">{description}</p>
        <div class="essay-byline">
          <time datetime={pubDate.toISOString()}>
            {t.publishedOn}
            {formatDate(pubDate)}
          </time>
          {
            updatedDate && (
              <time datetime={updatedDate.toISOString()}>
                {t.updatedOn} {formatDate(updatedDate)}
              </time>
            )
          }
          {timeToRead && <span>{timeToRead}</span>}
          <CopyPermalink />
        </div>
        {
          tags.length > 0 && (
            <p class="essay-tags">
              {tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="essay-rule" aria-hidden="true"></div>

    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <div class="essay-prose" id="article-content">
        <slot />
      </div>

      <AdSlot slot="article" format="horizontal" />

      <footer class="essay-foot">
        <a href={getLangPath('/writing')} class="essay-foot__back">
          ← {t.backToList}
        </a>
        <div class="essay-foot__share">
          <span>{t.shareText}</span>
          <CopyPermalink />
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .essay {
    padding-bottom: 5rem;
  }

  .essay-head {
    position: relative;
    padding: 7.5rem 0 2.75rem;
    overflow: hidden;
  }
  .essay-head__wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      55% 45% at 80% 10%,
      rgb(var(--color-accent) / 0.07),
      transparent 70%
    );
    pointer-events: none;
  }

  .essay-back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: rgb(var(--color-text-tertiary));
    transition: color 0.18s ease;
  }
  .essay-back:hover {
    color: rgb(var(--color-accent));
  }

  .essay-kicker {
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
    margin-bottom: 1rem;
  }

  .essay-title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 1.15rem;
    text-wrap: balance;
  }

  .essay-deck {
    font-size: 1.2rem;
    line-height: 1.65;
    color: rgb(var(--color-text-secondary));
    max-width: 38rem;
    margin-bottom: 1.5rem;
  }

  .essay-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.1rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgb(var(--color-text-tertiary));
  }

  .essay-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    color: rgb(var(--color-text-tertiary));
  }

  .essay-rule {
    height: 1px;
    margin: 0 auto 2.75rem;
    max-width: 48rem;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--color-border)),
      transparent
    );
  }

  .essay-prose {
    font-size: 1.085rem;
    line-height: 1.85;
    color: rgb(var(--color-text-secondary));
  }

  .essay-prose :global(> :first-child) {
    margin-top: 0;
  }

  .essay-prose :global(h2) {
    font-family: theme('fontFamily.heading');
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgb(var(--color-text-primary));
    margin: 2.85rem 0 1rem;
  }

  .essay-prose :global(h3) {
    font-family: theme('fontFamily.heading');
    font-size: 1.2rem;
    font-weight: 650;
    color: rgb(var(--color-text-primary));
    margin: 2.1rem 0 0.75rem;
  }

  .essay-prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .essay-prose :global(p:first-of-type) {
    font-size: 1.2rem;
    line-height: 1.75;
    color: rgb(var(--color-text-primary) / 0.9);
  }

  .essay-prose :global(ul),
  .essay-prose :global(ol) {
    margin: 0 0 1.35rem 1.15rem;
  }
  .essay-prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .essay-prose :global(ul) {
    list-style: disc;
  }
  .essay-prose :global(ol) {
    list-style: decimal;
  }

  .essay-prose :global(a) {
    color: rgb(var(--color-accent));
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .essay-prose :global(strong) {
    color: rgb(var(--color-text-primary));
    font-weight: 600;
  }

  .essay-prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid rgb(var(--color-accent) / 0.55);
    font-family:
      theme('fontFamily.serif'), ui-serif, Georgia, 'Noto Serif SC', serif;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.7;
    color: rgb(var(--color-text-primary) / 0.82);
  }
  .essay-prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }
  .essay-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .essay-prose :global(code) {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
    padding: 0.1rem 0.3rem;
    border-radius: 0.2rem;
    background: rgb(var(--color-bg-secondary) / 0.8);
    color: rgb(var(--color-text-primary));
  }

  .essay-prose :global(pre) {
    margin: 1.6rem 0;
    padding: 1.15rem 1.2rem;
    border-radius: 0.35rem;
    background: rgb(var(--color-bg-secondary));
    overflow-x: auto;
  }
  .essay-prose :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .essay-prose :global(hr) {
    border: 0;
    height: 1px;
    margin: 2.75rem auto;
    max-width: 8rem;
    background: rgb(var(--color-border));
  }

  .essay-prose :global(img) {
    margin: 1.75rem 0;
    border-radius: 0.25rem;
  }

  .essay-prose :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .essay-prose :global(th),
  .essay-prose :global(td) {
    border-bottom: 1px solid rgb(var(--color-border) / 0.7);
    padding: 0.6rem 0.4rem;
    text-align: left;
  }
  .essay-prose :global(th) {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: rgb(var(--color-text-primary));
  }

  .essay-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--color-border) / 0.55);
  }
  .essay-foot__back {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: rgb(var(--color-accent));
  }
  .essay-foot__share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
</style>
