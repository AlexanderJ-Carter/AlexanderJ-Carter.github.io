---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/types';

interface Props {
  lang?: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  timeToRead?: string;
}

const { lang = 'zh-CN', title, description, pubDate, updatedDate, category, tags, timeToRead } = Astro.props;

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const i18n = {
  'zh-CN': {
    backToList: '返回写作列表',
    publishedOn: '发布于',
    updatedOn: '更新于',
    minRead: '分钟阅读',
    tags: '标签',
    relatedPosts: '相关文章',
    shareText: '分享',
  },
  'zh-TW': {
    backToList: '返回寫作列表',
    publishedOn: '發布於',
    updatedOn: '更新於',
    minRead: '分鐘閱讀',
    tags: '標籤',
    relatedPosts: '相關文章',
    shareText: '分享',
  },
  'en-GB': {
    backToList: 'Back to Writing',
    publishedOn: 'Published on',
    updatedOn: 'Updated on',
    minRead: 'min read',
    tags: 'Tags',
    relatedPosts: 'Related Posts',
    shareText: 'Share',
  },
  fr: {
    backToList: "Retour aux écrits",
    publishedOn: 'Publié le',
    updatedOn: 'Mis à jour le',
    minRead: 'min de lecture',
    tags: 'Tags',
    relatedPosts: 'Articles associés',
    shareText: 'Partager',
  },
  ru: {
    backToList: 'Назад к статьям',
    publishedOn: 'Опубликовано',
    updatedOn: 'Обновлено',
    minRead: 'мин чтения',
    tags: 'Теги',
    relatedPosts: 'Похожие статьи',
    shareText: 'Поделиться',
  },
};

const t = i18n[lang as Lang] || i18n['zh-CN'];

const formatDate = (date: Date) => {
  const locale = lang === 'zh-CN' ? 'zh-CN' : lang === 'zh-TW' ? 'zh-TW' : lang === 'fr' ? 'fr-FR' : lang === 'ru' ? 'ru-RU' : 'en-GB';
  return date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<BaseLayout title={`${title} - Alexander Carter`} description={description}>
  <article class="pt-32 pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <a
        href={getLangPath('/writing')}
        class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>{t.backToList}</span>
      </a>

      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-primary-500/10 text-primary-500">
            {category}
          </span>
          {timeToRead && (
            <span class="text-xs text-[rgb(var(--color-text-tertiary))]">
              {timeToRead}
            </span>
          )}
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]">
          {title}
        </h1>
        <p class="text-lg text-[rgb(var(--color-text-secondary))] mb-4">
          {description}
        </p>
        <div class="flex items-center gap-4 text-sm text-[rgb(var(--color-text-tertiary))]">
          <time datetime={pubDate.toISOString()}>
            {t.publishedOn} {formatDate(pubDate)}
          </time>
          {updatedDate && (
            <time datetime={updatedDate.toISOString()}>
              {t.updatedOn} {formatDate(updatedDate)}
            </time>
          )}
        </div>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-4">
            {tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded bg-[rgb(var(--color-bg-accent))] text-[rgb(var(--color-text-tertiary))]">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none mb-16" id="article-content">
        <slot />
      </div>

      <footer class="border-t border-[rgb(var(--color-border))] pt-8">
        <div class="flex items-center justify-between">
          <a
            href={getLangPath('/writing')}
            class="text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors"
          >
            &larr; {t.backToList}
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  #article-content :global(h2) {
    @apply text-2xl font-bold mt-10 mb-4 text-[rgb(var(--color-text-primary))];
  }
  #article-content :global(h3) {
    @apply text-xl font-semibold mt-8 mb-3 text-[rgb(var(--color-text-primary))];
  }
  #article-content :global(p) {
    @apply text-[rgb(var(--color-text-secondary))] leading-relaxed mb-4;
  }
  #article-content :global(ul), #article-content :global(ol) {
    @apply ml-6 mb-4 space-y-2 text-[rgb(var(--color-text-secondary))];
  }
  #article-content :global(ul) {
    @apply list-disc;
  }
  #article-content :global(ol) {
    @apply list-decimal;
  }
  #article-content :global(code) {
    @apply px-1.5 py-0.5 rounded bg-[rgb(var(--color-bg-accent))] text-sm font-mono;
  }
  #article-content :global(pre) {
    @apply p-4 rounded-xl bg-[rgb(var(--color-bg-secondary))] overflow-x-auto mb-4;
  }
  #article-content :global(pre code) {
    @apply bg-transparent p-0;
  }
  #article-content :global(blockquote) {
    @apply border-l-4 border-primary-500 pl-4 italic text-[rgb(var(--color-text-secondary))] my-4;
  }
  #article-content :global(strong) {
    @apply font-semibold text-[rgb(var(--color-text-primary))];
  }
  #article-content :global(a) {
    @apply text-primary-500 hover:text-primary-600 underline;
  }
  #article-content :global(hr) {
    @apply border-t border-[rgb(var(--color-border))] my-8;
  }
</style>
