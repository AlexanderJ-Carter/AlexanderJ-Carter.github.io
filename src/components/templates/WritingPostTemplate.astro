---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../chrome/AdSlot.astro';
import CopyPermalink from '../widgets/CopyPermalink.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/types';
import { writingCopy } from '../../i18n/pages/writing';
import {
  dateLocaleFor,
  relatedPosts,
  taxonomySlug,
} from '../../lib/writing';

interface Props {
  lang?: string;
  postId: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  timeToRead?: string;
}

const {
  lang = 'zh-CN',
  postId,
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  timeToRead,
} = Astro.props;

const resolvedLang = lang as Lang;

function lp(path: string): string {
  if (resolvedLang === 'zh-CN') return path;
  const prefix = resolvedLang === 'en-GB' ? 'en' : resolvedLang;
  return `/${prefix}${path}`;
}

const t = writingCopy[resolvedLang] ?? writingCopy['zh-CN'];
const dateLocale = dateLocaleFor(resolvedLang);

const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const allPosts = await getCollection('writing');
const related = relatedPosts(allPosts, {
  id: postId,
  category,
  tags,
  lang: resolvedLang,
});
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  jsonLd={{
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: 'Alexander James Carter',
      url: 'https://alexander.xin',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': Astro.url.href,
    },
    inLanguage: resolvedLang,
  }}
>
  <article class="essay">
    <header class="essay-head">
      <div class="essay-head__wash" aria-hidden="true"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-3xl relative">
        <a href={lp('/writing')} class="essay-back">{t.backToList}</a>
        <p class="essay-kicker">
          <a href={lp(`/writing/categories/${taxonomySlug(category)}`)}>
            {category}
          </a>
        </p>
        <h1 class="essay-title">{title}</h1>
        <p class="essay-deck">{description}</p>
        <div class="essay-byline">
          <time datetime={pubDate.toISOString()}>
            {t.publishedOn}
            {formatDate(pubDate)}
          </time>
          {
            updatedDate && (
              <time datetime={updatedDate.toISOString()}>
                {t.updatedOn} {formatDate(updatedDate)}
              </time>
            )
          }
          {timeToRead && <span>{timeToRead}</span>}
          <CopyPermalink />
        </div>
        {
          tags.length > 0 && (
            <p class="essay-tags">
              {tags.map((tag) => (
                <a href={lp(`/writing/tags/${taxonomySlug(tag)}`)}>#{tag}</a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="essay-rule" aria-hidden="true"></div>

    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <div class="essay-prose" id="article-content">
        <slot />
      </div>

      <AdSlot slot="article" format="horizontal" />

      {
        related.length > 0 && (
          <aside class="essay-related" aria-labelledby="related-heading">
            <h2 id="related-heading">{t.related}</h2>
            <ul>
              {related.map((post) => (
                <li>
                  <a href={lp(`/writing/${post.id}`)}>
                    <span class="essay-related__cat">{post.data.category}</span>
                    <span class="essay-related__title">{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <footer class="essay-foot">
        <a href={lp('/writing')} class="essay-foot__back">
          ← {t.backToList}
        </a>
        <div class="essay-foot__share">
          <span>{t.shareText}</span>
          <CopyPermalink />
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .essay {
    padding-bottom: 5rem;
  }

  .essay-head {
    position: relative;
    padding: 7.5rem 0 2.75rem;
    overflow: hidden;
  }
  .essay-head__wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      55% 45% at 80% 10%,
      rgb(var(--color-accent) / 0.07),
      transparent 70%
    );
    pointer-events: none;
  }

  .essay-back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: rgb(var(--color-text-tertiary));
    transition: color 0.18s ease;
  }
  .essay-back:hover,
  .essay-back:focus-visible {
    color: rgb(var(--color-accent));
  }
  .essay-back:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .essay-kicker {
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
    margin-bottom: 1rem;
  }
  .essay-kicker a {
    color: inherit;
  }
  .essay-kicker a:hover,
  .essay-kicker a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .essay-kicker a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .essay-title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 1.15rem;
    text-wrap: balance;
  }

  .essay-deck {
    font-size: 1.2rem;
    line-height: 1.65;
    color: rgb(var(--color-text-secondary));
    max-width: 38rem;
    margin-bottom: 1.5rem;
  }

  .essay-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.1rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgb(var(--color-text-tertiary));
  }

  .essay-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
  }
  .essay-tags a {
    color: rgb(var(--color-text-tertiary));
    transition: color 0.18s ease;
  }
  .essay-tags a:hover,
  .essay-tags a:focus-visible {
    color: rgb(var(--color-accent));
  }
  .essay-tags a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .essay-rule {
    height: 1px;
    margin: 0 auto 2.75rem;
    max-width: 48rem;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--color-border)),
      transparent
    );
  }

  .essay-prose {
    font-size: 1.085rem;
    line-height: 1.85;
    color: rgb(var(--color-text-secondary));
  }

  .essay-prose :global(> :first-child) {
    margin-top: 0;
  }

  .essay-prose :global(h2) {
    font-family: theme('fontFamily.heading');
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgb(var(--color-text-primary));
    margin: 2.85rem 0 1rem;
  }

  .essay-prose :global(h3) {
    font-family: theme('fontFamily.heading');
    font-size: 1.2rem;
    font-weight: 650;
    color: rgb(var(--color-text-primary));
    margin: 2.1rem 0 0.75rem;
  }

  .essay-prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .essay-prose :global(p:first-of-type) {
    font-size: 1.2rem;
    line-height: 1.75;
    color: rgb(var(--color-text-primary) / 0.9);
  }

  .essay-prose :global(ul),
  .essay-prose :global(ol) {
    margin: 0 0 1.35rem 1.15rem;
  }
  .essay-prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .essay-prose :global(ul) {
    list-style: disc;
  }
  .essay-prose :global(ol) {
    list-style: decimal;
  }

  .essay-prose :global(a) {
    color: rgb(var(--color-accent));
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .essay-prose :global(strong) {
    color: rgb(var(--color-text-primary));
    font-weight: 600;
  }

  .essay-prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid rgb(var(--color-accent) / 0.55);
    font-family:
      theme('fontFamily.serif'), ui-serif, Georgia, 'Noto Serif SC', serif;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.7;
    color: rgb(var(--color-text-primary) / 0.82);
  }
  .essay-prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }
  .essay-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .essay-prose :global(code) {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
    padding: 0.1rem 0.3rem;
    border-radius: 0.2rem;
    background: rgb(var(--color-bg-secondary) / 0.8);
    color: rgb(var(--color-text-primary));
  }

  .essay-prose :global(pre) {
    margin: 1.6rem 0;
    padding: 1.15rem 1.2rem;
    border-radius: 0.35rem;
    background: rgb(var(--color-bg-secondary));
    overflow-x: auto;
  }
  .essay-prose :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .essay-prose :global(hr) {
    border: 0;
    height: 1px;
    margin: 2.75rem auto;
    max-width: 8rem;
    background: rgb(var(--color-border));
  }

  .essay-prose :global(img) {
    margin: 1.75rem 0;
    border-radius: 0.25rem;
  }

  .essay-prose :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .essay-prose :global(th),
  .essay-prose :global(td) {
    border-bottom: 1px solid rgb(var(--color-border) / 0.7);
    padding: 0.6rem 0.4rem;
    text-align: left;
  }
  .essay-prose :global(th) {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: rgb(var(--color-text-primary));
  }

  .essay-related {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(var(--color-border) / 0.55);
  }
  .essay-related h2 {
    font-family: theme('fontFamily.heading');
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .essay-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .essay-related li a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.95rem 0;
    border-top: 1px solid rgb(var(--color-border) / 0.4);
    text-decoration: none;
    color: inherit;
    transition: color 0.18s ease;
  }
  .essay-related li:last-child a {
    border-bottom: 1px solid rgb(var(--color-border) / 0.4);
  }
  .essay-related li a:hover,
  .essay-related li a:focus-visible {
    color: rgb(var(--color-accent));
  }
  .essay-related li a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .essay-related__cat {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .essay-related__title {
    font-family: theme('fontFamily.heading');
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }

  .essay-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--color-border) / 0.55);
  }
  .essay-foot__back {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: rgb(var(--color-accent));
  }
  .essay-foot__back:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .essay-foot__share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }

  @media (prefers-reduced-motion: reduce) {
    .essay-back,
    .essay-tags a,
    .essay-related li a {
      transition: none;
    }
  }
</style>
