    headerTitle: '📅 智能日历',
    headerDesc:
      '管理您的时间，规划您的生活。支持节假日显示、自定义日程和事件管理',
    prevMonth: '← 上月',
    nextMonth: '下月 →',
    loading: '加载中...',
    weekdays: ['日', '一', '二', '三', '四', '五', '六'],
    today: '今天',
    goToToday: '回到今天',
    addEvent: '添加日程',
    upcomingEvents: '近期日程',
    noEvents: '暂无近期日程',
    eventTitle: '日程标题',
    eventTime: '时间',
    eventDesc: '描述',
    save: '保存',
    cancel: '取消',
    delete: '删除',
  },
  'zh-TW': {
    title: '智能日曆',
    headerTitle: '📅 智能日曆',
    headerDesc:
      '管理您的時間，規劃您的生活。支持節假日顯示、自定義日程和事件管理',
    prevMonth: '← 上月',
    nextMonth: '下月 →',
    loading: '加載中...',
    weekdays: ['日', '一', '二', '三', '四', '五', '六'],
    today: '今天',
    goToToday: '回到今天',
    addEvent: '添加日程',
    upcomingEvents: '近期日程',
    noEvents: '暫無近期日程',
    eventTitle: '日程標題',
    eventTime: '時間',
    eventDesc: '描述',
    save: '保存',
    cancel: '取消',
    delete: '刪除',
  },
  'en-GB': {
    title: 'Smart Calendar',
    headerTitle: '📅 Smart Calendar',
    headerDesc:
      'Manage your time, plan your life. Supports holiday display, custom schedules, and event management',
    prevMonth: '← Prev',
    nextMonth: 'Next →',
    loading: 'Loading...',
    weekdays: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
    today: 'Today',
    goToToday: 'Go to today',
    addEvent: 'Add Event',
    upcomingEvents: 'Upcoming Events',
    noEvents: 'No upcoming events',
    eventTitle: 'Event Title',
    eventTime: 'Time',
    eventDesc: 'Description',
    save: 'Save',
    cancel: 'Cancel',
    delete: 'Delete',
  },
  fr: {
    title: 'Calendrier Intelligent',
    headerTitle: '📅 Calendrier Intelligent',
    headerDesc:
      "Gérez votre temps, planifiez votre vie. Prend en charge l'affichage des jours fériés, les horaires personnalisés et la gestion des événements",
    prevMonth: '← Préc',
    nextMonth: 'Suiv →',
    loading: 'Chargement...',
    weekdays: ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'],
    today: "Aujourd'hui",
    goToToday: "Retour à aujourd'hui",
    addEvent: 'Ajouter un événement',
    upcomingEvents: 'Événements à venir',
    noEvents: "Pas d'événements à venir",
    eventTitle: "Titre de l'événement",
    eventTime: 'Heure',
    eventDesc: 'Description',
    save: 'Enregistrer',
    cancel: 'Annuler',
    delete: 'Supprimer',
  },
  ru: {
    title: 'Умный календарь',
    headerTitle: '📅 Умный календарь',
    headerDesc:
      'Управляйте своим временем, планируйте свою жизнь. Поддержка отображения праздников, пользовательских расписаний и управления событиями',
    prevMonth: '← Пред',
    nextMonth: 'След →',
    loading: 'Загрузка...',
    weekdays: ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'],
    today: 'Сегодня',
    goToToday: 'На сегодня',
    addEvent: 'Добавить событие',
    upcomingEvents: 'Предстоящие события',
    noEvents: 'Нет предстоящих событий',
    eventTitle: 'Название события',
