const content = calendarData[lang as Lang] || calendarData['en-GB'];
---

<BaseLayout title={content.title}>
  <PageHero
    folio="Folio Calendar"
    kicker="Tools"
    title={content.title}
    description={content.headerDesc}
  />

  <!-- Calendar Section -->
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Calendar Display -->
      <div class="lg:col-span-2">
        <div
          class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] p-8 rounded-sm"
        >
          <!-- Month Navigation -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-8">
            <button
              type="button"
              onclick="prevMonth()"
              class="p-2 hover:bg-[rgb(var(--color-bg-secondary))] rounded-sm transition-colors"
              aria-label={content.prevMonth}
            >
              {content.prevMonth}
            </button>
            <h2
              class="text-2xl font-heading font-bold order-first w-full md:order-none md:w-auto"
              id="currentMonth"
            >
              {content.loading}
            </h2>
            <button
              type="button"
              onclick="goToToday()"
              class="px-3 py-1.5 rounded-sm bg-primary-500/15 text-primary-600 dark:text-primary-400 hover:bg-primary-500/25 text-sm font-medium transition-colors"
            >
              {content.goToToday}
            </button>
            <button
              type="button"
              onclick="nextMonth()"
              class="p-2 hover:bg-[rgb(var(--color-bg-secondary))] rounded-sm transition-colors"
              aria-label={content.nextMonth}
            >
              {content.nextMonth}
            </button>
          </div>

          <!-- Weekdays -->
          <div class="grid grid-cols-7 gap-2 mb-2">
            {
              content.weekdays.map((day: string) => (
                <div class="text-center font-bold text-[rgb(var(--color-text-secondary))] py-2">
                  {day}
                </div>
              ))
            }
          </div>

          <!-- Days Grid -->
          <div id="calendarGrid" class="grid grid-cols-7 gap-2">
            <!-- Days will be inserted here by JS -->
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- Today's Info -->
        <div
          class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] p-6 rounded-sm"
        >
          <h3 class="text-xl font-bold mb-4">{content.today}</h3>
          <div id="todayInfo" class="text-[rgb(var(--color-text-secondary))]">
            <!-- Today info inserted by JS -->
          </div>
          <button
            onclick="openAddEventModal()"
            class="mt-4 w-full py-2 bg-primary-500 text-white rounded-sm hover:bg-primary-600 transition-colors"
          >
            {content.addEvent}
          </button>
        </div>

        <!-- Upcoming Events -->
        <div
          class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] p-6 rounded-sm"
        >
          <h3 class="text-xl font-bold mb-4">{content.upcomingEvents}</h3>
          <div id="upcomingEvents" class="space-y-4">
            <p class="text-[rgb(var(--color-text-secondary))] text-sm">
              {content.noEvents}
            </p>
          </div>
        </div>

        <RelatedTools lang={lang} current="calendar" />
      </div>
    </div>
  </section>

  <!-- Add Event Modal -->
  <div
    id="eventModal"
    class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50"
  >
    <div
      class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] p-8 max-w-md w-full mx-4 rounded-sm"
    >
      <h3 class="text-2xl font-bold mb-6">{content.addEvent}</h3>
      <form id="eventForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1"
            >{content.eventTitle}</label
          >
          <input
            type="text"
            name="title"
            required
            class="w-full px-4 py-2 rounded-sm bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))]"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >{content.eventTime}</label
          >
          <input
            type="datetime-local"
            name="time"
            required
            class="w-full px-4 py-2 rounded-sm bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))]"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >{content.eventDesc}</label
          >
          <textarea
            name="description"
            rows="3"
            class="w-full px-4 py-2 rounded-sm bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))]"
          ></textarea>
        </div>
        <div class="flex justify-end gap-4 mt-6">
          <button
            type="button"
            onclick="closeEventModal()"
            class="px-4 py-2 rounded-sm hover:bg-[rgb(var(--color-bg-secondary))]"
          >
            {content.cancel}
          </button>
          <button
            type="submit"
            class="px-4 py-2 bg-primary-500 text-white rounded-sm hover:bg-primary-600"
          >
            {content.save}
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // @ts-nocheck
  let currentDate = new Date();
  const currentMonthElement = document.getElementById('currentMonth');
  const calendarGrid = document.getElementById('calendarGrid');
  const todayInfo = document.getElementById('todayInfo');

  // Chinese holidays data (Month is 0-indexed: 0=Jan, 1=Feb, etc.)
  const holidays = {
    '0-1': '元旦',
    '1-14': '情人节',
    '2-8': '妇女节',
    '3-5': '清明节',
    '4-1': '劳动节',
    '4-4': '青年节',
    '5-1': '儿童节',
    '7-1': '建军节',
    '8-10': '教师节',
    '9-1': '国庆节',
    '9-2': '国庆假期',
    '9-3': '国庆假期',
    '9-4': '国庆假期',
    '9-5': '国庆假期',
    '9-6': '国庆假期',
    '9-7': '国庆假期',
    '11-24': '平安夜',
    '11-25': '圣诞节',
  };

  // Lunar holidays approximation or fixed dates could be added here
  // For a real production app, use a library like 'chinese-lunar-calendar' or fetch from an API

  function renderCalendar() {
    if (!currentMonthElement || !calendarGrid) return;

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    // Update header
    currentMonthElement.textContent = currentDate.toLocaleDateString(
      undefined,
      { month: 'long', year: 'numeric' }
    );

    // Clear grid
    calendarGrid.innerHTML = '';

    // First day of the month
    const firstDay = new Date(year, month, 1).getDay();
    // Days in month
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Padding for empty days
    for (let i = 0; i < firstDay; i++) {
      const emptyDay = document.createElement('div');
      emptyDay.className =
        'h-24 bg-[rgb(var(--color-bg-secondary))] rounded-sm opacity-50';
      calendarGrid.appendChild(emptyDay);
    }

    // Days
    const today = new Date();
    for (let i = 1; i <= daysInMonth; i++) {
      const dayElement = document.createElement('div');
      const isToday =
        i === today.getDate() &&
        month === today.getMonth() &&
        year === today.getFullYear();

      // Check for holiday
      const holidayKey = `${month}-${i}`;
      const holidayName = holidays[holidayKey];

      dayElement.className = `h-24 p-2 rounded-sm border border-[rgb(var(--color-border))] hover:border-primary-500 transition-colors relative flex flex-col justify-between ${isToday ? 'bg-primary-500/10 border-primary-500' : 'bg-[rgb(var(--color-bg-secondary))]'}`;

      let holidayHtml = '';
      if (holidayName) {
        holidayHtml = `<span class="text-xs text-red-500 font-bold truncate w-full">${holidayName}</span>`;
      }

      dayElement.innerHTML = `
        <span class="font-bold ${isToday ? 'text-primary-500' : 'text-[rgb(var(--color-text-primary))]'}">${i}</span>
        ${holidayHtml}
      `;

      calendarGrid.appendChild(dayElement);
    }

    // Update Today Info
    if (todayInfo) {
      const todayKey = `${today.getMonth()}-${today.getDate()}`;
      const todayHoliday = holidays[todayKey];

      todayInfo.innerHTML = `
            <div class="text-4xl font-bold text-primary-500 mb-2">${today.getDate()}</div>
            <div class="text-lg mb-2">${today.toLocaleDateString(undefined, { weekday: 'long', month: 'long', year: 'numeric' })}</div>
            ${todayHoliday ? `<div class="text-red-500 font-bold">🎉 ${todayHoliday}</div>` : ''}
        `;
    }
  }

  window['prevMonth'] = function () {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  };

  window['nextMonth'] = function () {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  };

  window['goToToday'] = function () {
    currentDate = new Date();
    renderCalendar();
  };

  document.addEventListener('keydown', function (e) {
    if (e.target && (e.target.closest('input') || e.target.closest('textarea')))
      return;
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      window['prevMonth']();
    }
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      window['nextMonth']();
    }
  });

  // Modal functions
  window['openAddEventModal'] = function () {
    const modal = document.getElementById('eventModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  // Modal close function
  window['closeEventModal'] = function () {
    const modal = document.getElementById('eventModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  };

  // Initial render
  renderCalendar();
</script>
