  },
  'zh-TW': {
    title: '友情連結',
    subtitle: '我的朋友們',
    badge: '🔗 Friends',
    intro: '這裡是一些我喜歡的網站和朋友們的主頁，歡迎互鏈。',
    apply: '申請友鏈',
    applyDesc: '發送郵件至',
    requirements: '友鏈要求',
    req1: '網站內容健康、積極向上',
    req2: '網站能夠正常訪問',
    req3: '優先考慮技術部落格或創意作品集',
    back: '返回首頁',
    noDesc: '這個人很懶，什麼都沒寫',
    adTitle: '合作展示位',
    adDesc: '這裡可展示你的品牌、產品或活動，歡迎聯繫合作。',
    adCta: '諮詢合作',
    placeholderTag: '待加入',
  },
  'en-GB': {
    title: 'Friends',
    subtitle: 'People & Sites I Enjoy',
    badge: '🔗 Friends',
    intro: 'Here are some websites I enjoy and my friends\' homepages. Link exchanges welcome.',
    apply: 'Apply for Link Exchange',
    applyDesc: 'Send email to',
    requirements: 'Requirements',
    req1: 'Website content must be healthy and positive',
    req2: 'Website must be accessible',
    req3: 'Tech blogs or creative portfolios preferred',
    back: 'Back to home',
    noDesc: 'No description provided',
    adTitle: 'Partner Spotlight',
    adDesc: 'A reserved slot for your brand, product, or campaign.',
    adCta: 'Enquire now',
    placeholderTag: 'Coming soon',
  },
  fr: {
    title: 'Amis',
    subtitle: 'Gens et sites que j\'apprécie',
    badge: '🔗 Amis',
    intro: 'Voici quelques sites Web que j\'apprécie et les pages d\'accueil de mes amis. Échanges de liens bienvenus.',
    apply: 'Demander un échange de lien',
    applyDesc: 'Envoyer un email à',
    requirements: 'Conditions',
    req1: 'Le contenu du site doit être sain et positif',
