  },
  ru: {
    title: 'Друзья',
    subtitle: 'Люди и сайты, которые мне нравятся',
    badge: '🔗 Друзья',
    intro: 'Здесь представлены сайты, которые мне нравятся, и домашние страницы моих друзей. Обмен ссылками приветствуется.',
    apply: 'Подать заявку на обмен ссылками',
    applyDesc: 'Отправить письмо на',
    requirements: 'Требования',
    req1: 'Содержание сайта должно быть здоровым и позитивным',
    req2: 'Сайт должен быть доступен',
    req3: 'Предпочитаются технические блоги или креативные портфолио',
