  fr: {
    title: 'Références',
    subtitle: 'Outils, IA et infrastructure que j’utilise réellement',
    badge: 'Reference Links',
    intro:
      'Cette page n’est plus un échange de liens. Elle garde les ressources officielles que j’ouvre pour écrire, construire, déboguer et déployer.',
    ai: 'IA et écriture',
    infra: 'Ingénierie et déploiement',
    mine: 'Mes sites externes',
    visit: 'Ouvrir',
    noteTitle: 'Pourquoi cette forme',
    note: 'Les liens externes d’un site personnel doivent expliquer ce que j’utilise, ce en quoi j’ai confiance et où vivent les projets associés.',
    back: "Retour à l'accueil",
  },
  ru: {
    title: 'Ссылки',
    subtitle: 'Инструменты, AI-продукты и инфраструктура, которыми я пользуюсь',
    badge: 'Reference Links',
    intro:
      'Это больше не страница случайного обмена ссылками. Здесь официальные ресурсы, которые я открываю для письма, разработки, отладки и деплоя.',
    ai: 'AI и письмо',
    infra: 'Инженерия и деплой',
    mine: 'Мои внешние сайты',
    visit: 'Открыть',
    noteTitle: 'Почему так',
    note: 'Внешние ссылки на личном сайте должны объяснять, чем я пользуюсь, чему доверяю и где живут связанные проекты.',
    back: 'На главную',
  },
};

const sections = [
  {
    key: 'ai',
    links: [
      {
        name: 'OpenAI',
        url: 'https://openai.com/',
        desc: {
          'zh-CN': '模型、研究与产品入口。',
          'zh-TW': '模型、研究與產品入口。',
          'en-GB': 'Models, research and product entry points.',
          fr: 'Modèles, recherche et produits.',
          ru: 'Модели, исследования и продукты.',
        },
        tags: ['AI', 'Models'],
      },
      {
        name: 'Claude',
        url: 'https://claude.ai/',
        desc: {
          'zh-CN': '日常写作、阅读与代码协作入口。',
          'zh-TW': '日常寫作、閱讀與程式協作入口。',
          'en-GB': 'Daily writing, reading and coding assistant.',
          fr: 'Assistant pour écrire, lire et coder.',
          ru: 'Помощник для письма, чтения и кода.',
        },
        tags: ['AI', 'Writing'],
      },
      {
        name: 'Anthropic',
        url: 'https://www.anthropic.com/',
        desc: {
          'zh-CN': 'Claude 背后的研究与公司信息。',
          'zh-TW': 'Claude 背後的研究與公司資訊。',
          'en-GB': 'Research and company information behind Claude.',
          fr: 'Recherche et informations derrière Claude.',
          ru: 'Исследования и компания за Claude.',
        },
        tags: ['Research'],
      },
    ],
  },
  {
    key: 'infra',
    links: [
      {
        name: 'GitHub',
        url: 'https://github.com/AlexanderJ-Carter',
        desc: {
          'zh-CN': '公开仓库、项目源码与维护记录。',
          'zh-TW': '公開倉庫、專案原始碼與維護記錄。',
          'en-GB': 'Public repositories, source code and maintenance history.',
          fr: 'Dépôts publics, code source et historique.',
          ru: 'Публичные репозитории, исходный код и история.',
        },
        tags: ['Code'],
      },
      {
        name: 'Cloudflare',
        url: 'https://www.cloudflare.com/',
        desc: {
          'zh-CN': '站点部署、边缘网络、Workers 与隧道相关入口。',
          'zh-TW': '站點部署、邊緣網路、Workers 與隧道相關入口。',
          'en-GB': 'Site delivery, edge network, Workers and Tunnel.',
          fr: 'Déploiement, réseau edge, Workers et Tunnel.',
          ru: 'Доставка сайта, edge-сеть, Workers и Tunnel.',
        },
        tags: ['Edge', 'Deploy'],
      },
      {
        name: 'Astro',
        url: 'https://astro.build/',
        desc: {
          'zh-CN': '本站静态生成和内容页面的基础框架。',
          'zh-TW': '本站靜態生成和內容頁面的基礎框架。',
          'en-GB': 'The static-site framework behind this site.',
          fr: 'Le framework statique derrière ce site.',
          ru: 'Статический фреймворк этого сайта.',
        },
        tags: ['SSG'],
      },
    ],
  },
  {
    key: 'mine',
    links: [
      {
        name: 'MyCook',
        url: 'https://cook.alexander.xin',
        desc: {
          'zh-CN': '把做饭步骤整理成更容易检索和执行的菜谱站。',
          'zh-TW': '把做飯步驟整理成更容易檢索和執行的菜譜站。',
          'en-GB': 'A recipe site shaped for lookup and execution.',
          fr: 'Site de recettes pensé pour chercher et exécuter.',
          ru: 'Сайт рецептов для поиска и выполнения.',
        },
        tags: ['Food', 'Docs'],
      },
      {
        name: 'Linux Command',
        url: 'https://linux-command.alexander.xin',
        desc: {
          'zh-CN': '常用 Linux 指令的速查入口。',
          'zh-TW': '常用 Linux 指令的速查入口。',
          'en-GB': 'Quick lookup for common Linux commands.',
          fr: 'Recherche rapide de commandes Linux.',
          ru: 'Быстрый поиск команд Linux.',
        },
        tags: ['CLI'],
      },
      {
        name: 'NetQ',
        url: 'https://netq.alexander.xin',
        desc: {
          'zh-CN': '交互式网络排查 CLI 与命令思路整理。',
          'zh-TW': '互動式網路排查 CLI 與命令思路整理。',
          'en-GB': 'Interactive network troubleshooting CLI and command flow.',
          fr: 'CLI de diagnostic réseau et logique de commandes.',
          ru: 'CLI диагностики сети и поток команд.',
        },
        tags: ['Network'],
      },
    ],
  },
];

const text = t[lang as Lang] || t['en-GB'];

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<BaseLayout title={text.title} description={text.subtitle}>
  <PageHero
    kicker="References"
    title={text.title}
    description={text.intro}
    narrow={false}
  />

  <section class="pb-20 md:pb-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[1fr_18rem] items-start max-w-5xl">
        <div class="space-y-10">
          {
            sections.map((section) => (
              <section>
                <h2 class="text-2xl font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]">
                  {text[section.key]}
                </h2>
                <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                  {section.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border border-[rgb(var(--color-border))] p-5 flex flex-col min-h-[13rem] group hover:border-[rgb(var(--color-text-tertiary))] transition-colors"
                    >
                      <div class="flex items-start justify-between gap-4 mb-4">
                        <h3 class="text-lg font-heading font-bold text-[rgb(var(--color-text-primary))] group-hover:text-primary-500 transition-colors">
                          {link.name}
                        </h3>
                        <span class="text-[rgb(var(--color-text-tertiary))] group-hover:text-primary-500 flex-shrink-0 text-sm">
                          ↗
                        </span>
                      </div>
                      <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed flex-1">
                        {link.desc[lang as Lang] || link.desc['en-GB']}
                      </p>
                      <div class="mt-5 flex items-center justify-between gap-3">
                        <div class="flex flex-wrap gap-2">
                          {link.tags.map((tag) => (
                            <span class="text-xs text-[rgb(var(--color-text-tertiary))] border border-[rgb(var(--color-border))] px-2 py-0.5">
                              {tag}
                            </span>
                          ))}
                        </div>
                        <span class="text-xs font-medium text-[rgb(var(--color-text-secondary))]">
                          {text.visit}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <aside
          class="lg:sticky lg:top-28 border border-[rgb(var(--color-border))] p-5"
        >
          <h2
            class="font-heading font-bold text-[rgb(var(--color-text-primary))] mb-3"
          >
            {text.noteTitle}
          </h2>
          <p
            class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed"
          >
            {text.note}
          </p>
          <a
            href={getLangPath('/projects')}
            class="mt-5 inline-flex text-sm font-medium text-primary-500 hover:text-primary-600"
          >
            {
              lang === 'zh-CN'
                ? '看项目页'
                : lang === 'zh-TW'
                  ? '看專案頁'
                  : lang === 'fr'
                    ? 'Voir les projets'
                    : lang === 'ru'
                      ? 'К проектам'
                      : 'View projects'
            }
          </a>
        </aside>
      </div>

      <div
        class="mt-14 pt-8 border-t border-[rgb(var(--color-border))] max-w-5xl"
      >
        <a
          href={getLangPath('/')}
          class="link-underline text-primary-500 hover:text-primary-600 font-medium inline-flex items-center gap-1"
        >
          ← {text.back}
        </a>
      </div>

      <RelatedTools lang={lang} current="friends" />
    </div>
  </section>
</BaseLayout>
