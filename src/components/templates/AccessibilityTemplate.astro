const content = accessibilityData[lang as Lang] || accessibilityData['en-GB'];
---

<BaseLayout title={content.title}>
  <div class="container mx-auto px-4 lg:px-8 max-w-3xl pt-28 md:pt-32">
    <a
      href={getLangPath('/')}
      class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>{content.back}</span>
    </a>
  </div>

  <PageHero
    class="!pt-0"
    folio="Folio Access"
    title={content.headerTitle}
    description={content.headerDesc}
  />

  <section class="pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <!-- Legal nav -->
      <nav
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs sm:text-sm text-[rgb(var(--color-text-secondary))] mb-10"
        aria-label={lang === 'zh-CN' || lang === 'zh-TW'
          ? '法律与政策导航'
          : 'Legal & policy navigation'}
      >
        <a
          href={getLangPath('/privacy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '隐私政策'
              : lang === 'zh-TW'
                ? '隱私權政策'
                : 'Privacy'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/terms')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '服务条款'
              : lang === 'zh-TW'
                ? '服務條款'
                : 'Terms'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/license')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '许可证'
              : lang === 'zh-TW'
                ? '許可證'
                : 'License'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/accessibility')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '无障碍'
              : lang === 'zh-TW'
                ? '無障礙'
                : 'Accessibility'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/security/policy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '安全政策'
              : lang === 'zh-TW'
                ? '安全政策'
                : 'Security'
          }
        </a>
      </nav>

      <!-- Content -->
      <div class="glass-card p-8 md:p-12 prose prose-lg max-w-none">
        <h2>{content.commitmentTitle}</h2>
        <p>
          {content.commitmentDesc}
        </p>

        <h2>{content.featuresTitle}</h2>
        <p>{content.featuresDesc}</p>

        <div class="grid md:grid-cols-2 gap-4 my-6">
          {
            content.features.map((feature: any) => (
              <div class="p-4 bg-primary-500/10 rounded-sm">
                <div class="flex items-center gap-3 mb-2">
                  <span class="meta-mono text-sm tracking-widest text-primary-600 dark:text-primary-400">{feature.icon}</span>
                  <h3 class="text-lg font-bold mb-0">{feature.title}</h3>
                </div>
                <p class="text-sm mb-0">{feature.desc}</p>
              </div>
            ))
          }
        </div>

        <h2>{content.standardsTitle}</h2>
        <p>
          {content.standardsDesc}
        </p>

        <h2>{content.actionTitle}</h2>
        <p>{content.actionDesc}</p>
        <ul class="list-disc list-inside space-y-2">
          <li>{content.guide1}</li>
          <li>{content.guide2}</li>
          <li>{content.guide3}</li>
        </ul>

        <h3>{content.shortcutsTitle}</h3>
        <div class="flex flex-wrap gap-3 not-prose">
          <kbd
            class="px-2 py-1 rounded bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-sm"
            >Tab</kbd
          >
          <kbd
            class="px-2 py-1 rounded bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-sm"
            >Shift + Tab</kbd
          >
          <kbd
            class="px-2 py-1 rounded bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-sm"
            >Ctrl/Cmd + K</kbd
          >
          <kbd
            class="px-2 py-1 rounded bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-sm"
            >/</kbd
          >
        </div>

        <div class="flex flex-wrap gap-3 not-prose mt-4">
          <button
            id="acc-contrast-toggle"
            type="button"
            class="px-4 py-2 rounded-sm bg-primary-500/15 hover:bg-primary-500/25 text-primary-600 dark:text-primary-400 font-medium"
          >
            {content.contrastBtn}
          </button>
          <button
            id="acc-motion-toggle"
            type="button"
            class="px-4 py-2 rounded-sm bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]"
          >
            {content.motionBtn}
          </button>
        </div>

        <h2>{content.feedbackTitle}</h2>
        <p>
          {content.feedbackDesc}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const contrastBtn = document.getElementById('acc-contrast-toggle');
    const motionBtn = document.getElementById('acc-motion-toggle');
    const html = document.documentElement;
    const styleId = 'accessibility-preview-style';
    function ensureStyle() {
      let style = document.getElementById(styleId);
      if (!style) {
        style = document.createElement('style');
        style.id = styleId;
        style.textContent = `
          html.acc-high-contrast { filter: contrast(1.15) saturate(1.05); }
          html.acc-reduced-motion *, html.acc-reduced-motion *::before, html.acc-reduced-motion *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }
        `;
        document.head.appendChild(style);
      }
    }
    ensureStyle();
    contrastBtn?.addEventListener('click', () =>
      html.classList.toggle('acc-high-contrast')
    );
    motionBtn?.addEventListener('click', () =>
      html.classList.toggle('acc-reduced-motion')
    );
  })();
</script>
