---
/**
 * Tools index — on-site utilities and external hubs from site-registry.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import { getExternalToolSites } from '../../data/site-registry';
import { resolveLang, getLangPath } from '../../i18n/types';

interface Props {
  lang?: string;
}

const lang = resolveLang(Astro.props.lang);
const lp = (path: string) => getLangPath(lang, path);
const externalItems = getExternalToolSites().map((site) => ({
  href: site.url,
  title: site.labels[lang],
  desc: site.descriptions[lang],
}));

const copy = {
  'zh-CN': {
    kicker: 'Tools',
    title: '实用工具',
    description: '轻量、本地优先、无需登录。把常用能力收在这里。',
    onsite: '站内工具',
    external: '外部站点',
    tips: '说明',
    tipBody:
      '站内工具尽量在浏览器本地完成计算；外部站点为独立项目，打开新标签访问。',
    items: [
      { href: '/time', title: '世界时间', desc: '多时区对照与复制' },
      { href: '/calendar', title: '日历', desc: '月视图与日期浏览' },
      { href: '/currency', title: '汇率', desc: '主要货币换算参考' },
      { href: '/units', title: '单位换算', desc: '温度、长度、重量' },
      { href: '/qr', title: 'QR 生成', desc: '链接转二维码' },
      { href: '/now', title: 'Now', desc: '本地时间与快捷入口' },
      { href: '/fun', title: '彩蛋', desc: '今日一帧、曝光三角、小游戏与电台' },
      { href: '/changelog', title: '更新日志', desc: '版本与重要改动' },
    ],
  },
  'zh-TW': {
    kicker: 'Tools',
    title: '實用工具',
    description: '輕量、本地優先、無需登入。把常用能力收在這裡。',
    onsite: '站內工具',
    external: '外部站點',
    tips: '說明',
    tipBody:
      '站內工具盡量在瀏覽器本地完成計算；外部站點為獨立專案，開啟新分頁訪問。',
    items: [
      { href: '/time', title: '世界時間', desc: '多時區對照與複製' },
      { href: '/calendar', title: '日曆', desc: '月視圖與日期瀏覽' },
      { href: '/currency', title: '匯率', desc: '主要貨幣換算參考' },
      { href: '/units', title: '單位換算', desc: '溫度、長度、重量' },
      { href: '/qr', title: 'QR 生成', desc: '連結轉二維碼' },
      { href: '/now', title: 'Now', desc: '本地時間與快捷入口' },
      { href: '/fun', title: '彩蛋', desc: '今日一幀、曝光三角、小遊戲與電台' },
      { href: '/changelog', title: '更新日誌', desc: '版本與重要改動' },
    ],
  },
  'en-GB': {
    kicker: 'Tools',
    title: 'Useful tools',
    description:
      'Lightweight, local-first, no login. Everyday utilities in one place.',
    onsite: 'On this site',
    external: 'External sites',
    tips: 'Notes',
    tipBody:
      'On-site tools prefer local browser computation. External sites open in a new tab.',
    items: [
      {
        href: '/time',
        title: 'World time',
        desc: 'Time zones and copy helpers',
      },
      {
        href: '/calendar',
        title: 'Calendar',
        desc: 'Month view and date browsing',
      },
      {
        href: '/currency',
        title: 'Currency',
        desc: 'Major FX reference rates',
      },
      { href: '/units', title: 'Units', desc: 'Temperature, length, weight' },
      { href: '/qr', title: 'QR code', desc: 'URL to QR' },
      { href: '/now', title: 'Now', desc: 'Local time and quick links' },
      {
        href: '/fun',
        title: 'Play',
        desc: 'Daily frame, exposure triangle, games and radio',
      },
      { href: '/changelog', title: 'Changelog', desc: 'Version history' },
    ],
  },
  fr: {
    kicker: 'Tools',
    title: 'Outils utiles',
    description:
      'Légers, locaux d’abord, sans connexion. Les utilitaires du quotidien.',
    onsite: 'Sur ce site',
    external: 'Sites externes',
    tips: 'Notes',
    tipBody:
      'Les outils du site privilégient le calcul local. Les sites externes s’ouvrent dans un nouvel onglet.',
    items: [
      { href: '/time', title: 'Heure mondiale', desc: 'Fuseaux et copie' },
      { href: '/calendar', title: 'Calendrier', desc: 'Vue mensuelle' },
      { href: '/currency', title: 'Devises', desc: 'Taux de référence' },
      { href: '/units', title: 'Unités', desc: 'Température, longueur, poids' },
      { href: '/qr', title: 'QR', desc: 'Lien en QR' },
      { href: '/now', title: 'Now', desc: 'Heure locale et raccourcis' },
      {
        href: '/fun',
        title: 'Surprises',
        desc: 'Cadre du jour, triangle d’exposition, jeux et radio',
      },
      { href: '/changelog', title: 'Journal', desc: 'Historique des versions' },
    ],
  },
  ru: {
    kicker: 'Tools',
    title: 'Инструменты',
    description:
      'Лёгкие, локальные, без входа. Повседневные утилиты в одном месте.',
    onsite: 'На сайте',
    external: 'Внешние сайты',
    tips: 'Заметки',
    tipBody:
      'Инструменты сайта считают локально в браузере. Внешние сайты открываются в новой вкладке.',
    items: [
      {
        href: '/time',
        title: 'Мировое время',
        desc: 'Часовые пояса и копирование',
      },
      { href: '/calendar', title: 'Календарь', desc: 'Месячный вид' },
      { href: '/currency', title: 'Валюты', desc: 'Ориентировочные курсы' },
      { href: '/units', title: 'Единицы', desc: 'Температура, длина, вес' },
      { href: '/qr', title: 'QR', desc: 'Ссылка в QR' },
      { href: '/now', title: 'Now', desc: 'Локальное время и быстрые ссылки' },
      {
        href: '/fun',
        title: 'Пасхалки',
        desc: 'Кадр дня, треугольник экспозиции, игры и радио',
      },
      { href: '/changelog', title: 'Изменения', desc: 'История версий' },
    ],
  },
} as const;

const t = copy[lang] || copy['zh-CN'];
---

<BaseLayout title={t.title} description={t.description}>
  <PageHero
    folio="Folio Tools"
    kicker={t.kicker}
    title={t.title}
    description={t.description}
  />

  <section class="pb-20">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <h2
        class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-6"
      >
        {t.onsite}
      </h2>
      <ul
        class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))] mb-14"
      >
        {
          t.items.map((item) => (
            <li>
              <a
                href={lp(item.href)}
                class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-8 py-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
              >
                <span class="font-heading text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors sm:w-40 shrink-0">
                  {item.title}
                </span>
                <span class="text-[rgb(var(--color-text-secondary))]">
                  {item.desc}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2
        class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-6"
      >
        {t.external}
      </h2>
      <ul
        class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))] mb-14"
      >
        {
          externalItems.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-8 py-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
              >
                <span class="font-heading text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors sm:w-40 shrink-0">
                  {item.title}
                </span>
                <span class="text-[rgb(var(--color-text-secondary))]">
                  {item.desc}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="border border-[rgb(var(--color-border))] p-6">
        <h2 class="font-heading font-semibold mb-2">{t.tips}</h2>
        <p
          class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed"
        >
          {t.tipBody}
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
