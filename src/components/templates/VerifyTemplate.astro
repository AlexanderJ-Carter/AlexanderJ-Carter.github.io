---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { skipVerify, turnstileSiteKey, isDev } from '../../config/site';
import { resolveLang } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);

const copy = {
  'zh-CN': {
    title: '安全验证',
    desc: '完成验证后即可访问受保护页面。',
    verifying: '正在确认你是真人访客',
    verifyDesc: '通常只需几秒。完成后会自动跳转。',
    helpTitle: '为什么需要验证？',
    helpDesc:
      '用于降低恶意爬取与滥用风险。验证由 Cloudflare Turnstile 提供，不收集额外账号信息。',
    footer: 'Powered by Cloudflare Turnstile',
    skipTitle: '本地开发模式',
    skipDesc: '当前已跳过人机验证。点击下方按钮继续访问。',
    skipButton: '跳过并继续',
    forceHint:
      '正式环境仍会要求验证。需要强制测试时可设 PUBLIC_FORCE_VERIFY=true。',
  },
  'zh-TW': {
    title: '安全驗證',
    desc: '完成驗證後即可存取受保護頁面。',
    verifying: '正在確認你是真人訪客',
    verifyDesc: '通常只需幾秒。完成後會自動跳轉。',
    helpTitle: '為什麼需要驗證？',
    helpDesc:
      '用於降低惡意爬取與濫用風險。驗證由 Cloudflare Turnstile 提供，不收集額外帳號資訊。',
    footer: 'Powered by Cloudflare Turnstile',
    skipTitle: '本地開發模式',
    skipDesc: '目前已跳過真人驗證。點擊下方按鈕繼續訪問。',
    skipButton: '跳過並繼續',
    forceHint:
      '正式環境仍會要求驗證。需要強制測試時可設 PUBLIC_FORCE_VERIFY=true。',
  },
  'en-GB': {
    title: 'Security check',
    desc: 'Complete verification to open protected pages.',
    verifying: 'Confirming you are a real visitor',
    verifyDesc: 'This usually takes a few seconds, then we redirect you.',
    helpTitle: 'Why this step?',
    helpDesc:
      'It reduces scraping and abuse. Verification is provided by Cloudflare Turnstile and does not create an account.',
    footer: 'Powered by Cloudflare Turnstile',
    skipTitle: 'Local development',
    skipDesc:
      'Human verification is skipped here. Continue to your destination.',
    skipButton: 'Skip and continue',
    forceHint:
      'Production still requires Turnstile. Set PUBLIC_FORCE_VERIFY=true to test the gate in dev.',
  },
  fr: {
    title: 'Vérification',
    desc: 'Terminez la vérification pour ouvrir les pages protégées.',
    verifying: 'Confirmation que vous êtes un visiteur réel',
    verifyDesc: 'Cela prend généralement quelques secondes, puis redirection.',
    helpTitle: 'Pourquoi cette étape ?',
    helpDesc:
      'Elle réduit le scraping et les abus. La vérification est fournie par Cloudflare Turnstile.',
    footer: 'Propulsé par Cloudflare Turnstile',
    skipTitle: 'Développement local',
    skipDesc:
      'La vérification est désactivée ici. Continuez vers la destination.',
    skipButton: 'Passer et continuer',
    forceHint:
      'La production exige encore Turnstile. Définissez PUBLIC_FORCE_VERIFY=true pour tester.',
  },
  ru: {
    title: 'Проверка',
    desc: 'Пройдите проверку, чтобы открыть защищённые страницы.',
    verifying: 'Подтверждаем, что вы реальный посетитель',
    verifyDesc: 'Обычно несколько секунд — затем перенаправление.',
    helpTitle: 'Зачем это?',
    helpDesc:
      'Снижает скрейпинг и злоупотребления. Проверку обеспечивает Cloudflare Turnstile.',
    footer: 'При поддержке Cloudflare Turnstile',
    skipTitle: 'Локальная разработка',
    skipDesc: 'Проверка здесь отключена. Продолжите к целевой странице.',
    skipButton: 'Пропустить и продолжить',
    forceHint:
      'В продакшене Turnstile обязателен. PUBLIC_FORCE_VERIFY=true — чтобы тестировать в dev.',
  },
} as const;

const content = copy[lang] || copy['en-GB'];
---

<BaseLayout
  title={`${content.title} - Alexander Carter`}
  description={content.desc}
  showHeader={true}
  showFooter={true}
>
  <PageHero kicker="Verify" title={content.title} description={content.desc} />

  <section class="pb-24">
    <div class="page-shell">
      <div
        class="border border-[rgb(var(--color-border))] p-8 md:p-10 flex flex-col items-center text-center"
      >
        {
          skipVerify ? (
            <>
              <p class="font-heading text-sm tracking-[0.18em] uppercase text-primary-600 dark:text-primary-400 mb-3">
                {isDev ? 'DEV' : 'SKIP'}
              </p>
              <h2 class="font-heading text-2xl font-bold mb-3">
                {content.skipTitle}
              </h2>
              <p class="text-[rgb(var(--color-text-secondary))] mb-8 max-w-md">
                {content.skipDesc}
              </p>
              <button type="button" id="verify-skip-btn" class="btn-primary">
                {content.skipButton}
              </button>
              <p class="mt-6 text-xs text-[rgb(var(--color-text-tertiary))] max-w-sm">
                {content.forceHint}
              </p>
            </>
          ) : (
            <>
              <div
                class="w-14 h-14 mb-6 border border-[rgb(var(--color-border))] flex items-center justify-center text-primary-600 dark:text-primary-400"
                aria-hidden="true"
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.75"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
              <h2 class="font-heading text-xl font-bold mb-2">
                {content.verifying}
              </h2>
              <p class="text-[rgb(var(--color-text-secondary))] mb-8 max-w-sm">
                {content.verifyDesc}
              </p>
              <script
                is:inline
                src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                async
                defer
              />
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-callback="onTurnstileSuccess"
                data-theme="auto"
              />
              <p class="mt-6 text-xs text-[rgb(var(--color-text-tertiary))]">
                {content.footer}
              </p>
            </>
          )
        }
      </div>

      <aside class="mt-10 border-t border-[rgb(var(--color-border))] pt-8">
        <h3 class="font-heading font-semibold mb-2">{content.helpTitle}</h3>
        <p
          class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed"
        >
          {content.helpDesc}
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  function completeVerification() {
    try {
      sessionStorage.setItem('is_verified', 'true');
    } catch (_) {}
    const urlParams = new URLSearchParams(window.location.search);
    const returnUrl = urlParams.get('redirect') || '/';
    window.location.href = returnUrl;
  }

  window.onTurnstileSuccess = function () {
    completeVerification();
  };

  document
    .getElementById('verify-skip-btn')
    ?.addEventListener('click', completeVerification);

  // If we landed on /verify while skip is on, auto-continue after a short beat
  if (document.getElementById('verify-skip-btn')) {
    const params = new URLSearchParams(window.location.search);
    if (params.get('redirect')) {
      setTimeout(completeVerification, 400);
    }
  }
</script>
