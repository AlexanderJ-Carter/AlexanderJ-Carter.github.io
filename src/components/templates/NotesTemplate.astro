---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.props;
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = (lang as string) === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const content: Record<
  Lang,
  {
    title: string;
    description: string;
    badge: string;
    intro: string;
    principlesTitle: string;
    principles: Array<{ label: string; text: string }>;
    continue: string;
    relatedTitle: string;
    related: Array<{ label: string; href: string; desc: string }>;
    notes: Array<{
      title: string;
      category: string;
      time: string;
      summary: string;
      paragraphs: string[];
      takeaways: string[];
    }>;
  }
