const content = licenseData[lang as Lang] || licenseData['en-US'];
---

<BaseLayout title={`${content.title} - Alexander Carter`} showFooter={false}>
  <section class="pt-32 pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <!-- Back Button -->
      <a
        href={`/${lang === 'zh-CN' ? '' : lang}`}
        class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>{content.back}</span>
      </a>

      <!-- Header -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 text-white text-2xl mb-6"
        >
          ⚖️
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
          {content.headerTitle}
        </h1>
        <p class="text-lg text-[rgb(var(--color-text-secondary))]">
          {content.headerDesc}
        </p>
      </div>

      <!-- Content -->
      <div class="glass-card p-8 md:p-12 space-y-6">
        <div>
          <h2
            class="text-2xl font-bold mb-4 text-[rgb(var(--color-text-primary))]"
          >
            {content.contentTitle}
          </h2>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {content.contentP1}
            <a
              href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans"
              target="_blank"
              class="text-primary-500 hover:text-primary-600 font-semibold"
            >
              {content.licenseName}
            </a>
            {content.contentP2}
          </p>
        </div>

        <!-- CC License Badge -->
        <div class="flex justify-center my-8">
          <div
            class="p-6 bg-[rgb(var(--color-bg-secondary))] rounded-lg inline-flex flex-col items-center gap-4"
          >
            <div class="flex gap-2 text-4xl">
              <i class="fab fa-creative-commons"></i>
              <i class="fab fa-creative-commons-by"></i>
              <i class="fab fa-creative-commons-nc"></i>
              <i class="fab fa-creative-commons-sa"></i>
            </div>
            <span
              class="font-mono text-sm text-[rgb(var(--color-text-secondary))]"
              >CC BY-NC-SA 4.0</span
            >
          </div>
        </div>

        <div>
          <h3
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {content.rightsTitle}
          </h3>
          <ul class="list-disc list-inside space-y-2 ml-4">
            {
              content.rights.map((item: any) => (
                <li class="text-[rgb(var(--color-text-secondary))]">
                  <strong class="text-[rgb(var(--color-text-primary))]">
                    {item.title}
                  </strong>
                  : {item.desc}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3
            class="text-xl font-bold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {content.conditionsTitle}
          </h3>
          <ul class="list-disc list-inside space-y-2 ml-4">
            {
              content.conditions.map((item: any) => (
                <li class="text-[rgb(var(--color-text-secondary))]">
                  <strong class="text-[rgb(var(--color-text-primary))]">
                    {item.title}
                  </strong>
                  : {item.desc}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="mt-8 p-6 bg-primary-500/10 border border-primary-500/20 rounded-lg"
        >
          <h3 class="text-xl font-bold text-primary-500 mb-3">
            {content.disclaimerTitle}
          </h3>
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
            {content.disclaimer}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
