---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import { timelineData } from '../../i18n/pages/timeline';

const { lang } = Astro.props;
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const content = timelineData[lang as Lang] || timelineData['en-GB'];
---
<BaseLayout title={content.title} description={content.description}>
  <PageHero
    folio="Folio Time"
    kicker={content.tag}
    title={content.headerTitle}
    description={content.headerDesc}
    narrow={false}
  />

  <section class="pb-20 md:pb-28">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <ol
        class="relative border-l border-[rgb(var(--color-border))] ml-3 md:ml-4"
        id="timeline-ol"
        aria-label={content.headerTitle}
      >
        {
          content.events.map((event) => (
            <li class="relative pl-8 md:pl-10 pb-12 last:pb-0">
              <span
                class="absolute left-0 top-1.5 -translate-x-1/2 w-2 h-2 rounded-full bg-[rgb(var(--color-text-tertiary))] ring-4 ring-[rgb(var(--color-bg-primary))]"
                aria-hidden="true"
              />
              <p class="font-heading text-sm tracking-wide text-[rgb(var(--color-text-tertiary))] mb-2">
                {event.year}
              </p>
              <h2 class="font-heading font-bold text-lg text-[rgb(var(--color-text-primary))] mb-2">
                {event.title}
              </h2>
              <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed mb-3">
                {event.description}
              </p>
              {event.tags && (
                <div class="flex flex-wrap gap-2">
                  {event.tags.map((tag) => (
                    <span class="text-xs text-[rgb(var(--color-text-tertiary))] border border-[rgb(var(--color-border))] px-2 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ol>

      <div class="mt-16 pt-10 border-t border-[rgb(var(--color-border))]">
        <a
          href={getLangPath('/')}
          class="link-underline text-primary-500 hover:text-primary-600 font-medium text-sm inline-flex items-center gap-1"
        >
          ← {content.back}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
