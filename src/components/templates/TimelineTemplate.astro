const content = timelineData[lang as Lang] || timelineData['en-GB'];
---

<BaseLayout title={content.title} description={content.description}>
  <!-- Hero -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient opacity-50" aria-hidden="true"></div>
    <div class="aurora" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-80" style="background: var(--hero-spotlight);" aria-hidden="true"></div>

    <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-5xl">
      <header class="text-center mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card text-sm font-medium mb-5">
          <span aria-hidden="true">📅</span>
          {content.tag}
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-4 gradient-text tracking-tight">
          {content.headerTitle}
        </h1>
        <p class="text-lg text-[rgb(var(--color-text-secondary))] max-w-xl mx-auto">
          {content.headerDesc}
        </p>
      </header>

      <!-- Timeline -->
      <ol class="relative" id="timeline-ol" aria-label={content.headerTitle}>
        <!-- Central vertical line (desktop only) -->
        <div
          class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-primary-500/10 via-primary-500/40 to-primary-500/10"
          aria-hidden="true"
        ></div>
        <!-- Scroll progress overlay (desktop) -->
        <div
          class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 w-[3px] rounded-full bg-gradient-to-b from-primary-500 via-accent-500 to-primary-500 origin-top"
          id="timeline-progress"
          style="height: 0%; transition: height 0.15s ease-out;"
          aria-hidden="true"
        ></div>

        <!-- Left gutter line (mobile) -->
        <div
          class="md:hidden absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-primary-500/10 via-primary-500/40 to-primary-500/10"
          aria-hidden="true"
        ></div>
        <!-- Scroll progress overlay (mobile) -->
        <div
          class="md:hidden absolute left-6 top-0 w-[3px] rounded-full bg-gradient-to-b from-primary-500 via-accent-500 to-primary-500 origin-top -translate-x-[1px]"
          id="timeline-progress-mobile"
          style="height: 0%; transition: height 0.15s ease-out;"
          aria-hidden="true"
        ></div>

        <div class="space-y-10 md:space-y-14">
          {content.events.map((event, index) => {
            const isLeft = index % 2 === 0;
            return (
              <li class="relative">
                <!-- Desktop: alternating layout -->
                <div class={`hidden md:flex items-center gap-0 ${isLeft ? 'flex-row-reverse' : 'flex-row'}`}>
                  <!-- Card half -->
                  <div class="w-[calc(50%-2rem)] reveal">
                    <article class={`glass-card p-6 lg:p-8 group hover:-translate-y-1 transition-transform duration-300 ${isLeft ? 'ml-auto' : 'mr-auto'}`}>
                      <div class={`inline-block text-xs font-semibold px-2.5 py-1 rounded-full bg-gradient-to-r ${event.color} text-white mb-3`}>
                        {event.year}
                      </div>
                      <h2 class="font-heading font-bold text-lg text-[rgb(var(--color-text-primary))] mb-2 group-hover:text-primary-500 transition-colors">
                        {event.title}
                      </h2>
                      <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed mb-4">
                        {event.description}
                      </p>
                      {event.tags && (
                        <div class="flex flex-wrap gap-1.5">
                          {event.tags.map((tag) => (
                            <span class="text-xs px-2 py-0.5 rounded-full bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-secondary))] border border-[rgb(var(--color-border))]">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </article>
                  </div>

                  <!-- Center icon -->
                  <div class="flex-shrink-0 w-16 flex justify-center z-10">
                    <div class={`w-14 h-14 rounded-full bg-gradient-to-br ${event.color} flex items-center justify-center text-2xl shadow-lg ring-4 ring-[rgb(var(--color-bg-primary))]`} aria-hidden="true">
                      {event.icon}
                    </div>
                  </div>

                  <!-- Spacer half -->
                  <div class="w-[calc(50%-2rem)]"></div>
                </div>

                <!-- Mobile: left-aligned single column -->
                <div class="md:hidden flex items-start gap-4 pl-3">
                  <!-- Icon on left rail -->
                  <div class="flex-shrink-0 relative">
                    <div class={`w-10 h-10 rounded-full bg-gradient-to-br ${event.color} flex items-center justify-center text-lg shadow-md ring-2 ring-[rgb(var(--color-bg-primary))]`} aria-hidden="true">
                      {event.icon}
                    </div>
                  </div>

                  <!-- Card -->
                  <article class="flex-1 glass-card p-5 reveal group hover:-translate-y-0.5 transition-transform duration-300">
                    <div class={`inline-block text-xs font-semibold px-2 py-0.5 rounded-full bg-gradient-to-r ${event.color} text-white mb-2`}>
                      {event.year}
                    </div>
                    <h2 class="font-heading font-bold text-base text-[rgb(var(--color-text-primary))] mb-1.5 group-hover:text-primary-500 transition-colors">
                      {event.title}
                    </h2>
                    <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed mb-3">
                      {event.description}
                    </p>
                    {event.tags && (
                      <div class="flex flex-wrap gap-1.5">
                        {event.tags.map((tag) => (
                          <span class="text-xs px-2 py-0.5 rounded-full bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-secondary))] border border-[rgb(var(--color-border))]">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                </div>
              </li>
            );
          })}
        </div>
      </ol>

      <!-- Back link -->
      <div class="mt-16 pt-10 border-t border-[rgb(var(--color-border))] reveal">
        <a
          href={getLangPath('/')}
          class="link-underline text-primary-500 hover:text-primary-600 font-medium text-sm inline-flex items-center gap-1"
        >
          ← {content.back}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const ol = document.getElementById('timeline-ol');
    const bar = document.getElementById('timeline-progress');
    const barMobile = document.getElementById('timeline-progress-mobile');
    if (!ol) return;

    function update() {
      const rect = ol.getBoundingClientRect();
      const olTop = rect.top + window.scrollY;
      const olHeight = rect.height;
      if (olHeight <= 0) return;

      const scrolled = window.scrollY + window.innerHeight * 0.5 - olTop;
      const pct = Math.max(0, Math.min(100, (scrolled / olHeight) * 100));
      if (bar) bar.style.height = pct + '%';
      if (barMobile) barMobile.style.height = pct + '%';
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
