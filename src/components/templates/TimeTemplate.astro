---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.props;

type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  return `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

