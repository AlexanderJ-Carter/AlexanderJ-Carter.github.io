const content = timeData[lang as Lang] || timeData['en-GB'];

const worldZones = [
  { id: 'london', label: content.london, tz: 'Europe/London', utc: 'UTC+0' },
  { id: 'ny', label: content.newYork, tz: 'America/New_York', utc: 'UTC-5' },
  { id: 'tokyo', label: content.tokyo, tz: 'Asia/Tokyo', utc: 'UTC+9' },
  { id: 'sydney', label: content.sydney, tz: 'Australia/Sydney', utc: 'UTC+11' },
];

const relatedTools = [
  { href: getLangPath('/calendar'), label: content.calendar, icon: '📅' },
  { href: getLangPath('/currency'), label: content.currency, icon: '💱' },
  { href: getLangPath('/now'), label: content.now, icon: '📍' },
  { href: getLangPath('/uses'), label: content.uses, icon: '🛠' },
  { href: getLangPath('/units'), label: content.units, icon: '📐' },
  { href: getLangPath('/qr'), label: content.qr, icon: '📱' },
];
---

<BaseLayout title={`${content.title} - Alexander Carter`}>
  <!-- Hero -->
  <section class="relative pt-28 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient" aria-hidden="true" />
    <div class="absolute inset-0 opacity-100" style="background: var(--hero-spotlight);" aria-hidden="true" />
    <div class="section-divider" aria-hidden="true" />
    <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
      <p class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 dark:bg-white/5 border border-white/20 dark:border-white/10 text-sm font-medium mb-4">
        <span aria-hidden="true">🕐</span> {content.tag}
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-4 gradient-text tracking-tight">
        {content.headerTitle}
      </h1>
      <p class="text-lg text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto">
        {content.headerDesc}
      </p>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-12 md:py-16 container mx-auto px-4 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-5 max-w-6xl mx-auto">
      <!-- Left: Main clock + Your time -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Beijing / Primary clock -->
        <div class="glass-card p-8 md:p-10 relative overflow-hidden rounded-2xl reveal">
          <div class="absolute top-0 right-0 w-40 h-40 bg-primary-500/10 rounded-full -translate-y-1/2 translate-x-1/2" aria-hidden="true" />
          <div class="relative">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
              <div>
                <p class="text-sm font-medium text-[rgb(var(--color-text-secondary))] uppercase tracking-wider">
                  {content.beijingLabel}
                </p>
                <p class="text-xs text-[rgb(var(--color-text-tertiary))] mt-0.5">{content.beijingTz}</p>
              </div>
              <button
                type="button"
                id="copy-main"
                class="copy-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[rgb(var(--color-bg-secondary))] hover:bg-primary-500/15 border border-[rgb(var(--color-border))] hover:border-primary-500/40 text-sm font-medium text-[rgb(var(--color-text-primary))] transition-colors"
                data-copy-label={content.copy}
                data-copied-label={content.copied}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span class="copy-btn-text">{content.copy}</span>
              </button>
            </div>
            <div class="text-5xl sm:text-6xl md:text-7xl font-mono font-bold tracking-tight text-[rgb(var(--color-text-primary))] tabular-nums py-4" id="main-clock">
              00:00:00
            </div>
            <p class="text-lg text-[rgb(var(--color-text-secondary))]" id="main-date">
              ----/--/--
            </p>
            <p class="text-sm text-[rgb(var(--color-text-tertiary))] mt-2 font-mono" id="main-utc">
              UTC --
            </p>
          </div>
        </div>

        <!-- Your local time -->
        <div class="glass-card p-6 rounded-2xl border border-[rgb(var(--color-border))]/60 reveal">
          <p class="text-sm font-medium text-[rgb(var(--color-text-secondary))] mb-2">{content.yourTime}</p>
          <p class="text-3xl md:text-4xl font-mono font-bold tracking-tight tabular-nums text-[rgb(var(--color-text-primary))]" id="local-clock">
            --:--:--
          </p>
          <p class="text-[rgb(var(--color-text-tertiary))] text-sm mt-1" id="local-date">--</p>
        </div>
      </div>

      <!-- Right: World clocks + API -->
      <div class="lg:col-span-2 space-y-6">
        <div class="glass-card p-6 rounded-2xl reveal">
          <h2 class="text-lg font-heading font-bold mb-4 text-[rgb(var(--color-text-primary))]">
            {content.worldClocks}
          </h2>
          <ul class="space-y-3" aria-label={content.worldClocks}>
            {worldZones.map((z) => (
              <li class="flex items-center justify-between gap-4 py-2 border-b border-[rgb(var(--color-border))]/50 last:border-0">
                <div>
                  <span class="font-medium text-[rgb(var(--color-text-primary))]">{z.label}</span>
                  <span class="text-xs text-[rgb(var(--color-text-tertiary))] ml-2">{z.utc}</span>
                </div>
                <span class="font-mono text-lg tabular-nums text-[rgb(var(--color-text-primary))]" id={`clock-${z.id}`}>--:--</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="glass-card p-6 rounded-2xl border border-primary-500/20 bg-primary-500/5 dark:bg-primary-500/10 reveal">
          <h3 class="text-base font-heading font-bold text-primary-600 dark:text-primary-400 mb-2">
            {content.apiTitle}
          </h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-3">
            {content.apiDesc}
          </p>
          <code class="block p-3 rounded-xl bg-[rgb(var(--color-bg-primary))]/80 dark:bg-black/20 text-xs font-mono break-all border border-[rgb(var(--color-border))] mb-2">
            {content.apiExample}
          </code>
          {content.apiReturns && (
            <p class="text-xs text-[rgb(var(--color-text-tertiary))] mb-3">{content.apiReturns}</p>
          )}
        </div>
      </div>
    </div>

    <!-- Related tools -->
    <div class="max-w-6xl mx-auto mt-16 pt-12 border-t border-[rgb(var(--color-border))] reveal">
      <p class="text-sm font-medium text-[rgb(var(--color-text-secondary))] mb-4">{content.relatedTitle}</p>
      <nav class="flex flex-wrap gap-3" aria-label={content.relatedTitle}>
        {relatedTools.map((tool) => (
          <a
            href={tool.href}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[rgb(var(--color-bg-secondary))] hover:bg-primary-500/10 border border-[rgb(var(--color-border))] hover:border-primary-500/30 text-[rgb(var(--color-text-primary))] font-medium transition-colors"
          >
            <span aria-hidden="true">{tool.icon}</span>
            {tool.label}
          </a>
        ))}
      </nav>
      <p class="mt-6">
        <a href={getLangPath('/')} class="text-primary-500 hover:text-primary-600 font-medium text-sm inline-flex items-center gap-1">
          ← {content.back}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ lang }}>
  const localeMap = { 'zh-CN': 'zh-CN', 'zh-TW': 'zh-TW', 'en-GB': 'en-GB', fr: 'fr-FR', ru: 'ru-RU' };
  const locale = localeMap[lang] || 'en-GB';

  function updateClocks() {
    const now = new Date();

    const beijingTime = new Date(now.toLocaleString(locale, { timeZone: 'Asia/Shanghai' }));
    const mainClock = document.getElementById('main-clock');
    const mainDate = document.getElementById('main-date');
    const mainUtc = document.getElementById('main-utc');
    if (mainClock) mainClock.textContent = beijingTime.toLocaleTimeString(locale, { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (mainDate) mainDate.textContent = beijingTime.toLocaleDateString(locale, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
    if (mainUtc) mainUtc.textContent = 'UTC+8';

    const localClock = document.getElementById('local-clock');
    const localDate = document.getElementById('local-date');
    if (localClock) localClock.textContent = now.toLocaleTimeString(locale, { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (localDate) localDate.textContent = now.toLocaleDateString(locale, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });

    const formatTime = (tz) => new Date(now.toLocaleString(locale, { timeZone: tz })).toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
    const zones = [{ id: 'london', tz: 'Europe/London' }, { id: 'ny', tz: 'America/New_York' }, { id: 'tokyo', tz: 'Asia/Tokyo' }, { id: 'sydney', tz: 'Australia/Sydney' }];
    zones.forEach((z) => {
      const el = document.getElementById('clock-' + z.id);
      if (el) el.textContent = formatTime(z.tz);
    });
  }

  setInterval(updateClocks, 1000);
  updateClocks();

  const copyBtn = document.getElementById('copy-main');
  if (copyBtn) {
    const labelEl = copyBtn.querySelector('.copy-btn-text');
    const copyLabel = copyBtn.getAttribute('data-copy-label') || 'Copy';
    const copiedLabel = copyBtn.getAttribute('data-copied-label') || 'Copied';
    copyBtn.addEventListener('click', async () => {
      const mainClock = document.getElementById('main-clock');
      const mainDate = document.getElementById('main-date');
      const text = mainClock && mainDate ? mainClock.textContent + ' ' + mainDate.textContent : '';
      try {
        await navigator.clipboard.writeText(text);
        if (labelEl) labelEl.textContent = copiedLabel;
        copyBtn.classList.add('!border-primary-500', '!bg-primary-500/20');
        setTimeout(() => {
          if (labelEl) labelEl.textContent = copyLabel;
          copyBtn.classList.remove('!border-primary-500', '!bg-primary-500/20');
        }, 2000);
      } catch (_) {}
    });
  }
</script>
