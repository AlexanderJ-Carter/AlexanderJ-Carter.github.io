    back: '返回首頁',
  },
  'en-GB': {
    title: 'World Time',
    tag: 'World clocks · Standard time',
    headerTitle: 'World Time',
    headerDesc: 'Clear local and major time zones at a glance, with copy and API.',
    beijingLabel: 'Beijing',
    beijingTz: 'UTC+8',
    yourTime: 'Your local time',
    copy: 'Copy',
    copied: 'Copied',
    worldClocks: 'World clocks',
    london: 'London',
