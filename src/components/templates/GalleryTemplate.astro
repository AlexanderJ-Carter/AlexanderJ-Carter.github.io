  }
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.25rem;
  }
  .gallery-filter-btn {
    padding: 0.55rem 0.85rem;
    min-height: 2.75rem;
    font-family: theme('fontFamily.heading');
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(var(--color-text-tertiary));
    border-radius: 999px;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .gallery-filter-btn:hover,
  .gallery-filter-btn:focus-visible {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-secondary) / 0.7);
  }
  .gallery-filter-btn.is-active {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.1);
  }
  .gallery-filter-btn:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .gallery-source {
    padding: 0;
  }
  .gallery-source__select {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(var(--color-border));
    border-radius: 0;
    background: transparent;
    color: rgb(var(--color-text-primary));
    padding: 0.45rem 0;
    font-size: 0.85rem;
  }

  /* Magazine sheet */
  .gallery-sheet {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem 1.5rem;
  }
  @media (min-width: 768px) {
    .gallery-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.75rem 1.75rem;
    }
  }
  @media (min-width: 1100px) {
    .gallery-sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 0;
  }
  .shot--lead {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .shot--lead {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 1.5rem 2rem;
      align-items: end;
    }
  }
  .shot:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .shot__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-bg-secondary));
    border-radius: 0.2rem;
  }
  .shot--lead .shot__media {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) {
    .shot--lead .shot__media {
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }

  .shot .gallery-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--color-border) / 0.25) 0%,
      rgb(var(--color-bg-secondary)) 50%,
      rgb(var(--color-border) / 0.25) 100%
    );
    background-size: 200% 100%;
    animation: galleryShimmer 1.3s linear infinite;
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .shot .gallery-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: blur(8px) saturate(0.9);
    transform: scale(1.04);
    transition:
      opacity 0.5s ease,
      filter 0.6s ease,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot.is-loaded .gallery-skeleton {
    opacity: 0;
    pointer-events: none;
  }
  .shot.is-loaded .gallery-image {
    opacity: 1;
    filter: blur(0) saturate(1.04);
    transform: scale(1);
  }
  .shot:hover.is-loaded .gallery-image,
  .shot:focus-visible.is-loaded .gallery-image {
    transform: scale(1.04);
  }

  .shot__no {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    z-index: 2;
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: white;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.45);
    opacity: 0.85;
  }

  .shot__copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0 0.1rem;
  }
  .shot__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .shot__meta span:first-child {
    color: rgb(var(--color-accent));
  }
  .shot__title {
    font-family: theme('fontFamily.heading');
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgb(var(--color-text-primary));
    transition: color 0.18s ease;
  }
  .shot:hover .shot__title,
  .shot:focus-visible .shot__title {
    color: rgb(var(--color-accent));
  }
  .shot--lead .shot__title {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .shot__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(var(--color-text-secondary));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes galleryShimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  .gallery-reveal {
    animation: galleryReveal 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes galleryReveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Lightbox — soft darkroom */
  .gallery-lightbox {
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .gallery-lightbox.is-open {
    display: flex;
    animation: lightboxIn 0.28s ease-out;
  }
  .gallery-lightbox__veil {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(8px);
  }
  .gallery-lightbox__stage {
    position: relative;
    z-index: 1;
    width: min(56rem, 100%);
    max-height: 90vh;
  }
  .lightbox-mat {
    padding: 0;
    background: transparent;
    border: 0;
  }
  .lightbox-mat__index {
    color: rgb(255 255 255 / 0.45);
    margin-bottom: 0.85rem;
    letter-spacing: 0.14em;
  }
  .lightbox-mat__window {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    max-height: 68vh;
    overflow: hidden;
  }
  .lightbox-mat__window img {
    max-width: 100%;
    max-height: 68vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.2rem;
  }
  .lightbox-mat__caption {
    margin-top: 1.15rem;
  }
  .gallery-lightbox__ctrl {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: white;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .gallery-lightbox__ctrl:hover,
  .gallery-lightbox__ctrl:focus-visible {
    background: rgb(255 255 255 / 0.2);
  }
  .gallery-lightbox__ctrl:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }
  .gallery-lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .gallery-lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .gallery-lightbox__prev {
    left: 0.75rem;
  }
  .gallery-lightbox__next {
    right: 0.75rem;
  }

  @keyframes lightboxIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot .gallery-image,
    .gallery-filter-btn,
    .gallery-reveal,
    .gallery-lightbox.is-open {
      animation: none !important;
      transition: none !important;
    }
    .shot:hover.is-loaded .gallery-image,
    .shot:focus-visible.is-loaded .gallery-image {
      transform: none;
    }
  }
</style>
