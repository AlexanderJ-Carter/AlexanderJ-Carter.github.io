      category: 'nature',
      title: 'Лепестки После Дождя',
      description: 'Капли росы на цветах',
      image: '/img/gallery/nature-flower-01.jpg',
    },
    {
      id: 15,
      category: 'nature',
      title: 'Утренняя Тень Цветка',
      description: 'Утренний свет сквозь лепестки',
      image: '/img/gallery/nature-flower-02.jpg',
    },
    {
      id: 16,
      category: 'food',
      title: 'Изысканный Десерт',
      description: 'Сладкий момент',
      image: '/img/gallery/food-01.jpg',
    },
    {
      id: 17,
      category: 'food',
      title: 'Традиционная Кухня',
      description: 'Классический вкус',
      image: '/img/gallery/food-02.jpg',
    },
    {
      id: 18,
      category: 'food',
      title: 'Креативное Блюдо',
      description: 'Кулинарный шедевр',
      image: '/img/gallery/food-03.jpg',
    },
  ],
};

const categories = categoriesData[lang as Lang] || categoriesData['en-GB'];
const galleryItems =
  galleryItemsData[lang as Lang] || galleryItemsData['en-GB'];
---

<BaseLayout title={t('gallery.title')}>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-mesh-gradient">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <h1
        class="text-5xl md:text-6xl font-heading font-bold mb-6 gradient-text tracking-tight"
      >
        {t('gallery.title')}
      </h1>
      <p
        class="text-xl text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto"
      >
        {
          lang === 'zh-CN'
            ? '探索我的摄影作品集，记录生活中的美好瞬间'
            : lang === 'zh-TW'
              ? '探索我的攝影作品集，記錄生活中的美好瞬間'
              : lang === 'fr'
                ? 'Explorez ma collection de photographies, capturant les beaux moments de la vie'
                : lang === 'ru'
                  ? 'Исследуйте мою коллекцию фотографий, запечатлевая прекрасные моменты жизни'
                  : 'Explore my photography portfolio, capturing beautiful moments in life'
        }
      </p>
      <p class="mt-4 text-sm text-[rgb(var(--color-text-tertiary))] max-w-xl mx-auto">
        {
          lang === 'zh-CN'
            ? '使用下方分类筛选风景、自然、美食，或直接浏览全部作品。'
            : lang === 'zh-TW'
              ? '使用下方分類篩選風景、自然、美食，或直接瀏覽全部作品。'
              : lang === 'fr'
                ? 'Filtrez par paysage, nature ou nourriture, ou parcourez tout.'
                : lang === 'ru'
                  ? 'Фильтруйте по пейзажу, природе или еде или смотрите все работы.'
                  : 'Filter by landscape, nature or food, or browse all works.'
        }
      </p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <!-- Stats Bar -->
    <div class="flex flex-wrap justify-center gap-8 mb-12">
      <div class="text-center">
        <div
          class="text-4xl font-heading font-bold bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent"
          id="total-count"
        >
          0
        </div>
        <div class="text-sm text-[rgb(var(--color-text-secondary))] mt-1">
          {
            lang === 'zh-CN'
              ? '总作品数'
              : lang === 'zh-TW'
                ? '總作品數'
                : lang === 'fr'
                  ? 'Total'
                  : lang === 'ru'
                    ? 'Всего'
                    : 'Total Works'
          }
        </div>
      </div>
      <div class="text-center">
        <div
          class="text-4xl font-heading font-bold bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent"
        >
          {galleryItems.filter((i) => i.category === 'landscape').length}
        </div>
        <div class="text-sm text-[rgb(var(--color-text-secondary))] mt-1">
          {
            lang === 'zh-CN'
              ? '风景摄影'
              : lang === 'zh-TW'
                ? '風景攝影'
                : lang === 'fr'
                  ? 'Paysages'
                  : lang === 'ru'
                    ? 'Пейзажи'
                    : 'Landscapes'
          }
        </div>
      </div>
      <div class="text-center">
        <div
          class="text-4xl font-heading font-bold bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent"
        >
          {galleryItems.filter((i) => i.category === 'nature').length}
        </div>
        <div class="text-sm text-[rgb(var(--color-text-secondary))] mt-1">
          {
            lang === 'zh-CN'
              ? '自然微距'
              : lang === 'zh-TW'
                ? '自然微距'
                : lang === 'fr'
                  ? 'Nature'
                  : lang === 'ru'
                    ? 'Природа'
                    : 'Nature'
          }
        </div>
      </div>
      <div class="text-center">
        <div
          class="text-4xl font-heading font-bold bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent"
        >
          {galleryItems.filter((i) => i.category === 'food').length}
        </div>
        <div class="text-sm text-[rgb(var(--color-text-secondary))] mt-1">
          {
            lang === 'zh-CN'
              ? '美食摄影'
              : lang === 'zh-TW'
                ? '美食攝影'
                : lang === 'fr'
                  ? 'Nourriture'
                  : lang === 'ru'
                    ? 'Еда'
                    : 'Food'
          }
        </div>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-tabs">
      {
        categories.map((cat) => (
          <button
            class="px-6 py-3 rounded-xl font-semibold transition-all duration-300 filter-btn hover:scale-105 hover:shadow-lg"
            class:list={{
              'bg-gradient-to-r from-primary-500 to-accent-500 text-white shadow-lg':
                cat.id === 'all',
              'glass-card hover:bg-[rgb(var(--color-bg-tertiary))]':
                cat.id !== 'all',
            }}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- Gallery Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      id="gallery-grid"
    >
      {
        galleryItems.map((item) => (
          <div
            class="group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3] cursor-pointer gallery-item"
            data-category={item.category}
          >
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <h3 class="text-white text-xl font-bold transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                {item.title}
              </h3>
              <p class="text-gray-200 text-sm mt-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Gallery filtering logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const totalCount = document.getElementById('total-count');

  // Update total count
  if (totalCount) {
    totalCount.textContent = galleryItems.length.toString();
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update active button state
      filterBtns.forEach((b) => {
        b.classList.remove(
          'bg-gradient-to-r',
          'from-primary-500',
          'to-accent-500',
          'text-white',
          'shadow-lg'
        );
        b.classList.add(
          'glass-card',
          'hover:bg-[rgb(var(--color-bg-tertiary))]'
        );
      });
      btn.classList.remove(
        'glass-card',
        'hover:bg-[rgb(var(--color-bg-tertiary))]'
      );
      btn.classList.add(
        'bg-gradient-to-r',
        'from-primary-500',
        'to-accent-500',
        'text-white',
        'shadow-lg'
      );

      const filterValue = btn.getAttribute('data-filter');
      let visibleCount = 0;

      galleryItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === itemCategory) {
          (item as HTMLElement).style.display = 'block';
          // Add animation
          item.classList.add('animate-fade-in');
          setTimeout(() => item.classList.remove('animate-fade-in'), 500);
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      // Update count based on filter
      if (totalCount) {
        totalCount.textContent = visibleCount.toString();
      }
    });
  });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
