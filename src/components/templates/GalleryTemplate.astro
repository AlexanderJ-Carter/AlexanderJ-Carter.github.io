    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-border) / 0.5);
  }
  @media (min-width: 1024px) {
    .gallery-toolbar {
      grid-template-columns: auto 1fr minmax(11rem, 14rem);
      align-items: end;
      gap: 2rem;
    }
  }
  .gallery-toolbar__stats {
