---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import {
  gallerySrcFallback,
  gallerySrcSet,
  galleryLightboxSrc,
} from '../../i18n/types';
import {
  getGalleryCategories,
  getGalleryItems,
  getGallerySourceUi,
} from '../../data/gallery';

const { lang } = Astro.props;
const t = useTranslations(lang);
type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

const categories = getGalleryCategories(lang as Lang);
const galleryItems = getGalleryItems(lang as Lang);
const sourceUi = getGallerySourceUi(lang as Lang);
---
<BaseLayout title={t('gallery.title')}>
  <section class="relative pt-28 pb-10">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-2xl">
        <p class="folio-mark mb-3">Contact Sheet</p>
        <p
          class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4"
        >
          Gallery
        </p>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold mb-4 tracking-tight"
        >
          {t('gallery.title')}
        </h1>
        <p
          class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] leading-relaxed"
        >
          {
            lang === 'zh-CN'
              ? '冲印衬纸上的联系单——点开任一相框放大观片。'
              : lang === 'zh-TW'
                ? '沖印襯紙上的聯繫單——點開任一相框放大觀片。'
                : lang === 'fr'
                  ? 'Planche-contact sur passe-partout — ouvrez un cadre pour agrandir.'
                  : lang === 'ru'
                    ? 'Контактный лист на паспарту — откройте рамку для просмотра.'
                    : 'A contact sheet on print mats — open any frame to view larger.'
          }
        </p>
        <div class="mt-8 film-edge max-w-md opacity-80" aria-hidden="true">
        </div>
      </div>
    </div>
  </section>

  {
    galleryItems
      .slice(0, 3)
      .map((item) => <link rel="preload" as="image" href={item.image} />)
  }

  <section class="pb-20 md:pb-28 container mx-auto px-4 lg:px-8">
    <div class="gallery-toolbar mb-10">
      <div class="gallery-toolbar__stats" id="gallery-stats">
        <span class="gallery-stat">
          <strong id="total-count">{galleryItems.length}</strong>
          <span>
            {
              lang === 'zh-CN'
                ? '帧'
                : lang === 'zh-TW'
                  ? '幀'
                  : lang === 'fr'
                    ? 'frames'
                    : lang === 'ru'
                      ? 'кадров'
                      : 'frames'
            }
          </span>
        </span>
        <span class="gallery-stat meta-mono !tracking-[0.08em]">
          L {galleryItems.filter((i) => i.category === 'landscape').length}
        </span>
        <span class="gallery-stat meta-mono !tracking-[0.08em]">
          N {galleryItems.filter((i) => i.category === 'nature').length}
        </span>
        <span class="gallery-stat meta-mono !tracking-[0.08em]">
          F {galleryItems.filter((i) => i.category === 'food').length}
        </span>
        <span class="gallery-stat meta-mono !tracking-[0.08em]">
          A {galleryItems.filter((i) => i.category === 'architecture').length}
        </span>
        <span class="gallery-stat meta-mono !tracking-[0.08em]">
          S {galleryItems.filter((i) => i.category === 'street').length}
        </span>
      </div>

      <div
        class="gallery-filters"
        id="filter-tabs"
        role="tablist"
        aria-label={lang === 'zh-CN' ? '按分类筛选' : 'Filter by category'}
      >
        {
          categories.map((cat) => (
            <button
              type="button"
              role="tab"
              aria-selected={cat.id === 'all'}
              tabindex={cat.id === 'all' ? 0 : -1}
              class:list={[
                'gallery-filter-btn',
                cat.id === 'all' && 'is-active',
              ]}
              data-filter={cat.id}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <div class="gallery-source">
        <p class="folio-mark mb-2">{sourceUi.title}</p>
        <p
          class="text-xs text-[rgb(var(--color-text-secondary))] mb-3 leading-relaxed"
        >
          {sourceUi.note}
        </p>
        <label for="source-filter" class="sr-only">{sourceUi.title}</label>
        <select id="source-filter" class="gallery-source__select">
          <option value="all">{sourceUi.all}</option>
          <option value="local">{sourceUi.local}</option>
          <option value="remote">{sourceUi.remote}</option>
        </select>
      </div>
    </div>

    <div class="gallery-sheet" id="gallery-grid">
      {
        galleryItems.map((item, index) => {
          const catLabel =
            categories.find((c) => c.id === item.category)?.label ??
            item.category;
          const frameNo = String(index + 1).padStart(2, '0');
          const isRemote = item.image.startsWith('http');
          return (
            <button
              type="button"
              class:list={[
                'shot gallery-item group',
                index === 0 && 'shot--lead',
              ]}
              data-category={item.category}
              data-source={isRemote ? 'remote' : 'local'}
              data-gallery-index={index}
              data-image={galleryLightboxSrc(item.image)}
              data-title={item.title}
              data-description={item.description}
              data-category-label={catLabel}
              aria-label={
                lang === 'zh-CN' ? `查看：${item.title}` : `View: ${item.title}`
              }
            >
              <span class="shot__media">
                <span class="gallery-skeleton" aria-hidden="true" />
                <img
                  src={gallerySrcFallback(item.image)}
                  srcset={gallerySrcSet(item.image)}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt=""
                  width="800"
                  height="600"
                  class="gallery-image"
                  loading={index < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                  referrerpolicy="no-referrer"
                  fetchpriority={index < 3 ? 'high' : 'auto'}
                />
                <span class="shot__no" aria-hidden="true">
                  {frameNo}
                </span>
              </span>
              <span class="shot__copy">
                <span class="shot__meta">
                  <span>{catLabel}</span>
                  <span>
                    {isRemote ? sourceUi.remoteTag : sourceUi.localTag}
                  </span>
                </span>
                <span class="shot__title">{item.title}</span>
                <span class="shot__desc">{item.description}</span>
              </span>
            </button>
          );
        })
      }
    </div>
  </section>

  <div
    id="gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
    aria-describedby="lightbox-desc"
    class="gallery-lightbox fixed inset-0 z-[100] hidden"
  >
    <div class="gallery-lightbox__veil" data-lightbox-dismiss></div>
    <button
      type="button"
      id="lightbox-close"
      class="gallery-lightbox__ctrl gallery-lightbox__close"
      aria-label={lang === 'zh-CN' ? '关闭' : 'Close'}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
    <button
      type="button"
      id="lightbox-prev"
      class="gallery-lightbox__ctrl gallery-lightbox__nav gallery-lightbox__prev"
      aria-label={lang === 'zh-CN' ? '上一张' : 'Previous'}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path></svg
      >
    </button>
    <button
      type="button"
      id="lightbox-next"
      class="gallery-lightbox__ctrl gallery-lightbox__nav gallery-lightbox__next"
      aria-label={lang === 'zh-CN' ? '下一张' : 'Next'}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path></svg
      >
    </button>

    <div class="gallery-lightbox__stage">
      <div class="lightbox-mat">
        <p class="lightbox-mat__index meta-mono" id="lightbox-index">01 / 01</p>
        <div class="lightbox-mat__window">
          <img id="lightbox-image" src="" alt="" />
        </div>
        <div class="lightbox-mat__caption">
          <p
            id="lightbox-cat"
            class="meta-mono !text-[10px] text-white/55 mb-2"
          >
          </p>
          <h2
            id="lightbox-title"
            class="font-heading text-xl md:text-2xl font-bold text-white"
          >
          </h2>
          <p
            id="lightbox-desc"
            class="text-white/75 text-sm mt-2 leading-relaxed"
          >
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const totalCountEl = document.getElementById('total-count');
  const sourceFilterEl = document.getElementById(
    'source-filter'
  ) as HTMLSelectElement | null;
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById(
    'lightbox-image'
  ) as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxCat = document.getElementById('lightbox-cat');
  const lightboxIndex = document.getElementById('lightbox-index');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentFilter = 'all';
  let currentSourceFilter = 'all';
  let currentLightboxIndex = 0;

  function initGalleryImageLoading() {
    galleryItems.forEach((item) => {
      const image = item.querySelector('img') as HTMLImageElement | null;
      if (!image) return;

      const markLoaded = () => {
        item.classList.add('is-loaded');
      };

      if (image.complete && image.naturalWidth > 0) {
        markLoaded();
        return;
      }

      image.addEventListener('load', markLoaded, { once: true });
      image.addEventListener('error', markLoaded, { once: true });
    });
  }

  initGalleryImageLoading();

  function getVisibleItems(): Element[] {
    return Array.from(galleryItems).filter((el) => {
      const cat = el.getAttribute('data-category');
      const source = el.getAttribute('data-source');
      const categoryOk = currentFilter === 'all' || cat === currentFilter;
      const sourceOk =
        currentSourceFilter === 'all' || source === currentSourceFilter;
      return categoryOk && sourceOk;
    });
  }

  function applyFilters() {
    const visible = getVisibleItems();
    galleryItems.forEach((item) => {
      const show = visible.includes(item);
      (item as HTMLElement).style.display = show ? '' : 'none';
      if (show) {
        item.classList.remove('gallery-reveal');
        void (item as HTMLElement).offsetWidth;
        item.classList.add('gallery-reveal');
      }
    });
    if (totalCountEl) totalCountEl.textContent = String(visible.length);
  }

  function fillLightbox(item: Element, index: number, total: number) {
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    const cat = item.getAttribute('data-category-label');
    if (img) lightboxImage.src = img;
    lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
    if (lightboxCat) lightboxCat.textContent = cat || '';
    if (lightboxIndex) {
      lightboxIndex.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }
    currentLightboxIndex = index;
  }

  let lightboxTrigger: HTMLElement | null = null;

  function openLightbox(index: number) {
    const visible = getVisibleItems();
    const item = visible[index];
    if (!item || !lightbox || !lightboxImage || !lightboxTitle || !lightboxDesc)
      return;
    lightboxTrigger = document.activeElement as HTMLElement;
    fillLightbox(item, index, visible.length);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    lightboxClose?.focus();
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('is-open');
    }
    document.body.style.overflow = '';
    lightboxTrigger?.focus();
    lightboxTrigger = null;
  }

  function showLightboxPrev() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    const next = (currentLightboxIndex - 1 + visible.length) % visible.length;
    fillLightbox(visible[next], next, visible.length);
  }

  function showLightboxNext() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    const next = (currentLightboxIndex + 1) % visible.length;
    fillLightbox(visible[next], next, visible.length);
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const visible = getVisibleItems();
      const idx = visible.indexOf(item);
      if (idx !== -1) openLightbox(idx);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', showLightboxPrev);
  lightboxNext?.addEventListener('click', showLightboxNext);
  lightbox
    ?.querySelector('[data-lightbox-dismiss]')
    ?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showLightboxPrev();
    if (e.key === 'ArrowRight') showLightboxNext();
    if (e.key === 'Tab' && lightbox) {
      const focusable = lightbox.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterValue = btn.getAttribute('data-filter') || 'all';
      currentFilter = filterValue;

      filterBtns.forEach((b) => {
        const isActive = b.getAttribute('data-filter') === filterValue;
        b.setAttribute('aria-selected', String(isActive));
        (b as HTMLElement).tabIndex = isActive ? 0 : -1;
        b.classList.toggle('is-active', isActive);
      });

      applyFilters();
    });

    btn.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (
        ke.key !== 'ArrowRight' &&
        ke.key !== 'ArrowLeft' &&
        ke.key !== 'Home' &&
        ke.key !== 'End'
      ) {
        return;
      }
      ke.preventDefault();
      const tabs = Array.from(filterBtns) as HTMLElement[];
      const i = tabs.indexOf(btn as HTMLElement);
      if (i < 0) return;
      let next = i;
      if (ke.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (ke.key === 'ArrowLeft')
        next = (i - 1 + tabs.length) % tabs.length;
      else if (ke.key === 'Home') next = 0;
      else if (ke.key === 'End') next = tabs.length - 1;
      tabs[next]?.focus();
      tabs[next]?.click();
    });
  });

  sourceFilterEl?.addEventListener('change', () => {
    currentSourceFilter = sourceFilterEl.value;
    applyFilters();
  });
</script>

<style>
  /* Toolbar — open, not boxed */
  .gallery-toolbar {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-border) / 0.5);
  }
  @media (min-width: 1024px) {
    .gallery-toolbar {
      grid-template-columns: auto 1fr minmax(11rem, 14rem);
      align-items: end;
      gap: 2rem;
    }
  }
  .gallery-toolbar__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: baseline;
  }
  .gallery-stat {
    font-size: 0.85rem;
    color: rgb(var(--color-text-secondary));
  }
  .gallery-stat strong {
    font-family: theme('fontFamily.heading');
    font-size: 1.35rem;
    font-weight: 700;
    color: rgb(var(--color-text-primary));
    margin-right: 0.25rem;
  }
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.25rem;
  }
  .gallery-filter-btn {
    padding: 0.55rem 0.85rem;
    min-height: 2.75rem;
    font-family: theme('fontFamily.heading');
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(var(--color-text-tertiary));
    border-radius: 999px;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .gallery-filter-btn:hover,
  .gallery-filter-btn:focus-visible {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-secondary) / 0.7);
  }
  .gallery-filter-btn.is-active {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.1);
  }
  .gallery-filter-btn:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .gallery-source {
    padding: 0;
  }
  .gallery-source__select {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(var(--color-border));
    border-radius: 0;
    background: transparent;
    color: rgb(var(--color-text-primary));
    padding: 0.45rem 0;
    font-size: 0.85rem;
  }

  /* Magazine sheet */
  .gallery-sheet {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem 1.5rem;
  }
  @media (min-width: 768px) {
    .gallery-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.75rem 1.75rem;
    }
  }
  @media (min-width: 1100px) {
    .gallery-sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 0;
  }
  .shot--lead {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .shot--lead {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 1.5rem 2rem;
      align-items: end;
    }
  }
  .shot:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .shot__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-bg-secondary));
    border-radius: 0.2rem;
  }
  .shot--lead .shot__media {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) {
    .shot--lead .shot__media {
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }

  .shot .gallery-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--color-border) / 0.25) 0%,
      rgb(var(--color-bg-secondary)) 50%,
      rgb(var(--color-border) / 0.25) 100%
    );
    background-size: 200% 100%;
    animation: galleryShimmer 1.3s linear infinite;
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .shot .gallery-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: blur(8px) saturate(0.9);
    transform: scale(1.04);
    transition:
      opacity 0.5s ease,
      filter 0.6s ease,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot.is-loaded .gallery-skeleton {
    opacity: 0;
    pointer-events: none;
  }
  .shot.is-loaded .gallery-image {
    opacity: 1;
    filter: blur(0) saturate(1.04);
    transform: scale(1);
  }
  .shot:hover.is-loaded .gallery-image,
  .shot:focus-visible.is-loaded .gallery-image {
    transform: scale(1.04);
  }

  .shot__no {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    z-index: 2;
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: white;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.45);
    opacity: 0.85;
  }

  .shot__copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0 0.1rem;
  }
  .shot__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .shot__meta span:first-child {
    color: rgb(var(--color-accent));
  }
  .shot__title {
    font-family: theme('fontFamily.heading');
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgb(var(--color-text-primary));
    transition: color 0.18s ease;
  }
  .shot:hover .shot__title,
  .shot:focus-visible .shot__title {
    color: rgb(var(--color-accent));
  }
  .shot--lead .shot__title {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .shot__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(var(--color-text-secondary));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes galleryShimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  .gallery-reveal {
    animation: galleryReveal 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes galleryReveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Lightbox — soft darkroom */
  .gallery-lightbox {
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .gallery-lightbox.is-open {
    display: flex;
    animation: lightboxIn 0.28s ease-out;
  }
  .gallery-lightbox__veil {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(8px);
