const galleryItems =
  galleryItemsData[lang as Lang] || galleryItemsData['en-GB'];

const sourceText: Record<Lang, any> = {
  'zh-CN': {
    title: '图片来源策略',
    all: '全部来源',
    local: '仅本站素材',
    remote: '包含外部图源',
