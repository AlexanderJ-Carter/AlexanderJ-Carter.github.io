---

<BaseLayout title={t('gallery.title')}>
  <!-- Hero: 创意视觉层次 + 胶片感装饰 -->
  <section class="relative pt-28 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient opacity-90"></div>
    <div class="absolute inset-0 bg-[var(--hero-spotlight)] opacity-60"></div>
    <!-- 装饰：模拟胶片齿孔 -->
    <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-24 pointer-events-none opacity-[0.07] dark:opacity-[0.12]" aria-hidden="true">
      <div class="flex justify-between px-2 max-w-4xl mx-auto gap-1">
        {Array.from({ length: 24 }).map((_) => (
          <div class="w-2 h-2 rounded-full bg-[rgb(var(--color-text-primary))]" />
        ))}
      </div>
    </div>
    <div class="container relative z-10 mx-auto px-4 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card text-sm font-medium text-[rgb(var(--color-text-secondary))] mb-6">
        <span class="text-lg" aria-hidden="true">📷</span>
        <span>
          {lang === 'zh-CN' ? '摄影作品集' : lang === 'zh-TW' ? '攝影作品集' : lang === 'fr' ? 'Portfolio photo' : lang === 'ru' ? 'Фотопортфолио' : 'Photo Portfolio'}
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold mb-4 gradient-text tracking-tight">
        {t('gallery.title')}
      </h1>
      <p class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto leading-relaxed">
        {
          lang === 'zh-CN'
            ? '探索摄影作品集，记录生活中的美好瞬间'
            : lang === 'zh-TW'
              ? '探索攝影作品集，記錄生活中的美好瞬間'
              : lang === 'fr'
                ? 'Explorez ma collection, capturant les beaux moments de la vie'
                : lang === 'ru'
                  ? 'Исследуйте коллекцию фотографий, запечатлевая прекрасные моменты жизни'
                  : 'Explore my photography portfolio, capturing beautiful moments in life'
        }
      </p>
      <p class="mt-3 text-sm text-[rgb(var(--color-text-tertiary))]">
        {
          lang === 'zh-CN'
            ? '点击作品可放大查看 · 使用分类快速筛选'
            : lang === 'zh-TW'
              ? '點擊作品可放大查看 · 使用分類快速篩選'
              : lang === 'fr'
                ? 'Cliquez pour agrandir · Filtrez par catégorie'
                : lang === 'ru'
                  ? 'Нажмите для увеличения · Фильтр по категориям'
                  : 'Click to enlarge · Filter by category'
        }
      </p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <!-- 统计与筛选：紧凑胶囊 + 带图标 -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-10">
      <div class="flex flex-wrap gap-3" id="gallery-stats">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card text-sm">
          <span aria-hidden="true">📷</span>
          <strong id="total-count" class="text-primary-500">{galleryItems.length}</strong>
          <span class="text-[rgb(var(--color-text-secondary))]">
            {lang === 'zh-CN' ? '件作品' : lang === 'zh-TW' ? '件作品' : lang === 'fr' ? 'œuvres' : lang === 'ru' ? 'работ' : 'works'}
          </span>
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm">
          <span aria-hidden="true">🏔️</span> {galleryItems.filter((i) => i.category === 'landscape').length}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm">
          <span aria-hidden="true">🌿</span> {galleryItems.filter((i) => i.category === 'nature').length}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm">
          <span aria-hidden="true">🍽️</span> {galleryItems.filter((i) => i.category === 'food').length}
        </span>
      </div>
      <div class="flex flex-wrap gap-2" id="filter-tabs" role="tablist" aria-label={lang === 'zh-CN' ? '按分类筛选' : 'Filter by category'}>
        {
          categories.map((cat) => (
            <button
              type="button"
              role="tab"
              aria-selected={cat.id === 'all'}
              tabindex={cat.id === 'all' ? 0 : -1}
              class="gallery-filter-btn px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-300 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
              class:list={{
                'bg-gradient-to-r from-primary-500 to-accent-500 text-white shadow-lg':
                  cat.id === 'all',
                'glass-card text-[rgb(var(--color-text-secondary))] hover:bg-[rgb(var(--color-bg-accent))] hover:text-[rgb(var(--color-text-primary))]':
                  cat.id !== 'all',
              }}
              data-filter={cat.id}
            >
              {cat.id === 'all' && '✨ '}
              {cat.id === 'landscape' && '🏔️ '}
              {cat.id === 'nature' && '🌿 '}
              {cat.id === 'food' && '🍽️ '}
              {cat.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- 画廊网格：首张大图 featured，卡片可点击灯箱 -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6"
      id="gallery-grid"
    >
      {
        galleryItems.map((item, index) => {
          const catLabel = categories.find((c) => c.id === item.category)?.label ?? item.category;
          return (
            <button
              type="button"
              class="gallery-item group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3] cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 border-0 p-0"
              class:list={{
                'md:col-span-2': index === 0,
              }}
              data-category={item.category}
              data-gallery-index={index}
              data-image={item.image}
              data-title={item.title}
              data-description={item.description}
              aria-label={lang === 'zh-CN' ? `查看：${item.title}` : `View: ${item.title}`}
            >
              <img
                src={item.image}
                alt=""
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
                loading={index < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5 md:p-6">
                <span class="inline-flex items-center gap-2 text-white/90 text-xs font-medium mb-2">
                  {item.category === 'landscape' && '🏔️ '}
                  {item.category === 'nature' && '🌿 '}
                  {item.category === 'food' && '🍽️ '}
                  {catLabel}
                </span>
                <h3 class="text-white text-lg md:text-xl font-bold">{item.title}</h3>
                <p class="text-gray-200 text-sm mt-1 line-clamp-2">{item.description}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-white/80 font-medium">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                  {lang === 'zh-CN' ? '放大查看' : lang === 'zh-TW' ? '放大查看' : lang === 'fr' ? 'Agrandir' : lang === 'ru' ? 'Увеличить' : 'View larger'}
                </span>
              </div>
            </button>
          );
        })
      }
    </div>
  </section>

  <!-- Lightbox 灯箱 -->
  <div
    id="gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label={lang === 'zh-CN' ? '作品大图' : 'Image viewer'}
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/90 backdrop-blur-sm"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '关闭' : 'Close'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '上一张' : 'Previous'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '下一张' : 'Next'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="relative max-w-5xl max-h-[85vh] w-full flex flex-col items-center">
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] w-auto object-contain rounded-lg shadow-2xl" />
      <div class="mt-4 text-center text-white px-4">
        <h2 id="lightbox-title" class="text-xl font-bold"></h2>
        <p id="lightbox-desc" class="text-white/80 text-sm mt-1"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const totalCountEl = document.getElementById('total-count');
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentFilter = 'all';
  let currentLightboxIndex = 0;

  function getVisibleItems(): Element[] {
    return Array.from(galleryItems).filter((el) => {
      const cat = el.getAttribute('data-category');
      return currentFilter === 'all' || cat === currentFilter;
    });
  }

  function openLightbox(index: number) {
    const visible = getVisibleItems();
    const item = visible[index];
    if (!item || !lightbox || !lightboxImage || !lightboxTitle || !lightboxDesc) return;
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (img) lightboxImage.src = img;
    lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
    currentLightboxIndex = index;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    lightboxClose?.focus();
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
    document.body.style.overflow = '';
  }

  function showLightboxPrev() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    currentLightboxIndex = (currentLightboxIndex - 1 + visible.length) % visible.length;
    const item = visible[currentLightboxIndex];
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (lightboxImage && img) lightboxImage.src = img;
    if (lightboxImage) lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
  }

  function showLightboxNext() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    currentLightboxIndex = (currentLightboxIndex + 1) % visible.length;
    const item = visible[currentLightboxIndex];
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (lightboxImage && img) lightboxImage.src = img;
    if (lightboxImage) lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const visible = getVisibleItems();
      const idx = visible.indexOf(item);
      if (idx !== -1) openLightbox(idx);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', showLightboxPrev);
  lightboxNext?.addEventListener('click', showLightboxNext);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('flex')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showLightboxPrev();
    if (e.key === 'ArrowRight') showLightboxNext();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterValue = btn.getAttribute('data-filter') || 'all';
      currentFilter = filterValue;

      filterBtns.forEach((b) => {
        const isActive = b.getAttribute('data-filter') === filterValue;
        b.setAttribute('aria-selected', String(isActive));
        (b as HTMLElement).tabIndex = isActive ? 0 : -1;
        b.classList.remove('bg-gradient-to-r', 'from-primary-500', 'to-accent-500', 'text-white', 'shadow-lg');
        b.classList.add('glass-card', 'text-[rgb(var(--color-text-secondary))]');
      });
      btn.classList.remove('glass-card', 'text-[rgb(var(--color-text-secondary))]');
      btn.classList.add('bg-gradient-to-r', 'from-primary-500', 'to-accent-500', 'text-white', 'shadow-lg');

      let visibleCount = 0;
      galleryItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        const show = filterValue === 'all' || filterValue === itemCategory;
        (item as HTMLElement).style.display = show ? '' : 'none';
        if (show) {
          item.classList.add('gallery-reveal');
          visibleCount++;
        }
      });
      if (totalCountEl) totalCountEl.textContent = String(visibleCount);
    });
  });
</script>

<style>
  .gallery-reveal {
    animation: galleryReveal 0.4s ease-out forwards;
  }

  @keyframes galleryReveal {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  #gallery-lightbox.flex {
    animation: lightboxIn 0.2s ease-out;
  }

  @keyframes lightboxIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
