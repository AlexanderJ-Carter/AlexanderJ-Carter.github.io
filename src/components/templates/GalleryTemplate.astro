const sourceUi = sourceText[lang as Lang] || sourceText['en-GB'];
---

<BaseLayout title={t('gallery.title')}>
  <section class="relative pt-28 pb-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-2xl mb-4">
        <p
          class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4"
        >
          Gallery
        </p>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold mb-4 tracking-tight"
        >
          {t('gallery.title')}
        </h1>
        <p
          class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] leading-relaxed"
        >
          {
            lang === 'zh-CN'
              ? '探索摄影作品集，记录生活中的美好瞬间'
              : lang === 'zh-TW'
                ? '探索攝影作品集，記錄生活中的美好瞬間'
                : lang === 'fr'
                  ? 'Explorez ma collection, capturant les beaux moments de la vie'
                  : lang === 'ru'
                    ? 'Исследуйте коллекцию фотографий, запечатлевая прекрасные моменты жизни'
                    : 'Explore my photography portfolio, capturing beautiful moments in life'
          }
        </p>
        <p class="mt-3 text-sm text-[rgb(var(--color-text-tertiary))]">
          {
            lang === 'zh-CN'
              ? '点击作品可放大查看 · 使用分类快速筛选'
              : lang === 'zh-TW'
                ? '點擊作品可放大查看 · 使用分類快速篩選'
                : lang === 'fr'
                  ? 'Cliquez pour agrandir · Filtrez par catégorie'
                  : lang === 'ru'
                    ? 'Нажмите для увеличения · Фильтр по категориям'
                    : 'Click to enlarge · Filter by category'
          }
        </p>
      </div>
    </div>
  </section>

  <!-- Performance Preload -->
  {
    galleryItems
      .slice(0, 3)
      .map((item) => <link rel="preload" as="image" href={item.image} />)
  }
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <!-- 统计与筛选：紧凑胶囊 + 带图标 -->
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-10"
    >
      <div class="flex flex-wrap gap-3" id="gallery-stats">
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm"
        >
          <strong id="total-count" class="text-[rgb(var(--color-text-primary))]"
            >{galleryItems.length}</strong
          >
          <span class="text-[rgb(var(--color-text-secondary))]">
            {
              lang === 'zh-CN'
                ? '件作品'
                : lang === 'zh-TW'
                  ? '件作品'
                  : lang === 'fr'
                    ? 'œuvres'
                    : lang === 'ru'
                      ? 'работ'
                      : 'works'
            }
          </span>
        </span>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))]"
        >
          {galleryItems.filter((i) => i.category === 'landscape').length}
        </span>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))]"
        >
          {galleryItems.filter((i) => i.category === 'nature').length}
        </span>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))]"
        >
          {galleryItems.filter((i) => i.category === 'food').length}
        </span>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))]"
        >
          {galleryItems.filter((i) => i.category === 'architecture').length}
        </span>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[rgb(var(--color-border))] text-sm text-[rgb(var(--color-text-secondary))]"
        >
          {galleryItems.filter((i) => i.category === 'street').length}
        </span>
      </div>
      <div
        class="flex flex-wrap gap-2"
        id="filter-tabs"
        role="tablist"
        aria-label={lang === 'zh-CN' ? '按分类筛选' : 'Filter by category'}
      >
        {
          categories.map((cat) => (
            <button
              type="button"
              role="tab"
              aria-selected={cat.id === 'all'}
              tabindex={cat.id === 'all' ? 0 : -1}
              class="gallery-filter-btn px-4 py-2 rounded-lg font-medium text-sm border transition-colors focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
              class:list={{
                'border-[rgb(var(--color-text-primary))] bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))]':
                  cat.id === 'all',
                'border-[rgb(var(--color-border))] text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] hover:border-[rgb(var(--color-text-tertiary))]':
                  cat.id !== 'all',
              }}
              data-filter={cat.id}
            >
              {cat.label}
            </button>
          ))
        }
      </div>
      <div
        class="border border-[rgb(var(--color-border))] rounded-lg p-3 text-xs sm:text-sm max-w-sm"
      >
        <p class="font-semibold text-[rgb(var(--color-text-primary))] mb-1">
          {sourceUi.title}
        </p>
        <p class="text-[rgb(var(--color-text-secondary))]">{sourceUi.note}</p>
        <div class="mt-3">
          <label for="source-filter" class="sr-only">{sourceUi.title}</label>
          <select
            id="source-filter"
            class="w-full rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] px-3 py-2 text-sm text-[rgb(var(--color-text-primary))] focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none"
          >
            <option value="all">{sourceUi.all}</option>
            <option value="local">{sourceUi.local}</option>
            <option value="remote">{sourceUi.remote}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 画廊网格：首张大图 featured，卡片可点击灯箱 -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6"
      id="gallery-grid"
    >
      {
        galleryItems.map((item, index) => {
          const catLabel =
            categories.find((c) => c.id === item.category)?.label ??
            item.category;
          return (
            <button
              type="button"
              class="gallery-item card-hover group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3] cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 border-0 p-0 transition-all duration-300"
              class:list={{
                'md:col-span-2': index === 0,
              }}
              data-category={item.category}
              data-source={item.image.startsWith('http') ? 'remote' : 'local'}
              data-gallery-index={index}
              data-image={item.image}
              data-title={item.title}
              data-description={item.description}
              aria-label={
                lang === 'zh-CN' ? `查看：${item.title}` : `View: ${item.title}`
              }
            >
              <div
                class="gallery-skeleton absolute inset-0"
                aria-hidden="true"
              />
              <img
                src={item.image}
                alt={`${item.title} - ${item.description}`}
                class="gallery-image absolute inset-0 w-full h-full object-cover opacity-0 transform group-hover:scale-105 transition-all duration-500 ease-out"
                loading={index < 6 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                fetchpriority={index < 3 ? 'high' : 'low'}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5 md:p-6">
                <span class="inline-flex items-center gap-2 text-white/90 text-xs font-medium mb-2">
                  {item.category === 'landscape' && '🏔️ '}
                  {item.category === 'nature' && '🌿 '}
                  {item.category === 'food' && '🍽️ '}
                  {item.category === 'architecture' && '🏛️ '}
                  {item.category === 'street' && '🌃 '}
                  {catLabel}
                </span>
                <span class="inline-flex items-center w-fit mb-2 px-2 py-0.5 rounded bg-black/35 text-white/90 text-[11px]">
                  {item.image.startsWith('http')
                    ? sourceUi.remoteTag
                    : sourceUi.localTag}
                </span>
                <h3 class="text-white text-lg md:text-xl font-bold">
                  {item.title}
                </h3>
                <p class="text-gray-200 text-sm mt-1 line-clamp-2">
                  {item.description}
                </p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-white/80 font-medium">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                    />
                  </svg>
                  {lang === 'zh-CN'
                    ? '放大查看'
                    : lang === 'zh-TW'
                      ? '放大查看'
                      : lang === 'fr'
                        ? 'Agrandir'
                        : lang === 'ru'
                          ? 'Увеличить'
                          : 'View larger'}
                </span>
              </div>
            </button>
          );
        })
      }
    </div>
  </section>

  <!-- Lightbox 灯箱 -->
  <div
    id="gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label={lang === 'zh-CN' ? '作品大图' : 'Image viewer'}
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/90 backdrop-blur-sm"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '关闭' : 'Close'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '上一张' : 'Previous'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path></svg
      >
    </button>
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-white"
      aria-label={lang === 'zh-CN' ? '下一张' : 'Next'}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path></svg
      >
    </button>
    <div
      class="relative max-w-5xl max-h-[85vh] w-full flex flex-col items-center"
    >
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-w-full max-h-[70vh] w-auto object-contain rounded-lg shadow-2xl"
      />
      <div class="mt-4 text-center text-white px-4">
        <h2 id="lightbox-title" class="text-xl font-bold">Selected image</h2>
        <p id="lightbox-desc" class="text-white/80 text-sm mt-1"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const totalCountEl = document.getElementById('total-count');
  const sourceFilterEl = document.getElementById(
    'source-filter'
  ) as HTMLSelectElement | null;
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById(
    'lightbox-image'
  ) as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentFilter = 'all';
  let currentSourceFilter = 'all';
  let currentLightboxIndex = 0;

  function initGalleryImageLoading() {
    galleryItems.forEach((item) => {
      const image = item.querySelector('img') as HTMLImageElement | null;
      if (!image) return;

      const markLoaded = () => {
        item.classList.add('is-loaded');
      };

      if (image.complete && image.naturalWidth > 0) {
        markLoaded();
        return;
      }

      image.addEventListener('load', markLoaded, { once: true });
      image.addEventListener('error', markLoaded, { once: true });
    });
  }

  initGalleryImageLoading();

  function getVisibleItems(): Element[] {
    return Array.from(galleryItems).filter((el) => {
      const cat = el.getAttribute('data-category');
      const source = el.getAttribute('data-source');
      const categoryOk = currentFilter === 'all' || cat === currentFilter;
      const sourceOk =
        currentSourceFilter === 'all' || source === currentSourceFilter;
      return categoryOk && sourceOk;
    });
  }

  function applyFilters() {
    const visible = getVisibleItems();
    galleryItems.forEach((item) => {
      const show = visible.includes(item);
      (item as HTMLElement).style.display = show ? '' : 'none';
      if (show) item.classList.add('gallery-reveal');
    });
    if (totalCountEl) totalCountEl.textContent = String(visible.length);
  }

  function openLightbox(index: number) {
    const visible = getVisibleItems();
    const item = visible[index];
    if (!item || !lightbox || !lightboxImage || !lightboxTitle || !lightboxDesc)
      return;
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (img) lightboxImage.src = img;
    lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
    currentLightboxIndex = index;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    lightboxClose?.focus();
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
    document.body.style.overflow = '';
  }

  function showLightboxPrev() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    currentLightboxIndex =
      (currentLightboxIndex - 1 + visible.length) % visible.length;
    const item = visible[currentLightboxIndex];
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (lightboxImage && img) lightboxImage.src = img;
    if (lightboxImage) lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
  }

  function showLightboxNext() {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    currentLightboxIndex = (currentLightboxIndex + 1) % visible.length;
    const item = visible[currentLightboxIndex];
    const img = item.getAttribute('data-image');
    const title = item.getAttribute('data-title');
    const desc = item.getAttribute('data-description');
    if (lightboxImage && img) lightboxImage.src = img;
    if (lightboxImage) lightboxImage.alt = title || '';
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = desc || '';
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const visible = getVisibleItems();
      const idx = visible.indexOf(item);
      if (idx !== -1) openLightbox(idx);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', showLightboxPrev);
  lightboxNext?.addEventListener('click', showLightboxNext);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('flex')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showLightboxPrev();
    if (e.key === 'ArrowRight') showLightboxNext();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterValue = btn.getAttribute('data-filter') || 'all';
      currentFilter = filterValue;

      filterBtns.forEach((b) => {
        const isActive = b.getAttribute('data-filter') === filterValue;
        b.setAttribute('aria-selected', String(isActive));
        (b as HTMLElement).tabIndex = isActive ? 0 : -1;
        b.classList.remove(
          'border-[rgb(var(--color-text-primary))]',
          'bg-[rgb(var(--color-bg-secondary))]',
          'text-[rgb(var(--color-text-primary))]'
        );
        b.classList.add(
          'border-[rgb(var(--color-border))]',
          'text-[rgb(var(--color-text-secondary))]'
        );
      });
      btn.classList.remove(
        'border-[rgb(var(--color-border))]',
        'text-[rgb(var(--color-text-secondary))]'
      );
      btn.classList.add(
        'border-[rgb(var(--color-text-primary))]',
        'bg-[rgb(var(--color-bg-secondary))]',
        'text-[rgb(var(--color-text-primary))]'
      );

      let visibleCount = 0;
      applyFilters();
      visibleCount = getVisibleItems().length;
      if (totalCountEl) totalCountEl.textContent = String(visibleCount);
    });
  });

  sourceFilterEl?.addEventListener('change', () => {
    currentSourceFilter = sourceFilterEl.value;
    applyFilters();
  });
</script>

<style>
  .gallery-item .gallery-skeleton {
    background: linear-gradient(
      90deg,
      rgba(148, 163, 184, 0.18) 0%,
      rgba(226, 232, 240, 0.35) 50%,
      rgba(148, 163, 184, 0.18) 100%
    );
    background-size: 200% 100%;
    animation: galleryShimmer 1.3s linear infinite;
    opacity: 1;
    transition: opacity 0.35s ease;
  }

  .dark .gallery-item .gallery-skeleton {
    background: linear-gradient(
      90deg,
      rgba(51, 65, 85, 0.5) 0%,
      rgba(71, 85, 105, 0.7) 50%,
      rgba(51, 65, 85, 0.5) 100%
    );
  }

  .gallery-item .gallery-image {
    filter: blur(6px);
  }

  .gallery-item.is-loaded .gallery-skeleton {
    opacity: 0;
    pointer-events: none;
  }

  .gallery-item.is-loaded .gallery-image {
    opacity: 1;
    filter: blur(0);
  }

  @keyframes galleryShimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  .gallery-reveal {
    animation: galleryReveal 0.4s ease-out forwards;
  }

  @keyframes galleryReveal {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  #gallery-lightbox.flex {
    animation: lightboxIn 0.2s ease-out;
  }

  @keyframes lightboxIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item .gallery-image,
    .gallery-item .gallery-skeleton,
    .gallery-reveal,
    #gallery-lightbox.flex {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>
