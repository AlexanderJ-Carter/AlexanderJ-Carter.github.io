    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: baseline;
  }
  .gallery-stat {
    font-size: 0.85rem;
    color: rgb(var(--color-text-secondary));
  }
  .gallery-stat strong {
    font-family: theme('fontFamily.heading');
    font-size: 1.35rem;
