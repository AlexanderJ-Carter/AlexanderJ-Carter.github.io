const t =
  securityAcknowledgmentsData[lang as Lang] ||
  securityAcknowledgmentsData['en-GB'];
---

<BaseLayout title={t.title} description={t.description}>
  <div class="container mx-auto px-4 lg:px-8 max-w-3xl pt-28 md:pt-32">
    <a
      href={getLangPath('/')}
      class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span
        >{
          lang === 'zh-CN'
            ? '返回首页'
            : lang === 'zh-TW'
              ? '返回首頁'
              : lang === 'fr'
                ? "Retour à l'accueil"
                : lang === 'ru'
                  ? 'На главную'
                  : 'Back to home'
        }</span
      >
    </a>
  </div>

  <PageHero
    class="!pt-0"
    folio="Folio Thanks"
    title={t.title}
    description={t.headerDesc}
    note={`${t.lastUpdatedLabel}${t.lastUpdated}`}
    narrow={false}
  />

  <section class="pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <!-- Legal nav -->
      <nav
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs sm:text-sm text-[rgb(var(--color-text-secondary))] mb-10"
        aria-label={lang === 'zh-CN' || lang === 'zh-TW'
          ? '法律与政策导航'
          : 'Legal & policy navigation'}
      >
        <a
          href={getLangPath('/privacy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '隐私政策'
              : lang === 'zh-TW'
                ? '隱私權政策'
                : 'Privacy'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/terms')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '服务条款'
              : lang === 'zh-TW'
                ? '服務條款'
                : 'Terms'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/license')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '许可证'
              : lang === 'zh-TW'
                ? '許可證'
                : 'License'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/accessibility')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '无障碍'
              : lang === 'zh-TW'
                ? '無障礙'
                : 'Accessibility'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/security/policy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '安全政策'
              : lang === 'zh-TW'
                ? '安全政策'
                : 'Security'
          }
        </a>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Navigation -->
        <div class="lg:w-1/4">
          <div class="sticky top-24 glass-card p-6">
            <h5
              class="font-heading font-bold mb-4 text-sm uppercase tracking-wide text-[rgb(var(--color-text-tertiary))]"
            >
              {t.sidebarTitle}
            </h5>
            <nav class="flex flex-col space-y-1.5">
              <a
                href="#overview"
                class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors py-0.5"
                >{t.nav.overview}</a
              >
              <a
                href="#reports"
                class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors py-0.5"
                >{t.nav.reports}</a
              >
              <a
                href="#contact"
                class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors py-0.5"
                >{t.nav.contact}</a
              >
              <a
                href="#policy"
                class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors py-0.5"
                >{t.nav.policy}</a
              >
            </nav>
          </div>
        </div>

        <!-- Main Content -->
        <div class="lg:w-3/4 space-y-8">
          <!-- 1. Overview -->
          <section id="overview" class="glass-card p-8">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span class="text-primary-500">️</span>
              {t.sections.overview.title}
            </h2>
            <p class="mb-4 text-[rgb(var(--color-text-secondary))]">
              {t.sections.overview.content}
            </p>
            <ul
              class="list-disc list-inside space-y-2 mb-6 text-[rgb(var(--color-text-secondary))]"
            >
              {t.sections.overview.list.map((item: string) => <li>{item}</li>)}
            </ul>
            <div
              class="bg-red-50 dark:bg-red-900/20 rounded-sm p-4 flex gap-3 items-center border border-red-100 dark:border-red-800"
            >
              <span class="text-red-500 text-xl">️</span>
              <p class="text-red-700 dark:text-red-200 font-medium">
                {t.sections.overview.note}
              </p>
            </div>
          </section>

          <!-- 2. Reports -->
          <section id="reports" class="glass-card p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
              {t.sections.reports.title}
            </h2>

            <!-- Empty State -->
            <div
              class="bg-blue-50 dark:bg-blue-900/10 rounded-sm p-8 text-center border border-blue-100 dark:border-blue-800"
            >
              <div
                class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
              >
              </div>
              <h4
                class="text-xl font-bold text-[rgb(var(--color-text-primary))] mb-2"
              >
                {t.sections.reports.emptyTitle}
              </h4>
              <p class="text-[rgb(var(--color-text-secondary))]">
                {t.sections.reports.emptyDesc}
              </p>
            </div>
          </section>

          <!-- 3. Contact -->
          <section id="contact" class="glass-card p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
              {t.sections.contact.title}
            </h2>
            <p class="mb-6 text-[rgb(var(--color-text-secondary))]">
              {t.sections.contact.content}
            </p>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div
                class="bg-[rgb(var(--color-bg-secondary))] p-6 rounded-sm border border-[rgb(var(--color-border))]"
              >
                <h5 class="font-bold mb-3 flex items-center gap-2">
                  <span class="text-primary-500">️</span>
                  {t.sections.contact.emailTitle}
                </h5>
                <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-4">
                  {t.sections.contact.emailDesc}
                </p>
                <a
                  href="mailto:contact-us@alexander.xin"
                  class="inline-flex items-center justify-center w-full px-4 py-2 bg-primary-500 text-white rounded-sm hover:bg-primary-600 transition-colors"
                >
                  contact-us@alexander.xin
                </a>
              </div>
              <div
                class="bg-[rgb(var(--color-bg-secondary))] p-6 rounded-sm border border-[rgb(var(--color-border))]"
              >
                <h5 class="font-bold mb-3 flex items-center gap-2">
                  {t.sections.contact.encryptedTitle}
                </h5>
                <p class="text-sm text-[rgb(var(--color-text-tertiary))] mb-4">
                  {t.sections.contact.encryptedDesc}
                </p>
                <a
                  href="/security/pgp-key.asc"
                  target="_blank"
                  class="inline-flex items-center justify-center w-full px-4 py-2 bg-green-500 text-white rounded-sm hover:bg-green-600 transition-colors"
                >
                  {t.sections.contact.downloadKey}
                </a>
              </div>
            </div>

            <div
              class="bg-blue-50 dark:bg-blue-900/20 rounded-sm p-4 flex gap-3 items-center border border-blue-100 dark:border-blue-800"
            >
              <span class="text-blue-500">⏱️</span>
              <p class="text-sm text-blue-700 dark:text-blue-200">
                {t.sections.contact.commitment}
              </p>
            </div>
          </section>

          <!-- 4. Policy -->
          <section id="policy" class="glass-card p-8">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              {t.sections.policy.title}
            </h2>
            <p class="mb-6 text-[rgb(var(--color-text-secondary))]">
              {t.sections.policy.content}
            </p>
            <div class="flex flex-wrap gap-4">
              <a
                href={`${pathPrefix}/security/policy`}
                class="px-6 py-2 border border-primary-500 text-primary-500 rounded-sm hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors flex items-center gap-2"
              >
                <span>️</span>
                {t.sections.policy.securityPolicy}
              </a>
              <a
                href="/.well-known/security.txt"
                class="px-6 py-2 border border-[rgb(var(--color-border))] text-[rgb(var(--color-text-secondary))] rounded-sm hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-2"
              >
                <span></span>
                {t.sections.policy.securityTxt}
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
