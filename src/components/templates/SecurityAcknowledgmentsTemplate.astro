const t =
  securityAcknowledgmentsData[lang as Lang] ||
  securityAcknowledgmentsData['en-US'];
---

<BaseLayout
  title={`${t.title} | Alexander James Carter`}
  description={t.description}
>
  <div class="container mx-auto px-4 py-12 lg:py-20 max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 gradient-text">
        {t.title}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        {t.headerDesc}
      </p>
      <p class="text-sm text-gray-500 mt-4">
        {t.lastUpdatedLabel}{t.lastUpdated}
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar Navigation -->
      <div class="lg:w-1/4">
        <div
          class="sticky top-24 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md rounded-xl p-6 shadow-lg border border-gray-100 dark:border-gray-700"
        >
          <h5 class="font-bold mb-4 text-lg">{t.sidebarTitle}</h5>
          <nav class="flex flex-col space-y-2">
            <a
              href="#overview"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-500 transition-colors"
              >{t.nav.overview}</a
            >
            <a
              href="#reports"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-500 transition-colors"
              >{t.nav.reports}</a
            >
            <a
              href="#contact"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-500 transition-colors"
              >{t.nav.contact}</a
            >
            <a
              href="#policy"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-500 transition-colors"
              >{t.nav.policy}</a
            >
          </nav>
        </div>
      </div>

      <!-- Main Content -->
      <div class="lg:w-3/4 space-y-8">
        <!-- 1. Overview -->
        <section
          id="overview"
          class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-700"
        >
          <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <span class="text-primary-500">🛡️</span>
            {t.sections.overview.title}
          </h2>
          <p class="mb-4 text-gray-600 dark:text-gray-300">
            {t.sections.overview.content}
          </p>
          <ul
            class="list-disc list-inside space-y-2 mb-6 text-gray-600 dark:text-gray-300"
          >
            {t.sections.overview.list.map((item: string) => <li>{item}</li>)}
          </ul>
          <div
            class="bg-red-50 dark:bg-red-900/20 rounded-xl p-4 flex gap-3 items-center border border-red-100 dark:border-red-800"
          >
            <span class="text-red-500 text-xl">❤️</span>
            <p class="text-red-700 dark:text-red-200 font-medium">
              {t.sections.overview.note}
            </p>
          </div>
        </section>

        <!-- 2. Reports -->
        <section
          id="reports"
          class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-700"
        >
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-primary-500">📋</span>
            {t.sections.reports.title}
          </h2>

          <!-- Empty State -->
          <div
            class="bg-blue-50 dark:bg-blue-900/10 rounded-xl p-8 text-center border border-blue-100 dark:border-blue-800"
          >
            <div
              class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-green-500 text-2xl">✓</span>
            </div>
            <h4 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-2">
              {t.sections.reports.emptyTitle}
            </h4>
            <p class="text-gray-600 dark:text-gray-400">
              {t.sections.reports.emptyDesc}
            </p>
          </div>
        </section>

        <!-- 3. Contact -->
        <section
          id="contact"
          class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-700"
        >
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-primary-500">📧</span>
            {t.sections.contact.title}
          </h2>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t.sections.contact.content}
          </p>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div
              class="bg-gray-50 dark:bg-gray-700/50 p-6 rounded-xl border border-gray-100 dark:border-gray-600"
            >
              <h5 class="font-bold mb-3 flex items-center gap-2">
                <span class="text-primary-500">✉️</span>
                {t.sections.contact.emailTitle}
              </h5>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                {t.sections.contact.emailDesc}
              </p>
              <a
                href="mailto:contact-us@alexander.xin"
                class="inline-flex items-center justify-center w-full px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
              >
                contact-us@alexander.xin
              </a>
            </div>
            <div
              class="bg-gray-50 dark:bg-gray-700/50 p-6 rounded-xl border border-gray-100 dark:border-gray-600"
            >
              <h5 class="font-bold mb-3 flex items-center gap-2">
                <span class="text-green-500">🔒</span>
                {t.sections.contact.encryptedTitle}
              </h5>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                {t.sections.contact.encryptedDesc}
              </p>
              <a
                href="/security/pgp-key.asc"
                target="_blank"
                class="inline-flex items-center justify-center w-full px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors"
              >
                {t.sections.contact.downloadKey}
              </a>
            </div>
          </div>

          <div
            class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4 flex gap-3 items-center border border-blue-100 dark:border-blue-800"
          >
            <span class="text-blue-500">⏱️</span>
            <p class="text-sm text-blue-700 dark:text-blue-200">
              {t.sections.contact.commitment}
            </p>
          </div>
        </section>

        <!-- 4. Policy -->
        <section
          id="policy"
          class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-700"
        >
          <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <span class="text-primary-500">📄</span>
            {t.sections.policy.title}
          </h2>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t.sections.policy.content}
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href={`${pathPrefix}/security/policy`}
              class="px-6 py-2 border border-primary-500 text-primary-500 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors flex items-center gap-2"
            >
              <span>🛡️</span>
              {t.sections.policy.securityPolicy}
            </a>
            <a
              href="/.well-known/security.txt"
              class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors flex items-center gap-2"
            >
              <span>📝</span>
              {t.sections.policy.securityTxt}
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .gradient-text {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-primary-500 to-accent-500;
  }

  /* Smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
  }
</style>
