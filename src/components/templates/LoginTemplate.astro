---
/**
 * Maintainer entry — no passwords collected; guides to Access App Launcher.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ACCESS_LAUNCHER_URL,
  IDENTITY_URL,
  getOpsSites,
} from '../../data/site-registry';

const OPS_PORTAL_URL = 'https://ops.alexander.xin';
import { resolveLang, getLangPath, type Lang } from '../../i18n/types';

interface Props {
  lang?: string;
}

const lang = resolveLang(Astro.props.lang);
const lp = (path: string) => getLangPath(lang, path);
const ops = getOpsSites().filter((s) => s.status === 'live' && s.access);

const copy: Record<
  Lang,
  {
    title: string;
    description: string;
    kicker: string;
    headline: string;
    lead: string;
    publicNote: string;
    cta: string;
    opsPortal: string;
    identity: string;
    opsLabel: string;
    back: string;
    network: string;
  }
> = {
  'zh-CN': {
    title: '维护者入口',
    description: '公开站无需登录。维护者经 Cloudflare Access 进入运维控制面。',
    kicker: 'Ops gate',
    headline: '这里不是访客账户',
    lead: '主站保持匿名。登录只保护 Git、容器、Nginx、SSH 等私有工具。',
    publicNote: '浏览内容、工具与实验区不需要账号。',
    cta: '打开 Access 启动台',
    opsPortal: '运维状态台',
    identity: '身份源 Pocket ID',
    opsLabel: '受保护的入口',
    back: '返回主站',
    network: '站群目录',
  },
  'zh-TW': {
    title: '維護者入口',
    description: '公開站無需登入。維護者經 Cloudflare Access 進入運維控制面。',
    kicker: 'Ops gate',
    headline: '這裡不是訪客帳戶',
    lead: '主站保持匿名。登入只保護 Git、容器、Nginx、SSH 等私有工具。',
    publicNote: '瀏覽內容、工具與實驗區不需要帳號。',
    cta: '打開 Access 啟動台',
    opsPortal: '運維狀態台',
    identity: '身份源 Pocket ID',
    opsLabel: '受保護的入口',
    back: '返回主站',
    network: '站群目錄',
  },
  'en-GB': {
    title: 'Maintainer entry',
    description:
      'Public pages need no login. Maintainers use Cloudflare Access for the ops plane.',
    kicker: 'Ops gate',
    headline: 'Not a visitor account',
    lead: 'The portfolio stays anonymous. Sign-in only protects private tools such as Git, containers, Nginx and SSH.',
    publicNote: 'Reading content, tools and the lab needs no account.',
    cta: 'Open Access launcher',
    opsPortal: 'Ops portal',
    identity: 'Identity: Pocket ID',
    opsLabel: 'Protected entries',
    back: 'Back home',
    network: 'Network directory',
  },
  fr: {
    title: 'Entrée mainteneur',
    description:
      'Pas de compte visiteur. Les mainteneurs passent par Cloudflare Access.',
    kicker: 'Ops gate',
    headline: 'Pas un compte visiteur',
    lead: 'Le site public reste anonyme. La connexion ne protège que les outils privés (Git, conteneurs, Nginx, SSH).',
    publicNote: 'Lire le contenu, les outils et le labo ne nécessite aucun compte.',
    cta: 'Ouvrir le lanceur Access',
    opsPortal: 'Portail ops',
    identity: 'Identité : Pocket ID',
    opsLabel: 'Entrées protégées',
    back: 'Accueil',
    network: 'Annuaire réseau',
  },
  ru: {
    title: 'Вход для сопровождения',
    description:
      'Публичному сайту вход не нужен. Сопровождение — через Cloudflare Access.',
    kicker: 'Ops gate',
    headline: 'Это не аккаунт посетителя',
    lead: 'Публичный сайт остаётся анонимным. Вход защищает только приватные инструменты: Git, контейнеры, Nginx, SSH.',
    publicNote: 'Контент, инструменты и лаборатория не требуют аккаунта.',
    cta: 'Открыть Access launcher',
    opsPortal: 'Ops-портал',
    identity: 'Идентичность: Pocket ID',
    opsLabel: 'Защищённые входы',
    back: 'На главную',
    network: 'Каталог сети',
  },
};

const t = copy[lang];
---

<BaseLayout
  title={t.title}
  description={t.description}
  showHeader={false}
  showFooter={true}
  mainClass="!p-0"
>
  <div class="login-shell">
    <div class="login-shell__inner">
      <p class="login-shell__kicker">{t.kicker}</p>
      <h1 class="login-shell__title">{t.headline}</h1>
      <p class="login-shell__lead">{t.lead}</p>
      <p class="login-shell__note">{t.publicNote}</p>

      <div class="login-shell__actions">
        <a
          class="login-shell__cta"
          href={ACCESS_LAUNCHER_URL}
          rel="noopener noreferrer"
        >
          {t.cta}
        </a>
        <a
          class="login-shell__ghost"
          href={OPS_PORTAL_URL}
          rel="noopener noreferrer"
        >
          {t.opsPortal}
        </a>
        <a
          class="login-shell__ghost"
          href={IDENTITY_URL}
          rel="noopener noreferrer"
          target="_blank"
        >
          {t.identity}
        </a>
      </div>

      <section class="login-shell__ops" aria-labelledby="ops-heading">
        <h2 id="ops-heading">{t.opsLabel}</h2>
        <ul>
          {
            ops.map((site) => (
              <li>
                <a href={site.url} rel="noopener noreferrer">
                  {site.labels[lang]}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="login-shell__foot">
        <a href={lp('/')}>{t.back}</a>
        <span aria-hidden="true">·</span>
        <a href={lp('/network')}>{t.network}</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .login-shell {
    --ink: #e8e2d4;
    --line: #e8c478;
    --bg0: #0b0d12;
    --bg1: #12161f;
    min-height: 100svh;
    background:
      radial-gradient(ellipse 80% 50% at 20% 0%, #1a2438 0%, transparent 55%),
      radial-gradient(ellipse 60% 40% at 90% 80%, #1c1810 0%, transparent 50%),
      linear-gradient(165deg, var(--bg0), var(--bg1));
    color: var(--ink);
    display: flex;
    align-items: center;
    padding: 4rem 1.25rem;
  }

  .login-shell__inner {
    max-width: 36rem;
    margin: 0 auto;
  }

  .login-shell__kicker {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--line);
    margin: 0 0 1rem;
  }

  .login-shell__title {
    font-family: 'Syne', 'Noto Serif SC', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .login-shell__lead,
  .login-shell__note {
    margin: 0 0 0.85rem;
    line-height: 1.65;
    opacity: 0.85;
  }

  .login-shell__note {
    opacity: 0.65;
    font-size: 0.95rem;
  }

  .login-shell__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 2.25rem;
  }

  .login-shell__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.2rem;
    background: color-mix(in oklab, var(--line) 88%, #fff);
    color: #14110c;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .login-shell__cta:focus-visible {
    outline: 2px solid var(--line);
    outline-offset: 3px;
  }

  .login-shell__ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1rem;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.85;
  }

  .login-shell__ops h2 {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 0.75rem;
  }

  .login-shell__ops ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .login-shell__ops a {
    color: color-mix(in oklab, var(--ink) 80%, var(--line));
    text-underline-offset: 3px;
  }

  .login-shell__foot {
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .login-shell__foot a {
    color: inherit;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .login-shell {
      background: var(--bg0);
    }
  }
</style>
