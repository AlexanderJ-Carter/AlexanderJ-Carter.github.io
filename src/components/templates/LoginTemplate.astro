---
/**
 * Maintainer entry — no visitor signup; primary CTA is Ops Portal.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ACCESS_LAUNCHER_URL,
  IDENTITY_URL,
  getOpsSites,
} from '../../data/site-registry';
import { resolveLang, getLangPath, type Lang } from '../../i18n/types';

const OPS_PORTAL_URL = 'https://ops.alexander.xin';

interface Props {
  lang?: string;
}

const lang = resolveLang(Astro.props.lang);
const lp = (path: string) => getLangPath(lang, path);
const ops = getOpsSites().filter((s) => s.status === 'live' && s.access);

const copy: Record<
  Lang,
  {
    title: string;
    description: string;
    kicker: string;
    headline: string;
    lead: string;
    publicNote: string;
    cta: string;
    launcher: string;
    identity: string;
    opsLabel: string;
    back: string;
    network: string;
  }
> = {
  'zh-CN': {
    title: '维护者入口',
    description:
      '公开站无需登录。维护者从 Ops Portal 进入运维控制面（Cloudflare Access）。',
    kicker: 'Ops gate',
    headline: '这里不是访客注册',
    lead: '主站保持匿名。此页只通向运维工具：Git、容器、Nginx、SSH 等，不面向读者开户。',
    publicNote: '浏览内容、工具与实验区不需要账号。',
    cta: '打开 Ops Portal',
    launcher: 'Access 启动台（备选）',
    identity: '身份源 Pocket ID',
    opsLabel: '受保护的入口',
    back: '返回主站',
    network: '站群目录',
  },
  'zh-TW': {
    title: '維護者入口',
    description:
      '公開站無需登入。維護者從 Ops Portal 進入運維控制面（Cloudflare Access）。',
    kicker: 'Ops gate',
    headline: '這裡不是訪客註冊',
    lead: '主站保持匿名。此頁只通向運維工具：Git、容器、Nginx、SSH 等，不面向讀者開戶。',
    publicNote: '瀏覽內容、工具與實驗區不需要帳號。',
    cta: '打開 Ops Portal',
    launcher: 'Access 啟動台（備選）',
    identity: '身份源 Pocket ID',
    opsLabel: '受保護的入口',
    back: '返回主站',
    network: '站群目錄',
  },
  'en-GB': {
    title: 'Maintainer entry',
    description:
      'Public pages need no login. Maintainers enter the ops plane via Ops Portal (Cloudflare Access).',
    kicker: 'Ops gate',
    headline: 'Not visitor registration',
    lead: 'The portfolio stays anonymous. This page only reaches private tools—Git, containers, Nginx, SSH—not reader accounts.',
    publicNote: 'Reading content, tools and the lab needs no account.',
    cta: 'Open Ops Portal',
    launcher: 'Access launcher (secondary)',
    identity: 'Identity: Pocket ID',
    opsLabel: 'Protected entries',
    back: 'Back home',
    network: 'Network directory',
  },
  fr: {
    title: 'Entrée mainteneur',
    description:
      'Pas de compte visiteur. Les mainteneurs entrent via Ops Portal (Cloudflare Access).',
    kicker: 'Ops gate',
    headline: 'Pas une inscription visiteur',
    lead: 'Le site public reste anonyme. Cette page mène uniquement aux outils privés (Git, conteneurs, Nginx, SSH), pas à des comptes lecteurs.',
    publicNote:
      'Lire le contenu, les outils et le labo ne nécessite aucun compte.',
    cta: 'Ouvrir Ops Portal',
    launcher: 'Lanceur Access (secondaire)',
    identity: 'Identité : Pocket ID',
    opsLabel: 'Entrées protégées',
    back: 'Accueil',
    network: 'Annuaire réseau',
  },
  ru: {
    title: 'Вход для сопровождения',
    description:
      'Публичному сайту вход не нужен. Сопровождение — через Ops Portal (Cloudflare Access).',
    kicker: 'Ops gate',
    headline: 'Это не регистрация посетителя',
    lead: 'Публичный сайт остаётся анонимным. Эта страница ведёт только к приватным инструментам: Git, контейнеры, Nginx, SSH — не к аккаунтам читателей.',
    publicNote: 'Контент, инструменты и лаборатория не требуют аккаунта.',
    cta: 'Открыть Ops Portal',
    launcher: 'Access launcher (запасной)',
    identity: 'Идентичность: Pocket ID',
    opsLabel: 'Защищённые входы',
    back: 'На главную',
    network: 'Каталог сети',
  },
};

const t = copy[lang];
---

<BaseLayout
  title={t.title}
  description={t.description}
  showHeader={false}
  showFooter={true}
  mainClass="!p-0"
  robots="noindex, nofollow"
>
  <div class="login-shell">
    <div class="login-shell__wash" aria-hidden="true"></div>
    <div class="login-shell__inner">
      <p class="login-shell__folio">Folio Ops</p>
      <p class="login-shell__kicker">{t.kicker}</p>
      <h1 class="login-shell__title">{t.headline}</h1>
      <p class="login-shell__lead">{t.lead}</p>
      <p class="login-shell__note">{t.publicNote}</p>

      <div class="login-shell__actions">
        <a
          class="login-shell__cta"
          href={OPS_PORTAL_URL}
          rel="noopener noreferrer"
        >
          {t.cta}
        </a>
        <a
          class="login-shell__ghost"
          href={ACCESS_LAUNCHER_URL}
          rel="noopener noreferrer"
        >
          {t.launcher}
        </a>
        <a
          class="login-shell__ghost"
          href={IDENTITY_URL}
          rel="noopener noreferrer"
          target="_blank"
        >
          {t.identity}
        </a>
      </div>

      <section class="login-shell__ops" aria-labelledby="ops-heading">
        <h2 id="ops-heading">{t.opsLabel}</h2>
        <ul class="login-shell__ops-list">
          {
            ops.map((site, i) => (
              <li>
                <a href={site.url} rel="noopener noreferrer" class="list-row">
                  <span class="meta-mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="login-shell__ops-name">{site.labels[lang]}</span>
                  <span class="meta-mono" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="login-shell__foot">
        <a href={lp('/')}>{t.back}</a>
        <span aria-hidden="true">·</span>
        <a href={lp('/network')}>{t.network}</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .login-shell {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem 1.25rem 4rem;
    background: rgb(var(--color-bg-primary));
    overflow: hidden;
  }
  .login-shell__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        55% 45% at 12% 8%,
        rgb(var(--color-accent) / 0.1),
        transparent 68%
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-bg-secondary) / 0.55),
        transparent 65%
      );
    pointer-events: none;
  }
  .login-shell__inner {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
    width: 100%;
  }
  .login-shell__folio {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
    margin: 0 0 0.85rem;
  }
  .login-shell__folio::before {
    content: '— ';
  }
  .login-shell__kicker {
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
    margin: 0 0 1rem;
  }
  .login-shell__title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 0 1rem;
    color: rgb(var(--color-text-primary));
  }
  .login-shell__lead,
  .login-shell__note {
    margin: 0 0 0.85rem;
    line-height: 1.65;
    color: rgb(var(--color-text-secondary));
  }
  .login-shell__note {
    font-size: 0.95rem;
    color: rgb(var(--color-text-tertiary));
  }
  .login-shell__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 2.5rem;
  }
  .login-shell__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    background: rgb(var(--color-accent));
    border: 1px solid transparent;
    transition: background-color 0.18s ease;
  }
  .login-shell__cta:hover {
    background: rgb(var(--color-accent) / 0.88);
  }
  .login-shell__cta:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  .login-shell__ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 0.35rem;
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    font-size: 0.95rem;
    color: rgb(var(--color-text-secondary));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--color-border) / 0.8);
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .login-shell__ghost:hover,
  .login-shell__ghost:focus-visible {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.55);
  }
  .login-shell__ghost:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  .login-shell__ops h2 {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
    margin: 0 0 0.85rem;
  }
  .login-shell__ops-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(var(--color-border) / 0.7);
  }
  .login-shell__ops-list li {
    border-bottom: 1px solid rgb(var(--color-border) / 0.55);
  }
  .login-shell__ops-list a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.95rem 0.15rem;
    text-decoration: none;
    color: inherit;
  }
  .login-shell__ops-list a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  .login-shell__ops-name {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    transition: color 0.18s ease;
  }
  .login-shell__ops-list a:hover .login-shell__ops-name,
  .login-shell__ops-list a:focus-visible .login-shell__ops-name {
    color: rgb(var(--color-accent));
  }
  .login-shell__foot {
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.9rem;
    color: rgb(var(--color-text-tertiary));
  }
  .login-shell__foot a {
    color: inherit;
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }
  .login-shell__foot a:hover,
  .login-shell__foot a:focus-visible {
    color: rgb(var(--color-accent));
  }
  .login-shell__foot a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .login-shell__cta,
    .login-shell__ghost,
    .login-shell__ops-name,
    .login-shell__foot a {
      transition: none;
    }
  }
</style>
