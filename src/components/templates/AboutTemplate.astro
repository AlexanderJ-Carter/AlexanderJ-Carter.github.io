---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutCopy } from '../../i18n/pages/about';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const t = aboutCopy[lang];
const lp = (path: string) => getLangPath(lang, path);

function resolveHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  return lp(href);
}
---

<BaseLayout title={t.title} description={t.subtitle} protectedPage={true}>
  <header class="pt-28 md:pt-32 pb-10 md:pb-12 border-b border-[rgb(var(--color-border))]">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <a
        href={lp('/')}
        class="inline-flex items-center gap-2 text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-600 dark:hover:text-primary-400 transition-colors mb-8"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t.back}
      </a>

      <p class="folio-mark mb-3">Folio I</p>
      <p
        class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4"
      >
        {t.kicker}
      </p>
      <h1
        class="font-heading text-4xl sm:text-5xl font-bold tracking-tight mb-4"
      >
        Alexander James Carter
      </h1>
      <p
        class="text-lg text-[rgb(var(--color-text-secondary))] leading-relaxed mb-6"
      >
        {t.subtitle}
      </p>
      <ul class="flex flex-wrap items-center gap-x-1 text-sm mb-8">
        {
          t.meta.map((item, i) => (
            <li class="inline-flex items-center text-[rgb(var(--color-text-secondary))]">
              {i > 0 && (
                <span class="mx-2.5 text-[rgb(var(--color-text-tertiary))]" aria-hidden="true">
                  ·
                </span>
              )}
              <span class="font-heading">{item}</span>
            </li>
          ))
        }
      </ul>
      <p
        class="font-serif text-xl italic text-[rgb(var(--color-text-primary))] border-l-2 border-[rgb(var(--color-accent)_/_0.55)] pl-5 mb-8"
      >
        “{t.motto}”
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={lp('/contact')} class="btn-primary">{t.ctaContact}</a>
        <a
          href={t.profileHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          {t.profileLabel} ↗
        </a>
        <a
          href="https://github.com/AlexanderJ-Carter"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          {t.ctaGithub} ↗
        </a>
      </div>
    </div>
  </header>

  <!-- Intro -->
  <section class="py-14 md:py-16">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <p class="folio-mark mb-3">01</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-5">
        {t.introTitle}
      </h2>
      {
        t.paragraphs.map((p) => (
          <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed text-base md:text-lg">
            {p}
          </p>
        ))
      }
    </div>
  </section>

  <!-- Research -->
  <section class="py-14 md:py-16 bg-[rgb(var(--color-bg-secondary))]">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <p class="folio-mark mb-3">02</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3">
        {t.researchTitle}
      </h2>
      <p
        class="font-heading text-lg text-primary-600 dark:text-primary-400 mb-4"
      >
        {t.researchLead}
      </p>
      <p
        class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-8"
      >
        {t.researchBody}
      </p>
      <ul class="space-y-2 text-sm font-heading mb-10">
        <li>
          <a
            href={t.collabHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
          >
            {t.collabLabel} ↗
          </a>
        </li>
        <li>
          <a
            href={t.platformHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
          >
            {t.platformLabel} ↗
          </a>
        </li>
        <li>
          <a
            href={t.relatedPaperHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
          >
            {t.relatedPaperLabel} ↗
          </a>
        </li>
      </ul>

      <article
        class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] p-6 md:p-8"
      >
        <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
          <div>
            <p class="folio-mark mb-2">{t.pubTitle}</p>
            <p class="meta-mono text-[rgb(var(--color-text-tertiary))]">
              {t.pubYear} · {t.pubVenue}
            </p>
          </div>
          <div class="flex gap-3">
            <a
              href={t.pubAbs}
              target="_blank"
              rel="noopener noreferrer"
              class="pub-chip">abs ↗</a
            >
            <a
              href={t.pubPdf}
              target="_blank"
              rel="noopener noreferrer"
              class="pub-chip">pdf ↗</a
            >
          </div>
        </div>
        <h3 class="font-heading text-xl font-semibold leading-snug">
          {t.pubName}
        </h3>
      </article>
    </div>
  </section>

  <!-- Projects + Now -->
  <section class="py-14 md:py-16">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <p class="folio-mark mb-3">03</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3">
        {t.workTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-8 leading-relaxed">
        {t.workIntro}
      </p>

      <div class="folio-directory mb-14">
        {
          t.projects.map((project, i) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="folio-directory-row !items-start sm:!items-baseline"
            >
              <span class="fd-index pt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <span class="fd-title">{project.name}</span>
                <span class="fd-host fd-host-mobile">{project.role}</span>
                <p class="mt-1.5 text-sm text-[rgb(var(--color-text-secondary))]">
                  {project.desc}
                </p>
              </span>
              <span class="fd-host fd-host-desktop pt-1">{project.role}</span>
              <span class="fd-arrow pt-1" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>

      <p class="folio-mark mb-3">04</p>
      <h2 class="font-heading text-2xl font-bold tracking-tight mb-5">
        {t.nowTitle}
      </h2>
      <ol class="border-y border-[rgb(var(--color-border))]">
        {
          t.nowItems.map((item, i) => (
            <li class="flex gap-4 py-4 border-b border-[rgb(var(--color-border))] last:border-0">
              <span class="meta-mono !text-[10px] text-[rgb(var(--color-text-tertiary))] pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed">
                {item}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-14 md:py-16 bg-[rgb(var(--color-bg-secondary))]">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <p class="folio-mark mb-3">05</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3">
        {t.connectTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-8 leading-relaxed">
        {t.connectIntro}
      </p>
      <div class="folio-directory">
        {
          t.links.map((link, i) => (
            <a
              href={resolveHref(link.href)}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="folio-directory-row"
            >
              <span class="fd-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0">
                <span class="fd-title">{link.label}</span>
                <span class="fd-host fd-host-mobile">{link.note}</span>
              </span>
              <span class="fd-host fd-host-desktop">{link.note}</span>
              <span class="fd-arrow" aria-hidden="true">
                {link.external || link.href.startsWith('mailto:') ? '↗' : '→'}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pub-chip {
    width: fit-content;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    color: rgb(var(--color-text-secondary));
    padding: 0.35rem 0.65rem;
    font-size: 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    letter-spacing: 0.04em;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .pub-chip:hover {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.45);
  }
</style>
