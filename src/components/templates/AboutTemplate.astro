---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutCopy } from '../../i18n/pages/about';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const t = aboutCopy[lang];
const p = t.personal;
const lp = (path: string) => getLangPath(lang, path);

function resolveHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  return lp(href);
}

const publications = [
  {
    title: t.pubName,
    venue: `${t.pubYear} · ${t.pubVenue}`,
    href: t.pubAbs,
    pdf: t.pubPdf,
  },
  {
    title:
      'Grounding LLM Agent Intent in Multi-Module Environments with Executable Action Programs',
    venue: '2026 · EMNLP',
    href: 'https://openreview.net/forum?id=c9mKOXi2zV',
    pdf: 'https://fi.ee.tsinghua.edu.cn/public/publications/2e874c1a-a032-11f1-8112-4eb6c6416b98.pdf',
  },
];

const researchAreaNotes: Record<typeof lang, string[]> = {
  'zh-CN': [
    '让智能体理解目标、调用工具，并在环境中可靠行动。',
    '研究多个智能体之间的协作、互动与涌现行为。',
    '用可运行的模拟与实验方法研究社会科学问题。',
  ],
  'zh-TW': [
    '讓智能體理解目標、呼叫工具，並在環境中可靠行動。',
    '研究多個智能體之間的協作、互動與湧現行為。',
    '用可運行的模擬與實驗方法研究社會科學問題。',
  ],
  'en-GB': [
    'Agents that interpret goals, use tools and act reliably in environments.',
    'Coordination, interaction and emergent behaviour across agents.',
    'Runnable simulations and experiments for social-science questions.',
  ],
  fr: [
    'Des agents capables de comprendre un but, utiliser des outils et agir.',
    'Coordination, interaction et comportements émergents entre agents.',
    'Simulations et expériences exécutables pour les sciences sociales.',
  ],
  ru: [
    'Агенты, понимающие цели, использующие инструменты и действующие в среде.',
    'Координация, взаимодействие и возникающее поведение нескольких агентов.',
    'Исполняемые симуляции и эксперименты для социальных наук.',
  ],
};
---

<BaseLayout title={t.title} description={t.subtitle} protectedPage={true}>
  <header class="pt-28 md:pt-32 pb-0">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <a
        href={lp('/')}
        class="inline-flex items-center gap-2 text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-600 dark:hover:text-primary-400 transition-colors mb-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t.back}
      </a>

      <div class="max-w-3xl">
        <div>
          <p
            class="font-heading text-sm tracking-[0.2em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4"
          >
            {t.kicker}
          </p>
          <h1
            class="font-heading text-4xl sm:text-5xl md:text-[3.25rem] font-bold tracking-tight mb-5 text-balance"
          >
            {t.displayName}
          </h1>
          <p
            class="text-lg md:text-xl text-[rgb(var(--color-text-secondary))] leading-relaxed mb-8 max-w-2xl"
          >
            {t.subtitle}
          </p>

          <dl class="flex flex-wrap gap-x-5 gap-y-2 mb-10 text-sm">
            {
              t.meta.map((item) => (
                <div>
                  <dt class="sr-only">{item}</dt>
                  <dd class="font-heading font-semibold tracking-wide text-[rgb(var(--color-text-secondary))]">
                    {item}
                  </dd>
                </div>
              ))
            }
          </dl>

          <nav
            class="flex flex-wrap gap-x-5 gap-y-3 pb-4 lg:pb-12"
            aria-label={t.connectTitle}
          >
            {
              t.links.map((link) => (
                <a
                  href={resolveHref(link.href)}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="profile-link"
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div class="film-edge mt-10 md:mt-0" aria-hidden="true"></div>

  <!-- Line of work -->
  <section class="py-14 md:py-16 section-seam">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="max-w-3xl">
        <p class="folio-mark mb-3">01 · About</p>
        <h2
          class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-6"
        >
          {t.introTitle}
        </h2>
        {
          t.paragraphs.map((para) => (
            <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed text-base md:text-lg max-w-2xl">
              {para}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Research -->
  <section
    class="py-14 md:py-16 bg-[rgb(var(--color-bg-secondary))] section-tint"
  >
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="max-w-3xl">
        <p class="folio-mark mb-3">02 · Research</p>
        <h2
          class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
        >
          {t.researchTitle}
        </h2>
        <p
          class="font-heading text-lg md:text-xl text-primary-600 dark:text-primary-400 mb-4"
        >
          {t.researchLead}
        </p>
        <p
          class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-8 max-w-2xl"
        >
          {t.researchBody}
        </p>
      </div>

      <ul class="research-focus-grid max-w-4xl">
        {
          p.interests.slice(0, 3).map((item, i) => (
            <li class="research-focus-card">
              <span class="meta-mono text-[rgb(var(--color-text-tertiary))]">
                0{i + 1}
              </span>
              <span class="font-heading font-semibold">{item}</span>
              <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed">
                {researchAreaNotes[lang][i]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="py-14 md:py-16 section-seam">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="max-w-3xl mb-8">
        <p class="folio-mark mb-3">03 · Selected work</p>
        <h2
          class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
        >
          {t.workTitle}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
          {t.workIntro}
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 max-w-4xl">
        {
          t.projects.map((project, i) => (
            <article class="work-card">
              <div class="flex items-start justify-between gap-4 mb-8">
                <span class="meta-mono text-[rgb(var(--color-text-tertiary))]">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-xs text-[rgb(var(--color-text-tertiary))]">
                  {project.role}
                </span>
              </div>
              <h3
                class={`font-heading text-xl font-semibold${project.desc ? ' mb-3' : ''}`}
              >
                {project.href ? (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                  >
                    {project.name} ↗
                  </a>
                ) : (
                  project.name
                )}
              </h3>
              {project.desc ? (
                <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed">
                  {project.desc}
                </p>
              ) : null}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Publications -->
  <section
    class="py-14 md:py-16 bg-[rgb(var(--color-bg-secondary))] section-tint"
  >
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="max-w-3xl mb-8">
        <p class="folio-mark mb-3">04 · Publications</p>
        <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight">
          {t.pubTitle}
        </h2>
      </div>
      <div class="space-y-4 max-w-4xl">
        {
          publications.map((publication, i) => (
            <article class="publication-row">
              <span class="meta-mono text-[rgb(var(--color-text-tertiary))]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <p class="meta-mono text-[rgb(var(--color-text-tertiary))] mb-2">
                  {publication.venue}
                </p>
                <h3 class="font-heading text-lg md:text-xl font-semibold leading-snug">
                  {publication.title}
                </h3>
              </div>
              <div class="flex gap-2 col-start-2 md:col-start-auto">
                <a
                  href={publication.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pub-chip"
                >
                  page ↗
                </a>
                <a
                  href={publication.pdf}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pub-chip"
                >
                  pdf ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Personal details -->
  <section class="py-14 md:py-16 section-seam" aria-labelledby="personal-title">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="max-w-3xl mb-8">
        <p class="folio-mark mb-3">05 · Beyond research</p>
        <h2
          id="personal-title"
          class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
        >
          {p.sectionTitle}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
          {p.sectionLead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-[1.25fr_1fr] max-w-4xl">
        <div>
          <p class="folio-mark mb-3">{p.educationLabel}</p>
          <ul class="space-y-2">
            {
              p.education.map((item) => (
                <li class="text-[rgb(var(--color-text-secondary))] leading-relaxed pl-3 border-l-2 border-[rgb(var(--color-accent)_/_0.35)]">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="folio-mark mb-3">{p.interestsLabel}</p>
          <ul class="flex flex-wrap gap-2">
            {
              p.interests
                .slice(3)
                .map((item) => <li class="interest-chip">{item}</li>)
            }
          </ul>
        </div>
      </div>
      <div
        class="mt-12 pt-8 border-t border-[rgb(var(--color-border))] max-w-4xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5"
      >
        <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
          {t.connectIntro}
        </p>
        <a href={lp('/contact')} class="btn-secondary shrink-0">
          {t.ctaContact} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--color-text-secondary));
    border-bottom: 1px solid rgb(var(--color-border));
    padding-bottom: 0.2rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .profile-link:hover {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.55);
  }

  .research-focus-grid {
    display: grid;
    gap: 1px;
    background: rgb(var(--color-border));
    border: 1px solid rgb(var(--color-border));
  }

  .research-focus-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 8.5rem;
    padding: 1.25rem;
    background: rgb(var(--color-bg-primary));
  }

  .work-card {
    min-height: 15rem;
    padding: 1.5rem;
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-bg-primary));
  }

  .publication-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem 0;
    border-top: 1px solid rgb(var(--color-border));
  }

  .interest-chip {
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    color: rgb(var(--color-text-secondary));
  }

  @media (min-width: 768px) {
    .research-focus-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .publication-row {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  .pub-chip {
    width: fit-content;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    color: rgb(var(--color-text-secondary));
    padding: 0.35rem 0.65rem;
    font-size: 0.7rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .pub-chip:hover {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.45);
    background: rgb(var(--color-bg-secondary) / 0.5);
  }
</style>
