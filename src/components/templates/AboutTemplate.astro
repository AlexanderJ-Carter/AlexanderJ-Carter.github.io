                class="radar-polygon"
                points={skills
                  .map((skill, i) => {
                    const angle =
                      (Math.PI * 2 * i) / skills.length - Math.PI / 2;
                    const r = (skill.level / 100) * 160;
                    return `${200 + Math.cos(angle) * r},${200 + Math.sin(angle) * r}`;
