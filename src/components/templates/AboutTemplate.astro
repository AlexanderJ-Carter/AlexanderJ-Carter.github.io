---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { aboutCopy } from '../../i18n/pages/about';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const t = aboutCopy[lang];
const lp = (path: string) => getLangPath(lang, path);

function resolveHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  return lp(href);
}
---

<BaseLayout
  title={`${t.title} — Alexander Carter`}
  description={t.subtitle}
  protectedPage={true}
>
  <PageHero
    kicker={t.kicker}
    title="Alexander James Carter"
    description={t.subtitle}
    backHref={lp('/')}
    backLabel={t.back}
  >
    <p
      class="mt-6 max-w-2xl font-serif text-xl md:text-2xl italic text-[rgb(var(--color-text-primary))] leading-snug"
    >
      “{t.motto}”
    </p>
  </PageHero>

  <section class="pb-8">
    <div class="page-shell">
      <ul
        class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[rgb(var(--color-text-secondary))]"
      >
        {
          t.meta.map((item, i) => (
            <li class="inline-flex items-center gap-3">
              {i > 0 && (
                <span
                  aria-hidden="true"
                  class="text-[rgb(var(--color-text-tertiary))]"
                >
                  ·
                </span>
              )}
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Intro -->
  <section class="pb-16 md:pb-20">
    <div class="page-shell">
      <article class="about-panel">
        <h2
          class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-6"
        >
          {t.introTitle}
        </h2>
        <div
          class="space-y-5 text-[15px] md:text-base leading-relaxed text-[rgb(var(--color-text-secondary))]"
        >
          {t.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </article>
    </div>
  </section>

  <!-- Research + Now -->
  <section class="pb-16 md:pb-20 bg-[rgb(var(--color-bg-secondary))]">
    <div class="page-shell py-16 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h2
            class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
          >
            {t.researchTitle}
          </h2>
          <p
            class="font-heading text-lg text-primary-600 dark:text-primary-400 mb-4"
          >
            {t.researchLead}
          </p>
          <p
            class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-6"
          >
            {t.researchBody}
          </p>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-heading">
            <a
              href={t.collabHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
            >
              {t.collabLabel}
            </a>
            <a
              href={t.platformHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
            >
              {t.platformLabel}
            </a>
          </div>

          <div class="mt-10 pt-8 border-t border-[rgb(var(--color-border))]">
            <h3
              class="font-heading text-sm tracking-[0.14em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4"
            >
              {t.pubTitle}
            </h3>
            <p
              class="text-xs text-[rgb(var(--color-text-tertiary))] mb-2 font-heading"
            >
              {t.pubYear} · {t.pubVenue}
            </p>
            <p
              class="font-heading font-semibold text-[rgb(var(--color-text-primary))] mb-3 leading-snug"
            >
              {t.pubName}
            </p>
            <div class="flex gap-4 text-sm">
              <a
                href={t.pubAbs}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
              >
                abs
              </a>
              <a
                href={t.pubPdf}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
              >
                pdf
              </a>
            </div>
          </div>
        </div>

        <aside class="about-panel h-fit">
          <h2 class="font-heading text-xl font-bold tracking-tight mb-5">
            {t.nowTitle}
          </h2>
          <ul class="space-y-4">
            {
              t.nowItems.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]">
                  <span
                    class="mt-2 h-1.5 w-1.5 rounded-full bg-primary-500 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="pb-16 md:pb-20">
    <div class="page-shell">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
      >
        {t.workTitle}
      </h2>
      <p
        class="text-[rgb(var(--color-text-secondary))] mb-10 leading-relaxed max-w-2xl"
      >
        {t.workIntro}
      </p>

      <ul
        class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))]"
      >
        {
          t.projects.map((project) => (
            <li>
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group block py-6 list-row focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-8">
                  <div class="sm:min-w-[14rem]">
                    <h3 class="font-heading text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                      {project.name}
                    </h3>
                    <p class="text-xs uppercase tracking-wide text-[rgb(var(--color-text-tertiary))] font-heading mt-1">
                      {project.role}
                    </p>
                  </div>
                  <p class="text-sm text-[rgb(var(--color-text-secondary))] leading-relaxed flex-1">
                    {project.desc}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Stack + Languages -->
  <section class="pb-16 md:pb-20 bg-[rgb(var(--color-bg-secondary))]">
    <div class="page-shell py-16 md:py-20">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2
            class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-8"
          >
            {t.stackTitle}
          </h2>
          <div class="space-y-8">
            {
              t.stackGroups.map((group) => (
                <div>
                  <h3 class="font-heading text-sm tracking-[0.14em] uppercase text-[rgb(var(--color-text-tertiary))] mb-3">
                    {group.title}
                  </h3>
                  <ul class="flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <li class="about-chip">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <h2
            class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-8"
          >
            {t.langsTitle}
          </h2>
          <ul
            class="divide-y divide-[rgb(var(--color-border))] border-y border-[rgb(var(--color-border))]"
          >
            {
              t.langs.map((item) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span class="font-heading font-semibold">{item.name}</span>
                  <span class="text-sm text-[rgb(var(--color-text-tertiary))]">
                    {item.level}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <section class="pb-20 md:pb-28">
    <div class="page-shell">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold tracking-tight mb-3"
      >
        {t.connectTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] mb-10 leading-relaxed">
        {t.connectIntro}
      </p>

      <ul
        class="grid sm:grid-cols-2 gap-px bg-[rgb(var(--color-border))] border border-[rgb(var(--color-border))]"
      >
        {
          t.links.map((link) => (
            <li class="bg-[rgb(var(--color-bg-primary))]">
              <a
                href={resolveHref(link.href)}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="block p-5 list-row focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
              >
                <div class="font-heading font-semibold mb-1">{link.label}</div>
                <div class="text-sm text-[rgb(var(--color-text-secondary))]">
                  {link.note}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-panel {
    border: 1px solid rgb(var(--color-border));
    background: linear-gradient(
      165deg,
      rgb(var(--color-bg-primary)) 0%,
      rgb(var(--color-bg-secondary) / 0.55) 100%
    );
    padding: 2rem;
    box-shadow: 0 1px 0 rgb(var(--color-border) / 0.5);
  }

  @media (min-width: 768px) {
    .about-panel {
      padding: 2.75rem 3rem;
    }
  }

  .about-chip {
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-bg-primary));
    color: rgb(var(--color-text-secondary));
    font-size: 0.8125rem;
    line-height: 1.2;
    padding: 0.4rem 0.7rem;
    font-family: theme('fontFamily.heading');
  }
</style>
