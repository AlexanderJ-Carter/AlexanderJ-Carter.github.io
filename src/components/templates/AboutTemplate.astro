---

<BaseLayout
  title={t('about.title') + ' | Alexander James Carter'}
  description={lang === 'zh-CN'
    ? '了解更多关于我的经历、技能和故事'
    : 'Learn more about my experience, skills and story'}
  protectedPage={true}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-mesh-gradient">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Avatar -->
        <div class="mb-8 inline-block">
          <div
            class="w-32 h-32 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 p-1"
          >
            <div
              class="w-full h-full rounded-full bg-[rgb(var(--color-bg-primary))] flex items-center justify-center text-6xl"
            >
              👨‍💻
            </div>
          </div>
        </div>

        <h1 class="text-5xl md:text-6xl font-display font-bold mb-6">
          <span class="gradient-text">Alexander James Carter</span>
        </h1>

        <p class="text-xl text-[rgb(var(--color-text-secondary))] mb-8">
          {t('about.subtitle')}
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-8">
          <span
            class="px-4 py-2 rounded-full bg-primary-500/10 text-primary-500 font-medium hover:scale-105 transition-transform cursor-default"
            >{t('about.age')}</span
          >
          <span
            class="px-4 py-2 rounded-full bg-accent-500/10 text-accent-500 font-medium hover:scale-105 transition-transform cursor-default"
            >{t('about.location')}</span
          >
          <span
            class="px-4 py-2 rounded-full bg-green-500/10 text-green-500 font-medium hover:scale-105 transition-transform cursor-default"
            >{t('about.status')}</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Bio Section -->
  <section class="py-16 container mx-auto px-4 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <!-- Bio Section -->
      <div class="glass-card p-8 md:p-12 mb-12" data-aos="fade-up">
        <h2
          class="text-3xl font-display font-bold mb-6 flex items-center gap-3"
        >
          <span class="text-4xl">👋</span>
          {t('about.bio')}
        </h2>
        <div
          class="prose prose-lg max-w-none text-[rgb(var(--color-text-secondary))]"
        >
          <p class="mb-4 leading-relaxed">
            {t('about.bio.text1')}
            <strong>Alexander James Carter</strong>{t('about.bio.text2')}<strong
              >{t('about.bio.text3')}</strong
            >{t('about.bio.text4')}
          </p>
          <p class="mb-4 leading-relaxed">
