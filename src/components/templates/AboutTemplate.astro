<style>
  .skill-item-enhanced {
    padding: 1.25rem;
    background: rgb(var(--color-bg-primary));
    border-radius: 0.75rem;
    transition: all 0.3s ease;
  }

  .skill-item-enhanced:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(var(--color-primary-rgb), 0.15);
  }

  [data-aos] {
    opacity: 0;
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-aos].aos-animate {
    opacity: 1;
  }

  [data-aos='fade-up'] {
    transform: translateY(30px);
  }

  [data-aos='fade-up'].aos-animate {
    transform: translateY(0);
  }

  /* Radar chart animation */
  .radar-polygon {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    transition:
      stroke-dashoffset 1.5s ease-out,
      opacity 1s ease-out;
  }

  .skill-radar.radar-visible .radar-polygon {
    stroke-dashoffset: 0;
    opacity: 0.7;
  }

  .radar-dot {
    opacity: 0;
    transform-origin: center;
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
    transform: scale(0);
  }

  .skill-radar.radar-visible .radar-dot {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  // Animate skill bars on scroll
  const observeSkillBars = () => {
    const skillBars = document.querySelectorAll('.skill-bar');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const bar = entry.target as HTMLElement;
            const targetWidth = bar.getAttribute('data-width');
            if (targetWidth) {
              setTimeout(() => {
                bar.style.width = `${targetWidth}%`;
              }, 100);
            }
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );

    skillBars.forEach((bar) => observer.observe(bar));
  };

  // Simple AOS (Animate On Scroll) implementation
  const initAOS = () => {
    const elements = document.querySelectorAll('[data-aos]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('aos-animate');
          }
        });
      },
      { threshold: 0.1 }
    );

    elements.forEach((el) => observer.observe(el));
  };

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      observeSkillBars();
      initAOS();
      observeRadar();
    });
  } else {
    observeSkillBars();
    initAOS();
    observeRadar();
  }

  // Animate radar chart on scroll
  function observeRadar() {
    const radar = document.querySelector('.skill-radar');
    if (!radar) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            radar.classList.add('radar-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(radar);
  }
</script>
