const content = termsData[lang as Lang] || termsData['en-GB'];
const tocTitle =
  lang === 'zh-CN' ? '目录导航' : lang === 'zh-TW' ? '目錄導航' : lang === 'fr' ? 'Sommaire' : lang === 'ru' ? 'Содержание' : 'Contents';
---

<BaseLayout title={`${content.title} - Alexander Carter`} showFooter={false}>
  <section class="pt-32 pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <!-- Back Button -->
      <a
        href={getLangPath('/')}
        class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>{content.back}</span>
      </a>

      <!-- Header -->
      <div class="text-center mb-10">
        <div
          class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 text-white text-2xl mb-6"
        >
          📋
        </div>
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-3">
          {content.headerTitle}
        </h1>
        <p class="text-sm text-[rgb(var(--color-text-tertiary))]">
          {content.lastUpdated}
        </p>
      </div>

      <!-- Legal nav -->
      <nav
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs sm:text-sm text-[rgb(var(--color-text-secondary))] mb-10"
        aria-label={lang === 'zh-CN' || lang === 'zh-TW'
          ? '法律与政策导航'
          : 'Legal & policy navigation'}
      >
        <a
          href={getLangPath('/privacy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '隐私政策'
              : lang === 'zh-TW'
                ? '隱私權政策'
                : 'Privacy'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/terms')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '服务条款'
              : lang === 'zh-TW'
                ? '服務條款'
                : 'Terms'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/license')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '许可证'
              : lang === 'zh-TW'
                ? '許可證'
                : 'License'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/accessibility')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '无障碍'
              : lang === 'zh-TW'
                ? '無障礙'
                : 'Accessibility'
          }
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={getLangPath('/security/policy')}
          class="link-underline hover:text-primary-500"
        >
          {
            lang === 'zh-CN'
              ? '安全政策'
              : lang === 'zh-TW'
                ? '安全政策'
                : 'Security'
          }
        </a>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <aside class="lg:w-1/4">
          <div class="sticky top-24 glass-card p-5 rounded-xl">
            <h2 class="text-sm uppercase tracking-wide font-semibold text-[rgb(var(--color-text-tertiary))] mb-3">{tocTitle}</h2>
            <nav class="space-y-1.5">
              {content.sections.map((section: any, i: number) => (
                <a href={`#section-${i + 1}`} data-target={`section-${i + 1}`} class="toc-link block text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors rounded px-2 py-1">
                  {section.title}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- Content -->
        <div class="lg:w-3/4 glass-card p-8 md:p-12 space-y-8">
          {
            content.sections.map((section: any, i: number) => (
              <section id={`section-${i + 1}`} class="scroll-mt-28 space-y-4">
                <h2 class="text-2xl font-bold text-[rgb(var(--color-text-primary))]">
                  {section.title}
                </h2>
                <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
                  {section.content}
                </p>
                {section.list && (
                  <ul class="list-disc list-inside space-y-2 ml-4">
                    {section.list.map((item: string) => (
                      <li class="text-[rgb(var(--color-text-secondary))]">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const links = Array.from(document.querySelectorAll('.toc-link'));
    const sections = Array.from(document.querySelectorAll('section[id^="section-"]'));
    if (!links.length || !sections.length) return;
    const map = new Map(links.map((l) => [l.getAttribute('data-target'), l]));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => l.classList.remove('bg-primary-500/10', 'text-primary-500', 'font-semibold'));
          const id = entry.target.getAttribute('id');
          const active = id ? map.get(id) : null;
          active?.classList.add('bg-primary-500/10', 'text-primary-500', 'font-semibold');
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: [0.1, 0.3] }
    );
    sections.forEach((s) => observer.observe(s));
  })();
</script>
