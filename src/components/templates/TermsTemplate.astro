---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import termsData from '../../i18n/pages/terms';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const content = termsData[lang];
const lp = (path: string) => getLangPath(lang, path);

const tocTitle = {
  'zh-CN': '目录导航',
  'zh-TW': '目錄導航',
  'en-GB': 'Contents',
  fr: 'Sommaire',
  ru: 'Содержание',
}[lang];

const legalNav = {
  'zh-CN': {
    label: '法律与政策导航',
    privacy: '隐私政策',
    terms: '服务条款',
    license: '许可证',
    accessibility: '无障碍',
    security: '安全政策',
  },
  'zh-TW': {
    label: '法律與政策導航',
    privacy: '隱私權政策',
    terms: '服務條款',
    license: '許可證',
    accessibility: '無障礙',
    security: '安全政策',
  },
  'en-GB': {
    label: 'Legal and policy navigation',
    privacy: 'Privacy',
    terms: 'Terms',
    license: 'Licence',
    accessibility: 'Accessibility',
    security: 'Security',
  },
  fr: {
    label: 'Navigation juridique',
    privacy: 'Confidentialité',
    terms: 'Conditions',
    license: 'Licence',
    accessibility: 'Accessibilité',
    security: 'Sécurité',
  },
  ru: {
    label: 'Юридическая навигация',
    privacy: 'Конфиденциальность',
    terms: 'Условия',
    license: 'Лицензия',
    accessibility: 'Доступность',
    security: 'Безопасность',
  },
}[lang];

const links = [
  { label: legalNav.privacy, href: lp('/privacy') },
  { label: legalNav.terms, href: lp('/terms') },
  { label: legalNav.license, href: lp('/license') },
  { label: legalNav.accessibility, href: lp('/accessibility') },
  { label: legalNav.security, href: lp('/security/policy') },
];
---

<BaseLayout title={content.title}>
  <div class="container mx-auto px-4 lg:px-8 max-w-3xl pt-28 md:pt-32">
    <a
      href={lp('/')}
      class="inline-flex items-center gap-2 text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors mb-8"
    >
      <span aria-hidden="true">←</span>
      <span>{content.back}</span>
    </a>
  </div>

  <PageHero
    class="!pt-0"
    folio="Folio Legal"
    title={content.headerTitle}
    note={content.lastUpdated}
  />

  <section class="pb-16 min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <nav
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs sm:text-sm text-[rgb(var(--color-text-secondary))] mb-10"
        aria-label={legalNav.label}
      >
        {
          links.map((link, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a href={link.href} class="link-underline hover:text-primary-500">
                {link.label}
              </a>
            </>
          ))
        }
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <aside class="lg:w-1/4">
          <div class="sticky top-24 glass-card p-5">
            <h2
              class="text-sm uppercase tracking-wide font-semibold text-[rgb(var(--color-text-tertiary))] mb-3"
            >
              {tocTitle}
            </h2>
            <nav class="space-y-1.5">
              {
                content.sections.map((section, index) => (
                  <a
                    href={`#section-${index + 1}`}
                    class="block text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors rounded px-2 py-1"
                  >
                    {section.title}
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>

        <div class="lg:w-3/4 glass-card p-8 md:p-12 space-y-8">
          {
            content.sections.map((section, index) => (
              <section
                id={`section-${index + 1}`}
                class="scroll-mt-28 space-y-4"
              >
                <h2 class="text-2xl font-bold text-[rgb(var(--color-text-primary))]">
                  {section.title}
                </h2>
                <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed">
                  {section.content}
                </p>
                {section.list && (
                  <ul class="list-disc list-inside space-y-2 ml-4">
                    {section.list.map((item: string) => (
                      <li class="text-[rgb(var(--color-text-secondary))]">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
