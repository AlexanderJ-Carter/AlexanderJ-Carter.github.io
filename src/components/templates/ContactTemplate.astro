const content = contactData[lang as Lang] || contactData['en-US'];
---

<BaseLayout
  title={content.title}
  description={content.description}
  protectedPage={true}
>
  <main class="min-h-screen py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <button
        onclick="history.back()"
        class="mb-8 text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-accent))] transition-colors flex items-center gap-2"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {content.back}
      </button>

      <!-- Header -->
      <div class="text-center mb-16">
        <h1
          class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent"
        >
          {content.headerTitle}
        </h1>
        <p
          class="text-xl text-[rgb(var(--color-text-secondary))] max-w-2xl mx-auto"
        >
          {content.headerDesc}
        </p>
      </div>

      <!-- Contact Info Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <!-- Email -->
        <div
          class="glass-card rounded-xl p-6 text-center hover:shadow-lg transition-all"
        >
          <div
            class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-primary-500 to-accent-500 rounded-full flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {content.email}
          </h3>
          <a
            href="mailto:contact-us@alexander.xin"
            class="text-[rgb(var(--color-accent))] hover:underline"
          >
            contact-us@alexander.xin
          </a>
        </div>

        <!-- Location -->
        <div
          class="glass-card rounded-xl p-6 text-center hover:shadow-lg transition-all"
        >
          <div
            class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-primary-500 to-accent-500 rounded-full flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            {content.location}
          </h3>
          <p class="text-[rgb(var(--color-text-secondary))]">
            {content.locationValue}
          </p>
        </div>

        <!-- Social -->
        <div
          class="glass-card rounded-xl p-6 text-center hover:shadow-lg transition-all"
        >
          <div
            class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-primary-500 to-accent-500 rounded-full flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold mb-2 text-[rgb(var(--color-text-primary))]"
          >
            GitHub
          </h3>
          <a
            href="https://github.com/AlexanderJ-Carter"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[rgb(var(--color-accent))] hover:underline"
          >
            @AlexanderJ-Carter
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="mt-12 text-center">
        <p class="text-[rgb(var(--color-text-secondary))] mb-6">
          {content.quickLinks}
        </p>
        <div class="flex gap-4 justify-center">
          <a
            href="https://github.com/AlexanderJ-Carter"
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-[rgb(var(--color-bg-secondary))] hover:bg-primary-500 text-[rgb(var(--color-text-primary))] hover:text-white transition-all"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="mailto:contact-us@alexander.xin"
            class="p-3 rounded-full bg-[rgb(var(--color-bg-secondary))] hover:bg-primary-500 text-[rgb(var(--color-text-primary))] hover:text-white transition-all"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
