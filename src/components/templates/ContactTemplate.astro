---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import SiteHelpAsk from '../chrome/SiteHelpAsk.astro';
import { supportCopy } from '../../i18n/pages/support';
import { contactData } from '../../i18n/pages/contact';
import { resolveLang } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);

type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const content = contactData[lang as Lang] || contactData['en-GB'];
const collaboration = supportCopy[lang as Lang] || supportCopy['en-GB'];
---

<BaseLayout
  title={content.title}
  description={content.description}
  protectedPage={true}
>
  <PageHero
    folio="Folio Contact"
    kicker="Contact"
    title={content.headerTitle}
    description={content.headerDesc}
  />

  <section class="pb-20 md:pb-28">
    <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
      <!-- Contact Info -->
      <dl
        class="border-y border-[rgb(var(--color-border))] divide-y divide-[rgb(var(--color-border))] mb-12"
      >
        <div
          class="py-5 grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-1 sm:gap-6"
        >
          <dt
            class="font-heading text-sm font-semibold text-[rgb(var(--color-text-primary))]"
          >
            {content.email}
          </dt>
          <dd>
            <a
              href="mailto:contact-us@alexander.xin"
              class="link-underline text-primary-500 hover:text-primary-600"
            >
              contact-us@alexander.xin
            </a>
          </dd>
        </div>
        <div
          class="py-5 grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-1 sm:gap-6"
        >
          <dt
            class="font-heading text-sm font-semibold text-[rgb(var(--color-text-primary))]"
          >
            {content.location}
          </dt>
          <dd class="text-[rgb(var(--color-text-secondary))]">
            {content.locationValue}
          </dd>
        </div>
        <div
          class="py-5 grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-1 sm:gap-6"
        >
          <dt
            class="font-heading text-sm font-semibold text-[rgb(var(--color-text-primary))]"
          >
            GitHub
          </dt>
          <dd>
            <a
              href="https://github.com/AlexanderJ-Carter"
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline text-primary-500 hover:text-primary-600"
            >
              @AlexanderJ-Carter
            </a>
          </dd>
        </div>
      </dl>

      <div class="mb-12">
        <SiteHelpAsk lang={lang} context="contact" />
      </div>

      <section class="border-t border-[rgb(var(--color-border))] pt-8 mb-12">
        <h2
          class="font-heading text-xl md:text-2xl font-bold tracking-tight mb-3"
        >
          {collaboration.collabTitle}
        </h2>
        <p class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-5">
          {collaboration.collabBody}
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            collaboration.collabTypes.map((item) => (
              <li class="border border-[rgb(var(--color-border))] px-3 py-1 text-xs text-[rgb(var(--color-text-secondary))]">
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Contact Form -->
      <div class="border border-[rgb(var(--color-border))] p-6 md:p-8 mb-12">
        <h2
          class="text-2xl font-heading font-bold mb-6 text-[rgb(var(--color-text-primary))]"
        >
          {content.formTitle}
        </h2>

        <form id="contact-form" class="space-y-5" novalidate>
          <div class="form-field">
            <label for="contact-name">{content.nameLabel}</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              minlength="2"
              maxlength="80"
              placeholder={content.namePlaceholder}
              autocomplete="name"
            />
          </div>

          <div class="form-field">
            <label for="contact-email">{content.emailLabel}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              maxlength="120"
              placeholder="you@example.com"
              autocomplete="email"
            />
          </div>

          <div class="form-field">
            <label for="contact-subject">{content.subjectLabel}</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              required
              minlength="4"
              maxlength="120"
              placeholder={content.subjectPlaceholder}
            />
          </div>

          <div class="form-field">
            <label for="contact-message">{content.messageLabel}</label>
            <textarea
              id="contact-message"
              name="message"
              required
              minlength="10"
              maxlength="2000"
              rows="6"
              placeholder={content.messagePlaceholder}></textarea>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary !px-6 !py-3"
              >{content.submit}</button
            >
            <p
              id="contact-submit-feedback"
              class="hidden text-sm text-emerald-600 dark:text-emerald-400"
              role="status"
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <!-- Quick Links -->
      <div class="mt-12">
        <p class="text-[rgb(var(--color-text-secondary))] mb-4">
          {content.quickLinks}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/AlexanderJ-Carter"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline text-primary-500 hover:text-primary-600 text-sm font-medium"
          >
            GitHub
          </a>
          <a
            href="mailto:contact-us@alexander.xin"
            class="link-underline text-primary-500 hover:text-primary-600 text-sm font-medium"
          >
            contact-us@alexander.xin
          </a>
          <a
            href={getLangPath('/help')}
            class="link-underline text-primary-500 hover:text-primary-600 text-sm font-medium"
          >
            {content.helpHint}
            {content.helpLink}
          </a>
        </div>
      </div>

      <!-- Contact notice (privacy & terms) -->
      {
        content.contactNotice && (
          <p class="mt-10 text-sm text-[rgb(var(--color-text-tertiary))] border-t border-[rgb(var(--color-border))] pt-6">
            {content.contactNotice}
          </p>
        )
      }

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-[rgb(var(--color-border))]">
        <a
          href={getLangPath('/')}
          class="link-underline text-primary-500 hover:text-primary-600 font-medium text-sm inline-flex items-center gap-1"
        >
          ← {content.back}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ lang, successText: content.success }} is:inline>
  const contactForm = document.getElementById('contact-form');
  const submitFeedback = document.getElementById('contact-submit-feedback');

  function getInvalidMessage(currentLang) {
    if (currentLang === 'zh-CN') return '请先完善表单信息后再发送。';
    if (currentLang === 'zh-TW') return '請先完善表單資訊後再傳送。';
    if (currentLang === 'fr')
      return "Veuillez d'abord compléter le formulaire.";
    if (currentLang === 'ru')
      return 'Пожалуйста, сначала заполните форму корректно.';
    return 'Please complete the form before sending.';
  }

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      window.showToast?.({
        message: getInvalidMessage(lang),
        type: 'warning',
      });
      return;
    }

    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const subject = String(formData.get('subject') || '').trim();
    const message = String(formData.get('message') || '').trim();

    const mailBody = [`Name: ${name}`, `Email: ${email}`, '', message].join(
      '\n'
    );

    const mailtoUrl = `mailto:contact-us@alexander.xin?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mailBody)}`;

    if (submitFeedback) {
      submitFeedback.textContent = successText;
      submitFeedback.classList.remove('hidden');
    }

    window.showToast?.({ message: successText, type: 'success' });
    window.location.href = mailtoUrl;
    form.reset();
  });
</script>
