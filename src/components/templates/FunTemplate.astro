        <article
          class="glass-card p-6 md:p-8 reveal"
        >
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {text.breathingTitle}
            </h2>
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {text.breathingDesc}
