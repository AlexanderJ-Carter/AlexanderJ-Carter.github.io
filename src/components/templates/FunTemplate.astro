    'Tidy your desk for 5 minutes',
    'Write 3 goals for today',
    'Drink water and do a quick stretch',
    'Delete 5 useless files',
    'Read one page and keep one quote',
  ],
  fr: [
    'Rangez votre bureau 5 minutes',
    "Notez 3 objectifs d'aujourd'hui",
    'Buvez de l’eau et étirez-vous',
    'Supprimez 5 fichiers inutiles',
    'Lisez une page et retenez une phrase',
  ],
  ru: [
    'Уберите стол 5 минут',
    'Запишите 3 цели на сегодня',
    'Выпейте воду и потянитесь',
    'Удалите 5 ненужных файлов',
    'Прочитайте 1 страницу и запишите мысль',
  ],
