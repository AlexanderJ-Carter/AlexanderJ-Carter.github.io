// 服务端随机选一张图（构建时固定，刷新页面会变）
const randomIndex = Math.floor(Math.random() * galleryImages.length);
const randomImage = galleryImages[randomIndex];
const imageTitle =
  lang === 'zh-CN' || lang === 'zh-TW' ? randomImage.zh : randomImage.en;
const galleryPath =
  lang === 'zh-CN' ? '/gallery' : `/${lang === 'en-GB' ? 'en' : lang}/gallery`;
---

<BaseLayout title={text.title} description={text.subtitle}>
  <PageHero
    folio="Folio Play"
    kicker="Play"
    title={text.title}
    description={lang === 'zh-CN'
      ? '小游戏、每日灵感与隐藏惊喜——玩一玩再走。'
      : lang === 'zh-TW'
        ? '小遊戲、每日靈感與隱藏驚喜——玩一玩再走。'
        : lang === 'fr'
          ? 'Mini-jeux, inspiration du jour et surprises.'
          : lang === 'ru'
            ? 'Мини-игры, вдохновение дня и сюрпризы.'
            : 'Mini games, daily inspiration and hidden surprises.'}
    backHref={lp('/')}
    backLabel={lang === 'zh-CN'
      ? '返回首页'
      : lang === 'zh-TW'
        ? '返回首頁'
        : lang === 'fr'
          ? "Retour à l'accueil"
          : lang === 'ru'
            ? 'На главную'
            : 'Back to home'}
  />

  <section class="pb-20 md:pb-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- 随机一言 -->
        <article
          class="glass-card p-6 md:p-8 reveal"
        >
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {text.randomQuote}
            </h2>
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {text.randomQuoteDesc}
          </p>
          <div
            id="quote-box"
            class="min-h-[88px] p-4 rounded-sm bg-[rgb(var(--color-bg-secondary))]/80 border border-[rgb(var(--color-border))] mb-4 transition-colors duration-200"
          >
            <p
              id="quote-text"
              class="text-base md:text-lg font-medium text-[rgb(var(--color-text-primary))] leading-relaxed"
            >
              —
            </p>
            <p
              id="quote-lang"
              class="text-sm text-[rgb(var(--color-text-tertiary))] mt-2"
            >
            </p>
          </div>
          <button
            type="button"
            id="quote-refresh"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-sm bg-primary-500/15 hover:bg-primary-500/25 text-primary-600 dark:text-primary-400 font-medium transition-colors focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            {text.refresh}
          </button>
        </article>

        <!-- 随机作品 -->
        <article
          class="glass-card p-6 md:p-8 reveal"
        >
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {text.randomWork}
            </h2>
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {text.randomWorkDesc}
          </p>
          <a
            href={galleryPath}
            class="block group relative overflow-hidden rounded-sm aspect-[4/3] mb-4 ring-2 ring-transparent hover:ring-primary-500/30 transition-all duration-300"
          >
            <img
              src={randomImage.src}
              alt={imageTitle}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4"
            >
              <span class="text-white font-medium">{imageTitle}</span>
            </div>
          </a>
          <a
            href={galleryPath}
            class="link-underline inline-flex items-center gap-2 text-primary-500 hover:text-primary-600 font-medium text-sm"
          >
            {text.viewGallery}
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
            >
          </a>
        </article>
      </div>

      <!-- Konami + 打字 两栏或堆叠 -->
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto mt-6">
        <article class="glass-card p-6 md:p-8 reveal">
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {text.konamiTitle}
            </h2>
          </div>
          <p class="text-[rgb(var(--color-text-secondary))] text-sm mb-2">
            {text.konamiDesc}
          </p>
          <p class="text-xs text-[rgb(var(--color-text-tertiary))] font-mono">
            {text.konamiHint}
          </p>
        </article>

        <article class="glass-card p-6 md:p-8 reveal">
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {text.typingTitle}
            </h2>
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {text.typingDesc}
          </p>
          <p
            id="typing-sentence"
            class="text-base font-medium text-[rgb(var(--color-text-primary))] mb-3 p-3 rounded-sm bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))]"
          >
            {text.sentence}
          </p>
          <div class="flex flex-wrap gap-3 items-center">
            <input
              type="text"
              id="typing-input"
              placeholder={text.placeholder}
              class="flex-1 min-w-[180px] px-4 py-2.5 rounded-sm border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none text-sm"
              disabled
            />
            <button
              type="button"
              id="typing-start"
              class="px-5 py-2.5 rounded-sm bg-primary-600 text-white font-semibold text-sm hover:bg-primary-700 transition-opacity focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
            >
              {text.start}
            </button>
          </div>
          <div
            id="typing-result"
            class="hidden mt-4 p-3 rounded-sm bg-primary-500/10 border border-primary-500/30"
          >
            <p
              class="font-semibold text-primary-600 dark:text-primary-400 text-sm"
            >
              {text.yourTime}: <span id="typing-time">0</span>
              {text.seconds}
            </p>
            <button
              type="button"
              id="typing-again"
              class="mt-2 text-sm text-primary-500 hover:underline focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
            >
              {text.again}
            </button>
          </div>
        </article>
      </div>

      <!-- Memory Match Game -->
      <div class="max-w-5xl mx-auto mt-6">
        <article
          class="glass-card p-6 md:p-8 reveal"
        >
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
            >
              {mem.title}
            </h2>
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-4">
            {mem.desc}
          </p>
          <div class="flex items-center gap-6 mb-4 text-sm font-medium">
            <span class="text-[rgb(var(--color-text-secondary))]"
              >{mem.moves}: <span
                id="mem-moves"
                class="text-primary-500 font-bold">0</span
              ></span
            >
            <span class="text-[rgb(var(--color-text-secondary))]"
              >{mem.matched}: <span
                id="mem-matched"
                class="text-green-500 font-bold">0</span
              >/6</span
            >
          </div>
          <div
            id="mem-board"
            class="grid grid-cols-3 sm:grid-cols-4 gap-3 mb-4"
            role="group"
            aria-label={mem.title}
          >
            <!-- Cards inserted by JS -->
          </div>
          <div id="mem-complete" class="hidden text-center py-4">
            <p class="text-lg font-bold text-green-500 mb-2">
              {mem.complete}
            </p>
          </div>
          <button
            type="button"
            id="mem-reset"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-sm bg-primary-500/15 hover:bg-primary-500/25 text-primary-600 dark:text-primary-400 font-medium transition-colors focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            {mem.reset}
          </button>
        </article>
      </div>

      <!-- Extra mini widgets -->
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto mt-6">
        <article
          class="glass-card p-6 md:p-8 reveal"
        >
          <div class="flex items-center gap-3 mb-3">
            <h2
              class="text-xl font-heading font-bold text-[rgb(var(--color-text-primary))]"
