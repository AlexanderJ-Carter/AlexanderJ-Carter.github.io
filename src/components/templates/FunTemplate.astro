    border: none;
    padding: 0;
    outline: none;
  }

  .mem-card:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
    border-radius: 0.75rem;
  }

  .mem-card-back,
  .mem-card-front {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    font-size: 1.75rem;
    font-weight: 700;
    backface-visibility: hidden;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .mem-card-back {
    background: linear-gradient(
      135deg,
      rgb(var(--color-accent) / 0.15),
      rgb(217 70 239 / 0.15)
    );
    border: 1px solid var(--glass-border);
    color: rgb(var(--color-text-tertiary));
    transform: rotateY(0deg);
  }

  .mem-card-front {
    background: rgb(var(--color-bg-secondary));
    border: 2px solid rgb(var(--color-accent) / 0.3);
    transform: rotateY(180deg);
  }

  .mem-card.flipped .mem-card-back,
  .mem-card.mem-matched .mem-card-back {
    transform: rotateY(-180deg);
  }

  .mem-card.flipped .mem-card-front,
  .mem-card.mem-matched .mem-card-front {
    transform: rotateY(0deg);
  }

  .mem-card.mem-matched {
    pointer-events: none;
  }

  .mem-card.mem-matched .mem-card-front {
    border-color: rgb(34 197 94 / 0.5);
    background: rgb(34 197 94 / 0.08);
  }

  .breath-circle {
    width: 110px;
    height: 110px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(139 92 246 / 0.12);
    border: 2px solid rgb(139 92 246 / 0.3);
    color: rgb(var(--color-text-primary));
    font-size: 0.78rem;
    font-weight: 700;
    transition:
      transform 1s ease,
      background-color 0.6s ease,
      border-color 0.6s ease;
    text-align: center;
    padding: 0.4rem;
  }
  .breath-circle.inhale {
    transform: scale(1.18);
    background: rgb(16 185 129 / 0.16);
    border-color: rgb(16 185 129 / 0.45);
  }
  .breath-circle.exhale {
    transform: scale(0.9);
    background: rgb(59 130 246 / 0.16);
    border-color: rgb(59 130 246 / 0.45);
  }
  .breath-circle.hold {
    transform: scale(1.02);
    background: rgb(139 92 246 / 0.16);
    border-color: rgb(139 92 246 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .breath-circle {
      transition: none;
    }
  }
</style>
