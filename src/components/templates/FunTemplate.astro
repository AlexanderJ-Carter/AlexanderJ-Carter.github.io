  <script
    define:vars={{
      quotes: JSON.stringify(quotes),
      lang,
      microTasks: JSON.stringify(
        microTasks[lang as Lang] || microTasks['en-GB']
      ),
    }}
    is:inline
  >
    (function () {
      const quoteText = document.getElementById('quote-text');
      const quoteLang = document.getElementById('quote-lang');
      const quoteRefresh = document.getElementById('quote-refresh');
      const quoteBox = document.getElementById('quote-box');

      function pickQuote() {
        const list = typeof quotes === 'string' ? JSON.parse(quotes) : quotes;
        const i = Math.floor(Math.random() * list.length);
        const q = list[i];
        const useZh = lang === 'zh-CN' || lang === 'zh-TW';
        if (quoteText) quoteText.textContent = useZh ? q.zh : q.en;
        if (quoteLang)
          quoteLang.textContent = useZh ? '— ' + q.en : '— ' + q.zh;
        if (quoteBox) quoteBox.classList.add('animate-pulse');
        setTimeout(() => quoteBox?.classList.remove('animate-pulse'), 300);
      }

      pickQuote();
      quoteRefresh?.addEventListener('click', pickQuote);

      // Typing game
      const sentenceEl = document.getElementById('typing-sentence');
      const inputEl = document.getElementById('typing-input');
      const startBtn = document.getElementById('typing-start');
      const resultEl = document.getElementById('typing-result');
      const timeEl = document.getElementById('typing-time');
      const againBtn = document.getElementById('typing-again');

      if (!sentenceEl || !inputEl || !startBtn) return;

      const sentence = sentenceEl.textContent || '';
      let startTime = 0;

      startBtn.addEventListener('click', () => {
        inputEl.disabled = false;
        inputEl.value = '';
        inputEl.focus();
        resultEl?.classList.add('hidden');
        startTime = Date.now();
      });

      inputEl.addEventListener('input', () => {
        if (inputEl.value === sentence) {
          inputEl.disabled = true;
          const elapsed = ((Date.now() - startTime) / 1000).toFixed(2);
          if (timeEl) timeEl.textContent = elapsed;
          resultEl?.classList.remove('hidden');
        }
      });

      againBtn?.addEventListener('click', () => {
        startBtn?.click();
      });

      // Random task card
      const tasks =
        typeof microTasks === 'string' ? JSON.parse(microTasks) : microTasks;
      const taskResult = document.getElementById('task-result');
      const taskDraw = document.getElementById('task-draw');
      function drawTask() {
        if (!Array.isArray(tasks) || tasks.length === 0 || !taskResult) return;
        const i = Math.floor(Math.random() * tasks.length);
        taskResult.textContent = tasks[i];
      }
      drawTask();
      taskDraw?.addEventListener('click', drawTask);

      // Breathing rhythm
      const circle = document.getElementById('breath-circle');
      const phaseEl = document.getElementById('breath-phase');
      const startBreath = document.getElementById('breath-start');
      const stopBreath = document.getElementById('breath-stop');
      const phases = [
        { key: 'inhale', zh: '吸气 4s', en: 'Inhale 4s' },
        { key: 'hold', zh: '停顿 4s', en: 'Hold 4s' },
        { key: 'exhale', zh: '呼气 4s', en: 'Exhale 4s' },
        { key: 'hold2', zh: '停顿 4s', en: 'Hold 4s' },
      ];
      let timer = null;
      let idx = 0;
      function setPhase() {
        if (!phaseEl || !circle) return;
        const isZh = lang === 'zh-CN' || lang === 'zh-TW';
        const p = phases[idx];
        phaseEl.textContent = isZh ? p.zh : p.en;
        circle.classList.remove('inhale', 'hold', 'exhale');
        if (p.key === 'inhale') circle.classList.add('inhale');
        if (p.key === 'exhale') circle.classList.add('exhale');
        if (p.key === 'hold' || p.key === 'hold2') circle.classList.add('hold');
        idx = (idx + 1) % phases.length;
      }
      function stopRhythm() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
        if (phaseEl) phaseEl.textContent = 'Ready';
        circle?.classList.remove('inhale', 'hold', 'exhale');
      }
      startBreath?.addEventListener('click', () => {
        if (timer) return;
        setPhase();
        timer = setInterval(setPhase, 4000);
      });
      stopBreath?.addEventListener('click', stopRhythm);
    })();
  </script>

  <!-- Memory Match Game Script -->
  <script is:inline>
    (function () {
      var board = document.getElementById('mem-board');
      var movesEl = document.getElementById('mem-moves');
      var matchedEl = document.getElementById('mem-matched');
      var completeEl = document.getElementById('mem-complete');
      var resetBtn = document.getElementById('mem-reset');
      if (!board) return;

      var emojis = ['A', 'B', 'C', 'D', 'E', 'F'];
      var cards = [];
      var flipped = [];
      var matched = 0;
      var moves = 0;
      var locked = false;

      function shuffle(arr) {
        for (var i = arr.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = arr[i];
          arr[i] = arr[j];
          arr[j] = tmp;
        }
        return arr;
      }

      function createCard(emoji, idx) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mem-card';
        btn.setAttribute('data-emoji', emoji);
        btn.setAttribute('data-index', idx);
        btn.setAttribute('aria-label', 'Card ' + (idx + 1));
        btn.innerHTML =
          '<span class="mem-card-back">?</span><span class="mem-card-front">' +
          emoji +
          '</span>';
        btn.addEventListener('click', function () {
          flipCard(btn);
        });
        return btn;
      }

      function init() {
        board.innerHTML = '';
        cards = [];
        flipped = [];
        matched = 0;
        moves = 0;
        locked = false;
        if (movesEl) movesEl.textContent = '0';
        if (matchedEl) matchedEl.textContent = '0';
        if (completeEl) completeEl.classList.add('hidden');

        var deck = shuffle(emojis.concat(emojis));
        for (var i = 0; i < deck.length; i++) {
          var card = createCard(deck[i], i);
          cards.push(card);
          board.appendChild(card);
        }
      }

      function flipCard(btn) {
        if (locked) return;
        if (
          btn.classList.contains('flipped') ||
          btn.classList.contains('mem-matched')
        )
          return;
        if (flipped.length >= 2) return;

        btn.classList.add('flipped');
        flipped.push(btn);

        if (flipped.length === 2) {
          moves++;
          if (movesEl) movesEl.textContent = moves;
          locked = true;

          var a = flipped[0].getAttribute('data-emoji');
          var b = flipped[1].getAttribute('data-emoji');

          if (a === b) {
            flipped[0].classList.add('mem-matched');
            flipped[1].classList.add('mem-matched');
            matched++;
            if (matchedEl) matchedEl.textContent = matched;
            flipped = [];
            locked = false;

            if (matched === emojis.length) {
              setTimeout(function () {
                if (completeEl) completeEl.classList.remove('hidden');
              }, 400);
            }
          } else {
            setTimeout(function () {
              flipped[0].classList.remove('flipped');
              flipped[1].classList.remove('flipped');
              flipped = [];
              locked = false;
            }, 800);
          }
        }
      }

      resetBtn?.addEventListener('click', init);
      init();
    })();
  </script>
</BaseLayout>

