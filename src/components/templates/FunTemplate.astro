// 随机一言数据（中英混合，前端随机取）
const quotes = [
  {
    zh: '在光影与代码之间，寻找触动心弦的瞬间。',
    en: 'Between light and code, find the moment that touches the heart.',
  },
  {
    zh: '设计不仅仅是外观，更是如何运作。',
    en: 'Design is not just what it looks like. Design is how it works.',
  },
  { zh: '保持饥饿，保持愚蠢。', en: 'Stay hungry, stay foolish.' },
  { zh: '代码如诗，简洁即美。', en: 'Code is poetry. Simplicity is beauty.' },
  {
    zh: '每一张照片都是时间的切片。',
    en: 'Every photograph is a slice of time.',
  },
  { zh: '创造源于约束。', en: 'Creativity comes from constraint.' },
  { zh: '细节成就完美。', en: 'Details make perfection.' },
  { zh: '做一件事，并把它做好。', en: 'Do one thing and do it well.' },
  { zh: '学习是终身的事业。', en: 'Learning is a lifelong journey.' },
  {
    zh: '简单是可靠的先决条件。',
    en: 'Simplicity is a prerequisite for reliability.',
  },
