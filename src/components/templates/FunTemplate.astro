    moves: '步数',
    matched: '已配对',
    reset: '重新开始',
    complete: '全部找到！',
  },
  'zh-TW': {
    title: '記憶翻牌',
    desc: '翻轉卡片，找到所有配對的圖案。盡量用最少的步數完成！',
    moves: '步數',
    matched: '已配對',
    reset: '重新開始',
