---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../chrome/PageHero.astro';
import { getSitemapElsewhereLinks } from '../../data/site-registry';
import { sitemapCopy } from '../../i18n/pages/sitemap';
import { resolveLang, getLangPath } from '../../i18n/types';

const lang = resolveLang(Astro.props.lang);
const t = sitemapCopy[lang];
const home = getLangPath(lang, '/');
const elsewhereLinks = getSitemapElsewhereLinks(lang);
const sections = t.sections.map((section) =>
  section.id === 'elsewhere'
    ? { ...section, links: elsewhereLinks }
    : section
);

function resolveHref(path: string, external?: boolean) {
  if (external || path.startsWith('http')) return path;
  return getLangPath(lang, path);
}
---

<BaseLayout title={t.title} description={t.description}>
  <PageHero
    folio="Folio Index"
    kicker={t.kicker}
    title={t.headerTitle}
    description={t.headerDesc}
    backHref={home}
    backLabel={t.back}
    narrow={false}
  />

  <section class="pb-8 md:pb-10">
    <div class="page-shell-wide">
      <nav aria-label={t.tocLabel}>
        <ol
          class="flex flex-wrap gap-x-6 gap-y-2 border-y border-[rgb(var(--color-border))] py-4"
        >
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="group inline-flex items-baseline gap-2 text-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] transition-colors"
                >
                  <span class="meta-mono text-[rgb(var(--color-accent))]">
                    {section.index}
                  </span>
                  <span class="font-heading font-semibold">
                    {section.title}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="#languages"
              class="group inline-flex items-baseline gap-2 text-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] transition-colors"
            >
              <span class="meta-mono text-[rgb(var(--color-accent))]">05</span>
              <span class="font-heading font-semibold">{t.languagesTitle}</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="page-shell-wide space-y-16 md:space-y-20">
      {
        sections.map((section) => (
          <article id={section.id} class="scroll-mt-28">
            <header class="mb-6 md:mb-8 grid gap-3 md:grid-cols-[5rem_1fr] md:items-end">
              <p
                class="font-heading text-4xl md:text-5xl font-bold tabular-nums tracking-tight text-[rgb(var(--color-accent))]/80"
                aria-hidden="true"
              >
                {section.index}
              </p>
              <div>
                <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--color-text-primary))]">
                  {section.title}
                </h2>
                <p class="mt-1 text-[rgb(var(--color-text-secondary))]">
                  {section.lead}
                </p>
              </div>
            </header>

            <ul class="border-t border-[rgb(var(--color-border))]">
              {section.links.map((link, i) => {
                const href = resolveHref(link.path, link.external);
                const n = String(i + 1).padStart(2, '0');
                return (
                  <li class="border-b border-[rgb(var(--color-border))]">
                    <a
                      href={href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                      class="list-row group grid grid-cols-[2.5rem_1fr_auto] sm:grid-cols-[2.5rem_minmax(0,14rem)_1fr_auto] gap-x-3 sm:gap-x-6 items-baseline py-3.5 px-1 hover:pl-2"
                    >
                      <span class="meta-mono text-[rgb(var(--color-text-tertiary))] group-hover:text-[rgb(var(--color-accent))] transition-colors">
                        {n}
                      </span>
                      <span class="font-heading font-semibold text-[rgb(var(--color-text-primary))] group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {link.name}
                      </span>
                      <span class="hidden sm:block text-sm text-[rgb(var(--color-text-tertiary))] truncate">
                        {link.desc}
                      </span>
                      <span
                        class="meta-mono text-[rgb(var(--color-text-tertiary))] opacity-0 group-hover:opacity-100 transition-opacity"
                        aria-hidden="true"
                      >
                        {link.external ? '↗' : '→'}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }

      <article id="languages" class="scroll-mt-28">
        <header
          class="mb-6 md:mb-8 grid gap-3 md:grid-cols-[5rem_1fr] md:items-end"
        >
          <p
            class="font-heading text-4xl md:text-5xl font-bold tabular-nums tracking-tight text-[rgb(var(--color-accent))]/80"
            aria-hidden="true"
          >
            05
          </p>
          <div>
            <h2
              class="font-heading text-2xl md:text-3xl font-bold tracking-tight"
            >
              {t.languagesTitle}
            </h2>
            <p class="mt-1 text-[rgb(var(--color-text-secondary))]">
              {t.languagesLead}
            </p>
          </div>
        </header>

        <ul class="border-t border-[rgb(var(--color-border))]">
          {
            t.languages.map((language, i) => {
              const n = String(i + 1).padStart(2, '0');
              const current = language.code === lang;
              return (
                <li class="border-b border-[rgb(var(--color-border))]">
                  <a
                    href={language.path}
                    aria-current={current ? 'page' : undefined}
                    class:list={[
                      'list-row group grid grid-cols-[2.5rem_1fr_auto] gap-x-3 sm:gap-x-6 items-baseline py-3.5 px-1 hover:pl-2',
                      current && 'sitemap-lang-current',
                    ]}
                  >
                    <span class="meta-mono text-[rgb(var(--color-text-tertiary))]">
                      {n}
                    </span>
                    <span class="font-heading font-semibold text-[rgb(var(--color-text-primary))]">
                      {language.name}
                    </span>
                    <span class="meta-mono text-[rgb(var(--color-text-tertiary))]">
                      {language.code}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-lang-current {
    background: rgb(var(--color-bg-secondary) / 0.55);
  }
</style>
