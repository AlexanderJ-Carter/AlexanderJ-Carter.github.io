---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/types';
import { writingCopy, writingRssPath } from '../../i18n/pages/writing';
import {
  archiveYears,
  dateLocaleFor,
  postsForLang,
  uniqueTaxonomy,
} from '../../lib/writing';

const { lang = 'zh-CN' } = Astro.props as { lang?: Lang };

function lp(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

const t = writingCopy[lang] ?? writingCopy['zh-CN'];
const dateLocale = dateLocaleFor(lang);
const rssHref = writingRssPath(lang);

const allPosts = await getCollection('writing');
const posts = postsForLang(allPosts, lang);
const categories = uniqueTaxonomy(posts, 'category');
const tags = uniqueTaxonomy(posts, 'tags');
const years = archiveYears(posts);
const [featured, ...rest] = posts;
---

<BaseLayout title={t.title} description={t.description}>
  <header class="writing-hero">
    <div class="writing-hero__wash" aria-hidden="true"></div>
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative">
      <a href={lp('/')} class="writing-back">{t.backToHome}</a>

      <div class="writing-hero__grid">
        <div>
          <p class="writing-kicker">Blog · Writing</p>
          <h1 class="writing-hero__title">{t.title}</h1>
          <p class="writing-hero__lead">{t.intro}</p>
        </div>
        <p
          class="writing-hero__count"
          aria-label={`${posts.length} ${t.countLabel}`}
        >
          <span>{String(posts.length).padStart(2, '0')}</span>
          <small>{t.countLabel}</small>
        </p>
      </div>

      <nav class="writing-tools" aria-label={t.browseBy}>
        <a href={rssHref} class="writing-tools__rss">
          <span aria-hidden="true">◎</span>
          {t.rssCta}
        </a>
        <a href={lp('/writing/subscribe')}>{t.subscribe}</a>
        <a href={lp('/writing/archive')}>{t.archive}</a>
        <a href={lp('/writing/categories')}>{t.allCategories}</a>
        <a href={lp('/writing/tags')}>{t.allTags}</a>
      </nav>

      {
        categories.length > 0 && (
          <p class="writing-topics">
            <span>{t.categories}</span>
            {categories.map((cat, i) => (
              <>
                {i > 0 && <i aria-hidden="true">/</i>}
                <a href={lp(`/writing/categories/${cat.slug}`)}>{cat.name}</a>
              </>
            ))}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <p class="writing-topics writing-topics--tags">
            <span>{t.tags}</span>
            {tags.slice(0, 12).map((tag) => (
              <a href={lp(`/writing/tags/${tag.slug}`)}>#{tag.name}</a>
            ))}
            {tags.length > 12 && (
              <a href={lp('/writing/tags')} class="writing-topics__more">
                +{tags.length - 12}
              </a>
            )}
          </p>
        )
      }

      {
        years.length > 0 && (
          <p class="writing-years">
            <span>{t.archive}</span>
            {years.map((y) => (
              <a href={lp(`/writing/archive/${y.year}`)}>
                {y.year}
                <small>{y.count}</small>
              </a>
            ))}
          </p>
        )
      }
    </div>
  </header>

  <section class="writing-stream pb-24">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      {
        posts.length === 0 ? (
          <div class="writing-empty">
            <p>{t.noPosts}</p>
            <p class="writing-empty__hint">{t.emptyHint}</p>
          </div>
        ) : (
          <div class="space-y-16 md:space-y-20">
            {featured && (
              <a
                href={lp(`/writing/${featured.id}`)}
                class="stream-feature group"
              >
                <span class="stream-feature__no" aria-hidden="true">
                  01
                </span>
                <div class="stream-feature__copy">
                  <p class="stream-meta">
                    <span>{featured.data.category}</span>
                    <time datetime={featured.data.pubDate.toISOString()}>
                      {featured.data.pubDate.toLocaleDateString(dateLocale, {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    {featured.data.timeToRead && (
                      <span>{featured.data.timeToRead}</span>
                    )}
                  </p>
                  <h2 class="stream-feature__title">{featured.data.title}</h2>
                  <p class="stream-feature__desc">
                    {featured.data.description}
                  </p>
                  <span class="stream-feature__cta">
                    {t.readMore}
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            )}

            {rest.length > 0 && (
              <ul class="stream-list">
                {rest.map((post, i) => (
                  <li>
                    <a
                      href={lp(`/writing/${post.id}`)}
                      class="stream-item group"
                    >
                      <span class="stream-item__no" aria-hidden="true">
                        {String(i + 2).padStart(2, '0')}
                      </span>
                      <div class="stream-item__main">
                        <p class="stream-meta">
                          <span>{post.data.category}</span>
                          <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString(dateLocale, {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })}
                          </time>
                          {post.data.timeToRead && (
                            <span>{post.data.timeToRead}</span>
                          )}
                        </p>
                        <h2 class="stream-item__title">{post.data.title}</h2>
                        <p class="stream-item__desc">{post.data.description}</p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .writing-hero {
    position: relative;
    padding: 7.5rem 0 3.5rem;
    overflow: hidden;
  }
  .writing-hero__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 50% at 12% 18%,
        rgb(var(--color-accent) / 0.08),
        transparent 70%
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-bg-secondary) / 0.45),
        transparent 70%
      );
    pointer-events: none;
  }
  .writing-back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: rgb(var(--color-text-tertiary));
    transition: color 0.18s ease;
  }
  .writing-back:hover,
  .writing-back:focus-visible {
    color: rgb(var(--color-accent));
  }
  .writing-back:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .writing-kicker {
    font-family: theme('fontFamily.heading');
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
    margin-bottom: 1rem;
  }
  .writing-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .writing-hero__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }
  .writing-hero__title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.25rem;
  }
  .writing-hero__lead {
    max-width: 36rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgb(var(--color-text-secondary));
  }
  .writing-hero__count {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  @media (min-width: 900px) {
    .writing-hero__count {
      align-items: flex-end;
      text-align: right;
    }
  }
  .writing-hero__count span {
    font-family: theme('fontFamily.heading');
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: rgb(var(--color-accent) / 0.55);
  }
  .writing-hero__count small {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }

  .writing-tools {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.35rem;
    align-items: center;
  }
  .writing-tools a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    font-family: theme('fontFamily.heading');
    font-size: 0.88rem;
    font-weight: 600;
    color: rgb(var(--color-text-secondary));
    border-bottom: 1px solid rgb(var(--color-border) / 0.7);
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .writing-tools a:hover,
  .writing-tools a:focus-visible {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.55);
  }
  .writing-tools a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  .writing-tools__rss {
    color: rgb(var(--color-accent)) !important;
    border-bottom-color: rgb(var(--color-accent) / 0.45) !important;
  }

  .writing-topics {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.55rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-secondary));
  }
  .writing-topics--tags {
    margin-top: 0.85rem;
  }
  .writing-topics > span,
  .writing-years > span {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
    margin-right: 0.35rem;
  }
  .writing-topics i {
    font-style: normal;
    opacity: 0.35;
  }
  .writing-topics a {
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: inherit;
    transition: color 0.18s ease;
  }
  .writing-topics a:hover,
  .writing-topics a:focus-visible {
    color: rgb(var(--color-accent));
  }
  .writing-topics a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  .writing-topics__more {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: 0.72rem !important;
    font-weight: 500 !important;
  }

  .writing-years {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.85rem;
  }
  .writing-years a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: theme('fontFamily.heading');
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: rgb(var(--color-text-primary));
    transition: color 0.18s ease;
  }
  .writing-years a small {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: rgb(var(--color-text-tertiary));
  }
  .writing-years a:hover,
  .writing-years a:focus-visible {
    color: rgb(var(--color-accent));
  }
  .writing-years a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .writing-empty {
    padding: 4rem 0;
    max-width: 28rem;
  }
  .writing-empty p:first-child {
    font-family: theme('fontFamily.heading');
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .writing-empty__hint {
    color: rgb(var(--color-text-secondary));
    line-height: 1.65;
  }

  .writing-stream {
    padding-top: 1rem;
  }

  .stream-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-bottom: 0.85rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgb(var(--color-text-tertiary));
  }
  .stream-meta span:first-child {
    color: rgb(var(--color-accent));
  }

  .stream-feature {
    position: relative;
    display: block;
    padding: 0.5rem 0 0;
    text-decoration: none;
    color: inherit;
  }
  .stream-feature__no {
    position: absolute;
    top: -0.6rem;
    right: 0;
    font-family: theme('fontFamily.heading');
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: rgb(var(--color-text-primary) / 0.045);
    pointer-events: none;
    user-select: none;
  }
  .stream-feature__copy {
    position: relative;
    max-width: 42rem;
  }
  .stream-feature__title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }
  .stream-feature:hover .stream-feature__title,
  .stream-feature:focus-visible .stream-feature__title {
    color: rgb(var(--color-accent));
  }
  .stream-feature__desc {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgb(var(--color-text-secondary));
    margin-bottom: 1.35rem;
  }
  .stream-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: theme('fontFamily.heading');
    font-weight: 700;
    color: rgb(var(--color-accent));
    transition: gap 0.2s ease;
  }
  .stream-feature:hover .stream-feature__cta {
    gap: 0.7rem;
  }
  .stream-feature:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 6px;
  }

  .stream-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .stream-item {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding: 1.6rem 0;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid rgb(var(--color-border) / 0.55);
  }
  .stream-list li:last-child .stream-item {
    border-bottom: 1px solid rgb(var(--color-border) / 0.55);
  }
  .stream-item__no {
    font-family: theme('fontFamily.heading');
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgb(var(--color-text-tertiary) / 0.7);
    padding-top: 0.15rem;
    transition:
      color 0.2s ease,
      transform 0.25s ease;
  }
  .stream-item:hover .stream-item__no,
  .stream-item:focus-visible .stream-item__no {
    color: rgb(var(--color-accent));
    transform: translateX(2px);
  }
  .stream-item__title {
    font-family: theme('fontFamily.heading');
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.45rem;
    transition: color 0.18s ease;
  }
  .stream-item:hover .stream-item__title,
  .stream-item:focus-visible .stream-item__title {
    color: rgb(var(--color-accent));
  }
  .stream-item__desc {
    max-width: 38rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgb(var(--color-text-secondary));
  }
  .stream-item:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .stream-feature__cta,
    .stream-item__no,
    .stream-item__title,
    .stream-feature__title,
    .writing-tools a,
    .writing-topics a,
    .writing-years a {
      transition: none;
    }
  }
</style>
