---
// Reading Progress Component
// Shows reading progress only on long pages (scrollable height >= 2× viewport)
---

<div
  id="reading-progress"
  class="fixed top-0 left-0 right-0 h-1 bg-[rgb(var(--color-bg-secondary))] z-50 opacity-0 pointer-events-none transition-opacity duration-300 data-[visible]:opacity-100 data-[visible]:pointer-events-auto"
  style="visibility: hidden"
  role="progressbar"
  aria-hidden="true"
  aria-label="Reading progress"
>
  <div
    id="reading-progress-bar"
    class="h-full bg-gradient-to-r from-primary-500 via-accent-500 to-primary-600 transition-all duration-150"
    style="width: 0%"
  >
  </div>
</div>

<script>
  const container = document.getElementById('reading-progress');
  const progressBar = document.getElementById('reading-progress-bar');

  /** Show bar only when page is "long": scrollable height >= 2× viewport */
  const MIN_SCROLLABLE_VIEWPORTS = 2;

  function updateReadingProgress() {
    if (!container || !progressBar) return;

    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const scrollableHeight = documentHeight - windowHeight;

    const isLongPage =
      scrollableHeight >= MIN_SCROLLABLE_VIEWPORTS * windowHeight;
    if (isLongPage) {
      container.style.visibility = '';
      container.setAttribute('data-visible', '');
      container.setAttribute('aria-hidden', 'false');
      const progress =
        scrollableHeight > 0 ? (scrollTop / scrollableHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    } else {
      container.style.visibility = 'hidden';
      container.removeAttribute('data-visible');
      container.setAttribute('aria-hidden', 'true');
      progressBar.style.width = '0%';
    }
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        updateReadingProgress();
        ticking = false;
      });
      ticking = true;
    }
  });

  if (container) {
    container.style.visibility = '';
  }
  updateReadingProgress();
</script>
