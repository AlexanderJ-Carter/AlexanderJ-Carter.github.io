      },
      {
        href: getLangPath('/qr'),
        label:
          lang === 'zh-CN'
            ? 'QR 生成'
            : lang === 'zh-TW'
              ? 'QR 生成'
              : lang === 'fr'
                ? 'QR Code'
                : lang === 'ru'
                  ? 'QR-код'
                  : 'QR Code',
        icon: '📱',
        desc:
          lang === 'zh-CN'
            ? '链接转二维码'
            : lang === 'zh-TW'
