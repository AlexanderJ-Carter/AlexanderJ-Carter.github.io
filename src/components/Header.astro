---
import { getLangFromUrl, useTranslations, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.url).pathname;

// Helper: 与 Footer 一致，en-GB 使用 /en/ 前缀
function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

// Check if a link is active
function isActivePath(href: string | undefined): boolean {
  if (!href) return false;
  // Remove language prefix for comparison
  const normalizedCurrent = currentPath.replace(/^\/(zh-TW|en|fr|ru)\//, '/');
  const normalizedHref = href.replace(/^\/(zh-TW|en|fr|ru)\//, '/');
  return (
    normalizedCurrent === normalizedHref ||
    (normalizedHref === '/' &&
      (normalizedCurrent === '/' || normalizedCurrent === `/${lang}/`))
  );
}

interface SubMenuItem {
  href: string;
  label: string;
  icon: string;
  desc: string;
  external?: boolean;
}

interface NavItem {
  href?: string;
  label: string;
  icon: string;
  external?: boolean;
  submenu?: SubMenuItem[];
}

const mainNavItems: NavItem[] = [
  {
    href: lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`,
    label: t('nav.home'),
    icon: '🏠',
  },
  {
    label:
      lang === 'zh-CN'
        ? '创意'
        : lang === 'zh-TW'
          ? '創意'
          : lang === 'fr'
            ? 'Créatif'
            : lang === 'ru'
              ? 'Творчество'
              : 'Creative',
    icon: '✨',
    submenu: [
      {
        href: getLangPath('/gallery'),
        label: t('nav.gallery'),
        icon: '🎨',
        desc:
          lang === 'zh-CN'
            ? '作品展示'
            : lang === 'zh-TW'
              ? '作品展示'
              : lang === 'fr'
                ? 'Galerie'
                : lang === 'ru'
                  ? 'Галерея'
