---
import { getLangFromUrl, useTranslations, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.url).pathname;

// Helper: 与 Footer 一致，en-GB 使用 /en/ 前缀
function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

// Check if a link is active (exact or nested path)
function isActivePath(href: string | undefined): boolean {
  if (!href) return false;
  const strip = (p: string) =>
    p.replace(/^\/(zh-TW|en|fr|ru)(?=\/|$)/, '').replace(/\/$/, '') || '/';
  const current = strip(currentPath);
  const target = strip(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
}

function l(zh: string, tw: string, fr: string, ru: string, en: string): string {
  if (lang === 'zh-CN') return zh;
  if (lang === 'zh-TW') return tw;
  if (lang === 'fr') return fr;
  if (lang === 'ru') return ru;
  return en;
}

interface SubMenuItem {
  href: string;
  label: string;
  desc?: string;
  external?: boolean;
}

interface NavItem {
  href?: string;
  label: string;
  external?: boolean;
  mobileOnly?: boolean;
  submenu?: SubMenuItem[];
}

function isSubmenuActive(submenu: SubMenuItem[]): boolean {
  return submenu.some((item) => isActivePath(item.href));
}

const homeHref =
  lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`;

const moreSubmenu: SubMenuItem[] = [
  {
    href: getLangPath('/fun'),
    label: l('彩蛋', '彩蛋', 'Surprises', 'Пасхалки', 'Play'),
    desc: l(
      '诗词灵感、小游戏与番茄钟',
      '詩詞靈感、小遊戲與番茄鐘',
      'Citations, mini-jeux et pomodoro',
      'Цитаты, мини-игры и помодоро',
      'Quotes, mini games and pomodoro'
    ),
  },
  {
    href: getLangPath('/tools'),
    label: l('工具', '工具', 'Outils', 'Инструменты', 'Tools'),
    desc: l(
      '站内实用页与外部入口',
      '站內實用頁與外部入口',
      'Pages utiles et liens externes',
      'Полезные страницы и внешние ссылки',
      'On-site utilities and external links'
    ),
  },
  {
    href: getLangPath('/now'),
    label: 'Now',
    desc: l(
      '本地时间与快捷入口',
      '本地時間與快捷入口',
      'Heure locale et raccourcis',
      'Локальное время и быстрые ссылки',
      'Local time and quick links'
    ),
  },
  {
    href: getLangPath('/uses'),
    label: l('本站', '本站', 'Le site', 'О сайте', 'Uses'),
    desc: l(
      '技术栈与边界',
      '技術棧與邊界',
      'Stack et limites',
      'Стек и границы',
      'Stack and boundaries'
    ),
  },
  {
    href: getLangPath('/friends'),
    label: l('参考', '參考', 'Références', 'Ссылки', 'References'),
    desc: l(
      '工具与资料链接',
      '工具與資料連結',
      'Outils et ressources',
      'Инструменты и ресурсы',
      'Tools and resources'
    ),
  },
  {
    href: getLangPath('/reading-list'),
    label: t('nav.reading'),
    desc: l(
      '值得反复翻阅的书和文章',
      '值得反覆翻閱的書和文章',
      'Livres et articles à relire',
      'Книги и статьи для перечитывания',
      'Books and articles worth revisiting'
    ),
  },
  {
    href: getLangPath('/contact'),
    label: t('nav.contact'),
    desc: l(
      '取得联系',
      '取得聯繫',
      'Me contacter',
      'Связаться',
      'Get in touch'
    ),
  },
  {
    href: getLangPath('/license'),
    label: l('许可证', '許可證', 'Licence', 'Лицензия', 'Licence'),
    desc: l(
      '内容 CC 与源代码许可',
      '內容 CC 與源代碼許可',
      'Contenu CC et licence du code',
      'CC для контента и лицензия кода',
      'Content CC and source-code licence'
    ),
  },
  {
    href: getLangPath('/accessibility'),
    label: l(
      '无障碍',
      '無障礙',
      'Accessibilité',
      'Доступность',
      'Accessibility'
    ),
    desc: l(
      '键盘、对比度与辅助功能',
      '鍵盤、對比度與輔助功能',
      'Clavier, contraste et aides',
      'Клавиатура, контраст и доступность',
      'Keyboard, contrast and assistive use'
    ),
  },
  {
    href: getLangPath('/sitemap'),
    label: l('地图', '地圖', 'Plan', 'Карта', 'Sitemap'),
    desc: l(
      '全部页面',
      '全部頁面',
      'Toutes les pages',
      'Все страницы',
      'All pages'
    ),
  },
  {
    href: 'https://blog.alexander.xin',
    label: t('nav.blog'),
    desc: l(
      '独立博客',
      '獨立部落格',
      'Blog externe',
      'Внешний блог',
      'External blog'
    ),
    external: true,
  },
];

const mainNavItems: NavItem[] = [
  { href: homeHref, label: t('nav.home'), mobileOnly: true },
  { href: getLangPath('/gallery'), label: t('nav.gallery') },
  {
    href: getLangPath('/writing'),
    label: l('写作', '寫作', 'Écrits', 'Статьи', 'Writing'),
  },
  {
    href: getLangPath('/projects'),
    label: l('项目', '專案', 'Projets', 'Проекты', 'Projects'),
  },
  { href: getLangPath('/about'), label: t('nav.about') },
  { label: l('更多', '更多', 'Plus', 'Ещё', 'More'), submenu: moreSubmenu },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 nav-glass transition-all duration-300"
  id="header"
>
  <div class="scroll-indicator" id="scroll-indicator" hidden aria-hidden="true"></div>

  <nav class="relative z-50 container mx-auto px-4 lg:px-8 py-4" aria-label={lang === 'zh-CN' ? '主导航' : 'Main'}>
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a
        href={lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`}
        class="flex items-center gap-3 group"
      >
        <img
          src="/img/branding/logo-96.webp"
          alt={lang === 'zh-CN' ? '站点标志' : 'Site logo'}
          width="40"
          height="40"
          class="w-10 h-10 rounded-full opacity-90 group-hover:opacity-100 transition-opacity duration-200 dark:hidden"
        />
        <img
          src="/img/branding/logo-dark-96.webp"
          alt={lang === 'zh-CN' ? '站点标志' : 'Site logo'}
          width="40"
          height="40"
          class="w-10 h-10 rounded-full opacity-90 group-hover:opacity-100 transition-opacity duration-200 hidden dark:block"
        />
        <span
          class="font-heading font-bold text-xl hidden sm:block text-[rgb(var(--color-text-primary))] tracking-tight"
        >
          Alexander Carter
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {
          mainNavItems
            .filter((item) => !item.mobileOnly)
            .map((item) =>
              item.submenu ? (
                <div class="relative group submenu-group">
                  <button
                    type="button"
                    aria-haspopup="true"
                    aria-expanded="false"
                    class:list={[
                      'submenu-btn group relative inline-flex items-center gap-1.5 px-3 py-2 font-heading font-medium text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2',
                      isSubmenuActive(item.submenu)
                        ? 'text-primary-500'
                        : 'text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
                    ]}
                  >
                    <span>{item.label}</span>
                    <svg
                      class="submenu-chevron w-3 h-3 shrink-0 transition-transform duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                    <span
                      class:list={[
                        'nav-underline absolute bottom-0 left-3 right-3 h-px bg-primary-500 origin-left transition-transform duration-200',
                        isSubmenuActive(item.submenu)
                          ? 'scale-x-100'
                          : 'scale-x-0 group-hover:scale-x-100',
                      ]}
                      aria-hidden="true"
                    />
                  </button>
                  <div class="submenu-panel absolute left-0 mt-0 min-w-[15rem] bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-sm opacity-0 invisible scale-95 origin-top-left group-hover:opacity-100 group-hover:visible group-hover:scale-100 group-hover:mt-1.5 transition-all duration-200 ease-out z-50 py-1">
                    {item.submenu.map((subitem) => (
                      <a
                        href={subitem.href}
                        class:list={[
                          'block px-4 py-2.5 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500',
                          isActivePath(subitem.href)
                            ? 'text-primary-500'
                            : 'text-[rgb(var(--color-text-primary))] hover:bg-[rgb(var(--color-bg-accent))]',
                        ]}
                        target={subitem.external ? '_blank' : undefined}
                        rel={
                          subitem.external ? 'noopener noreferrer' : undefined
                        }
                        aria-current={
                          isActivePath(subitem.href) ? 'page' : undefined
                        }
                      >
                        <div class="font-heading text-sm font-medium">
                          {subitem.label}
                        </div>
                        {subitem.desc && (
                          <div class="mt-0.5 text-xs leading-snug text-[rgb(var(--color-text-secondary))]">
                            {subitem.desc}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'nav-link group relative inline-flex px-3 py-2 font-heading font-medium text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2',
                    isActivePath(item.href)
                      ? 'text-primary-500'
                      : 'text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
                  ]}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-current={isActivePath(item.href) ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <span
                    class:list={[
                      'nav-underline absolute bottom-0 left-3 right-3 h-px bg-primary-500 origin-left transition-transform duration-200',
                      isActivePath(item.href)
                        ? 'scale-x-100'
                        : 'scale-x-0 group-hover:scale-x-100',
                    ]}
                    aria-hidden="true"
                  />
                </a>
              )
            )
        }
      </div>

      <!-- Right Side Actions -->
      <div class="flex items-center gap-4">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label={t('theme.toggle')}
          class="inline-flex items-center justify-center min-w-11 min-h-11 rounded-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] hover:bg-[rgb(var(--color-bg-secondary))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-colors duration-200"
        >
          <svg
            class="w-6 h-6 sun-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            class="w-6 h-6 moon-icon hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <!-- Language Switcher -->
        <div class="relative group lang-group" id="lang-switcher">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="lang-menu"
            id="lang-switcher-btn"
            class="inline-flex items-center justify-center gap-2 min-w-11 min-h-11 px-2 rounded-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] hover:bg-[rgb(var(--color-bg-secondary))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 text-[rgb(var(--color-text-secondary))]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
              ></path>
            </svg>
            <span
              class="text-sm font-medium hidden sm:block text-[rgb(var(--color-text-secondary))]"
              >{languages[lang]}</span
            >
          </button>
          <div
            id="lang-menu"
            role="menu"
            class="lang-panel absolute right-0 mt-1.5 w-40 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-sm opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1"
          >
            {
              Object.entries(languages).map(([code, name]) => (
                <a
                  href={
                    code === 'zh-CN'
                      ? '/'
                      : code === 'en-GB'
                        ? '/en/'
                        : `/${code}/`
                  }
                  role="menuitem"
                  class="flex items-center justify-between px-4 py-2.5 text-sm text-[rgb(var(--color-text-secondary))] hover:bg-[rgb(var(--color-bg-accent))] hover:text-[rgb(var(--color-text-primary))] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500"
                  class:list={{
                    'font-medium text-primary-500': code === lang,
                  }}
                  aria-current={code === lang ? 'true' : undefined}
                >
                  <span>{name}</span>
                  {code === lang && (
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-primary-500 flex-shrink-0"
                      aria-hidden="true"
                    />
                  )}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label={lang === 'zh-CN' ? '打开菜单' : 'Toggle menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden inline-flex items-center justify-center min-w-11 min-h-11 rounded-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] hover:bg-[rgb(var(--color-bg-secondary))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-colors duration-200"
        >
          <svg
            class="w-6 h-6 hamburger"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="w-6 h-6 close hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu-backdrop"
    class="mobile-backdrop fixed inset-0 z-40 bg-black/20 hidden md:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute left-0 right-0 top-full z-50 border-t border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))]"
    role="navigation"
    aria-label={lang === 'zh-CN' ? '主导航' : 'Main navigation'}
  >
    <div class="px-4 lg:px-8 py-2">
      {
        mainNavItems.map((item) =>
          item.submenu ? (
            <div>
              <button
                type="button"
                aria-expanded="false"
                class="mobile-submenu-toggle w-full text-left py-3.5 px-4 text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))] rounded-sm transition-colors duration-200 flex items-center justify-between font-heading font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset"
              >
                <span>{item.label}</span>
                <svg
                  class="w-4 h-4 submenu-arrow shrink-0 transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <div class="mobile-submenu hidden pl-4 border-l border-[rgb(var(--color-border))] ml-4 mb-1">
                {item.submenu.map((subitem) => (
                  <a
                    href={subitem.href}
                    class:list={[
                      'block py-3.5 px-3 text-sm transition-colors rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset',
                      isActivePath(subitem.href)
                        ? 'text-primary-500 font-medium'
                        : 'text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
                    ]}
                    target={subitem.external ? '_blank' : undefined}
                    rel={subitem.external ? 'noopener noreferrer' : undefined}
                    aria-current={
                      isActivePath(subitem.href) ? 'page' : undefined
                    }
                  >
                    <span class="font-heading">{subitem.label}</span>
                    {subitem.desc && (
                      <span class="mt-0.5 block text-xs text-[rgb(var(--color-text-secondary))]">
                        {subitem.desc}
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'block py-3.5 px-4 rounded-sm transition-colors duration-200 font-heading font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset',
                isActivePath(item.href)
                  ? 'text-primary-500'
                  : 'text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
              ]}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={isActivePath(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          )
        )
      }
    </div>
  </div>
</header>

<style>
  .scroll-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: theme('colors.primary.500');
    width: 0%;
    transition: width 0.15s ease-out;
  }

  #header.nav-hidden {
    transform: translateY(-100%);
  }

  #header.nav-scrolled {
    box-shadow: 0 1px 0 rgb(var(--color-border));
  }

  #header {
    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease,
      background-color 0.28s ease;
  }

  .dark .sun-icon {
    display: none;
  }

  .dark .moon-icon {
    display: block;
  }

  .submenu-group[data-open] .submenu-panel {
    opacity: 1 !important;
    visibility: visible !important;
    transform: scale(1) !important;
    margin-top: 0.375rem !important;
  }

  .submenu-group[data-open] .submenu-chevron {
    transform: rotate(180deg);
  }

  .lang-group[data-open] .lang-panel {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .nav-link-active {
    color: theme('colors.primary.500') !important;
  }

  .nav-link-active .nav-underline {
    transform: scaleX(1) !important;
  }

  .mobile-backdrop.is-visible {
    display: block;
  }
</style>

<script is:inline>
  let lastScrollY = 0;
  const scrollThreshold = 12;

  // ── Theme toggle ────────────────────────────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const html = document.documentElement;

    // Start transition animation
    html.classList.add('theme-transitioning');

    // Toggle dark mode after fade-out begins
    setTimeout(() => {
      const isDark = html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      // Replace transitioning class with transition-in for fade-in effect
      html.classList.remove('theme-transitioning');
      html.classList.add('theme-transition-in');

      // Remove transition-in class after animation completes
      setTimeout(() => {
        html.classList.remove('theme-transition-in');
      }, 250);
    }, 125);
  });

  // ── Desktop submenu: click + keyboard support ────────────────────────────────
  function closeAllSubmenus() {
    document.querySelectorAll('.submenu-group[data-open]').forEach((g) => {
      g.removeAttribute('data-open');
      g.querySelector('button[aria-haspopup]')?.setAttribute(
        'aria-expanded',
        'false'
      );
    });
  }

  document.querySelectorAll('.submenu-group').forEach((group) => {
    const btn = group.querySelector('button.submenu-btn');

    // Click toggles open/close
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.hasAttribute('data-open');
      closeAllSubmenus();
      closeLangMenu();
      if (!isOpen) {
        group.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    // Keyboard: Enter/Space toggles; Escape closes; ArrowDown opens and moves focus
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        group.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        group.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
        group.querySelector('.submenu-panel a')?.focus();
      }
    });

    // Trap focus — close when focus leaves the group entirely
    group.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget)) {
        group.removeAttribute('data-open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ── Language switcher: click + keyboard support ──────────────────────────────
  const langGroup = document.getElementById('lang-switcher');
  const langBtn = document.getElementById('lang-switcher-btn');
  const langMenu = document.getElementById('lang-menu');

  function closeLangMenu() {
    langGroup?.removeAttribute('data-open');
    langBtn?.setAttribute('aria-expanded', 'false');
  }

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = langGroup?.hasAttribute('data-open');
    closeAllSubmenus();
    if (!isOpen) {
      langGroup?.setAttribute('data-open', '');
      langBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeLangMenu();
    }
  });

  langBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLangMenu();
      langBtn.focus();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      langGroup?.setAttribute('data-open', '');
      langBtn.setAttribute('aria-expanded', 'true');
      langMenu?.querySelector('a')?.focus();
    }
  });

  langGroup?.addEventListener('focusout', (e) => {
    if (!langGroup.contains(e.relatedTarget)) closeLangMenu();
  });

  // Click anywhere outside closes all
  document.addEventListener('click', () => {
    closeAllSubmenus();
    closeLangMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllSubmenus();
      closeLangMenu();
      if (mobileMenu?.classList.contains('menu-open')) closeMobileMenu();
    }
  });

  // ── Active page indicator ────────────────────────────────────────────────────
  (function markActivePage() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document
      .querySelectorAll('header a[href]:not([target="_blank"])')
      .forEach((a) => {
        const href = a.getAttribute('href')?.replace(/\/$/, '') || '';
        if (href && href === path) {
          a.setAttribute('aria-current', 'page');
          a.classList.add('nav-link-active');
        }
      });
  })();

  // ── Mobile menu toggle ───────────────────────────────────────────────────────
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
  const hamburger = mobileMenuToggle?.querySelector('.hamburger');
  const close = mobileMenuToggle?.querySelector('.close');

  function showMobileBackdrop() {
    mobileBackdrop?.classList.remove('hidden');
    mobileBackdrop?.classList.add('is-visible');
    mobileBackdrop?.setAttribute('aria-hidden', 'false');
  }

  function hideMobileBackdrop() {
    mobileBackdrop?.classList.add('hidden');
    mobileBackdrop?.classList.remove('is-visible');
    mobileBackdrop?.setAttribute('aria-hidden', 'true');
  }

  function closeMobileMenu() {
    mobileMenu?.classList.remove('menu-open');
    mobileMenu?.classList.add('menu-closing');
    hamburger?.classList.remove('rotating');
    hideMobileBackdrop();
    hamburger?.classList.remove('hidden');
    close?.classList.add('hidden');
    mobileMenuToggle?.setAttribute('aria-expanded', 'false');

    setTimeout(() => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('menu-closing');
    }, 300);
  }

  mobileMenuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('menu-open');

    if (isOpen) {
      closeMobileMenu();
      return;
    }

    mobileMenu?.classList.remove('hidden');
    mobileMenu?.classList.add('menu-open');
    hamburger?.classList.add('rotating');
    hamburger?.classList.add('hidden');
    close?.classList.remove('hidden');
    showMobileBackdrop();
    mobileMenuToggle?.setAttribute('aria-expanded', 'true');
  });

  mobileBackdrop?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('menu-open')) closeMobileMenu();
  });

  // Mobile submenu toggle
  document.querySelectorAll('.mobile-submenu-toggle').forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      if (!btn) return;
      const submenu = btn.nextElementSibling;
      const arrow = btn.querySelector('.submenu-arrow');
      const isOpening = submenu?.classList.contains('hidden') ?? false;
      submenu?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
      btn.setAttribute('aria-expanded', String(isOpening));
    });
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('menu-open')) return;
      closeMobileMenu();
    });
  });

  // ── Scroll progress + hide-on-scroll (rAF throttled) ───────────────────────
  let headerScrollTicking = false;
  function updateHeaderOnScroll() {
    const header = document.getElementById('header');
    const scrollTop = window.scrollY;

    if (header) {
      if (scrollTop > 24) {
        header.classList.add('nav-scrolled');
      } else {
        header.classList.remove('nav-scrolled');
      }

      if (header.contains(document.activeElement)) {
        header.classList.remove('nav-hidden');
        lastScrollY = scrollTop;
        headerScrollTicking = false;
        return;
      }

      if (scrollTop > lastScrollY + scrollThreshold) {
        header.classList.add('nav-hidden');
      } else if (scrollTop < lastScrollY - scrollThreshold || scrollTop < 10) {
        header.classList.remove('nav-hidden');
      }
    }

    lastScrollY = scrollTop;
    headerScrollTicking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (headerScrollTicking) return;
      headerScrollTicking = true;
      requestAnimationFrame(updateHeaderOnScroll);
    },
    { passive: true }
  );
</script>
