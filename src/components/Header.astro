        label:
          lang === 'zh-CN'
            ? '工具中台'
            : lang === 'zh-TW'
              ? '工具中台'
              : lang === 'fr'
                ? 'Hub Outils'
                : lang === 'ru'
                  ? 'Хаб инструментов'
                  : 'Tool Hub',
        icon: '🧰',
        desc:
          lang === 'zh-CN'
            ? '更多在线工具'
            : lang === 'zh-TW'
              ? '更多線上工具'
              : lang === 'fr'
                ? 'Plus d’outils'
                : lang === 'ru'
