        icon: '🍳',
        desc:
          lang === 'zh-CN'
            ? '程序员友好的菜谱站'
            : lang === 'zh-TW'
              ? '程式設計師友善菜譜站'
              : lang === 'fr'
                ? 'Recettes pratiques'
