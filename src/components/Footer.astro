---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/AlexanderJ-Carter',
    icon: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z',
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
  {
    name: 'Email',
    href: 'mailto:contact-us@alexander.xin',
    icon: 'M1.5 4.5l10.5 7.5 10.5-7.5v12a1.5 1.5 0 01-1.5 1.5h-18a1.5 1.5 0 01-1.5-1.5v-12zm21-3a1.5 1.5 0 00-1.5-1.5h-18a1.5 1.5 0 00-1.5 1.5v.379l10.5 7.5 10.5-7.5v-.379z',
  },
];

const exploreLinks = [
  {
    label: lang === 'zh-CN' ? '关于我' : 'About',
    href: lang === 'zh-CN' ? '/about' : '/en/about',
  },
  {
    label: lang === 'zh-CN' ? '画廊' : 'Gallery',
    href: lang === 'zh-CN' ? '/gallery' : '/en/gallery',
  },
  {
    label: lang === 'zh-CN' ? '日历' : 'Calendar',
    href: lang === 'zh-CN' ? '/calendar' : '/en/calendar',
  },
  {
    label: lang === 'zh-CN' ? '汇率' : 'Currency',
    href: lang === 'zh-CN' ? '/currency' : '/en/currency',
  },
  {
    label: lang === 'zh-CN' ? '世界时间' : 'World Time',
    href: lang === 'zh-CN' ? '/time' : '/en/time',
  },
];

const resourceLinks = [
  {
    label: lang === 'zh-CN' ? '隐私政策' : 'Privacy',
    href: lang === 'zh-CN' ? '/privacy' : '/en/privacy',
  },
  {
    label: lang === 'zh-CN' ? '服务条款' : 'Terms',
    href: lang === 'zh-CN' ? '/terms' : '/en/terms',
  },
  {
    label: lang === 'zh-CN' ? '许可证' : 'License',
    href: lang === 'zh-CN' ? '/license' : '/en/license',
  },
  {
    label: lang === 'zh-CN' ? '无障碍' : 'Accessibility',
    href: lang === 'zh-CN' ? '/accessibility' : '/en/accessibility',
  },
  {
    label: lang === 'zh-CN' ? '安全政策' : 'Security',
    href: '/security/policy',
  },
];
---

<footer
  class="mt-24 border-t border-[rgb(var(--color-border))] bg-gradient-to-b from-[rgb(var(--color-bg-primary))] to-[rgb(var(--color-bg-secondary))]"
>
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <!-- Main Footer Content -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4 mb-8">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/img/branding/logo.png"
            alt="Logo"
            class="w-10 h-10 rounded-lg"
          />
          <div>
            <p
              class="font-display font-semibold text-[rgb(var(--color-text-primary))]"
            >
              Alexander Carter
            </p>
            <p class="text-xs text-[rgb(var(--color-text-secondary))]">
              {
                lang === 'zh-CN'
                  ? '创意与技术的结合'
                  : 'Creativity meets technology'
              }
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="w-9 h-9 flex items-center justify-center rounded-lg border border-[rgb(var(--color-border))] hover:border-primary-500 hover:bg-primary-500/10 hover:text-primary-500 transition-all"
                aria-label={social.name}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={
                  social.href.startsWith('http')
                    ? 'noopener noreferrer'
                    : undefined
                }
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3
          class="font-semibold text-sm mb-4 text-[rgb(var(--color-text-primary))] uppercase tracking-wider"
        >
          {lang === 'zh-CN' ? '导航' : 'Navigation'}
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3
          class="font-semibold text-sm mb-4 text-[rgb(var(--color-text-primary))] uppercase tracking-wider"
        >
          {lang === 'zh-CN' ? '资源' : 'Resources'}
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            resourceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact & Info -->
      <div>
        <h3
          class="font-semibold text-sm mb-4 text-[rgb(var(--color-text-primary))] uppercase tracking-wider"
        >
          {lang === 'zh-CN' ? '联系' : 'Contact'}
        </h3>
        <div class="space-y-2.5 text-sm">
          <a
            href="mailto:contact-us@alexander.xin"
            class="block text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors"
          >
            contact-us@alexander.xin
          </a>
          <p class="text-[rgb(var(--color-text-secondary))] text-xs">
            {lang === 'zh-CN' ? '北京，中国' : 'Beijing, China'}
          </p>
          <a
            href={lang === 'zh-CN' ? '/sitemap' : '/en/sitemap'}
            class="inline-block mt-3 text-xs text-primary-500 hover:underline"
          >
            {lang === 'zh-CN' ? '🗺️ 网站地图' : '🗺️ Sitemap'}
          </a>
        </div>
      </div>
    </div>

    <!-- Badges -->
    <div class="border-t border-[rgb(var(--color-border))] pt-8">
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
        <a
          href={lang === 'zh-CN' ? '/license' : '/en/license'}
          class="px-3 py-1.5 rounded-md bg-[rgb(var(--color-bg-primary))] border border-[rgb(var(--color-border))] hover:border-primary-500 transition-colors flex items-center gap-1.5"
        >
          <span>CC</span>
          <span class="text-[rgb(var(--color-text-secondary))]"
            >BY-NC-SA 4.0</span
          >
        </a>
        <a
          href="https://github.com/AlexanderJ-Carter"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-md bg-[rgb(var(--color-bg-primary))] border border-[rgb(var(--color-border))] hover:border-primary-500 transition-colors flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          <span class="text-[rgb(var(--color-text-secondary))]"
            >Open Source</span
          >
        </a>
        <a
          href={lang === 'zh-CN' ? '/accessibility' : '/en/accessibility'}
          class="px-3 py-1.5 rounded-md bg-[rgb(var(--color-bg-primary))] border border-[rgb(var(--color-border))] hover:border-primary-500 transition-colors"
        >
          <span class="text-[rgb(var(--color-text-secondary))]"
            >♿ WCAG 2.1</span
          >
        </a>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div
    class="border-t border-[rgb(var(--color-border))] py-4 px-4 lg:px-8 bg-[rgb(var(--color-bg-primary))]"
  >
    <div
      class="container mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-[rgb(var(--color-text-tertiary))]"
    >
      <p>© {currentYear} Alexander James Carter</p>
      <div class="flex items-center gap-2 flex-wrap justify-center">
        <a
          href="https://pages.github.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary-500 transition-colors">GitHub Pages</a
        >
        <span>·</span>
        <a
          href="https://www.cloudflare.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary-500 transition-colors">Cloudflare</a
        >
      </div>
    </div>
  </div>
</footer>
