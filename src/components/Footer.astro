---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();

function getLangPath(path: string) {
  return lang === 'zh-CN' ? path : `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

const mainLinks = [
  { label: lang === 'zh-CN' ? '关于' : lang === 'zh-TW' ? '關於' : lang === 'fr' ? 'À propos' : lang === 'ru' ? 'Обо мне' : 'About', href: getLangPath('/about') },
  { label: lang === 'zh-CN' ? '画廊' : lang === 'zh-TW' ? '畫廊' : lang === 'fr' ? 'Galerie' : lang === 'ru' ? 'Галерея' : 'Gallery', href: getLangPath('/gallery') },
  { label: lang === 'zh-CN' ? '项目' : lang === 'zh-TW' ? '專案' : lang === 'fr' ? 'Projets' : lang === 'ru' ? 'Проекты' : 'Projects', href: getLangPath('/projects') },
  { label: lang === 'zh-CN' ? '联系' : lang === 'zh-TW' ? '聯繫' : lang === 'fr' ? 'Contact' : lang === 'ru' ? 'Контакт' : 'Contact', href: getLangPath('/contact') },
  { label: lang === 'zh-CN' ? '彩蛋' : lang === 'zh-TW' ? '彩蛋' : lang === 'fr' ? 'Easter Eggs' : lang === 'ru' ? 'Пасхалки' : 'Fun', href: getLangPath('/fun') },
  { label: lang === 'zh-CN' ? '时间线' : lang === 'zh-TW' ? '時間軸' : lang === 'fr' ? 'Chronologie' : lang === 'ru' ? 'Хронология' : 'Timeline', href: getLangPath('/timeline') },
];

const toolLinks = [
  { label: lang === 'zh-CN' ? '日历' : lang === 'zh-TW' ? '日曆' : lang === 'fr' ? 'Calendrier' : lang === 'ru' ? 'Календарь' : 'Calendar', href: getLangPath('/calendar') },
  { label: lang === 'zh-CN' ? '汇率' : lang === 'zh-TW' ? '匯率' : lang === 'fr' ? 'Taux de change' : lang === 'ru' ? 'Курс валют' : 'Currency', href: getLangPath('/currency') },
  { label: lang === 'zh-CN' ? '时间' : lang === 'zh-TW' ? '時間' : lang === 'fr' ? 'Heure' : lang === 'ru' ? 'Время' : 'Time', href: getLangPath('/time') },
  { label: 'Now', href: getLangPath('/now') },
  { label: lang === 'zh-CN' ? '本站' : lang === 'zh-TW' ? '本站' : lang === 'fr' ? 'Le site' : lang === 'ru' ? 'О сайте' : 'About site', href: getLangPath('/uses') },
  { label: lang === 'zh-CN' ? '单位换算' : lang === 'zh-TW' ? '單位換算' : lang === 'fr' ? 'Unités' : lang === 'ru' ? 'Единицы' : 'Units', href: getLangPath('/units') },
  { label: lang === 'zh-CN' ? 'QR 生成' : lang === 'zh-TW' ? 'QR 生成' : lang === 'fr' ? 'QR Code' : lang === 'ru' ? 'QR-код' : 'QR Code', href: getLangPath('/qr') },
  { label: lang === 'zh-CN' ? '网站地图' : lang === 'zh-TW' ? '網站地圖' : lang === 'fr' ? 'Plan du site' : lang === 'ru' ? 'Карта сайта' : 'Sitemap', href: getLangPath('/sitemap') },
];

const legalLinks = [
  { label: lang === 'zh-CN' ? '隐私政策' : lang === 'zh-TW' ? '隱私政策' : lang === 'fr' ? 'Confidentialité' : lang === 'ru' ? 'Конфиденциальность' : 'Privacy', href: getLangPath('/privacy') },
  { label: lang === 'zh-CN' ? '使用条款' : lang === 'zh-TW' ? '使用條款' : lang === 'fr' ? 'Conditions' : lang === 'ru' ? 'Условия' : 'Terms', href: getLangPath('/terms') },
  { label: lang === 'zh-CN' ? '许可证' : lang === 'zh-TW' ? '許可證' : lang === 'fr' ? 'Licence' : lang === 'ru' ? 'Лицензия' : 'License', href: getLangPath('/license') },
  { label: lang === 'zh-CN' ? '无障碍' : lang === 'zh-TW' ? '無障礙' : lang === 'fr' ? 'Accessibilité' : lang === 'ru' ? 'Доступность' : 'Accessibility', href: getLangPath('/accessibility') },
  { label: lang === 'zh-CN' ? '安全政策' : lang === 'zh-TW' ? '安全政策' : lang === 'fr' ? 'Sécurité' : lang === 'ru' ? 'Безопасность' : 'Security', href: getLangPath('/security/policy') },
  { label: lang === 'zh-CN' ? '安全致谢' : lang === 'zh-TW' ? '安全致謝' : lang === 'fr' ? 'Remerciements' : lang === 'ru' ? 'Благодарности' : 'Acknowledgments', href: getLangPath('/security/acknowledgments') },
];

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/AlexanderJ-Carter',
    icon: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z',
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
  {
    name: 'Email',
    href: 'mailto:contact-us@alexander.xin',
    icon: 'M1.5 4.5l10.5 7.5 10.5-7.5v12a1.5 1.5 0 01-1.5 1.5h-18a1.5 1.5 0 01-1.5-1.5v-12zm21-3a1.5 1.5 0 00-1.5-1.5h-18a1.5 1.5 0 00-1.5 1.5v.379l10.5 7.5 10.5-7.5v-.379z',
  },
];

const taglineMap: Record<string, string> = {
  'zh-CN': '创意 · 技术 · 探索',
  'zh-TW': '創意 · 技術 · 探索',
  'en-GB': 'Creativity · Technology · Exploration',
  fr: 'Créativité · Technologie · Exploration',
  ru: 'Творчество · Технологии · Исследование',
};

const colTitles: Record<string, { main: string; tools: string; legal: string }> = {
  'zh-CN': { main: '导航', tools: '工具', legal: '更多' },
  'zh-TW': { main: '導航', tools: '工具', legal: '更多' },
  'en-GB': { main: 'Pages', tools: 'Tools', legal: 'Info' },
  fr: { main: 'Pages', tools: 'Outils', legal: 'Infos' },
  ru: { main: 'Страницы', tools: 'Инструменты', legal: 'Инфо' },
};

const tagline = taglineMap[lang] || taglineMap['en-GB'];
const cols = colTitles[lang] || colTitles['en-GB'];
---

<footer class="mt-24 bg-[rgb(var(--color-bg-secondary))]">
  <!-- Gradient top divider -->
  <div class="h-px bg-gradient-to-r from-transparent via-primary-500/50 to-transparent"></div>

  <div class="container mx-auto px-4 lg:px-8 py-12 lg:py-16">

    <!-- Main grid: 4 columns on desktop, 2 on tablet, 1 on mobile -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-12">

      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href={lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`}
          class="flex items-center gap-3 mb-3 group w-fit"
          aria-label="Alexander Carter — Home"
        >
          <img src="/img/branding/logo.png" alt="" class="w-10 h-10 rounded-xl dark:hidden flex-shrink-0" loading="lazy" decoding="async" />
          <img src="/img/branding/logo-dark.png" alt="" class="w-10 h-10 rounded-xl hidden dark:block flex-shrink-0" loading="lazy" decoding="async" />
          <span class="font-heading font-bold text-lg text-[rgb(var(--color-text-primary))] group-hover:text-primary-500 transition-colors tracking-tight leading-tight">
            Alexander Carter
          </span>
        </a>
        <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-5 leading-relaxed">
          {tagline}
        </p>
        <!-- Social links -->
        <div class="flex flex-wrap items-center gap-2">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="w-9 h-9 flex items-center justify-center rounded-lg bg-[rgb(var(--color-bg-primary))] border border-[rgb(var(--color-border))] text-[rgb(var(--color-text-secondary))] hover:border-primary-500 hover:text-primary-500 active:scale-95 transition-all duration-150"
                aria-label={social.name}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Pages column -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[rgb(var(--color-text-tertiary))] mb-4 select-none">
          {cols.main}
        </h3>
        <ul class="space-y-2.5">
          {
            mainLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 link-underline transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Tools column -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[rgb(var(--color-text-tertiary))] mb-4 select-none">
          {cols.tools}
        </h3>
        <ul class="space-y-2.5">
          {
            toolLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 link-underline transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal & contact column -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[rgb(var(--color-text-tertiary))] mb-4 select-none">
          {cols.legal}
        </h3>
        <ul class="space-y-2.5">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 link-underline transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 pt-5 border-t border-[rgb(var(--color-border))]">
          <a
            href="mailto:contact-us@alexander.xin"
            class="text-sm text-[rgb(var(--color-text-secondary))] hover:text-primary-500 transition-colors break-all leading-relaxed"
            aria-label={lang === 'zh-CN' ? '发送邮件' : 'Send email'}
          >
            contact-us@alexander.xin
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-[rgb(var(--color-border))] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-xs text-[rgb(var(--color-text-tertiary))]">
        © {currentYear} Alexander James Carter
      </p>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={getLangPath('/license')}
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] text-xs text-[rgb(var(--color-text-secondary))] hover:border-primary-500 hover:text-primary-500 transition-colors"
        >
          <span class="font-semibold">CC</span> BY-NC-ND 4.0
        </a>
        <a
          href="https://github.com/AlexanderJ-Carter"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] text-xs text-[rgb(var(--color-text-secondary))] hover:border-primary-500 hover:text-primary-500 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          GitHub
        </a>
        <a
          href={getLangPath('/accessibility')}
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] text-xs text-[rgb(var(--color-text-secondary))] hover:border-primary-500 hover:text-primary-500 transition-colors"
        >
          ♿ WCAG 2.1
        </a>
      </div>
    </div>

  </div>
</footer>
