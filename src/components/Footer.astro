---
import { getLangFromUrl } from '../i18n/ui';
import SiteFilings from './SiteFilings.astro';

const lang = getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();

function getLangPath(path: string) {
  return lang === 'zh-CN' ? path : `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

const i18n = {
  'zh-CN': {
    desc: '摄影、写作与开源工程的长期角落。',
    nav: '导航',
    legal: '说明',
    contact: '联系',
    support: '支持本站',
    gallery: '画廊',
    writing: '写作',
    projects: '项目',
    about: '关于',
    tools: '工具',
    fun: '彩蛋',
    privacy: '隐私',
    terms: '条款',
    license: '许可证',
    accessibility: '无障碍',
    security: '安全',
    sitemap: '地图',
  },
  'zh-TW': {
    desc: '攝影、寫作與開源工程的長期角落。',
    nav: '導航',
    legal: '說明',
    contact: '聯繫',
    support: '支持本站',
    gallery: '畫廊',
    writing: '寫作',
    projects: '專案',
    about: '關於',
    tools: '工具',
    fun: '彩蛋',
    privacy: '隱私',
    terms: '條款',
    license: '許可證',
    accessibility: '無障礙',
    security: '安全',
    sitemap: '地圖',
  },
  'en-GB': {
    desc: 'A long-running corner for photography, writing and open-source making.',
    nav: 'Navigate',
    legal: 'Notes',
    contact: 'Contact',
    support: 'Support',
    gallery: 'Gallery',
    writing: 'Writing',
    projects: 'Projects',
    about: 'About',
    tools: 'Tools',
    fun: 'Play',
    privacy: 'Privacy',
    terms: 'Terms',
    license: 'Licence',
    accessibility: 'Accessibility',
    security: 'Security',
    sitemap: 'Sitemap',
  },
  fr: {
    desc: 'Un coin durable pour la photo, l’écriture et l’open source.',
    nav: 'Naviguer',
    legal: 'Notes',
    contact: 'Contact',
    support: 'Soutenir',
    gallery: 'Galerie',
    writing: 'Écrits',
    projects: 'Projets',
    about: 'À propos',
    tools: 'Outils',
    fun: 'Surprises',
    privacy: 'Confidentialité',
    terms: 'Conditions',
    license: 'Licence',
    accessibility: 'Accessibilité',
    security: 'Sécurité',
    sitemap: 'Plan',
  },
  ru: {
    desc: 'Долгоживущий угол для фото, текстов и open source.',
    nav: 'Навигация',
    legal: 'Сведения',
    contact: 'Контакты',
    support: 'Поддержать',
    gallery: 'Галерея',
    writing: 'Статьи',
    projects: 'Проекты',
    about: 'Обо мне',
    tools: 'Инструменты',
    fun: 'Пасхалки',
    privacy: 'Приватность',
    terms: 'Условия',
    license: 'Лицензия',
    accessibility: 'Доступность',
    security: 'Безопасность',
    sitemap: 'Карта',
  },
};

const t = i18n[lang as keyof typeof i18n] || i18n['zh-CN'];

const primary = [
  { label: t.gallery, href: getLangPath('/gallery') },
  { label: t.writing, href: getLangPath('/writing') },
  { label: t.projects, href: getLangPath('/projects') },
  { label: t.about, href: getLangPath('/about') },
  { label: t.tools, href: getLangPath('/tools') },
  { label: t.fun, href: getLangPath('/fun') },
];

const legal = [
  { label: t.privacy, href: getLangPath('/privacy') },
  { label: t.terms, href: getLangPath('/terms') },
  { label: t.license, href: getLangPath('/license') },
  { label: t.accessibility, href: getLangPath('/accessibility') },
  { label: t.security, href: getLangPath('/security/policy') },
  { label: t.sitemap, href: getLangPath('/sitemap') },
];
---

<footer class="mt-24 border-t border-[rgb(var(--color-border))] relative">
  <div
    class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-14">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] items-start">
      <div>
        <a href={getLangPath('/')} class="inline-flex items-center gap-3 group">
          <img
            src="/img/branding/logo-96.webp"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 rounded-sm dark:hidden"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/img/branding/logo-dark-96.webp"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 rounded-sm hidden dark:block"
            loading="lazy"
            decoding="async"
          />
          <span
            class="font-heading font-bold tracking-tight group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
          >
            Alexander Carter
          </span>
        </a>
        <p
          class="mt-4 max-w-md text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]"
        >
          {t.desc}
        </p>
        <a
          href="mailto:contact-us@alexander.xin"
          class="mt-4 inline-flex text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
        >
          {t.contact}: contact-us@alexander.xin
        </a>
      </div>

      <nav aria-label={t.nav} class="lg:justify-self-end">
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-heading">
          {
            primary.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[rgb(var(--color-text-secondary))] hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 pt-6 border-t border-[rgb(var(--color-border))] flex flex-col gap-4"
    >
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="text-xs text-[rgb(var(--color-text-tertiary))]">
            © {currentYear} Alexander James Carter
          </p>
          <a
            href={getLangPath('/support')}
            class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
          >
            {t.support}
          </a>
          <a href={getLangPath('/license')} class="footer-chip"
            >CC BY-NC-ND 4.0</a
          >
          <a href={getLangPath('/accessibility')} class="footer-chip">
            {t.accessibility}
          </a>
        </div>

        <nav aria-label={t.legal}>
          <ul
            class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[rgb(var(--color-text-tertiary))]"
          >
            {
              legal.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-[rgb(var(--color-text-secondary))] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <SiteFilings />
    </div>
  </div>
</footer>

<style>
  .footer-chip {
    width: fit-content;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    background: transparent;
    color: rgb(var(--color-text-tertiary));
    padding: 0.25rem 0.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .footer-chip:hover {
    color: rgb(var(--color-text-secondary));
    border-color: rgb(var(--color-accent) / 0.4);
  }
</style>
