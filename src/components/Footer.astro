---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();

function getLangPath(path: string) {
  return lang === 'zh-CN' ? path : `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

const i18n = {
  'zh-CN': {
    desc: '个人网站、项目、札记与工具的入口。页脚只保留真正有用的路径。',
    explore: '站内',
    projects: '我的项目',
    policy: '说明',
    contact: '联系',
  },
  'zh-TW': {
    desc: '個人網站、專案、札記與工具的入口。頁腳只保留真正有用的路徑。',
    explore: '站內',
    projects: '我的專案',
    policy: '說明',
    contact: '聯繫',
  },
  'en-GB': {
    desc: 'A compact entrance to the site, projects, notes and utilities.',
    explore: 'Explore',
    projects: 'My Projects',
    policy: 'Notes',
    contact: 'Contact',
  },
  fr: {
    desc: 'Entrée compacte vers le site, les projets, les notes et les outils.',
    explore: 'Explorer',
    projects: 'Mes projets',
    policy: 'Notes',
    contact: 'Contact',
  },
  ru: {
    desc: 'Компактный вход к сайту, проектам, заметкам и инструментам.',
    explore: 'Сайт',
    projects: 'Проекты',
    policy: 'Сведения',
    contact: 'Контакты',
  },
};

const t = i18n[lang as keyof typeof i18n] || i18n['zh-CN'];

const exploreLinks = [
  {
    label: lang === 'zh-CN' ? '首页' : lang === 'zh-TW' ? '首頁' : 'Home',
    href: getLangPath('/'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '项目'
        : lang === 'zh-TW'
          ? '專案'
          : lang === 'fr'
            ? 'Projets'
            : lang === 'ru'
              ? 'Проекты'
              : 'Projects',
    href: getLangPath('/projects'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '札记'
        : lang === 'zh-TW'
          ? '札記'
          : lang === 'ru'
            ? 'Заметки'
            : 'Notes',
    href: getLangPath('/notes'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '画廊'
        : lang === 'zh-TW'
          ? '畫廊'
          : lang === 'fr'
            ? 'Galerie'
            : lang === 'ru'
              ? 'Галерея'
              : 'Gallery',
    href: getLangPath('/gallery'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '参考'
        : lang === 'zh-TW'
          ? '參考'
          : lang === 'fr'
            ? 'Références'
            : lang === 'ru'
              ? 'Ссылки'
              : 'References',
    href: getLangPath('/friends'),
  },
];

const projectLinks = [
  { label: 'MyCook', href: 'https://cook.alexander.xin' },
  { label: 'Linux Command', href: 'https://linux-command.alexander.xin' },
  { label: 'NetQ', href: 'https://netq.alexander.xin' },
  { label: 'Tool Hub', href: 'https://tools.alexander.xin' },
  { label: 'GitHub', href: 'https://github.com/AlexanderJ-Carter' },
];

const policyLinks = [
  {
    label:
      lang === 'zh-CN'
        ? '隐私'
        : lang === 'zh-TW'
          ? '隱私'
          : lang === 'fr'
            ? 'Confidentialité'
            : lang === 'ru'
              ? 'Приватность'
              : 'Privacy',
    href: getLangPath('/privacy'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '条款'
        : lang === 'zh-TW'
          ? '條款'
          : lang === 'fr'
            ? 'Conditions'
            : lang === 'ru'
              ? 'Условия'
              : 'Terms',
    href: getLangPath('/terms'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '安全'
        : lang === 'zh-TW'
          ? '安全'
          : lang === 'fr'
            ? 'Sécurité'
            : lang === 'ru'
              ? 'Безопасность'
              : 'Security',
    href: getLangPath('/security/policy'),
  },
  {
    label:
      lang === 'zh-CN'
        ? '网站地图'
        : lang === 'zh-TW'
          ? '網站地圖'
          : lang === 'fr'
            ? 'Plan du site'
            : lang === 'ru'
              ? 'Карта сайта'
              : 'Sitemap',
    href: getLangPath('/sitemap'),
  },
];
---

<footer class="mt-24 border-t border-[rgb(var(--color-border))]">
  <div class="container mx-auto px-4 lg:px-8 py-10">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_2fr] items-start">
      <div>
        <a href={getLangPath('/')} class="inline-flex items-center gap-3">
          <img
            src="/img/branding/logo-96.webp"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 rounded-xl dark:hidden"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/img/branding/logo-dark-96.webp"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 rounded-xl hidden dark:block"
            loading="lazy"
            decoding="async"
          />
          <span
            class="font-heading font-bold text-[rgb(var(--color-text-primary))]"
          >
            Alexander Carter
          </span>
        </a>
        <p
          class="mt-4 max-w-sm text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]"
        >
          {t.desc}
        </p>
        <a
          href="mailto:contact-us@alexander.xin"
          class="mt-4 inline-flex text-sm font-medium text-primary-500 hover:text-primary-600"
        >
          {t.contact}: contact-us@alexander.xin
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <nav aria-label={t.explore}>
          <h2 class="footer-heading">{t.explore}</h2>
          <div class="footer-list">
            {exploreLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </nav>

        <nav aria-label={t.projects}>
          <h2 class="footer-heading">{t.projects}</h2>
          <div class="footer-list">
            {
              projectLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))
            }
          </div>
        </nav>

        <nav aria-label={t.policy}>
          <h2 class="footer-heading">{t.policy}</h2>
          <div class="footer-list">
            {policyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </nav>
      </div>
    </div>

    <div
      class="mt-10 pt-6 border-t border-[rgb(var(--color-border))] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
    >
      <p class="text-xs text-[rgb(var(--color-text-tertiary))]">
        © {currentYear} Alexander James Carter
      </p>
      <a href={getLangPath('/license')} class="footer-chip">CC BY-NC-ND 4.0</a>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    margin-bottom: 0.8rem;
    color: rgb(var(--color-text-tertiary));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-list {
    display: grid;
    gap: 0.55rem;
  }

  .footer-list a {
    width: fit-content;
    color: rgb(var(--color-text-secondary));
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .footer-list a:hover {
    color: rgb(14 165 233);
  }

  .footer-chip {
    width: fit-content;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.65rem;
    background: rgb(var(--color-bg-secondary));
    color: rgb(var(--color-text-secondary));
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
  }
</style>
