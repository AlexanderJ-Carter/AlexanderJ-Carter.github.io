---
/**
 * GitHub 活动卡片组件
 * 显示最近的 GitHub 活动
 */

interface Props {
  username?: string;
  lang?: string;
}

const { username = 'AlexanderJ-Carter', lang = 'zh-CN' } = Astro.props;

const githubText = {
  'zh-CN': {
    title: 'GitHub 活动',
    commits: '次提交',
    stars: '颗星',
    forks: '次复刻',
    repos: '个仓库',
    followers: '关注者',
    loading: '加载中...',
    viewProfile: '查看主页',
  },
  'zh-TW': {
    title: 'GitHub 活動',
    commits: '次提交',
    stars: '顆星',
    forks: '次複製',
    repos: '個倉庫',
    followers: '關注者',
    loading: '載入中...',
    viewProfile: '查看主頁',
  },
  'en-GB': {
    title: 'GitHub Activity',
    commits: 'commits',
    stars: 'stars',
    forks: 'forks',
    repos: 'repos',
    followers: 'followers',
    loading: 'Loading...',
    viewProfile: 'View Profile',
  },
  fr: {
    title: 'Activité GitHub',
    commits: 'commits',
    stars: 'étoiles',
    forks: 'forks',
    repos: 'dépôts',
    followers: 'abonnés',
    loading: 'Chargement...',
    viewProfile: 'Voir le Profil',
  },
  ru: {
    title: 'Активность GitHub',
    commits: 'коммитов',
    stars: 'звёзд',
    forks: 'форков',
    repos: 'репозиториев',
    followers: 'подписчиков',
    loading: 'Загрузка...',
    viewProfile: 'Профиль',
  },
};

const t = githubText[lang as keyof typeof githubText] || githubText['en-GB'];
---

<div
  id="github-card"
  class="github-widget glass-card rounded-2xl p-6 shadow-xl max-w-md"
>
  <div class="flex items-center gap-4 mb-6">
    <div class="relative">
      <img
        id="github-avatar"
        src="https://github.com/identicons/{username}.png"
        alt="GitHub Avatar"
        class="w-16 h-16 rounded-full"
      />
      <div
        class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white dark:border-gray-800"
      >
      </div>
    </div>
    <div class="flex-1">
      <h3 class="text-lg font-bold" id="github-name">{username}</h3>
      <p
        class="text-sm text-[rgb(var(--color-text-secondary))]"
        id="github-bio"
      >
        {t.loading}
      </p>
    </div>
  </div>

  <!-- 统计数据 -->
  <div class="grid grid-cols-4 gap-4 mb-6">
    <div class="text-center">
      <div class="text-2xl font-bold text-primary-500" id="github-repos">
        --
      </div>
      <div class="text-xs text-[rgb(var(--color-text-tertiary))]">
        {t.repos}
      </div>
    </div>
    <div class="text-center">
      <div class="text-2xl font-bold text-yellow-500" id="github-stars">--</div>
      <div class="text-xs text-[rgb(var(--color-text-tertiary))]">
        {t.stars}
      </div>
    </div>
    <div class="text-center">
      <div class="text-2xl font-bold text-blue-500" id="github-forks">--</div>
      <div class="text-xs text-[rgb(var(--color-text-tertiary))]">
        {t.forks}
      </div>
    </div>
    <div class="text-center">
      <div class="text-2xl font-bold text-purple-500" id="github-followers">
        --
      </div>
      <div class="text-xs text-[rgb(var(--color-text-tertiary))]">
        {t.followers}
      </div>
    </div>
  </div>

  <!-- 最近活动 -->
  <div class="mb-4">
    <h4 class="text-sm font-semibold mb-3">{t.title}</h4>
    <div id="github-activity" class="space-y-3">
      <!-- 活动将通过 JS 填充 -->
      <div class="text-center text-sm text-[rgb(var(--color-text-tertiary))]">
        {t.loading}
      </div>
    </div>
  </div>

  <!-- 查看主页 -->
  <a
    href="https://github.com/{username}"
    target="_blank"
    rel="noopener noreferrer"
    class="block w-full py-2 px-4 text-center bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-gray-200 text-white dark:text-gray-900 rounded-lg font-medium transition-colors"
  >
    {t.viewProfile}
  </a>
</div>

<style>
  .github-widget {
    background: linear-gradient(
      135deg,
      rgba(24, 23, 23, 0.05) 0%,
      rgba(36, 41, 46, 0.05) 100%
    );
  }

  .activity-item {
    @apply flex items-start gap-3 p-2 rounded-lg hover:bg-white/10 transition-colors;
  }

  .activity-icon {
    @apply w-5 h-5 flex-shrink-0;
  }

  .activity-content {
    @apply flex-1 min-w-0;
  }

  .activity-repo {
    @apply text-sm font-medium truncate;
  }

  .activity-desc {
    @apply text-xs text-[rgb(var(--color-text-tertiary))] truncate;
  }

  .activity-time {
    @apply text-xs text-[rgb(var(--color-text-tertiary))] flex-shrink-0;
  }
</style>

<script is:inline define:vars={{ username }}>
  async function fetchGitHubData() {
    try {
      // 获取用户信息
      const userResponse = await fetch(
        `https://api.github.com/users/${username}`
      );
      const userData = await userResponse.json();

      // 更新UI
      document.getElementById('github-avatar').src = userData.avatar_url;
      document.getElementById('github-name').textContent =
        userData.name || userData.login;
      document.getElementById('github-bio').textContent = userData.bio || '';
      document.getElementById('github-repos').textContent =
        userData.public_repos;
      document.getElementById('github-followers').textContent =
        userData.followers;

      // 获取仓库统计
      const reposResponse = await fetch(
        `https://api.github.com/users/${username}/repos?per_page=100`
      );
      const reposData = await reposResponse.json();

      const stars = reposData.reduce(
        (sum, repo) => sum + repo.stargazers_count,
        0
      );
      const forks = reposData.reduce((sum, repo) => sum + repo.forks_count, 0);

      document.getElementById('github-stars').textContent = stars;
      document.getElementById('github-forks').textContent = forks;

      // 获取最近活动
      const eventsResponse = await fetch(
        `https://api.github.com/users/${username}/events/public?per_page=5`
      );
      const eventsData = await eventsResponse.json();

      displayActivities(eventsData);
    } catch (error) {
      console.error('GitHub API Error:', error);
    }
  }

  function displayActivities(events) {
    const container = document.getElementById('github-activity');
    container.innerHTML = '';

    events.slice(0, 5).forEach((event) => {
      const item = document.createElement('div');
      item.className = 'activity-item';

      const time = new Date(event.created_at);
      const timeAgo = getTimeAgo(time);

      const icon = getActivityIcon(event.type);
      const desc = getActivityDescription(event);

      item.innerHTML = `
        <div class="activity-icon">${icon}</div>
        <div class="activity-content">
          <div class="activity-repo">${event.repo.name}</div>
          <div class="activity-desc">${desc}</div>
        </div>
        <div class="activity-time">${timeAgo}</div>
      `;

      container.appendChild(item);
    });
  }

  function getActivityIcon(type) {
    const icons = {
      PushEvent: '🚀',
      CreateEvent: '✨',
      DeleteEvent: '🗑️',
      IssuesEvent: '❓',
      IssueCommentEvent: '💬',
      WatchEvent: '⭐',
      ForkEvent: '🍴',
      PullRequestEvent: '🔄',
    };
    return icons[type] || '📝';
  }

  function getActivityDescription(event) {
    switch (event.type) {
      case 'PushEvent':
        return `推送了 ${event.payload.size} 次提交`;
      case 'CreateEvent':
        return `创建了 ${event.payload.ref_type}`;
      case 'DeleteEvent':
        return `删除了 ${event.payload.ref_type}`;
      case 'IssuesEvent':
        return `${event.payload.action} 了一个 Issue`;
      case 'IssueCommentEvent':
        return '发表了评论';
      case 'WatchEvent':
        return 'Star 了仓库';
      case 'ForkEvent':
        return 'Fork 了仓库';
      case 'PullRequestEvent':
        return `${event.payload.action} 了 Pull Request`;
      default:
        return event.type;
    }
  }

  function getTimeAgo(date) {
    const seconds = Math.floor((new Date() - date) / 1000);

    const intervals = {
      年: 31536000,
      月: 2592000,
      周: 604800,
      天: 86400,
      小时: 3600,
      分钟: 60,
    };

    for (const [unit, secondsInUnit] of Object.entries(intervals)) {
      const interval = Math.floor(seconds / secondsInUnit);
      if (interval >= 1) {
        return `${interval}${unit}前`;
      }
    }

    return '刚刚';
  }

  fetchGitHubData();

  // 每5分钟更新一次
  setInterval(fetchGitHubData, 5 * 60 * 1000);
</script>
