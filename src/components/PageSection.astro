---
/**
 * 页面区块：语义化 section，可选标题与交替背景，便于统一版式与无障碍。
 */
interface Props {
  id?: string;
  title?: string;
  /** 是否使用浅色背景（与主背景交替） */
  alt?: boolean;
  class?: string;
  /** 标题等级 */
  headingLevel?: 1 | 2 | 3;
}

const {
  id,
  title,
  alt = false,
  class: className = '',
  headingLevel = 2,
} = Astro.props;
const HeadingTag = `h${headingLevel}` as 'h1' | 'h2' | 'h3';
---

<section
  id={id}
  class:list={[
    'py-12 lg:py-16',
    alt ? 'bg-[rgb(var(--color-bg-secondary))]' : '',
    className,
  ]}
  aria-labelledby={id && title ? `${id}-heading` : undefined}
>
  <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
    {
      title && (
        <HeadingTag
          id={id ? `${id}-heading` : undefined}
          class="font-heading font-bold text-2xl md:text-3xl text-[rgb(var(--color-text-primary))] mb-6"
        >
          {title}
        </HeadingTag>
      )
    }
    <slot />
  </div>
</section>
