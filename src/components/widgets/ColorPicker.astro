---
/**
 * 颜色选择器组件
 * 取色、色彩转换、调色板生成
 */

interface Props {
  lang?: string;
}

const { lang = 'zh-CN' } = Astro.props;

const colorText = {
  'zh-CN': {
    title: '颜色选择器',
    pick: '选取颜色',
    hex: '十六进制',
    rgb: 'RGB',
    hsl: 'HSL',
    copy: '复制',
    copied: '已复制',
    palette: '调色板',
    generate: '生成调色板',
  },
  'zh-TW': {
    title: '顏色選擇器',
    pick: '選取顏色',
    hex: '十六進制',
    rgb: 'RGB',
    hsl: 'HSL',
    copy: '複製',
    copied: '已複製',
    palette: '調色板',
    generate: '生成調色板',
  },
  'en-GB': {
    title: 'Color Picker',
    pick: 'Pick Color',
    hex: 'HEX',
    rgb: 'RGB',
    hsl: 'HSL',
    copy: 'Copy',
    copied: 'Copied',
    palette: 'Palette',
    generate: 'Generate Palette',
  },
  fr: {
    title: 'Sélecteur de Couleur',
    pick: 'Choisir',
    hex: 'HEX',
    rgb: 'RGB',
    hsl: 'HSL',
    copy: 'Copier',
    copied: 'Copié',
    palette: 'Palette',
    generate: 'Générer',
  },
  ru: {
    title: 'Выбор Цвета',
    pick: 'Выбрать',
    hex: 'HEX',
    rgb: 'RGB',
    hsl: 'HSL',
    copy: 'Копировать',
    copied: 'Скопировано',
    palette: 'Палитра',
    generate: 'Генерировать',
  },
};

const t = colorText[lang as keyof typeof colorText] || colorText['zh-CN'];
---

<div
  id="color-picker"
  class="color-widget glass-card p-6 max-w-md"
>
  <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
    {t.title}
  </h3>

  <!-- 颜色选择 -->
  <div class="mb-6">
    <div
      class="relative h-32 rounded-xl overflow-hidden mb-4 cursor-pointer"
      id="color-preview"
      style="background: #0ea5e9"
    >
      <input
        type="color"
        id="color-input"
        value="#0ea5e9"
        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
      />
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="text-white text-2xl font-mono font-bold drop-shadow-lg"
          id="color-hex-display">#0ea5e9</span
        >
      </div>
    </div>

    <!-- 颜色值 -->
    <div class="space-y-3">
      <!-- HEX -->
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium w-16">{t.hex}</span>
        <input
          type="text"
          id="hex-value"
          value="#0ea5e9"
          readonly
          class="flex-1 px-3 py-2 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded font-mono text-sm"
        />
        <button
          class="copy-btn px-3 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded text-sm"
          data-target="hex-value">{t.copy}</button
        >
      </div>

      <!-- RGB -->
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium w-16">{t.rgb}</span>
        <input
          type="text"
          id="rgb-value"
          value="rgb(14, 165, 233)"
          readonly
          class="flex-1 px-3 py-2 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded font-mono text-sm"
        />
        <button
          class="copy-btn px-3 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded text-sm"
          data-target="rgb-value">{t.copy}</button
        >
      </div>

      <!-- HSL -->
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium w-16">{t.hsl}</span>
        <input
          type="text"
          id="hsl-value"
          value="hsl(199, 89%, 48%)"
          readonly
          class="flex-1 px-3 py-2 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded font-mono text-sm"
        />
        <button
          class="copy-btn px-3 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded text-sm"
          data-target="hsl-value">{t.copy}</button
        >
      </div>
    </div>
  </div>

  <!-- 调色板生成 -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h4 class="text-sm font-semibold">{t.palette}</h4>
      <button
        id="generate-palette"
        type="button"
        class="px-4 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded-sm text-sm font-medium transition-all"
      >
        {t.generate}
      </button>
    </div>
    <div id="palette-display" class="grid grid-cols-5 gap-2">
      <!-- 调色板颜色将通过 JS 填充 -->
    </div>
  </div>
</div>

<style>
  .color-widget {
    background: linear-gradient(
      135deg,
      rgba(236, 72, 153, 0.05) 0%,
      rgba(168, 85, 247, 0.05) 100%
    );
  }

  #color-preview:hover {
    transform: scale(1.02);
    transition: transform 0.2s;
  }

  .palette-color {
    @apply aspect-square rounded-lg cursor-pointer transition-transform hover:scale-110 relative;
  }

  .palette-color::after {
    content: '';
    @apply absolute inset-0 rounded-lg border-2 border-white/50 opacity-0 hover:opacity-100 transition-opacity;
  }
</style>

<script is:inline>
  const colorInput = document.getElementById('color-input');
  const colorPreview = document.getElementById('color-preview');
  const colorHexDisplay = document.getElementById('color-hex-display');
  const hexValue = document.getElementById('hex-value');
  const rgbValue = document.getElementById('rgb-value');
  const hslValue = document.getElementById('hsl-value');
  const generatePaletteBtn = document.getElementById('generate-palette');
  const paletteDisplay = document.getElementById('palette-display');

  // 更新颜色值
  function updateColorValues(hex) {
    // 更新预览
    colorPreview.style.background = hex;
    colorHexDisplay.textContent = hex;

    // HEX
    hexValue.value = hex.toUpperCase();

    // RGB
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    rgbValue.value = `rgb(${r}, ${g}, ${b})`;

    // HSL
    const hsl = rgbToHsl(r, g, b);
    hslValue.value = `hsl(${hsl[0]}, ${hsl[1]}%, ${hsl[2]}%)`;

    // 更新预览文字颜色（根据背景亮度）
    const brightness = (r * 299 + g * 587 + b * 114) / 1000;
    colorHexDisplay.style.color = brightness > 128 ? '#000' : '#fff';
  }

  // RGB 转 HSL
  function rgbToHsl(r, g, b) {
    r /= 255;
    g /= 255;
    b /= 255;

    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    let h = 0;
    let s = 0;
    const l = (max + min) / 2;

    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);

      switch (max) {
        case r:
          h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
          break;
        case g:
          h = ((b - r) / d + 2) / 6;
          break;
        case b:
          h = ((r - g) / d + 4) / 6;
          break;
      }
    }

    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  // 生成调色板
  function generatePalette() {
    paletteDisplay.innerHTML = '';

    for (let i = 0; i < 5; i++) {
      const hue = Math.floor(Math.random() * 360);
      const sat = Math.floor(Math.random() * 40) + 60;
      const light = Math.floor(Math.random() * 30) + 35;

      const color = document.createElement('div');
      color.className = 'palette-color';
      color.style.background = `hsl(${hue}, ${sat}%, ${light}%)`;
      color.title = `HSL(${hue}, ${sat}%, ${light}%)`;

      // 点击复制颜色
      color.addEventListener('click', () => {
        const hslColor = `hsl(${hue}, ${sat}%, ${light}%)`;
        navigator.clipboard.writeText(hslColor);
        color.style.transform = 'scale(1.2)';
        setTimeout(() => {
          color.style.transform = '';
        }, 200);
      });

      paletteDisplay.appendChild(color);
    }
  }

  // 颜色选择事件
  colorInput.addEventListener('input', (e) => {
    const target = e.target;
    updateColorValues(target.value);
  });

  // 复制按钮
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.target;
      const targetId = target.dataset.target;
      const input = document.getElementById(targetId);

      try {
        await navigator.clipboard.writeText(input.value);
        const originalText = target.textContent;
        target.textContent = '已复制';
        target.classList.add('bg-green-500');

        setTimeout(() => {
          target.textContent = originalText;
          target.classList.remove('bg-green-500');
        }, 1000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    });
  });

  // 生成调色板
  generatePaletteBtn?.addEventListener('click', generatePalette);

  // 初始化
  updateColorValues(colorInput.value);
  generatePalette();
</script>
