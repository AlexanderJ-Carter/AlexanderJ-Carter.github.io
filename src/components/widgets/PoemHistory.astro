---
import { onThisDayEvents, pickOnThisDay } from '../../data/on-this-day';

// 诗词和历史上的今天组件
const lang = Astro.props.lang || 'zh-CN';
const isZh = lang === 'zh-CN' || lang === 'zh-TW';

const now = new Date();
const monthNum = now.getMonth() + 1;
const dayNum = now.getDate();
const historyEvent = pickOnThisDay(monthNum, dayNum);
const historyText = historyEvent
  ? isZh
    ? historyEvent.zh
    : historyEvent.en
  : isZh
    ? '今天暂无收录事件'
    : 'No curated event for today';
const historyDateLabel = isZh
  ? `${historyEvent?.year ? historyEvent.year + '年 · ' : ''}${monthNum}月${dayNum}日`
  : `${monthNum}/${dayNum}${historyEvent?.year ? ' · ' + historyEvent.year : ''}`;

const dayPool = onThisDayEvents.filter(
  (e) => e.month === monthNum && e.day === dayNum
);
const historyPoolJson = JSON.stringify(
  (dayPool.length > 0 ? dayPool : historyEvent ? [historyEvent] : []).map(
    (e) => ({
      year: e.year,
      text: isZh ? e.zh : e.en,
    })
  )
);

// Curated quotes for non-Chinese visitors (grouped by language for variety)
const internationalQuotes: Record<
  string,
  { text: string; author: string; source?: string }[]
> = {
  'en-GB': [
    {
      text: 'A photograph is a certificate of presence.',
      author: 'Roland Barthes',
      source: 'Camera Lucida',
    },
    {
      text: 'Photography is the art of frozen time — the ability to store emotion and feelings within a frame.',
      author: 'Meshack Otieno',
    },
    {
      text: 'Light makes photography. Embrace light. Admire it. Love it. But above all, know light.',
      author: 'George Eastman',
    },
    {
      text: 'The best camera is the one you have with you.',
      author: 'Chase Jarvis',
    },
    {
      text: 'Simplicity is the ultimate sophistication.',
      author: 'Leonardo da Vinci',
    },
    {
      text: 'Perfection is achieved not when there is nothing more to add, but when there is nothing left to take away.',
      author: 'Antoine de Saint-Exupéry',
    },
    {
      text: 'The purpose of art is washing the dust of daily life off our souls.',
      author: 'Pablo Picasso',
    },
    {
      text: 'In photography there is a reality so subtle that it becomes more real than reality.',
      author: 'Alfred Stieglitz',
    },
  ],
  fr: [
    {
      text: "Une photographie, c'est un certificat de présence.",
      author: 'Roland Barthes',
      source: 'La chambre claire',
    },
    {
      text: "La perfection est atteinte, non pas lorsqu'il n'y a plus rien à ajouter, mais lorsqu'il n'y a plus rien à enlever.",
      author: 'Antoine de Saint-Exupéry',
    },
    {
      text: 'La simplicité est la sophistication suprême.',
      author: 'Léonard de Vinci',
    },
    {
      text: "L'imagination est plus importante que le savoir.",
      author: 'Albert Einstein',
    },
    {
      text: 'La lumière est la matière première de la photographie.',
      author: 'Ansel Adams',
    },
    { text: 'Chaque image est une histoire.', author: 'Henri Cartier-Bresson' },
  ],
  ru: [
    {
      text: 'Совершенство достигается не тогда, когда нечего добавить, а тогда, когда нечего убрать.',
      author: 'Антуан де Сент-Экзюпери',
    },
    { text: 'Воображение важнее знания.', author: 'Альберт Эйнштейн' },
    {
      text: 'Простота — это высшая степень изощрённости.',
      author: 'Леонардо да Винчи',
    },
    { text: 'Фотография — это сертификат присутствия.', author: 'Ролан Барт' },
    { text: 'Свет — это живопись, написанная мгновением.', author: 'Man Ray' },
  ],
};

const sectionTitle = isZh
  ? '每日灵感'
  : lang === 'fr'
    ? 'Inspiration du jour'
    : lang === 'ru'
      ? 'Вдохновение дня'
      : 'Daily Inspiration';

const sectionSubtitle = isZh
  ? '诗词与历史的交织，为生活注入文化气息'
  : lang === 'fr'
    ? 'Citations et histoire se croisent pour enrichir le quotidien'
    : lang === 'ru'
      ? 'Цитаты и история переплетаются, привнося культуру в жизнь'
      : 'Quotes and history intertwined, enriching life with culture';

const poemTitle = isZh
  ? '今日诗词'
  : lang === 'fr'
    ? 'Citation du jour'
    : lang === 'ru'
      ? 'Цитата дня'
      : 'Quote of the Day';

const historyTitle = isZh
  ? '历史上的今天'
  : lang === 'fr'
    ? "Ce jour dans l'histoire"
    : lang === 'ru'
      ? 'В этот день'
      : 'On This Day';

const poemLoadingText = isZh ? '载入诗词中...' : '...';
const historyShuffleLabel = isZh
  ? '换一条'
  : lang === 'fr'
    ? 'Une autre'
    : lang === 'ru'
      ? 'Другая'
      : 'Another';

// Pass quotes to client script as JSON
const intlQuotesJson = JSON.stringify(
  internationalQuotes[lang] || internationalQuotes['en-GB']
);
---

<section
  class="py-20 md:py-28 relative overflow-hidden border-y border-[rgb(var(--color-border))]"
>
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="mb-12 max-w-2xl">
      <p class="folio-mark mb-3">Plate Daily</p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold tracking-tight mb-3"
      >
        {sectionTitle}
      </h2>
      <p class="text-[rgb(var(--color-text-secondary))] text-lg">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- 诗词/Quote部分 -->
      <div class="glass-card p-8 h-full">
        <p class="folio-mark mb-4 text-center">Quote</p>
        <h3 class="font-heading text-2xl font-bold text-center mb-6">
          {poemTitle}
        </h3>
        <div class="text-center min-h-[120px] flex flex-col justify-center">
          {
            isZh ? (
              <>
                <div
                  id="poem_sentence"
                  class="text-xl md:text-2xl font-medium mb-4 text-[rgb(var(--color-text-primary))] leading-relaxed"
                >
                  {poemLoadingText}
                </div>
                <div class="ink-rule my-4" />
                <div
                  id="poem_info"
                  class="text-sm text-[rgb(var(--color-text-secondary))]"
                />
              </>
            ) : (
              <div id="intl-quote-block" class="text-center">
                <p
                  id="intl-quote-text"
                  class="text-lg md:text-xl font-medium mb-4 text-[rgb(var(--color-text-primary))] leading-relaxed italic"
                >
                  ...
                </p>
                <div class="ink-rule my-4" />
                <p
                  id="intl-quote-author"
                  class="text-sm text-[rgb(var(--color-text-secondary))]"
                />
              </div>
            )
          }
        </div>
      </div>

      <!-- 历史上的今天 -->
      <div class="glass-card p-8 h-full">
        <p class="folio-mark mb-4 text-center">On this day</p>
        <h3 class="font-heading text-2xl font-bold text-center mb-6">
          {historyTitle}
        </h3>
        <div
          id="history-today"
          class="text-center min-h-[120px] flex flex-col justify-center"
        >
          <div
            id="history-date"
            class="history-date text-lg font-semibold mb-3 text-[rgb(var(--color-text-primary))]"
          >
            {historyDateLabel}
          </div>
          <div
            id="history-event"
            class="history-event text-[rgb(var(--color-text-secondary))] leading-relaxed"
          >
            {historyText}
          </div>
          {
            dayPool.length > 1 && (
              <button
                type="button"
                id="history-shuffle"
                class="mt-5 mx-auto text-sm font-heading text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
              >
                {historyShuffleLabel}
              </button>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // jinrishici is global

  function initPoemAndHistory() {
    const lang = document.documentElement.lang || 'zh-CN';
    const isZh = lang.startsWith('zh');

    // 加载诗词（只在中文环境下）
    if (isZh) {
      if (typeof jinrishici !== 'undefined') {
        jinrishici.load(function (result) {
          const sentence = document.querySelector('#poem_sentence');
          const info = document.querySelector('#poem_info');

          if (sentence && info && result && result.data) {
            const origin = result.data.origin || {};
            sentence.textContent = result.data.content || '';
            info.textContent = `【${origin.dynasty || ''}】${origin.author || ''}《${origin.title || ''}》`;

            sentence.style.opacity = '0';
            info.style.opacity = '0';

            setTimeout(() => {
              sentence.style.transition = 'opacity 0.8s ease';
              sentence.style.opacity = '1';
            }, 300);

            setTimeout(() => {
              info.style.transition = 'opacity 0.8s ease';
              info.style.opacity = '1';
            }, 600);
          }
        });
      }
    } else {
      // 非中文：从全局注入的引言库随机选一条
      var all = window.__intlQuotes || [];
      if (Array.isArray(all) && all.length > 0) {
        var pick = all[Math.floor(Math.random() * all.length)];
        var textEl = document.getElementById('intl-quote-text');
        var authorEl = document.getElementById('intl-quote-author');
        if (textEl) {
          textEl.textContent = '\u201C' + pick.text + '\u201D';
          textEl.style.opacity = '0';
          setTimeout(function () {
            textEl.style.transition = 'opacity 0.8s ease';
            textEl.style.opacity = '1';
          }, 100);
        }
        if (authorEl) {
          var src = pick.source
            ? pick.author + ', ' + pick.source
            : pick.author;
          authorEl.textContent = '— ' + src;
          authorEl.style.opacity = '0';
          setTimeout(function () {
            authorEl.style.transition = 'opacity 0.8s ease';
            authorEl.style.opacity = '1';
          }, 400);
        }
      }
    }

    // 历史上的今天：本地精选，可换一条
    var pool = window.__historyPool || [];
    var shuffleBtn = document.getElementById('history-shuffle');
    var dateEl = document.getElementById('history-date');
    var eventEl = document.getElementById('history-event');
    if (shuffleBtn && pool.length > 1 && dateEl && eventEl) {
      shuffleBtn.addEventListener('click', function () {
        var item = pool[Math.floor(Math.random() * pool.length)];
        var month = new Date().getMonth() + 1;
        var day = new Date().getDate();
        dateEl.textContent = isZh
          ? (item.year ? item.year + '年 · ' : '') + month + '月' + day + '日'
          : month + '/' + day + (item.year ? ' · ' + item.year : '');
        eventEl.textContent = item.text;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPoemAndHistory);
  } else {
    initPoemAndHistory();
  }
</script>

{
  isZh && (
    <script
      is:inline
      src="https://sdk.jinrishici.com/v2/browser/jinrishici.js"
      async
    />
  )
}

{
  !isZh && (
    <script is:inline define:vars={{ intlQuotesJson }}>
      window.__intlQuotes = JSON.parse(intlQuotesJson || '[]');
    </script>
  )
}

<script is:inline define:vars={{ historyPoolJson }}>
  window.__historyPool = JSON.parse(historyPoolJson || '[]');
</script>
