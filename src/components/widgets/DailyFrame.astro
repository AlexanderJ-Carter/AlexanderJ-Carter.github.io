    subtitle: 'Один кадр в день — свои и гостевые по очереди.',
    credit: 'Источник',
  },
} as const;

const t = ui[lang as keyof typeof ui] || ui['en-GB'];
const framesJson = JSON.stringify(frames);
---

<article
  class="glass-card p-0 overflow-hidden reveal md:col-span-2"
  data-daily-frame
  data-lang={L}
  data-credit-label={t.credit}
>
  <script
    is:inline
    type="application/json"
    data-daily-frames
    set:html={framesJson}
  />
  <div class="grid md:grid-cols-2 gap-0">
    <div
      class="contact-sheet relative aspect-[4/3] md:aspect-auto md:min-h-[280px]"
    >
      <span class="contact-sheet-frame">01</span>
      <img
        data-daily-img
        src={frame.image}
        alt={frame.title[L]}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </div>
    <div class="p-6 md:p-8 flex flex-col justify-center">
      <p class="folio-mark mb-2">{t.folio}</p>
      <h2 class="font-heading text-xl md:text-2xl font-bold mb-2">{t.title}</h2>
      <p class="text-sm text-[rgb(var(--color-text-secondary))] mb-5">
        {t.subtitle}
      </p>
      <h3 class="font-heading text-lg font-semibold mb-2" data-daily-title>
        {frame.title[L]}
      </h3>
      <p
        class="text-[rgb(var(--color-text-secondary))] leading-relaxed mb-4"
        data-daily-note
      >
        {frame.note[L]}
      </p>
      <p
        class="meta-mono text-xs text-[rgb(var(--color-text-tertiary))] hidden"
        data-daily-credit
      >
      </p>
    </div>
  </div>
</article>

<script>
  function applyDailyFrame(root: HTMLElement) {
    const payload = root.querySelector('[data-daily-frames]');
    if (!payload?.textContent) return;

    type FrameRow = {
      image: string;
      title: Record<string, string>;
      note: Record<string, string>;
      credit?: string;
    };

    const frames = JSON.parse(payload.textContent) as FrameRow[];
    if (!frames.length) return;

    const lang = root.dataset.lang || 'en-GB';
    const creditLabel = root.dataset.creditLabel || 'Credit';
    const dayMs = 86400000;
    const utcDay = Math.floor(Date.now() / dayMs);
    const frame = frames[utcDay % frames.length];
    const title = frame.title[lang] || frame.title['en-GB'] || '';
    const note = frame.note[lang] || frame.note['en-GB'] || '';

    const img = root.querySelector<HTMLImageElement>('[data-daily-img]');
    const titleEl = root.querySelector('[data-daily-title]');
    const noteEl = root.querySelector('[data-daily-note]');
    const creditEl = root.querySelector('[data-daily-credit]');

    if (img) {
      img.src = frame.image;
      img.alt = title;
    }
    if (titleEl) titleEl.textContent = title;
    if (noteEl) noteEl.textContent = note;
    if (creditEl) {
      if (frame.credit) {
        creditEl.textContent = `${creditLabel} · ${frame.credit}`;
        creditEl.classList.remove('hidden');
      } else {
        creditEl.textContent = '';
        creditEl.classList.add('hidden');
      }
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-daily-frame]')
    .forEach(applyDailyFrame);
</script>
