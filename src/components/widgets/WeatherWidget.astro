---
/**
 * Live weather via Open-Meteo.
 * Uses geolocation when allowed; falls back to Beijing.
 */

interface Props {
  lang?: string;
  /** panel = full-width editorial block (Now); card = compact (Fun) */
  variant?: 'panel' | 'card';
  /** Tint the page atmosphere via html[data-sky] */
  ambient?: boolean;
}

const { lang = 'zh-CN', variant = 'card', ambient = false } = Astro.props;

const weatherText = {
  'zh-CN': {
    title: '天气',
    humidity: '湿度',
    wind: '风速',
    forecast: '七日',
    loading: '读取中…',
    error: '暂时读不到天气',
    refresh: '刷新',
    local: '定位',
    fallback: '默认 · 北京',
  },
  'zh-TW': {
    title: '天氣',
    humidity: '濕度',
    wind: '風速',
    forecast: '七日',
    loading: '讀取中…',
    error: '暫時讀不到天氣',
    refresh: '重新整理',
    local: '定位',
    fallback: '預設 · 北京',
  },
  'en-GB': {
    title: 'Weather',
    humidity: 'Humidity',
    wind: 'Wind',
    forecast: '7-day',
    loading: 'Loading…',
    error: 'Weather unavailable',
    refresh: 'Refresh',
    local: 'Located',
    fallback: 'Default · Beijing',
  },
  fr: {
    title: 'Météo',
    humidity: 'Humidité',
    wind: 'Vent',
    forecast: '7 jours',
    loading: 'Chargement…',
    error: 'Météo indisponible',
    refresh: 'Actualiser',
    local: 'Localisé',
    fallback: 'Défaut · Pékin',
  },
  ru: {
    title: 'Погода',
    humidity: 'Влажность',
    wind: 'Ветер',
    forecast: '7 дней',
    loading: 'Загрузка…',
    error: 'Погода недоступна',
    refresh: 'Обновить',
    local: 'Гео',
    fallback: 'По умолчанию · Пекин',
  },
} as const;

const t = weatherText[lang as keyof typeof weatherText] || weatherText['zh-CN'];
const rootClass =
  variant === 'panel'
    ? 'weather-widget weather-panel border border-[rgb(var(--color-border))] p-6 md:p-8'
    : 'weather-widget weather-card border border-[rgb(var(--color-border))] p-5';
---

<section
  class={rootClass}
  data-weather-root
  data-ambient={ambient ? 'true' : 'false'}
  data-lang={lang}
  aria-live="polite"
>
  <header class="flex items-start justify-between gap-4 mb-5">
    <div>
      <p class="meta-mono mb-1">{t.title}</p>
      <p
        class="text-sm text-[rgb(var(--color-text-tertiary))]"
        data-weather-source
      >
        {t.loading}
      </p>
    </div>
    <button
      type="button"
      data-weather-refresh
      class="meta-mono px-2 py-1 border border-[rgb(var(--color-border))] text-[rgb(var(--color-text-tertiary))] hover:text-[rgb(var(--color-text-primary))] hover:border-[rgb(var(--color-text-tertiary))] transition-colors"
      aria-label={t.refresh}
    >
      {t.refresh}
    </button>
  </header>

  <div class="flex flex-wrap items-end justify-between gap-6 mb-6">
    <div>
      <p
        class="font-heading text-5xl md:text-6xl font-bold tabular-nums tracking-tight text-[rgb(var(--color-text-primary))]"
        data-weather-temp
      >
        --°
      </p>
      <p
        class="mt-2 font-heading text-lg text-[rgb(var(--color-text-secondary))]"
        data-weather-desc
      >
        {t.loading}
      </p>
      <p
        class="mt-1 text-sm text-[rgb(var(--color-text-tertiary))]"
        data-weather-location
      >
        —
      </p>
    </div>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm min-w-[10rem]">
      <div>
        <dt class="text-[rgb(var(--color-text-tertiary))]">{t.humidity}</dt>
        <dd
          class="font-heading font-semibold tabular-nums text-[rgb(var(--color-text-primary))]"
          data-weather-humidity
        >
          —%
        </dd>
      </div>
      <div>
        <dt class="text-[rgb(var(--color-text-tertiary))]">{t.wind}</dt>
        <dd
          class="font-heading font-semibold tabular-nums text-[rgb(var(--color-text-primary))]"
          data-weather-wind
        >
          — m/s
        </dd>
      </div>
    </dl>
  </div>

  <div class="border-t border-[rgb(var(--color-border))] pt-4">
    <p class="meta-mono mb-3">{t.forecast}</p>
    <div class="grid grid-cols-4 sm:grid-cols-7 gap-2" data-weather-forecast>
    </div>
  </div>
</section>

<script define:vars={{ copy: t }} is:inline>
  (function () {
    const DEFAULT = {
      lat: 39.9042,
      lon: 116.4074,
      label: 'Beijing',
    };

    const roots = document.querySelectorAll('[data-weather-root]');
    if (!roots.length) return;

    const CODE_MAP = {
      0: { sky: 'clear', zh: '晴朗', en: 'Clear' },
      1: { sky: 'clear', zh: '晴间多云', en: 'Mainly clear' },
      2: { sky: 'cloud', zh: '多云', en: 'Partly cloudy' },
      3: { sky: 'cloud', zh: '阴天', en: 'Overcast' },
      45: { sky: 'fog', zh: '雾', en: 'Fog' },
      48: { sky: 'fog', zh: '雾凇', en: 'Rime fog' },
      51: { sky: 'rain', zh: '小雨', en: 'Light drizzle' },
      53: { sky: 'rain', zh: '中雨', en: 'Drizzle' },
      55: { sky: 'rain', zh: '大雨', en: 'Heavy drizzle' },
      61: { sky: 'rain', zh: '小雨', en: 'Light rain' },
      63: { sky: 'rain', zh: '中雨', en: 'Rain' },
      65: { sky: 'rain', zh: '大雨', en: 'Heavy rain' },
      71: { sky: 'snow', zh: '小雪', en: 'Light snow' },
      73: { sky: 'snow', zh: '中雪', en: 'Snow' },
      75: { sky: 'snow', zh: '大雪', en: 'Heavy snow' },
      77: { sky: 'snow', zh: '雪粒', en: 'Snow grains' },
      80: { sky: 'rain', zh: '阵雨', en: 'Showers' },
      81: { sky: 'rain', zh: '中阵雨', en: 'Showers' },
      82: { sky: 'rain', zh: '大阵雨', en: 'Heavy showers' },
      85: { sky: 'snow', zh: '小阵雪', en: 'Snow showers' },
      86: { sky: 'snow', zh: '大阵雪', en: 'Heavy snow showers' },
      95: { sky: 'rain', zh: '雷暴', en: 'Thunderstorm' },
      96: { sky: 'rain', zh: '雷暴冰雹', en: 'Thunderstorm' },
      99: { sky: 'rain', zh: '雷暴冰雹', en: 'Thunderstorm' },
    };

    function descFor(code, lang) {
      const row = CODE_MAP[code] || { sky: 'cloud', zh: '—', en: '—' };
      if (lang === 'zh-CN' || lang === 'zh-TW')
        return { ...row, label: row.zh };
      return { ...row, label: row.en };
    }

    function skyFrom(code) {
      return (CODE_MAP[code] || { sky: 'cloud' }).sky;
    }

    function weekday(iso, lang) {
      try {
        return new Date(iso + 'T12:00:00').toLocaleDateString(
          lang === 'zh-CN' || lang === 'zh-TW'
            ? lang
            : lang === 'en-GB'
              ? 'en-GB'
              : lang === 'fr'
                ? 'fr'
                : 'ru',
          { weekday: 'short' }
        );
      } catch {
        return iso.slice(5);
      }
    }

    async function fetchForecast(lat, lon) {
      const url =
        `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
        `&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code` +
        `&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=7`;
      const res = await fetch(url);
      if (!res.ok) throw new Error('weather http ' + res.status);
      return res.json();
    }

    function getPosition() {
      return new Promise((resolve) => {
        if (!navigator.geolocation) {
          resolve(null);
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (pos) =>
            resolve({
              lat: pos.coords.latitude,
              lon: pos.coords.longitude,
              label: null,
            }),
          () => resolve(null),
          {
            enableHighAccuracy: false,
            timeout: 8000,
            maximumAge: 30 * 60 * 1000,
          }
        );
      });
    }

    function paint(root, data, sourceLabel, lang, ambient) {
      const current = data.current;
      const daily = data.daily;
      const info = descFor(current.weather_code, lang);
      const loc =
        sourceLabel ||
        (data.timezone ? String(data.timezone).split('/').pop() : '—');
      const escapeHtml = (s) =>
        String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

      root.querySelector('[data-weather-temp]').textContent =
        Math.round(current.temperature_2m) + '°';
      root.querySelector('[data-weather-desc]').textContent = info.label;
      root.querySelector('[data-weather-location]').textContent = loc.replace(
        /_/g,
        ' '
      );
      root.querySelector('[data-weather-humidity]').textContent =
        current.relative_humidity_2m + '%';
      root.querySelector('[data-weather-wind]').textContent =
        Math.round(current.wind_speed_10m) + ' m/s';
      root.querySelector('[data-weather-source]').textContent = sourceLabel
        ? copy.fallback
        : copy.local;

      const forecast = root.querySelector('[data-weather-forecast]');
      forecast.innerHTML = '';
      const days = Math.min(7, daily.time.length);
      for (let i = 0; i < days; i++) {
        const dayInfo = descFor(daily.weather_code[i], lang);
        const el = document.createElement('div');
        el.className = 'forecast-day';
        el.innerHTML =
          '<span class="day">' +
          escapeHtml(weekday(daily.time[i], lang)) +
          '</span>' +
          '<span class="hi tabular-nums">' +
          Math.round(daily.temperature_2m_max[i]) +
          '°</span>' +
          '<span class="lo tabular-nums">' +
          Math.round(daily.temperature_2m_min[i]) +
          '°</span>' +
          '<span class="sr-only">' +
          escapeHtml(dayInfo.label) +
          '</span>';
        forecast.appendChild(el);
      }

      if (ambient) {
        document.documentElement.dataset.sky = skyFrom(current.weather_code);
      }
    }

    function showError(root) {
      root.querySelector('[data-weather-desc]').textContent = copy.error;
      root.querySelector('[data-weather-source]').textContent = '—';
    }

    async function load(root) {
      const lang = root.getAttribute('data-lang') || 'zh-CN';
      const ambient = root.getAttribute('data-ambient') === 'true';
      try {
        const pos = await getPosition();
        const coords = pos || DEFAULT;
        const data = await fetchForecast(coords.lat, coords.lon);
        paint(root, data, pos ? null : DEFAULT.label, lang, ambient);
      } catch (err) {
        console.error(err);
        try {
          const data = await fetchForecast(DEFAULT.lat, DEFAULT.lon);
          paint(root, data, DEFAULT.label, lang, ambient);
        } catch (err2) {
          console.error(err2);
          showError(root);
        }
      }
    }

    roots.forEach((root) => {
      root
        .querySelector('[data-weather-refresh]')
        ?.addEventListener('click', () => load(root));
      load(root);
      setInterval(() => load(root), 60 * 60 * 1000);
    });
  })();
</script>

<style>
  .weather-panel {
    background: linear-gradient(
      165deg,
      rgb(var(--color-bg-primary)) 0%,
      rgb(var(--color-bg-secondary) / 0.7) 100%
    );
  }

  .weather-card {
    background: rgb(var(--color-bg-secondary) / 0.45);
    max-width: 28rem;
  }

  .forecast-day {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.5rem 0.35rem;
    border: 1px solid transparent;
  }

  .forecast-day .day {
    font-family: theme('fontFamily.heading');
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }

  .forecast-day .hi {
    font-family: theme('fontFamily.heading');
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--color-text-primary));
  }

  .forecast-day .lo {
    font-size: 0.75rem;
    color: rgb(var(--color-text-tertiary));
  }
</style>
