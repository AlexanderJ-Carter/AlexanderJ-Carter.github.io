---
const { lang, current } = Astro.props;

type Lang = 'zh-CN' | 'zh-TW' | 'en-GB' | 'fr' | 'ru';

function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  return `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

const labels: Record<
  Lang,
  {
    title: string;
    calendar: string;
    currency: string;
    time: string;
    now: string;
    uses: string;
    units: string;
    qr: string;
    projects: string;
    back: string;
  }
> = {
  'zh-CN': {
    title: '更多小工具',
    calendar: '日历',
    currency: '汇率',
    time: '时间',
    now: '此刻',
    uses: '本站',
    units: '单位换算',
    qr: 'QR 生成',
    projects: '项目',
    back: '返回首页',
  },
  'zh-TW': {
    title: '更多小工具',
    calendar: '日曆',
    currency: '匯率',
    time: '時間',
    now: '此刻',
    uses: '本站',
    units: '單位換算',
    qr: 'QR 生成',
    projects: '專案',
    back: '返回首頁',
  },
  'en-GB': {
    title: 'More tools',
    calendar: 'Calendar',
    currency: 'Currency',
    time: 'Time',
    now: 'Now',
    uses: 'About site',
    units: 'Units',
    qr: 'QR Code',
    projects: 'Projects',
    back: 'Back to home',
  },
  fr: {
    title: "Plus d'outils",
    calendar: 'Calendrier',
    currency: 'Taux de change',
    time: 'Heure',
    now: 'Maintenant',
    uses: 'Le site',
    units: 'Unités',
    qr: 'QR Code',
    projects: 'Projets',
    back: "Retour à l'accueil",
  },
  ru: {
    title: 'Ещё инструменты',
    calendar: 'Календарь',
    currency: 'Курс валют',
    time: 'Время',
    now: 'Сейчас',
    uses: 'О сайте',
    units: 'Единицы',
    qr: 'QR-код',
    projects: 'Проекты',
    back: 'На главную',
  },
};

const t = labels[lang as Lang] || labels['en-GB'];

const tools = [
  {
    key: 'calendar',
    href: getLangPath('/calendar'),
    label: t.calendar,
    icon: '📅',
  },
  {
    key: 'currency',
    href: getLangPath('/currency'),
    label: t.currency,
    icon: '💱',
  },
  { key: 'time', href: getLangPath('/time'), label: t.time, icon: '🕐' },
  { key: 'now', href: getLangPath('/now'), label: t.now, icon: '📍' },
  { key: 'uses', href: getLangPath('/uses'), label: t.uses, icon: '🌐' },
  { key: 'units', href: getLangPath('/units'), label: t.units, icon: '📐' },
  { key: 'qr', href: getLangPath('/qr'), label: t.qr, icon: '📱' },
  {
    key: 'projects',
    href: getLangPath('/projects'),
    label: t.projects,
    icon: '🛠',
  },
].filter((tool) => tool.key !== current);
---

<div class="mt-16 pt-12 border-t border-[rgb(var(--color-border))] reveal">
  <p class="font-heading text-sm tracking-[0.18em] uppercase text-[rgb(var(--color-text-tertiary))] mb-4">
    {t.title}
  </p>
  <nav class="flex flex-wrap gap-3" aria-label={t.title}>
    {
      tools.map((tool) => (
        <a
          href={tool.href}
          class="inline-flex items-center px-4 py-2.5 border border-[rgb(var(--color-border))] hover:border-primary-500/40 text-[rgb(var(--color-text-primary))] font-heading text-sm font-medium transition-colors duration-200"
        >
          {tool.label}
        </a>
      ))
    }
  </nav>
  <p class="mt-6">
    <a
      href={getLangPath('/')}
      class="link-underline text-primary-500 hover:text-primary-600 font-medium text-sm inline-flex items-center gap-1"
    >
      ← {t.back}
    </a>
  </p>
</div>
