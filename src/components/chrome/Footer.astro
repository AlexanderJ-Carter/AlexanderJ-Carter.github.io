---
import { BLOG_ORIGIN } from '../../config/site';
import { getLangFromUrl } from '../../i18n/ui';
import SiteFilings from './SiteFilings.astro';
import ExposureMeter from '../widgets/ExposureMeter.astro';

const lang = getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();

function getLangPath(path: string) {
  return lang === 'zh-CN' ? path : `/${lang === 'en-GB' ? 'en' : lang}${path}`;
}

function blogPath(path: string): string {
  return new URL(getLangPath(path), BLOG_ORIGIN).href;
}

function hostOf(href: string): string {
  return new URL(href).hostname.replace(/^www\./, '');
}

