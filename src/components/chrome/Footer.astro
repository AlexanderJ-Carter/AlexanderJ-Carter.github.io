const t = i18n[lang as keyof typeof i18n] || i18n['zh-CN'];

const browse = [
  { label: t.gallery, href: getLangPath('/gallery') },
  { label: t.writing, href: blogPath('/writing') },
  { label: t.subscribe, href: blogPath('/writing/subscribe') },
  { label: t.projects, href: getLangPath('/projects') },
  { label: t.about, href: getLangPath('/about') },
  { label: t.tools, href: getLangPath('/tools') },
  { label: t.fun, href: getLangPath('/fun') },
  { label: t.next, href: getLangPath('/next') },
  { label: t.network, href: getLangPath('/network') },
];

const elsewhere = [
  { label: 'MyCook', href: 'https://cook.alexander.xin' },
  { label: 'Linux Command', href: 'https://linux-command.alexander.xin' },
  { label: 'NetQ', href: 'https://netq.alexander.xin' },
  { label: 'Lab', href: 'https://lab.alexander.xin' },
  { label: 'GitHub', href: 'https://github.com/AlexanderJ-Carter' },
];

const legal = [
  { label: t.privacy, href: getLangPath('/privacy') },
  { label: t.terms, href: getLangPath('/terms') },
  { label: t.license, href: getLangPath('/license') },
  { label: t.accessibility, href: getLangPath('/accessibility') },
  { label: t.security, href: getLangPath('/security/policy') },
  { label: t.changelog, href: getLangPath('/changelog') },
  { label: t.sitemap, href: getLangPath('/sitemap') },
];
---

<footer class="mt-24 border-t border-[rgb(var(--color-border))] relative">
  <div
    class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-14 md:py-16 space-y-12">
    <!-- Brand band -->
    <div
      class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 pb-10 border-b border-[rgb(var(--color-border))]"
    >
      <div class="max-w-xl">
        <a
          href={getLangPath('/')}
          class="inline-flex items-center gap-3 group mb-4"
        >
          <span
            class="relative shrink-0 w-10 h-10 rounded-sm overflow-hidden ring-1 ring-[rgb(var(--color-border))] group-hover:ring-[rgb(var(--color-accent)_/_0.5)] transition"
          >
            <img
              src="/img/branding/logo-96.webp"
              alt=""
              width="40"
              height="40"
              class="w-full h-full object-cover dark:hidden"
              loading="lazy"
              decoding="async"
            />
            <img
              src="/img/branding/logo-dark-96.webp"
              alt=""
              width="40"
              height="40"
              class="w-full h-full object-cover hidden dark:block"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span>
            <span
              class="block font-heading font-bold text-lg tracking-tight group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
            >
              Alexander Carter
            </span>
            <span
              class="meta-mono !text-[10px] !tracking-[0.14em] text-[rgb(var(--color-text-tertiary))]"
            >
              Photography · Writing · Making
            </span>
          </span>
        </a>
        <p
          class="text-sm leading-relaxed text-[rgb(var(--color-text-secondary))] mb-5"
        >
          {t.desc}
        </p>
        <ExposureMeter />
      </div>

      <a
        href="mailto:contact-us@alexander.xin"
        class="inline-flex items-center gap-3 border border-[rgb(var(--color-border))] px-5 py-3 hover:border-[rgb(var(--color-accent)_/_0.55)] hover:bg-[rgb(var(--color-bg-secondary))] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <span
          class="meta-mono !text-[10px] text-[rgb(var(--color-text-tertiary))]"
          >{t.contact}</span
        >
        <span
          class="font-heading text-sm font-semibold text-primary-600 dark:text-primary-400"
        >
          contact-us@alexander.xin
        </span>
      </a>
    </div>

    <!-- Browse + Notes -->
    <div class="grid gap-10 lg:grid-cols-2">
      <nav aria-label={t.browse}>
        <p class="folio-mark mb-4">{t.browse}</p>
        <ul class="flex flex-wrap gap-x-1 gap-y-2">
          {
            browse.map((link, i) => (
              <li class="inline-flex items-center text-sm font-heading">
                {i > 0 && (
                  <span
                    class="mx-2 text-[rgb(var(--color-text-tertiary))]"
                    aria-hidden="true"
                  >
                    ·
                  </span>
                )}
                <a
                  href={link.href}
                  class="text-[rgb(var(--color-text-secondary))] hover:text-primary-600 dark:hover:text-primary-400 transition-colors underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.legal}>
        <p class="folio-mark mb-4">{t.legal}</p>
        <ul class="flex flex-wrap gap-x-1 gap-y-2">
          {
            legal.map((link, i) => (
              <li class="inline-flex items-center text-sm">
                {i > 0 && (
                  <span
                    class="mx-2 text-[rgb(var(--color-text-tertiary))]"
                    aria-hidden="true"
                  >
                    ·
                  </span>
                )}
                <a
                  href={link.href}
                  class="text-[rgb(var(--color-text-tertiary))] hover:text-[rgb(var(--color-text-secondary))] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Elsewhere directory -->
    <section aria-labelledby="footer-elsewhere-title">
      <div
        class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5"
      >
        <div>
          <p class="folio-mark mb-2">Plate · Out</p>
          <h2
            id="footer-elsewhere-title"
            class="font-heading text-xl md:text-2xl font-bold tracking-tight"
          >
            {t.elsewhere}
          </h2>
          <p
            class="mt-1 text-sm text-[rgb(var(--color-text-secondary))] max-w-md"
          >
            {t.elsewhereLead}
          </p>
        </div>
      </div>

      <div class="folio-directory">
        {
          elsewhere.map((link, i) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="folio-directory-row"
            >
              <span class="fd-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0">
                <span class="fd-title">{link.label}</span>
                <span class="fd-host fd-host-mobile">{hostOf(link.href)}</span>
              </span>
              <span class="fd-host fd-host-desktop">{hostOf(link.href)}</span>
              <span class="fd-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Copyright bar -->
    <div
      class="pt-6 border-t border-[rgb(var(--color-border))] flex flex-col gap-4"
    >
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="text-xs text-[rgb(var(--color-text-tertiary))]">
            © {currentYear} Alexander James Carter
          </p>
          <a
            href={getLangPath('/support')}
            class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline underline-offset-4"
          >
            {t.support}
          </a>
          <a href={getLangPath('/license')} class="footer-chip"
            >CC BY-NC-ND 4.0</a
          >
          <a href={getLangPath('/accessibility')} class="footer-chip">
            {t.accessibility}
          </a>
        </div>
        <p
          class="meta-mono !text-[10px] text-[rgb(var(--color-text-tertiary))]"
        >
          {t.tagline}
        </p>
      </div>
      <p
        class="text-[0.7rem] tracking-wide text-[rgb(var(--color-text-tertiary))]"
      >
        {t.colophon}
      </p>
      <SiteFilings />
    </div>
  </div>
</footer>

<style>
  .footer-chip {
    width: fit-content;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    background: transparent;
    color: rgb(var(--color-text-tertiary));
    padding: 0.25rem 0.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .footer-chip:hover {
    color: rgb(var(--color-text-secondary));
    border-color: rgb(var(--color-accent) / 0.4);
  }
</style>
