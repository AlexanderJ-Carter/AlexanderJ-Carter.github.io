---
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const ariaLabels: Record<string, string> = {
  'zh-CN': '回到顶部',
  'zh-TW': '回到頂部',
  'en-GB': 'Back to top',
  fr: 'Retour en haut',
  ru: 'Наверх',
};
const ariaLabel = ariaLabels[lang] ?? 'Back to top';
---

<button
  id="back-to-top"
  type="button"
  aria-label={ariaLabel}
  class="studio-dock-btn fixed z-40 shadow-sm !bg-primary-600 !text-white !border-primary-600 opacity-0 invisible translate-y-4 transition-[opacity,transform,visibility] duration-300 ease-out focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-[rgb(var(--color-bg-primary))] hover:!bg-primary-700 active:!bg-primary-800"
>
  <svg
    class="w-5 h-5 mx-auto"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
  </svg>
</button>

<script>
  const backToTopButton = document.getElementById('back-to-top');
  const scrollThreshold = 400;

  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    if (scrollTop > scrollThreshold) {
      backToTopButton?.setAttribute('data-visible', 'true');
    } else {
      backToTopButton?.removeAttribute('data-visible');
    }
  });

  backToTopButton?.addEventListener('click', () => {
    const preferReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    window.scrollTo({
      top: 0,
      behavior: preferReduced ? 'auto' : 'smooth',
    });
  });
</script>

<style>
  #back-to-top {
    pointer-events: none;
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out,
      visibility 0s linear 0.3s,
      background-color 0.2s ease;
  }

  #back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Studio dock: above search + music */
  #back-to-top {
    right: 1rem;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 8.25rem);
  }

  @media (min-width: 768px) {
    #back-to-top {
      right: 1.5rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 8.5rem);
    }
  }

  @media (max-width: 640px) {
    #back-to-top {
      right: 1rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 8.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top {
      transition-duration: 0.01ms;
    }
  }
</style>
