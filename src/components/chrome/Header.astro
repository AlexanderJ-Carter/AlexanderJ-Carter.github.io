---
import { BLOG_ORIGIN } from '../../config/site';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.url).pathname;

// Helper: 与 Footer 一致，en-GB 使用 /en/ 前缀
function getLangPath(path: string) {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}

function writingHomeHref(): string {
  return new URL(getLangPath('/writing'), BLOG_ORIGIN).href;
}

// Check if a link is active (exact or nested path)
function isActivePath(href: string | undefined): boolean {
  if (!href) return false;
  let pathOnly = href;
  try {
    if (/^https?:\/\//i.test(href)) pathOnly = new URL(href).pathname;
  } catch {
    /* keep href */
  }
  const strip = (p: string) =>
    p.replace(/^\/(zh-TW|en|fr|ru)(?=\/|$)/, '').replace(/\/$/, '') || '/';
  const current = strip(currentPath);
  const target = strip(pathOnly);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
}

function l(zh: string, tw: string, fr: string, ru: string, en: string): string {
  if (lang === 'zh-CN') return zh;
  if (lang === 'zh-TW') return tw;
  if (lang === 'fr') return fr;
  if (lang === 'ru') return ru;
  return en;
}

interface SubMenuItem {
  href?: string;
  label: string;
  desc?: string;
  external?: boolean;
  /** Non-interactive group label inside a submenu */
  heading?: boolean;
}

interface NavItem {
  href?: string;
  label: string;
  external?: boolean;
  mobileOnly?: boolean;
  submenu?: SubMenuItem[];
}

function isSubmenuActive(submenu: SubMenuItem[]): boolean {
  return submenu.some((item) => !item.heading && isActivePath(item.href));
}

const homeHref =
  lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`;

const moreSubmenu: SubMenuItem[] = [
  {
    heading: true,
    label: l('工作台', '工作台', 'Atelier', 'Верстак', 'Workbench'),
  },
  {
    href: getLangPath('/tools'),
    label: l('工具', '工具', 'Outils', 'Инструменты', 'Tools'),
    desc: l(
      '站内实用页与外部入口',
      '站內實用頁與外部入口',
      'Pages utiles et liens externes',
      'Полезные страницы и внешние ссылки',
      'On-site utilities and external links'
    ),
  },
  {
    href: getLangPath('/now'),
    label: 'Now',
    desc: l(
      '本地时间与快捷入口',
      '本地時間與快捷入口',
      'Heure locale et raccourcis',
      'Локальное время и быстрые ссылки',
      'Local time and quick links'
    ),
  },
  {
    href: getLangPath('/fun'),
    label: l('彩蛋', '彩蛋', 'Surprises', 'Пасхалки', 'Play'),
    desc: l(
      '诗词灵感、小游戏与番茄钟',
      '詩詞靈感、小遊戲與番茄鐘',
      'Citations, mini-jeux et pomodoro',
      'Цитаты, мини-игры и помодоро',
      'Quotes, mini games and pomodoro'
    ),
  },
  {
    href: getLangPath('/reading-list'),
    label: t('nav.reading'),
    desc: l(
      '值得反复翻阅的书和文章',
      '值得反覆翻閱的書和文章',
      'Livres et articles à relire',
      'Книги и статьи для перечитывания',
      'Books and articles worth revisiting'
    ),
  },
  {
    href: getLangPath('/uses'),
    label: l('本站', '本站', 'Le site', 'О сайте', 'Uses'),
    desc: l(
      '技术栈与边界',
      '技術棧與邊界',
      'Stack et limites',
      'Стек и границы',
      'Stack and boundaries'
    ),
  },
  {
    href: getLangPath('/friends'),
    label: l('参考', '參考', 'Références', 'Ссылки', 'References'),
    desc: l(
      '工具与资料链接',
      '工具與資料連結',
      'Outils et ressources',
      'Инструменты и ресурсы',
      'Tools and resources'
    ),
  },
  {
    href: getLangPath('/contact'),
    label: t('nav.contact'),
    desc: l(
      '取得联系',
      '取得聯繫',
      'Me contacter',
      'Связаться',
      'Get in touch'
    ),
  },
  {
    heading: true,
    label: l('站外', '站外', 'Ailleurs', 'Снаружи', 'Elsewhere'),
  },
  {
    href: 'https://cook.alexander.xin',
    label: 'MyCook',
    desc: l('做饭菜谱', '做飯菜譜', 'Recettes', 'Рецепты', 'Recipes'),
    external: true,
  },
  {
    href: 'https://linux-command.alexander.xin',
    label: 'Linux Command',
    desc: l(
      '指令速查',
      '指令速查',
      'Commandes Linux',
      'Команды Linux',
      'Linux command reference'
    ),
    external: true,
  },
  {
    href: 'https://netq.alexander.xin',
    label: 'NetQ',
    desc: l('网络排查', '網路排查', 'Réseau', 'Сеть', 'Network lab'),
    external: true,
  },
  {
    heading: true,
    label: l('说明', '說明', 'Notes', 'Сведения', 'Notes'),
  },
  {
    href: getLangPath('/license'),
    label: l('许可证', '許可證', 'Licence', 'Лицензия', 'Licence'),
    desc: l(
      '内容 CC 与源代码许可',
      '內容 CC 與源代碼許可',
      'Contenu CC et licence du code',
      'CC для контента и лицензия кода',
      'Content CC and source-code licence'
    ),
  },
  {
    href: getLangPath('/accessibility'),
    label: l(
      '无障碍',
      '無障礙',
      'Accessibilité',
      'Доступность',
      'Accessibility'
    ),
    desc: l(
      '键盘、对比度与辅助功能',
      '鍵盤、對比度與輔助功能',
      'Clavier, contraste et aides',
      'Клавиатура, контраст и доступность',
      'Keyboard, contrast and assistive use'
    ),
  },
  {
    href: getLangPath('/sitemap'),
    label: l('地图', '地圖', 'Plan', 'Карта', 'Sitemap'),
    desc: l(
      '全部页面',
      '全部頁面',
      'Toutes les pages',
      'Все страницы',
      'All pages'
    ),
  },
];

const mainNavItems: NavItem[] = [
  { href: homeHref, label: t('nav.home'), mobileOnly: true },
  { href: getLangPath('/gallery'), label: t('nav.gallery') },
  {
    href: writingHomeHref(),
    label: t('nav.blog'),
  },
  {
    href: getLangPath('/projects'),
    label: l('项目', '專案', 'Projets', 'Проекты', 'Projects'),
  },
  { href: getLangPath('/about'), label: t('nav.about') },
  { label: l('更多', '更多', 'Plus', 'Ещё', 'More'), submenu: moreSubmenu },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 nav-glass site-header"
  id="header"
>
  <div
    class="nav-progress"
    id="scroll-indicator"
    role="progressbar"
    aria-hidden="true"
  >
  </div>
  <div class="nav-film-edge" aria-hidden="true"></div>

  <nav
    class="relative z-50 container mx-auto px-4 lg:px-8"
    aria-label={lang === 'zh-CN' ? '主导航' : 'Main'}
  >
    <div class="flex items-center justify-between gap-4 min-h-[4.25rem]">
      <a
        href={lang === 'zh-CN' ? '/' : lang === 'en-GB' ? '/en/' : `/${lang}/`}
        class="nav-brand group flex items-center gap-3 min-w-0"
      >
        <span class="nav-brand__mark">
          <img
            src="/img/branding/logo-96.webp"
            alt={lang === 'zh-CN' ? '站点标志' : 'Site logo'}
            width="36"
            height="36"
            class="w-full h-full object-cover dark:hidden"
          />
          <img
            src="/img/branding/logo-dark-96.webp"
            alt={lang === 'zh-CN' ? '站点标志' : 'Site logo'}
            width="36"
            height="36"
            class="w-full h-full object-cover hidden dark:block"
          />
        </span>
        <span class="min-w-0 hidden sm:block">
          <span class="nav-brand__title">Alexander Carter</span>
          <span class="nav-brand__sub">Photography · Writing · Making</span>
        </span>
      </a>

      <div class="nav-rail hidden md:flex items-center" role="list">
        {
          mainNavItems
            .filter((item) => !item.mobileOnly)
            .map((item, i) => {
              const idx = String(i + 1).padStart(2, '0');
              return item.submenu ? (
                <div class="relative submenu-group" role="listitem">
                  <button
                    type="button"
                    aria-haspopup="true"
                    aria-expanded="false"
                    class:list={[
                      'nav-item submenu-btn',
                      isSubmenuActive(item.submenu) && 'is-active',
                    ]}
                  >
                    <span class="nav-item__idx" aria-hidden="true">
                      {idx}
                    </span>
                    <span class="nav-item__label">{item.label}</span>
                    <svg
                      class="submenu-chevron nav-item__chev"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                    <span class="nav-item__ink" aria-hidden="true" />
                  </button>
                  <div class="submenu-panel">
                    <div class="submenu-panel__edge" aria-hidden="true" />
                    <p class="submenu-panel__kicker">Index · More</p>
                    {item.submenu.map((subitem, si) =>
                      subitem.heading ? (
                        <p class="submenu-heading">{subitem.label}</p>
                      ) : (
                        <a
                          href={subitem.href}
                          class:list={[
                            'submenu-link',
                            isActivePath(subitem.href) && 'is-active',
                          ]}
                          style={`--stagger:${si * 28}ms`}
                          target={subitem.external ? '_blank' : undefined}
                          rel={
                            subitem.external ? 'noopener noreferrer' : undefined
                          }
                          aria-current={
                            isActivePath(subitem.href) ? 'page' : undefined
                          }
                        >
                          <span class="submenu-link__idx" aria-hidden="true">
                            {String(si + 1).padStart(2, '0')}
                          </span>
                          <span class="submenu-link__body">
                            <span class="submenu-link__title">
                              {subitem.label}
                              {subitem.external ? ' ↗' : ''}
                            </span>
                            {subitem.desc && (
                              <span class="submenu-link__desc">
                                {subitem.desc}
                              </span>
                            )}
                          </span>
                        </a>
                      )
                    )}
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  role="listitem"
                  class:list={[
                    'nav-item',
                    isActivePath(item.href) && 'is-active',
                  ]}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-current={isActivePath(item.href) ? 'page' : undefined}
                >
                  <span class="nav-item__idx" aria-hidden="true">
                    {idx}
                  </span>
                  <span class="nav-item__label">{item.label}</span>
                  <span class="nav-item__ink" aria-hidden="true" />
                </a>
              );
            })
        }
      </div>

      <div class="nav-actions flex items-center gap-1 sm:gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label={t('theme.toggle')}
          class="nav-icon-btn"
        >
          <svg
            class="w-5 h-5 sun-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            class="w-5 h-5 moon-icon hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <div class="relative lang-group" id="lang-switcher">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="lang-menu"
            id="lang-switcher-btn"
            class="nav-icon-btn gap-1.5 px-2.5"
          >
            <svg
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
              ></path>
            </svg>
            <span class="text-xs font-heading font-semibold hidden sm:block">
              {languages[lang]}
            </span>
          </button>
          <div id="lang-menu" role="menu" class="lang-panel">
            {
              Object.entries(languages).map(([code, name]) => (
                <a
                  href={
                    code === 'zh-CN'
                      ? '/'
                      : code === 'en-GB'
                        ? '/en/'
                        : `/${code}/`
                  }
                  role="menuitem"
                  class:list={[
                    'lang-panel__item',
                    code === lang && 'is-active',
                  ]}
                  aria-current={code === lang ? 'true' : undefined}
                >
                  <span>{name}</span>
                  {code === lang && (
                    <span class="lang-panel__dot" aria-hidden="true" />
                  )}
                </a>
              ))
            }
          </div>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label={lang === 'zh-CN' ? '打开菜单' : 'Toggle menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="nav-icon-btn md:hidden burger-btn"
        >
          <span class="burger" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu-backdrop"
    class="mobile-backdrop fixed inset-0 z-40 hidden md:hidden"
    aria-hidden="true"
  >
  </div>

  <div
    id="mobile-menu"
    class="mobile-drawer md:hidden hidden absolute left-0 right-0 top-full z-50"
    role="navigation"
    aria-label={lang === 'zh-CN' ? '主导航' : 'Main navigation'}
  >
    <div class="mobile-drawer__inner">
      <div class="mobile-drawer__head">
        <p class="folio-mark mb-1">Index</p>
        <p
          class="meta-mono !text-[10px] text-[rgb(var(--color-text-tertiary))]"
        >
          {l('页面目录', '頁面目錄', 'Sommaire', 'Оглавление', 'Site index')}
        </p>
      </div>
      {
        mainNavItems.map((item, i) => {
          const idx = String(i + 1).padStart(2, '0');
          return item.submenu ? (
            <div class="mobile-block" style={`--stagger:${i * 40}ms`}>
              <button
                type="button"
                aria-expanded="false"
                class="mobile-submenu-toggle mobile-row"
              >
                <span class="mobile-row__idx">{idx}</span>
                <span class="mobile-row__label">{item.label}</span>
                <svg
                  class="w-4 h-4 submenu-arrow shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <div class="mobile-submenu hidden">
                {item.submenu.map((subitem) =>
                  subitem.heading ? (
                    <p class="mobile-subhead">{subitem.label}</p>
                  ) : (
                    <a
                      href={subitem.href}
                      class:list={[
                        'mobile-sublink',
                        isActivePath(subitem.href) && 'is-active',
                      ]}
                      target={subitem.external ? '_blank' : undefined}
                      rel={subitem.external ? 'noopener noreferrer' : undefined}
                      aria-current={
                        isActivePath(subitem.href) ? 'page' : undefined
                      }
                    >
                      <span class="font-heading font-medium">
                        {subitem.label}
                        {subitem.external ? ' ↗' : ''}
                      </span>
                      {subitem.desc && (
                        <span class="mobile-sublink__desc">{subitem.desc}</span>
                      )}
                    </a>
                  )
                )}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'mobile-row mobile-block',
                isActivePath(item.href) && 'is-active',
              ]}
              style={`--stagger:${i * 40}ms`}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={isActivePath(item.href) ? 'page' : undefined}
            >
              <span class="mobile-row__idx">{idx}</span>
              <span class="mobile-row__label">{item.label}</span>
              <span class="mobile-row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .nav-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(
      90deg,
      rgb(var(--color-accent)),
      rgb(var(--color-accent) / 0.35)
    );
    z-index: 60;
    transition: width 0.08s linear;
    pointer-events: none;
  }

  .nav-film-edge {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3px;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgb(var(--color-text-primary)) 0 8px,
      transparent 8px 14px
    );
    opacity: 0.07;
  }

  #header.nav-hidden {
    transform: translateY(-100%);
  }

  #header.nav-scrolled {
    background: rgb(var(--color-bg-primary) / 0.97);
    box-shadow: 0 1px 0 rgb(var(--color-border));
  }

  /* Brand */
  .nav-brand__mark {
    position: relative;
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    overflow: hidden;
    border-radius: 0.125rem;
    box-shadow: inset 0 0 0 1px rgb(var(--color-border));
    transition:
      box-shadow 0.25s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-brand:hover .nav-brand__mark,
  .nav-brand:focus-visible .nav-brand__mark {
    transform: translateY(-1px) scale(1.04);
    box-shadow: inset 0 0 0 1px rgb(var(--color-accent) / 0.55);
  }
  .nav-brand__title {
    display: block;
    font-family: theme('fontFamily.heading');
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    line-height: 1;
    color: rgb(var(--color-text-primary));
    transition: color 0.2s ease;
  }
  .nav-brand:hover .nav-brand__title {
    color: rgb(var(--color-accent));
  }
  .nav-brand__sub {
    display: none;
    margin-top: 0.3rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  @media (min-width: 768px) {
    .nav-brand__sub {
      display: block;
    }
  }

  /* Desktop rail */
  .nav-rail {
    gap: 0.1rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: rgb(var(--color-text-secondary));
    border-radius: 0.1rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-item:hover,
  .nav-item:focus-visible {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-primary) / 0.7);
    transform: translateY(-1px);
  }
  .nav-item:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .nav-item.is-active,
  .nav-item.nav-link-active {
    color: rgb(var(--color-accent));
  }
  .nav-item__idx {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgb(var(--color-text-tertiary));
    transition: color 0.2s ease;
  }
  .nav-item:hover .nav-item__idx,
  .nav-item.is-active .nav-item__idx,
  .nav-item.nav-link-active .nav-item__idx {
    color: rgb(var(--color-accent));
  }
  .nav-item__chev {
    width: 0.7rem;
    height: 0.7rem;
    opacity: 0.6;
    transition: transform 0.25s ease;
  }
  .nav-item__ink {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.28rem;
    height: 1.5px;
    background: rgb(var(--color-accent));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-item:hover .nav-item__ink,
  .nav-item:focus-visible .nav-item__ink,
  .nav-item.is-active .nav-item__ink,
  .nav-item.nav-link-active .nav-item__ink {
    transform: scaleX(1);
  }

  /* Submenu panel */
  .submenu-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    z-index: 60;
    min-width: 18rem;
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    padding: 0.55rem 0 0.4rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    background: rgb(var(--color-bg-primary));
    box-shadow:
      0 18px 40px -24px rgb(0 0 0 / 0.35),
      inset 3px 0 0 rgb(var(--color-accent) / 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top left;
    transition:
      opacity 0.22s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.22s ease;
  }
  .submenu-panel__edge {
    height: 3px;
    margin: 0 0.75rem 0.55rem;
    background: repeating-linear-gradient(
      90deg,
      rgb(var(--color-text-primary)) 0 7px,
      transparent 7px 12px
    );
    opacity: 0.1;
  }
  .submenu-panel__kicker {
    padding: 0 1rem 0.45rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .submenu-heading {
    padding: 0.7rem 1rem 0.25rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .submenu-link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.55rem;
    align-items: start;
    padding: 0.55rem 1rem;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .submenu-group[data-open] .submenu-panel,
  .submenu-group:hover .submenu-panel,
  .submenu-group:focus-within .submenu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .submenu-group[data-open] .submenu-link,
  .submenu-group:hover .submenu-link,
  .submenu-group:focus-within .submenu-link {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.28s ease var(--stagger, 0ms),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1) var(--stagger, 0ms),
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .submenu-group[data-open] .submenu-chevron,
  .submenu-group:hover .submenu-chevron {
    transform: rotate(180deg);
  }
  .submenu-link:hover,
  .submenu-link:focus-visible,
  .submenu-link.is-active {
    background: rgb(var(--color-bg-secondary) / 0.75);
  }
  .submenu-link.is-active .submenu-link__title {
    color: rgb(var(--color-accent));
  }
  .submenu-link__idx {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: rgb(var(--color-text-tertiary));
    padding-top: 0.15rem;
  }
  .submenu-link__title {
    display: block;
    font-family: theme('fontFamily.heading');
    font-size: 0.88rem;
    font-weight: 600;
    color: rgb(var(--color-text-primary));
  }
  .submenu-link__desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: rgb(var(--color-text-secondary));
  }

  /* Icon buttons */
  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 0.125rem;
    color: rgb(var(--color-text-secondary));
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.25s ease;
  }
  .nav-icon-btn:hover,
  .nav-icon-btn:focus-visible {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-secondary));
    transform: translateY(-1px);
  }
  .nav-icon-btn:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .dark .sun-icon {
    display: none;
  }
  .dark .moon-icon {
    display: block;
  }

  /* Language */
  .lang-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
    z-index: 60;
    width: 10.5rem;
    padding: 0.3rem 0;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.125rem;
    background: rgb(var(--color-bg-primary));
    box-shadow: 0 16px 36px -22px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.2s ease;
  }
  .lang-group[data-open] .lang-panel,
  .lang-group:hover .lang-panel,
  .lang-group:focus-within .lang-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .lang-panel__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.9rem;
    font-size: 0.82rem;
    color: rgb(var(--color-text-secondary));
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .lang-panel__item:hover,
  .lang-panel__item:focus-visible,
  .lang-panel__item.is-active {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-secondary) / 0.8);
  }
  .lang-panel__item.is-active {
    color: rgb(var(--color-accent));
    font-weight: 600;
  }
  .lang-panel__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: rgb(var(--color-accent));
  }

  /* Burger */
  .burger {
    position: relative;
    width: 1.15rem;
    height: 0.85rem;
    display: block;
  }
  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease,
      top 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .burger i:nth-child(1) {
    top: 0;
  }
  .burger i:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  .burger i:nth-child(3) {
    bottom: 0;
  }
  .burger-btn[aria-expanded='true'] .burger i:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  .burger-btn[aria-expanded='true'] .burger i:nth-child(2) {
    opacity: 0;
  }
  .burger-btn[aria-expanded='true'] .burger i:nth-child(3) {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Mobile drawer */
  .mobile-backdrop {
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .mobile-backdrop.is-visible {
    display: block;
    opacity: 1;
  }

  .mobile-drawer {
    border-top: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-bg-primary));
    max-height: min(78vh, 36rem);
    overflow-y: auto;
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.4);
  }
  .mobile-drawer__inner {
    padding: 0.75rem 1rem 1.25rem;
  }
  .mobile-drawer__head {
    padding: 0.5rem 0.65rem 0.85rem;
    border-bottom: 1px solid rgb(var(--color-border));
    margin-bottom: 0.35rem;
  }
  .mobile-block {
    opacity: 0;
    transform: translateY(8px);
  }
  #mobile-menu.menu-open .mobile-block {
    animation: nav-rise 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--stagger, 0ms);
  }
  .mobile-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 0.65rem;
    text-align: left;
    font-family: theme('fontFamily.heading');
    font-weight: 600;
    color: rgb(var(--color-text-secondary));
    border-radius: 0.125rem;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      padding-left 0.22s ease;
  }
  .mobile-row:hover,
  .mobile-row:focus-visible,
  .mobile-row.is-active {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-secondary) / 0.55);
  }
  .mobile-row.is-active {
    color: rgb(var(--color-accent));
  }
  .mobile-row:hover,
  .mobile-row:focus-visible {
    padding-left: 0.9rem;
  }
  .mobile-row__idx {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: rgb(var(--color-text-tertiary));
    width: 1.5rem;
  }
  .mobile-row__label {
    flex: 1;
    font-size: 1.05rem;
  }
  .mobile-row__arrow,
  .submenu-arrow {
    color: rgb(var(--color-text-tertiary));
    transition:
      transform 0.25s ease,
      color 0.2s ease;
  }
  .mobile-row:hover .mobile-row__arrow {
    color: rgb(var(--color-accent));
    transform: translateX(2px);
  }
  .mobile-submenu {
    margin: 0 0.5rem 0.4rem 2.2rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgb(var(--color-border));
  }
  .mobile-subhead {
    padding: 0.55rem 0.4rem 0.2rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-text-tertiary));
  }
  .mobile-sublink {
    display: block;
    padding: 0.55rem 0.4rem;
    border-radius: 0.125rem;
    color: rgb(var(--color-text-secondary));
  }
  .mobile-sublink.is-active,
  .mobile-sublink:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-bg-secondary) / 0.45);
  }
  .mobile-sublink__desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    color: rgb(var(--color-text-tertiary));
  }

  @keyframes nav-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-item,
    .nav-item__ink,
    .nav-brand__mark,
    .submenu-panel,
    .submenu-link,
    .lang-panel,
    .burger i,
    .mobile-row,
    .nav-icon-btn {
      transition: none !important;
      animation: none !important;
    }
    .nav-item:hover,
    .nav-icon-btn:hover {
      transform: none;
    }
    #mobile-menu.menu-open .mobile-block {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script is:inline>
  let lastScrollY = 0;
  const scrollThreshold = 12;

  // ── Theme toggle ────────────────────────────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const html = document.documentElement;

    // Start transition animation
    html.classList.add('theme-transitioning');

    // Toggle dark mode after fade-out begins
    setTimeout(() => {
      const isDark = html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      // Replace transitioning class with transition-in for fade-in effect
      html.classList.remove('theme-transitioning');
      html.classList.add('theme-transition-in');

      // Remove transition-in class after animation completes
      setTimeout(() => {
        html.classList.remove('theme-transition-in');
      }, 250);
    }, 125);
  });

  // ── Desktop submenu: click + keyboard support ────────────────────────────────
  function closeAllSubmenus() {
    document.querySelectorAll('.submenu-group[data-open]').forEach((g) => {
      g.removeAttribute('data-open');
      g.querySelector('button[aria-haspopup]')?.setAttribute(
        'aria-expanded',
        'false'
      );
    });
  }

  document.querySelectorAll('.submenu-group').forEach((group) => {
    const btn = group.querySelector('button.submenu-btn');

    // Click toggles open/close
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.hasAttribute('data-open');
      closeAllSubmenus();
      closeLangMenu();
      if (!isOpen) {
        group.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    // Keyboard: Enter/Space toggles; Escape closes; ArrowDown opens and moves focus
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        group.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        group.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
        group.querySelector('.submenu-panel a')?.focus();
      }
    });

    // Trap focus — close when focus leaves the group entirely
    group.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget)) {
        group.removeAttribute('data-open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ── Language switcher: click + keyboard support ──────────────────────────────
  const langGroup = document.getElementById('lang-switcher');
  const langBtn = document.getElementById('lang-switcher-btn');
  const langMenu = document.getElementById('lang-menu');

  function closeLangMenu() {
    langGroup?.removeAttribute('data-open');
    langBtn?.setAttribute('aria-expanded', 'false');
  }

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = langGroup?.hasAttribute('data-open');
    closeAllSubmenus();
    if (!isOpen) {
      langGroup?.setAttribute('data-open', '');
      langBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeLangMenu();
    }
  });

  langBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLangMenu();
      langBtn.focus();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      langGroup?.setAttribute('data-open', '');
      langBtn.setAttribute('aria-expanded', 'true');
      langMenu?.querySelector('a')?.focus();
    }
  });

  langGroup?.addEventListener('focusout', (e) => {
    if (!langGroup.contains(e.relatedTarget)) closeLangMenu();
  });

  // Click anywhere outside closes all
  document.addEventListener('click', () => {
    closeAllSubmenus();
    closeLangMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllSubmenus();
      closeLangMenu();
      if (mobileMenu?.classList.contains('menu-open')) closeMobileMenu();
    }
  });

  // ── Active page indicator ────────────────────────────────────────────────────
  (function markActivePage() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document
      .querySelectorAll('header a[href]:not([target="_blank"])')
      .forEach((a) => {
        const href = a.getAttribute('href')?.replace(/\/$/, '') || '';
        if (href && href === path) {
          a.setAttribute('aria-current', 'page');
          a.classList.add('nav-link-active');
        }
      });
  })();

  // ── Mobile menu toggle ───────────────────────────────────────────────────────
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
  let mobileCloseTimer;

  function showMobileBackdrop() {
    mobileBackdrop?.classList.remove('hidden');
    mobileBackdrop?.classList.add('is-visible');
    mobileBackdrop?.setAttribute('aria-hidden', 'false');
  }

  function hideMobileBackdrop() {
    mobileBackdrop?.classList.add('hidden');
    mobileBackdrop?.classList.remove('is-visible');
    mobileBackdrop?.setAttribute('aria-hidden', 'true');
  }

  function closeMobileMenu() {
    mobileMenu?.classList.remove('menu-open');
    mobileMenu?.classList.add('menu-closing');
    hideMobileBackdrop();
    mobileMenuToggle?.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    clearTimeout(mobileCloseTimer);
    mobileCloseTimer = setTimeout(() => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('menu-closing');
    }, 300);
  }

  mobileMenuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('menu-open');

    if (isOpen) {
      closeMobileMenu();
      return;
    }

    mobileMenu?.classList.remove('hidden', 'menu-closing');
    mobileMenu?.classList.add('menu-open');
    showMobileBackdrop();
    mobileMenuToggle?.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
  });

  mobileBackdrop?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('menu-open')) closeMobileMenu();
  });

  // Mobile submenu toggle
  document.querySelectorAll('.mobile-submenu-toggle').forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      if (!btn) return;
      const submenu = btn.nextElementSibling;
      const arrow = btn.querySelector('.submenu-arrow');
      const isOpening = submenu?.classList.contains('hidden') ?? false;
      submenu?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
      btn.setAttribute('aria-expanded', String(isOpening));
    });
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('menu-open')) return;
      closeMobileMenu();
    });
  });

  // ── Scroll progress + hide-on-scroll (rAF throttled) ───────────────────────
  let headerScrollTicking = false;
  const progressEl = document.getElementById('scroll-indicator');

  function updateHeaderOnScroll() {
    const header = document.getElementById('header');
    const scrollTop = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (progressEl && max > 0) {
      progressEl.style.width = `${Math.min(100, (scrollTop / max) * 100)}%`;
    }

    if (header) {
      if (scrollTop > 24) {
        header.classList.add('nav-scrolled');
      } else {
        header.classList.remove('nav-scrolled');
      }

      if (header.contains(document.activeElement)) {
        header.classList.remove('nav-hidden');
        lastScrollY = scrollTop;
        headerScrollTicking = false;
        return;
      }

      if (scrollTop > lastScrollY + scrollThreshold) {
        header.classList.add('nav-hidden');
      } else if (scrollTop < lastScrollY - scrollThreshold || scrollTop < 10) {
        header.classList.remove('nav-hidden');
      }
    }

    lastScrollY = scrollTop;
    headerScrollTicking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (headerScrollTicking) return;
      headerScrollTicking = true;
      requestAnimationFrame(updateHeaderOnScroll);
    },
    { passive: true }
  );
  updateHeaderOnScroll();
</script>
