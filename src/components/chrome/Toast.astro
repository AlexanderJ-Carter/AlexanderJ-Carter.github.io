---
// Toast Notification Component
// Displays temporary notifications with different types (success, error, info, warning)
// Usage: Create a div with id="toast-container" and use JS to trigger toasts

interface Props {
  duration?: number; // Auto-hide after ms (0 = manual)
}

const { duration = 4000 } = Astro.props;
---

<div
  id="toast-container"
  class="fixed bottom-6 right-6 z-[999] space-y-3 max-w-sm pointer-events-none"
>
</div>

<script define:vars={{ duration }} is:inline>
  /**
   * Global toast notification system
   * Call window.showToast({ message, type, duration })
   */
  window.showToast = function (options) {
    const {
      message = '',
      type = 'info', // 'success' | 'error' | 'info' | 'warning'
      duration: customDuration = duration,
    } = options || {};

    const container = document.getElementById('toast-container');
    if (!container) return;

    // Create toast element
    const toast = document.createElement('div');
    toast.className = 'toast-item pointer-events-auto';

    // Style based on type
    const styleMap = {
      success:
        'bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] border border-[rgb(var(--color-border))] border-l-2 border-l-emerald-600',
      error:
        'bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] border border-[rgb(var(--color-border))] border-l-2 border-l-red-600',
      warning:
        'bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] border border-[rgb(var(--color-border))] border-l-2 border-l-amber-600',
      info: 'bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] border border-[rgb(var(--color-border))] border-l-2 border-l-primary-600',
    };

    const iconMap = {
      success: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>`,
      error: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>`,
      warning: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>`,
      info: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>`,
    };

    const bgClass = styleMap[type] || styleMap.info;
    const icon = iconMap[type] || iconMap.info;

    toast.innerHTML = `
      <div class="flex items-center gap-3 px-4 py-3 rounded-sm ${bgClass} animate-slide-in">
        <div class="flex-shrink-0">${icon}</div>
        <div class="flex-1 text-sm font-medium" data-toast-message></div>
        <button class="toast-close flex-shrink-0 opacity-70 hover:opacity-100 transition-opacity">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        </button>
      </div>
    `;
    const messageEl = toast.querySelector('[data-toast-message]');
    if (messageEl) messageEl.textContent = String(message);

    // Add to container
    container.appendChild(toast);
    container.style.pointerEvents = 'auto';

    // Close button handler
    const closeBtn = toast.querySelector('.toast-close');
    const removeToast = () => {
      toast.classList.add('animate-fade-out');
      setTimeout(() => {
        toast.remove();
        if (container.children.length === 0) {
          container.style.pointerEvents = 'none';
        }
      }, 300);
    };

    closeBtn?.addEventListener('click', removeToast);

    // Auto-hide
    if (customDuration > 0) {
      setTimeout(removeToast, customDuration);
    }

    return toast;
  };
</script>

<style>
  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes fadeOut {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(400px);
      opacity: 0;
    }
  }

  .animate-slide-in {
    animation: slideIn 0.3s ease-out;
  }

  .animate-fade-out {
    animation: fadeOut 0.3s ease-out;
  }

  @media (max-width: 640px) {
    @keyframes slideIn {
      from {
        transform: translateY(100px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    @keyframes fadeOut {
      from {
        transform: translateY(0);
        opacity: 1;
      }
      to {
        transform: translateY(100px);
        opacity: 0;
      }
    }
  }
</style>
