---
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const translations = {
  'zh-CN': {
    title: '本地偏好提示',
    message:
      '本站主要用浏览器本地存储记住主题与语言偏好，不进行跨站跟踪。继续使用即表示您知悉这一点。',
    accept: '知道了',
    decline: '关闭',
    learnMore: '隐私政策',
  },
  'zh-TW': {
    title: '本地偏好提示',
    message:
      '本站主要用瀏覽器本地儲存記住主題與語言偏好，不進行跨站追蹤。繼續使用即表示您知悉這一點。',
    accept: '知道了',
    decline: '關閉',
    learnMore: '隱私政策',
  },
  'en-GB': {
    title: 'Local preferences',
    message:
      'This site mainly uses browser local storage for theme and language preferences. We do not run cross-site tracking. By continuing, you acknowledge this.',
    accept: 'Got it',
    decline: 'Dismiss',
    learnMore: 'Privacy policy',
  },
  fr: {
    title: 'Préférences locales',
    message:
      'Ce site utilise principalement le stockage local du navigateur pour les préférences de thème et de langue. Aucun suivi intersites. En continuant, vous en prenez note.',
    accept: 'Compris',
    decline: 'Fermer',
    learnMore: 'Confidentialité',
  },
  ru: {
    title: 'Локальные настройки',
    message:
      'Сайт в основном использует локальное хранилище браузера для темы и языка. Межсайтового отслеживания нет. Продолжая, вы это подтверждаете.',
    accept: 'Понятно',
    decline: 'Закрыть',
    learnMore: 'Конфиденциальность',
  },
};

const t = translations[lang] || translations['zh-CN'];
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 md:p-6 transform translate-y-full transition-transform duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
>
  <div
    class="container mx-auto max-w-4xl p-5 md:p-6 rounded-sm border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))]"
  >
    <div
      class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6"
    >
      <div class="flex-1">
        <h3
          id="cookie-consent-title"
          class="font-heading text-base md:text-lg font-semibold tracking-wide mb-2 text-[rgb(var(--color-text-primary))]"
        >
          {t.title}
        </h3>
        <p
          id="cookie-consent-desc"
          class="text-sm md:text-base text-[rgb(var(--color-text-secondary))] mb-4 md:mb-0"
        >
          {t.message}
          <a
            href={lang === 'zh-CN'
              ? '/privacy'
              : `/${lang === 'en-GB' ? 'en' : lang}/privacy`}
            class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-1 link-underline"
          >
            {t.learnMore}
          </a>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
        <button id="cookie-accept" class="btn-primary !px-5 !py-2.5 text-sm">
          {t.accept}
        </button>
        <button id="cookie-decline" class="btn-secondary !px-5 !py-2.5 text-sm">
          {t.decline}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const cookieConsent = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  function hasCookieConsent() {
    return localStorage.getItem('cookieConsent') !== null;
  }

  function showCookieConsent() {
    if (!hasCookieConsent() && cookieConsent) {
      setTimeout(() => {
        cookieConsent.classList.remove('translate-y-full');
        cookieConsent.classList.add('translate-y-0');
      }, 1000);
    }
  }

  function hideCookieConsent() {
    if (cookieConsent) {
      cookieConsent.classList.add('translate-y-full');
      cookieConsent.classList.remove('translate-y-0');
    }
  }

  function acceptCookies() {
    localStorage.setItem('cookieConsent', 'accepted');
    localStorage.setItem('cookieConsentDate', new Date().toISOString());
    hideCookieConsent();
  }

  function declineCookies() {
    localStorage.setItem('cookieConsent', 'declined');
    localStorage.setItem('cookieConsentDate', new Date().toISOString());
    hideCookieConsent();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', showCookieConsent);
  } else {
    showCookieConsent();
  }

  acceptBtn?.addEventListener('click', acceptCookies);
  declineBtn?.addEventListener('click', declineCookies);
</script>
