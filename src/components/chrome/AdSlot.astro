---
/**
 * Reserved AdSense unit. Renders nothing until PUBLIC_ADSENSE_CLIENT + slot are set.
 * Keep the component mounted in templates as a layout reservation only.
 */
import {
  adsEnabled,
  adsenseClient,
  adSlots,
  type AdSlotId,
} from '../../config/site';
import { getLangFromUrl } from '../../i18n/ui';

interface Props {
  slot: AdSlotId;
  /** Optional layout hint for CSS */
  format?: 'horizontal' | 'rectangle' | 'auto';
  class?: string;
}

const { slot, format = 'auto', class: className = '' } = Astro.props;

const slotId = adSlots[slot];
const active = adsEnabled && Boolean(slotId);
const lang = getLangFromUrl(Astro.url);
const label = {
  'zh-CN': '广告',
  'zh-TW': '廣告',
  'en-GB': 'Advertisement',
  fr: 'Publicité',
  ru: 'Реклама',
}[lang];

if (!active) return;

const pushScript = '(window.adsbygoogle=window.adsbygoogle||[]).push({})';
---

<aside
  class:list={['ad-slot', `ad-slot--${format}`, className]}
  aria-label={label}
  data-ad-slot={slot}
>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={adsenseClient}
    data-ad-slot={slotId}
    data-ad-format={format === 'auto' ? 'auto' : undefined}
    data-full-width-responsive={format === 'horizontal' ? 'true' : undefined}
  ></ins>
  <script is:inline data-astro-rerun set:html={pushScript} />
</aside>

<style>
  /* Reserves vertical space to prevent CLS before the ad fills. */
  .ad-slot {
    margin-block: 2rem;
    width: 100%;
    min-height: 120px;
    border: 1px solid rgb(var(--color-border) / 0.6);
    border-radius: 0.25rem;
    background: rgb(var(--color-bg-secondary) / 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Soft folio-mark watermark as the pre-fill placeholder. */
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0,
      transparent 18px,
      rgb(var(--color-border) / 0.18) 18px,
      rgb(var(--color-border) / 0.18) 19px
    );
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .ad-slot--rectangle {
    min-height: 250px;
  }

  /* Once AdSense marks the unit filled/unfilled, drop the placeholder chrome. */
  .ad-slot:has(ins[data-ad-status='filled']),
  .ad-slot:has(ins[data-ad-status='unfilled']) {
    border-color: transparent;
    background: transparent;
    background-image: none;
  }

  .ad-slot .adsbygoogle {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .ad-slot {
      transition: none;
    }
  }
</style>
