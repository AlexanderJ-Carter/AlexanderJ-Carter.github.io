---
/**
 * 全局键盘快捷键组件
 * 提供网站级别的快捷键支持
 */
const { lang = 'zh-CN' } = Astro.props;

const shortcuts = [
  {
    key: 'h',
    label: lang === 'zh-CN' ? '首页' : lang === 'zh-TW' ? '首頁' : 'Home',
    url: '/',
  },
  {
    key: 'g',
    label: lang === 'zh-CN' ? '画廊' : lang === 'zh-TW' ? '畫廊' : 'Gallery',
    url: '/gallery',
  },
  {
    key: 'p',
    label: lang === 'zh-CN' ? '项目' : lang === 'zh-TW' ? '專案' : 'Projects',
    url: '/projects',
  },
  {
    key: 'a',
    label: lang === 'zh-CN' ? '关于' : lang === 'zh-TW' ? '關於' : 'About',
    url: '/about',
  },
  {
    key: 'c',
    label: lang === 'zh-CN' ? '联系' : lang === 'zh-TW' ? '聯繫' : 'Contact',
    url: '/contact',
  },
  {
    key: 't',
    label: lang === 'zh-CN' ? '时间' : lang === 'zh-TW' ? '時間' : 'Time',
    url: '/time',
  },
  {
    key: '/',
    label: lang === 'zh-CN' ? '搜索' : lang === 'zh-TW' ? '搜尋' : 'Search',
    action: 'search',
  },
  {
    key: 'd',
    label:
      lang === 'zh-CN'
        ? '切换主题'
        : lang === 'zh-TW'
          ? '切換主題'
          : 'Toggle theme',
    action: 'theme',
  },
  {
    key: '?',
    label: lang === 'zh-CN' ? '帮助' : lang === 'zh-TW' ? '幫助' : 'Help',
    action: 'help',
  },
];

function getLangPath(path: string): string {
  if (lang === 'zh-CN') return path;
  const prefix = lang === 'en-GB' ? 'en' : lang;
  return `/${prefix}${path}`;
}
---

<!-- Keyboard Shortcuts Modal -->
<div
  id="shortcuts-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="shortcuts-title"
>
  <div
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
    id="shortcuts-backdrop"
  >
  </div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div
      class="border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] rounded-sm p-6 max-w-md w-full max-h-[80vh] overflow-y-auto"
    >
      <div class="flex items-center justify-between mb-4">
        <h2 id="shortcuts-title" class="text-xl font-heading font-bold">
          {
            lang === 'zh-CN'
              ? '键盘快捷键'
              : lang === 'zh-TW'
                ? '鍵盤快速鍵'
                : 'Keyboard Shortcuts'
          }
        </h2>
        <button
          id="close-shortcuts"
          type="button"
          class="p-2 min-w-11 min-h-11 hover:bg-[rgb(var(--color-bg-accent))] rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-primary-500"
          aria-label="Close"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="space-y-2">
        {
          shortcuts.map((shortcut) => (
            <div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-[rgb(var(--color-bg-accent))] transition-colors">
              <span class="text-[rgb(var(--color-text-secondary))]">
                {shortcut.label}
              </span>
              <kbd class="px-2 py-1 rounded bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] text-sm font-mono min-w-[2rem] text-center">
                {shortcut.key}
              </kbd>
            </div>
          ))
        }
      </div>
      <p
        class="mt-4 text-xs text-[rgb(var(--color-text-tertiary))] text-center"
      >
        {
          lang === 'zh-CN'
            ? '按 ? 显示/隐藏此帮助'
            : lang === 'zh-TW'
              ? '按 ? 顯示/隱藏此幫助'
              : 'Press ? to toggle this help'
        }
      </p>
    </div>
  </div>
</div>

<!-- Shortcut hint button (bottom right) -->
<button
  id="shortcuts-hint"
  type="button"
  class="shortcuts-hint fixed z-40 w-11 h-11 min-w-[44px] min-h-[44px] rounded-sm border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary))] hover:border-primary-500/50 opacity-70 hover:opacity-100 transition-opacity hidden md:flex items-center justify-center focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
  aria-label={lang === 'zh-CN' ? '键盘快捷键' : 'Keyboard shortcuts'}
  title={lang === 'zh-CN' ? '键盘快捷键 (?)' : 'Keyboard shortcuts (?)'}
>
  <svg
    class="w-5 h-5 text-[rgb(var(--color-text-secondary))]"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
</button>

<script is:inline define:vars={{ getLangPath }}>
  const modal = document.getElementById('shortcuts-modal');
  const backdrop = document.getElementById('shortcuts-backdrop');
  const closeBtn = document.getElementById('close-shortcuts');
  const hintBtn = document.getElementById('shortcuts-hint');

  /** @type {{ key: string; action?: string; url?: string }[]} */
  const shortcuts = [
    { key: 'h', url: '/' },
    { key: 'g', url: '/gallery' },
    { key: 'p', url: '/projects' },
    { key: 'a', url: '/about' },
    { key: 'c', url: '/contact' },
    { key: 't', url: '/time' },
    { key: '/', action: 'search' },
    { key: 'd', action: 'theme' },
    { key: '?', action: 'help' },
  ];

  function showModal() {
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function hideModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Toggle modal
  hintBtn?.addEventListener('click', showModal);
  closeBtn?.addEventListener('click', hideModal);
  backdrop?.addEventListener('click', hideModal);

  // Keyboard navigation
  modal?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      hideModal();
    }
  });

  // Global keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Ignore if typing in input/textarea
    if (
      e.target.tagName === 'INPUT' ||
      e.target.tagName === 'TEXTAREA' ||
      e.target.isContentEditable
    ) {
      return;
    }

    const key = e.key.toLowerCase();

    // Show/hide help
    if (e.shiftKey && key === '/') {
      e.preventDefault();
      showModal();
      return;
    }

    // Close modal
    if (key === 'escape') {
      hideModal();
      return;
    }

    // Find matching shortcut
    const shortcut = shortcuts.find((s) => s.key === key);
    if (shortcut) {
      e.preventDefault();

      if (shortcut.action === 'theme') {
        document.getElementById('theme-toggle')?.click();
      } else if (shortcut.action === 'search') {
        document.getElementById('quick-search-btn')?.click();
      } else if (shortcut.action === 'help') {
        if (modal?.classList.contains('hidden')) {
          showModal();
        } else {
          hideModal();
        }
      } else if (shortcut.url) {
        window.location.href = getLangPath(shortcut.url);
      }
    }
  });

  // Quiet first-visit affordance — no bounce carnival
  if (!localStorage.getItem('shortcuts-hint-seen')) {
    setTimeout(() => {
      hintBtn?.classList.add('opacity-100');
      localStorage.setItem('shortcuts-hint-seen', 'true');
    }, 4000);
  }
</script>

<style>
  /* Studio dock: three slots above the music FAB (order 3). */
  .shortcuts-hint {
    --dock-order: 3;
  }
</style>
