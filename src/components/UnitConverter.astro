---
/**
 * 单位转换器组件
 * 支持长度、重量、温度等多种转换
 */

interface Props {
  lang?: string;
}

const { lang = 'zh-CN' } = Astro.props;

const unitText = {
  'zh-CN': {
    title: '单位转换器',
    length: '长度',
    weight: '重量',
    temperature: '温度',
    area: '面积',
    volume: '体积',
    from: '从',
    to: '到',
    convert: '转换',
    swap: '交换',
  },
  'zh-TW': {
    title: '單位轉換器',
    length: '長度',
    weight: '重量',
    temperature: '溫度',
    area: '面積',
    volume: '體積',
    from: '從',
    to: '到',
    convert: '轉換',
    swap: '交換',
  },
  'en-GB': {
    title: 'Unit Converter',
    length: 'Length',
    weight: 'Weight',
    temperature: 'Temperature',
    area: 'Area',
    volume: 'Volume',
    from: 'From',
    to: 'To',
    convert: 'Convert',
    swap: 'Swap',
  },
  fr: {
    title: 'Convertisseur',
    length: 'Longueur',
    weight: 'Poids',
    temperature: 'Température',
    area: 'Surface',
    volume: 'Volume',
    from: 'De',
    to: 'À',
    convert: 'Convertir',
    swap: 'Échanger',
  },
  ru: {
    title: 'Конвертер',
    length: 'Длина',
    weight: 'Вес',
    temperature: 'Температура',
    area: 'Площадь',
    volume: 'Объём',
    from: 'Из',
    to: 'В',
    convert: 'Конвертировать',
    swap: 'Поменять',
  },
};

const t = unitText[lang as keyof typeof unitText] || unitText['zh-CN'];
---

<div id="unit-converter" class="converter-widget glass-card rounded-2xl p-6 shadow-xl max-w-md">
  <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
    <span class="text-2xl">📊</span>
    {t.title}
  </h3>

  <!-- 转换类型选择 -->
  <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
    <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all bg-primary-500 text-white" data-type="length">
      {t.length}
    </button>
    <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all bg-[rgb(var(--color-bg-accent))]" data-type="weight">
      {t.weight}
    </button>
    <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all bg-[rgb(var(--color-bg-accent))]" data-type="temperature">
      {t.temperature}
    </button>
    <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all bg-[rgb(var(--color-bg-accent))]" data-type="area">
      {t.area}
    </button>
    <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all bg-[rgb(var(--color-bg-accent))]" data-type="volume">
      {t.volume}
    </button>
  </div>

  <!-- 输入区域 -->
  <div class="space-y-4">
    <!-- 从 -->
    <div>
      <label class="text-sm font-medium mb-2 block">{t.from}</label>
      <div class="flex gap-2">
        <input
          type="number"
          id="from-value"
          step="any"
          placeholder="0"
          class="flex-1 px-4 py-3 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-lg text-lg font-mono"
        />
        <select id="from-unit" class="px-4 py-3 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-lg min-w-[100px]">
          <!-- 单位选项将通过 JS 填充 -->
        </select>
      </div>
    </div>

    <!-- 交换按钮 -->
    <div class="flex justify-center">
      <button id="swap-btn" type="button" class="p-3 bg-primary-500/10 hover:bg-primary-500/20 rounded-full transition-all hover:rotate-180" style="transition: transform 0.5s">
        <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
        </svg>
      </button>
    </div>

    <!-- 到 -->
    <div>
      <label class="text-sm font-medium mb-2 block">{t.to}</label>
      <div class="flex gap-2">
        <input
          type="number"
          id="to-value"
          readonly
          class="flex-1 px-4 py-3 bg-primary-500/10 border border-primary-500/30 rounded-lg text-lg font-mono font-bold text-primary-600 dark:text-primary-400"
        />
        <select id="to-unit" class="px-4 py-3 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-lg min-w-[100px]">
          <!-- 单位选项将通过 JS 填充 -->
        </select>
      </div>
    </div>
  </div>

  <!-- 转换公式显示 -->
  <div id="formula-display" class="mt-6 p-4 bg-[rgb(var(--color-bg-accent))] rounded-lg text-sm text-center text-[rgb(var(--color-text-secondary))]">
    <!-- 公式将通过 JS 显示 -->
  </div>
</div>

<style>
  .converter-widget {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(14, 165, 233, 0.05) 100%);
  }

  .type-btn.active {
    @apply bg-primary-500 text-white;
  }

  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<script is:inline>
  const units = {
    length: {
      name: '长度',
      units: [
        { id: 'mm', name: '毫米', factor: 0.001 },
        { id: 'cm', name: '厘米', factor: 0.01 },
        { id: 'm', name: '米', factor: 1 },
        { id: 'km', name: '千米', factor: 1000 },
        { id: 'in', name: '英寸', factor: 0.0254 },
        { id: 'ft', name: '英尺', factor: 0.3048 },
        { id: 'yd', name: '码', factor: 0.9144 },
        { id: 'mi', name: '英里', factor: 1609.344 },
      ],
    },
    weight: {
      name: '重量',
      units: [
        { id: 'mg', name: '毫克', factor: 0.000001 },
        { id: 'g', name: '克', factor: 0.001 },
        { id: 'kg', name: '千克', factor: 1 },
        { id: 't', name: '吨', factor: 1000 },
        { id: 'oz', name: '盎司', factor: 0.0283495 },
        { id: 'lb', name: '磅', factor: 0.453592 },
      ],
    },
    temperature: {
      name: '温度',
      units: [
        { id: 'c', name: '摄氏度', factor: 1 },
        { id: 'f', name: '华氏度', factor: 1 },
        { id: 'k', name: '开尔文', factor: 1 },
      ],
      special: true, // 温度需要特殊处理
    },
    area: {
      name: '面积',
      units: [
        { id: 'mm2', name: '平方毫米', factor: 0.000001 },
        { id: 'cm2', name: '平方厘米', factor: 0.0001 },
        { id: 'm2', name: '平方米', factor: 1 },
        { id: 'km2', name: '平方千米', factor: 1000000 },
        { id: 'ha', name: '公顷', factor: 10000 },
        { id: 'ac', name: '英亩', factor: 4046.86 },
      ],
    },
    volume: {
      name: '体积',
      units: [
        { id: 'ml', name: '毫升', factor: 0.001 },
        { id: 'l', name: '升', factor: 1 },
        { id: 'm3', name: '立方米', factor: 1000 },
        { id: 'gal', name: '加仑', factor: 3.78541 },
        { id: 'qt', name: '夸脱', factor: 0.946353 },
      ],
    },
  };

  const fromValue = document.getElementById('from-value');
  const toValue = document.getElementById('to-value');
  const fromUnit = document.getElementById('from-unit');
  const toUnitSelect = document.getElementById('to-unit');
  const swapBtn = document.getElementById('swap-btn');
  const formulaDisplay = document.getElementById('formula-display');
  const typeBtns = document.querySelectorAll('.type-btn');

  let currentType = 'length';

  // 填充单位选项
  function populateUnits(type) {
    const unitList = units[type].units;
    fromUnit.innerHTML = '';
    toUnitSelect.innerHTML = '';

    unitList.forEach((unit, index) => {
      fromUnit.innerHTML += `<option value="${unit.id}">${unit.name}</option>`;
      toUnitSelect.innerHTML += `<option value="${unit.id}">${unit.name}</option>`;
    });

    // 默认选择不同的单位
    toUnitSelect.selectedIndex = Math.min(1, unitList.length - 1);
  }

  // 转换温度
  function convertTemperature(value, from, to) {
    let celsius;

    // 先转换为摄氏度
    if (from === 'c') celsius = value;
    else if (from === 'f') celsius = (value - 32) * 5/9;
    else if (from === 'k') celsius = value - 273.15;

    // 从摄氏度转换为目标单位
    if (to === 'c') return celsius;
    else if (to === 'f') return celsius * 9/5 + 32;
    else if (to === 'k') return celsius + 273.15;
  }

  // 转换单位
  function convert() {
    const value = parseFloat(fromValue.value);
    if (isNaN(value)) {
      toValue.value = '';
      formulaDisplay.textContent = '请输入数值';
      return;
    }

    const from = fromUnit.value;
    const to = toUnitSelect.value;
    const type = currentType;

    let result;

    if (type === 'temperature') {
      result = convertTemperature(value, from, to);
    } else {
      const fromFactor = units[type].units.find(u => u.id === from).factor;
      const toFactor = units[type].units.find(u => u.id === to).factor;
      result = (value * fromFactor) / toFactor;
    }

    // 格式化结果
    toValue.value = result.toFixed(6).replace(/\.?0+$/, '');

    // 显示公式
    const fromName = units[type].units.find(u => u.id === from).name;
    const toName = units[type].units.find(u => u.id === to).name;
    formulaDisplay.textContent = `${value} ${fromName} = ${toValue.value} ${toName}`;
  }

  // 切换类型
  typeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      typeBtns.forEach(b => b.classList.remove('bg-primary-500', 'text-white'));
      btn.classList.add('bg-primary-500', 'text-white');

      currentType = btn.dataset.type;
      populateUnits(currentType);
      fromValue.value = '';
      toValue.value = '';
      formulaDisplay.textContent = '';
    });
  });

  // 交换单位
  swapBtn.addEventListener('click', () => {
    const tempUnit = fromUnit.value;
    fromUnit.value = toUnitSelect.value;
    toUnitSelect.value = tempUnit;
    convert();
  });

  // 输入监听
  fromValue.addEventListener('input', convert);
  fromUnit.addEventListener('change', convert);
  toUnitSelect.addEventListener('change', convert);

  // 初始化
  populateUnits(currentType);
</script>
