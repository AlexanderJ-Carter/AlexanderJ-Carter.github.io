---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const translations = {
  'zh-CN': {
    share: '分享',
    copied: '已复制链接',
    shareTo: '分享到',
    copyLink: '复制链接',
    nativeShare: '系统分享',
  },
  'zh-TW': {
    share: '分享',
    copied: '已複製連結',
    shareTo: '分享到',
    copyLink: '複製連結',
    nativeShare: '系統分享',
  },
  'en-GB': {
    share: 'Share',
    copied: 'Link copied',
    shareTo: 'Share to',
    copyLink: 'Copy Link',
    nativeShare: 'Native Share',
  },
  fr: {
    share: 'Partager',
    copied: 'Lien copié',
    shareTo: 'Partager sur',
    copyLink: 'Copier le lien',
    nativeShare: 'Partage natif',
  },
  ru: {
    share: 'Поделиться',
    copied: 'Ссылка скопирована',
    shareTo: 'Поделиться в',
    copyLink: 'Скопировать ссылку',
    nativeShare: 'Системный шэринг',
  },
};

const t = translations[lang] || translations['zh-CN'];
---

<div id="share-button" class="fixed z-40">
  <button
    aria-label={t.share}
    class="w-12 h-12 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 text-white shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 flex items-center justify-center group"
    onclick="toggleShareMenu()"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
      ></path>
    </svg>
    <span
      class="absolute right-full mr-3 px-3 py-1 bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))] rounded-lg text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap"
    >
      {t.share}
    </span>
  </button>

  <!-- Share Menu -->
  <div
    id="share-menu"
    class="hidden absolute bottom-full left-0 mb-3 glass-card rounded-xl p-3 min-w-[200px] w-max max-w-[min(320px,_calc(100vw_-_2.5rem))] max-h-[60vh] overflow-y-auto shadow-xl origin-bottom-left"
  >
    <div class="space-y-2">
      <button
        onclick="copyLink()"
        class="w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3"
      >
        <span>🔗</span>
        <span>{t.copyLink}</span>
      </button>
      <a
        id="instagram-share"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3"
      >
        <span>📷</span>
        <span>Instagram</span>
      </a>
      <a
        id="facebook-share"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3"
      >
        <span>📘</span>
        <span>Facebook</span>
      </a>
      <button
        id="native-share-btn"
        onclick="nativeShare()"
        class="w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3 hidden"
      >
        <span>📱</span>
        <span>{t.nativeShare}</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Share sits above safe-area and leaves room for BackToTop */
  #share-button {
    left: 1rem;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1.25rem);
  }

  @media (min-width: 768px) {
    #share-button {
      left: 1.5rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 2rem);
    }
  }

  /* Keep menu within viewport on very narrow screens */
  @media (max-width: 480px) {
    #share-menu {
      max-width: calc(100vw - 1.5rem);
      left: 0;
      right: auto;
    }
  }
</style>

<script define:vars={{ lang, translations }} is:inline>
  const messages = translations[lang] || translations['zh-CN'];
  const fallbackMessages = translations['zh-CN'];

  function toggleShareMenu() {
    const menu = document.getElementById('share-menu');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }

  function showToast(text) {
    const toast = document.createElement('div');
    toast.className =
      'fixed bottom-24 left-4 md:left-6 bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))] px-4 py-2 rounded-lg shadow-lg z-50';
    toast.textContent = text;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.remove();
    }, 2000);
  }

  async function copyLink() {
    const url = window.location.href;
    const copiedText = messages.copied || fallbackMessages.copied;

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(url);
        showToast(copiedText);
      } else {
        throw new Error('Clipboard API not available');
      }
    } catch (err) {
      // Fallback: prompt user to copy manually
      const promptText =
        messages.copyLink || fallbackMessages.copyLink || 'Copy Link';
      window.prompt(promptText, url);
      showToast(copiedText);
    }
    toggleShareMenu();
  }

  // Update share links on page load
  function updateShareLinks() {
    const instagramShare = document.getElementById('instagram-share');
    const facebookShare = document.getElementById('facebook-share');
    const nativeShareBtn = document.getElementById('native-share-btn');

    if (typeof window !== 'undefined') {
      const url = encodeURIComponent(window.location.href);

      if (instagramShare) {
        // Instagram doesn't support direct URL sharing, so link to Instagram
        instagramShare.href = `https://www.instagram.com`;
        instagramShare.onclick = (e) => {
          e.preventDefault();
          window.open(instagramShare.href, '_blank');
        };
      }
      if (facebookShare) {
        facebookShare.href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
        facebookShare.onclick = (e) => {
          e.preventDefault();
          window.open(facebookShare.href, '_blank');
        };
      }
      if (nativeShareBtn && 'share' in navigator) {
        nativeShareBtn.classList.remove('hidden');
      }
    }
  }

  async function nativeShare() {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
        toggleShareMenu();
      } catch (err) {
        console.log('Share cancelled');
      }
    }
  }

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const shareButton = document.getElementById('share-button');
    const shareMenu = document.getElementById('share-menu');
    const target = e.target;
    if (!target || !(target instanceof Node)) return;
    if (
      shareButton &&
      shareMenu &&
      !shareButton.contains(target) &&
      !shareMenu.contains(target)
    ) {
      shareMenu.classList.add('hidden');
    }
  });

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateShareLinks);
  } else {
    updateShareLinks();
  }

  // Make functions global
  if (typeof window !== 'undefined') {
    window['toggleShareMenu'] = toggleShareMenu;
    window['copyLink'] = copyLink;
    window['nativeShare'] = nativeShare;
  }
</script>
