---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const translations = {
  'zh-CN': {
    share: '分享',
    copied: '已复制链接',
    shareTo: '分享到',
    copyLink: '复制链接',
    nativeShare: '系统分享',
  },
  'zh-TW': {
    share: '分享',
    copied: '已複製連結',
    shareTo: '分享到',
    copyLink: '複製連結',
    nativeShare: '系統分享',
  },
  'en-GB': {
    share: 'Share',
    copied: 'Link copied',
    shareTo: 'Share to',
    copyLink: 'Copy Link',
    nativeShare: 'Native Share',
  },
  fr: {
    share: 'Partager',
    copied: 'Lien copié',
    shareTo: 'Partager sur',
    copyLink: 'Copier le lien',
    nativeShare: 'Partage natif',
  },
  ru: {
    share: 'Поделиться',
    copied: 'Ссылка скопирована',
    shareTo: 'Поделиться в',
    copyLink: 'Скопировать ссылку',
    nativeShare: 'Системный шэринг',
  },
};

const t = translations[lang] || translations['en-GB'];
---

<div id="share-button" class="fixed z-40">
  <button
    type="button"
    id="share-toggle-btn"
    aria-label={t.share}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="share-menu"
    class="w-12 h-12 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 text-white shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 flex items-center justify-center group focus-visible:ring-2 focus-visible:ring-green-400 focus-visible:ring-offset-2"
    onclick="toggleShareMenu()"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
      ></path>
    </svg>
    <span
      class="absolute right-full mr-3 px-3 py-1 bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))] rounded-lg text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap"
    >
      {t.share}
    </span>
  </button>

  <!-- Share Menu -->
  <div
    id="share-menu"
    class="hidden absolute bottom-full right-0 mb-3 glass-card rounded-xl p-3 min-w-[200px] w-max max-w-[min(320px,_calc(100vw_-_2.5rem))] max-h-[60vh] overflow-y-auto shadow-xl origin-bottom-right"
  >
    <div class="space-y-2">
      <button
        type="button"
        onclick="copyLink()"
        class="w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset"
      >
        <span aria-hidden="true">🔗</span>
        <span>{t.copyLink}</span>
      </button>
      <a
        id="twitter-share"
        href="https://twitter.com/intent/tweet"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset"
      >
        <span aria-hidden="true">𝕏</span>
        <span>Twitter / X</span>
      </a>
      <a
        id="facebook-share"
        href="https://www.facebook.com/sharer/sharer.php"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset"
      >
        <span aria-hidden="true">📘</span>
        <span>Facebook</span>
      </a>
      <button
        type="button"
        id="native-share-btn"
        onclick="nativeShare()"
        class="w-full text-left px-4 py-2 rounded-lg hover:bg-[rgb(var(--color-bg-secondary))] transition-colors flex items-center gap-3 hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset"
      >
        <span aria-hidden="true">📱</span>
        <span>{t.nativeShare}</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* 分享按钮：右侧一列，位于音乐 FAB 上方，避免与左侧搜索重叠 */
  #share-button {
    right: 1rem;
    left: auto;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 5rem);
  }

  @media (min-width: 768px) {
    #share-button {
      right: 1.5rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 5.5rem);
    }
  }

  @media (max-width: 640px) {
    #share-button {
      width: 2.75rem;
      height: 2.75rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 4.75rem);
    }
    #share-button svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  /* 菜单在按钮上方、右侧对齐弹出 */
  #share-menu {
    left: auto;
    right: 0;
  }
  @media (max-width: 480px) {
    #share-menu {
      max-width: min(320px, calc(100vw - 1.5rem));
      right: 0;
      left: auto;
    }
  }
</style>

<script define:vars={{ lang, translations }} is:inline>
  const messages = translations[lang] || translations['en-GB'];
  const fallbackMessages = translations['en-GB'];

  function toggleShareMenu() {
    const menu = document.getElementById('share-menu');
    const btn = document.getElementById('share-toggle-btn');
    if (menu) {
      const isHidden = menu.classList.toggle('hidden');
      if (btn) btn.setAttribute('aria-expanded', String(!isHidden));
    }
  }

  function showToast(text) {
    const toast = document.createElement('div');
    toast.className =
      'fixed bottom-24 left-4 md:left-6 bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))] px-4 py-2 rounded-lg shadow-lg z-50';
    toast.textContent = text;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.remove();
    }, 2000);
  }

  async function copyLink() {
    const url = window.location.href;
    const copiedText = messages.copied || fallbackMessages.copied;

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(url);
        showToast(copiedText);
      } else {
        throw new Error('Clipboard API not available');
      }
    } catch (err) {
      // Fallback: prompt user to copy manually
      const promptText =
        messages.copyLink || fallbackMessages.copyLink || 'Copy Link';
      window.prompt(promptText, url);
      showToast(copiedText);
    }
    toggleShareMenu();
  }

  // Update share links on page load
  function updateShareLinks() {
    const twitterShare = document.getElementById('twitter-share');
    const facebookShare = document.getElementById('facebook-share');
    const nativeShareBtn = document.getElementById('native-share-btn');

    if (typeof window !== 'undefined') {
      const url = encodeURIComponent(window.location.href);
      const title = encodeURIComponent(document.title || '');

      if (twitterShare) {
        twitterShare.href = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
      }
      if (facebookShare) {
        facebookShare.href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
      }
      if (nativeShareBtn && 'share' in navigator) {
        nativeShareBtn.classList.remove('hidden');
      }
    }
  }

  async function nativeShare() {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
        toggleShareMenu();
      } catch (err) {
        console.warn('Share cancelled');
      }
    }
  }

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const shareButton = document.getElementById('share-button');
    const shareMenu = document.getElementById('share-menu');
    const toggleBtn = document.getElementById('share-toggle-btn');
    const target = e.target;
    if (!target || !(target instanceof Node)) return;
    if (
      shareButton &&
      shareMenu &&
      !shareButton.contains(target) &&
      !shareMenu.contains(target)
    ) {
      shareMenu.classList.add('hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateShareLinks);
  } else {
    updateShareLinks();
  }

  // Make functions global
  if (typeof window !== 'undefined') {
    window['toggleShareMenu'] = toggleShareMenu;
    window['copyLink'] = copyLink;
    window['nativeShare'] = nativeShare;
  }
</script>
