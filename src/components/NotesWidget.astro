---
/**
 * 便签工具组件
 * 本地便签记录
 */

interface Props {
  lang?: string;
}

const { lang = 'zh-CN' } = Astro.props;

const notesText = {
  'zh-CN': {
    title: '便签',
    add: '新建',
    save: '保存',
    delete: '删除',
    placeholder: '在这里写点什么...',
    empty: '暂无便签，点击"新建"开始',
  },
  'zh-TW': {
    title: '便條',
    add: '新建',
    save: '儲存',
    delete: '刪除',
    placeholder: '在這裡寫點什麼...',
    empty: '暫無便條，點擊「新建」開始',
  },
  'en-GB': {
    title: 'Notes',
    add: 'New',
    save: 'Save',
    delete: 'Delete',
    placeholder: 'Write something here...',
    empty: 'No notes yet, click "New" to start',
  },
  fr: {
    title: 'Notes',
    add: 'Nouveau',
    save: 'Enregistrer',
    delete: 'Supprimer',
    placeholder: 'Écrivez quelque chose ici...',
    empty: 'Aucune note, cliquez sur "Nouveau" pour commencer',
  },
  ru: {
    title: 'Заметки',
    add: 'Новая',
    save: 'Сохранить',
    delete: 'Удалить',
    placeholder: 'Напишите что-нибудь...',
    empty: 'Нет заметок, нажмите "Новая" чтобы начать',
  },
};

const t = notesText[lang as keyof typeof notesText] || notesText['zh-CN'];
---

<div
  id="notes-widget"
  class="notes-widget glass-card rounded-2xl p-6 shadow-xl max-w-md"
>
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold flex items-center gap-2">
      <span class="text-2xl">📝</span>
      {t.title}
    </h3>
    <button
      id="add-note-btn"
      type="button"
      class="px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-lg text-sm font-medium transition-colors"
    >
      {t.add}
    </button>
  </div>

  <!-- 便签列表 -->
  <div id="notes-list" class="space-y-3 mb-4 max-h-80 overflow-y-auto">
    <!-- 便签将通过 JS 填充 -->
  </div>

  <!-- 编辑区域 -->
  <div id="note-editor" class="hidden">
    <textarea
      id="note-content"
      rows="6"
      placeholder={t.placeholder}
      class="w-full px-4 py-3 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-primary-500"
    ></textarea>
    <div class="flex gap-2 mt-3">
      <button
        id="save-note-btn"
        type="button"
        class="flex-1 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-lg font-medium transition-colors"
      >
        {t.save}
      </button>
      <button
        id="cancel-note-btn"
        type="button"
        class="px-4 py-2 bg-[rgb(var(--color-bg-accent))] hover:bg-[rgb(var(--color-bg-secondary))] rounded-lg font-medium transition-colors"
      >
        {lang === 'zh-CN' ? '取消' : 'Cancel'}
      </button>
    </div>
  </div>

  <!-- 空状态 -->
  <div
    id="empty-state"
    class="text-center py-8 text-[rgb(var(--color-text-tertiary))] hidden"
  >
    <p>{t.empty}</p>
  </div>
</div>

<style>
  .notes-widget {
    background: linear-gradient(
      135deg,
      rgba(251, 191, 36, 0.05) 0%,
      rgba(245, 158, 11, 0.05) 100%
    );
  }

  .note-item {
    @apply p-4 bg-[rgb(var(--color-bg-accent))] rounded-lg border-l-4 border-primary-500 hover:bg-primary-500/10 transition-colors cursor-pointer relative;
  }

  .note-content {
    @apply text-sm whitespace-pre-wrap break-words;
  }

  .note-time {
    @apply text-xs text-[rgb(var(--color-text-tertiary))] mt-2;
  }

  .note-delete {
    @apply absolute top-2 right-2 p-1 opacity-0 hover:opacity-100 transition-opacity text-red-500 hover:text-red-600;
  }

  .note-item:hover .note-delete {
    opacity: 1;
  }
</style>

<script is:inline>
  const STORAGE_KEY = 'alexander-notes';
  const notesList = document.getElementById('notes-list');
  const noteEditor = document.getElementById('note-editor');
  const noteContent = document.getElementById('note-content');
  const addNoteBtn = document.getElementById('add-note-btn');
  const saveNoteBtn = document.getElementById('save-note-btn');
  const cancelNoteBtn = document.getElementById('cancel-note-btn');
  const emptyState = document.getElementById('empty-state');

  let notes = [];
  let editingIndex = -1;

  // 加载便签
  function loadNotes() {
    const stored = localStorage.getItem(STORAGE_KEY);
    notes = stored ? JSON.parse(stored) : [];
    renderNotes();
  }

  // 保存便签
  function saveNotes() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
  }

  // 渲染便签列表
  function renderNotes() {
    if (notes.length === 0) {
      notesList.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    notesList.innerHTML = '';

    notes.forEach((note, index) => {
      const noteEl = document.createElement('div');
      noteEl.className = 'note-item';
      noteEl.innerHTML = `
        <div class="note-content">${escapeHtml(note.content)}</div>
        <div class="note-time">${formatTime(note.time)}</div>
        <button class="note-delete" data-index="${index}" aria-label="删除">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      `;

      // 点击编辑
      noteEl.addEventListener('click', (e) => {
        if (!e.target.closest('.note-delete')) {
          editNote(index);
        }
      });

      // 删除按钮
      noteEl.querySelector('.note-delete').addEventListener('click', (e) => {
        e.stopPropagation();
        deleteNote(index);
      });

      notesList.appendChild(noteEl);
    });
  }

  // 转义 HTML
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // 格式化时间
  function formatTime(timestamp) {
    const date = new Date(timestamp);
    const now = new Date();
    const diff = now - date;

    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return `${Math.floor(diff / 60000)} 分钟前`;
    if (diff < 86400000) return `${Math.floor(diff / 3600000)} 小时前`;

    return date.toLocaleDateString('zh-CN', {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  // 新建便签
  function newNote() {
    editingIndex = -1;
    noteContent.value = '';
    noteEditor.classList.remove('hidden');
    noteContent.focus();
  }

  // 编辑便签
  function editNote(index) {
    editingIndex = index;
    noteContent.value = notes[index].content;
    noteEditor.classList.remove('hidden');
    noteContent.focus();
  }

  // 保存便签
  function saveNote() {
    const content = noteContent.value.trim();
    if (!content) return;

    const note = {
      content,
      time: Date.now(),
    };

    if (editingIndex >= 0) {
      notes[editingIndex] = note;
    } else {
      notes.unshift(note);
    }

    saveNotes();
    renderNotes();
    cancelEdit();
  }

  // 删除便签
  function deleteNote(index) {
    notes.splice(index, 1);
    saveNotes();
    renderNotes();
  }

  // 取消编辑
  function cancelEdit() {
    editingIndex = -1;
    noteContent.value = '';
    noteEditor.classList.add('hidden');
  }

  // 事件监听
  addNoteBtn.addEventListener('click', newNote);
  saveNoteBtn.addEventListener('click', saveNote);
  cancelNoteBtn.addEventListener('click', cancelEdit);

  // 键盘快捷键
  noteContent.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cancelEdit();
    }
  });

  // 初始化
  loadNotes();
</script>
