---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const translations = {
  'zh-CN': {
    search: '搜索',
    theme: '主题',
    language: '语言',
  },
  'zh-TW': {
    search: '搜尋',
    theme: '主題',
    language: '語言',
  },
  'en-GB': {
    search: 'Search',
    theme: 'Theme',
    language: 'Language',
  },
  fr: {
    search: 'Rechercher',
    theme: 'Thème',
    language: 'Langue',
  },
  ru: {
    search: 'Поиск',
    theme: 'Тема',
    language: 'Язык',
  },
};

const t = translations[lang] || translations['zh-CN'];
---

<div id="quick-actions" class="fixed z-40 flex flex-col gap-3">
  <!-- Search Button -->
  <button
    type="button"
    id="quick-search-btn"
    aria-label={t.search}
    class="w-12 h-12 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 text-white shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 flex items-center justify-center group focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-[rgb(var(--color-bg-primary))]"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <span
      class="absolute right-full mr-3 px-3 py-1 bg-[rgb(var(--color-bg-secondary))] text-[rgb(var(--color-text-primary))] rounded-lg text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap"
    >
      {t.search}
    </span>
  </button>
</div>

<!-- Search Modal -->
<div id="search-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-start justify-center min-h-screen px-4 pt-20 pb-20">
    <button
      type="button"
      class="fixed inset-0 bg-[rgb(var(--color-bg-primary))] bg-opacity-90 backdrop-blur-sm"
      onclick="closeSearchModal()"
      aria-label="Close search"
    >
    </button>
    <div class="relative glass-card rounded-2xl p-6 max-w-2xl w-full mt-8">
      <div class="flex items-center gap-4 mb-6">
        <svg
          class="w-6 h-6 text-[rgb(var(--color-text-secondary))]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder={lang === 'zh-CN'
            ? '搜索页面…'
            : lang === 'zh-TW'
              ? '搜尋頁面…'
              : lang === 'fr'
                ? 'Rechercher une page…'
                : lang === 'ru'
                  ? 'Поиск страниц…'
                  : 'Search pages…'}
          class="flex-1 bg-transparent border-none outline-none text-base text-[rgb(var(--color-text-primary))] placeholder-[rgb(var(--color-text-tertiary))]"
          autofocus
        />
        <button
          onclick="closeSearchModal()"
          class="p-2 hover:bg-[rgb(var(--color-bg-secondary))] rounded-lg transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="search-results" class="space-y-2 max-h-96 overflow-y-auto">
        <!-- Results will be populated here -->
      </div>
    </div>
  </div>
</div>

<script define:vars={{ lang }} is:inline>
  const quickSearchBtn = document.getElementById('quick-search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');

  // Build lang-prefixed URL helper (mirrors getLangPath server-side logic)
  const langPrefix =
    lang === 'zh-CN' ? '' : '/' + (lang === 'en-GB' ? 'en' : lang);
  function p(path) {
    return langPrefix + path;
  }

  // Full page index for search
  const pageIndex = [
    {
      title:
        lang === 'zh-CN'
          ? '首页'
          : lang === 'zh-TW'
            ? '首頁'
            : lang === 'fr'
              ? 'Accueil'
              : lang === 'ru'
                ? 'Главная'
                : 'Home',
      url: p('/'),
      keywords: 'home,首页,主页,accueil,главная',
    },
    {
      title:
        lang === 'zh-CN'
          ? '关于我'
          : lang === 'zh-TW'
            ? '關於我'
            : lang === 'fr'
              ? 'À propos'
              : lang === 'ru'
                ? 'Обо мне'
                : 'About',
      url: p('/about'),
      keywords: 'about,关于,简介,a propos,обо мне',
    },
    {
      title:
        lang === 'zh-CN'
          ? '作品画廊'
          : lang === 'zh-TW'
            ? '作品畫廊'
            : lang === 'fr'
              ? 'Galerie'
              : lang === 'ru'
                ? 'Галерея'
                : 'Gallery',
      url: p('/gallery'),
      keywords: 'gallery,画廊,作品,galerie,галерея,photo',
    },
    {
      title:
        lang === 'zh-CN'
          ? '项目'
          : lang === 'zh-TW'
            ? '專案'
            : lang === 'fr'
              ? 'Projets'
              : lang === 'ru'
                ? 'Проекты'
                : 'Projects',
      url: p('/projects'),
      keywords: 'projects,项目,代码,code,work,projets,проекты',
    },
    {
      title:
        lang === 'zh-CN'
          ? '联系我'
          : lang === 'zh-TW'
            ? '聯繫我'
            : lang === 'fr'
              ? 'Contact'
              : lang === 'ru'
                ? 'Контакт'
                : 'Contact',
      url: p('/contact'),
      keywords: 'contact,联系,联系方式,контакт,email',
    },
    {
      title:
        lang === 'zh-CN'
          ? '彩蛋'
          : lang === 'zh-TW'
            ? '彩蛋'
            : lang === 'fr'
              ? 'Easter Eggs'
              : lang === 'ru'
                ? 'Пасхалки'
                : 'Fun',
      url: p('/fun'),
      keywords: 'fun,彩蛋,easter egg,好玩,pâques,пасхалки',
    },
    {
      title:
        lang === 'zh-CN'
          ? '札记'
          : lang === 'zh-TW'
            ? '札記'
            : lang === 'fr'
              ? 'Notes'
              : lang === 'ru'
                ? 'Заметки'
                : 'Notes',
      url: p('/notes'),
      keywords: 'notes,札记,札記,essay,writing,thoughts,записки',
    },
    {
      title:
        lang === 'zh-CN'
          ? '时间线'
          : lang === 'zh-TW'
            ? '時間軸'
            : lang === 'fr'
              ? 'Chronologie'
              : lang === 'ru'
                ? 'Хронология'
                : 'Timeline',
      url: p('/timeline'),
      keywords: 'timeline,时间线,history,经历,chronologie,хронология',
    },
    {
      title:
        lang === 'zh-CN'
          ? '日历'
          : lang === 'zh-TW'
            ? '日曆'
            : lang === 'fr'
              ? 'Calendrier'
              : lang === 'ru'
                ? 'Календарь'
                : 'Calendar',
      url: p('/calendar'),
      keywords: 'calendar,日历,日曆,calendrier,календарь',
    },
    {
      title:
        lang === 'zh-CN'
          ? '汇率'
          : lang === 'zh-TW'
            ? '匯率'
            : lang === 'fr'
              ? 'Taux de change'
              : lang === 'ru'
                ? 'Курс валют'
                : 'Currency',
      url: p('/currency'),
      keywords: 'currency,汇率,exchange,devise,курс валют',
    },
    {
      title:
        lang === 'zh-CN'
          ? '时间'
          : lang === 'zh-TW'
            ? '時間'
            : lang === 'fr'
              ? 'Heure'
              : lang === 'ru'
                ? 'Время'
                : 'World Time',
      url: p('/time'),
      keywords: 'time,时间,world clock,timezone,heure,время',
    },
    {
      title: 'Now',
      url: p('/now'),
      keywords: 'now,此刻,doing,en ce moment,сейчас',
    },
    {
      title:
        lang === 'zh-CN'
          ? '本站'
          : lang === 'zh-TW'
            ? '本站'
            : lang === 'fr'
              ? 'Le site'
              : lang === 'ru'
                ? 'О сайте'
                : 'About site',
      url: p('/uses'),
      keywords: 'about,site,本站,tech stack,astro,о сайте',
    },
    {
      title:
        lang === 'zh-CN'
          ? '单位换算'
          : lang === 'zh-TW'
            ? '單位換算'
            : lang === 'fr'
              ? 'Unités'
              : lang === 'ru'
                ? 'Единицы'
                : 'Units',
      url: p('/units'),
      keywords: 'units,单位,换算,converter,température,единицы',
    },
    {
      title:
        lang === 'zh-CN'
          ? 'QR 生成'
          : lang === 'zh-TW'
            ? 'QR 生成'
            : lang === 'fr'
              ? 'QR Code'
              : lang === 'ru'
                ? 'QR-код'
                : 'QR Code',
      url: p('/qr'),
      keywords: 'qr,二维码,qr code,qr-код',
    },
    {
      title:
        lang === 'zh-CN'
          ? '隐私政策'
          : lang === 'zh-TW'
            ? '隱私政策'
            : lang === 'fr'
              ? 'Confidentialité'
              : lang === 'ru'
                ? 'Конфиденциальность'
                : 'Privacy',
      url: p('/privacy'),
      keywords: 'privacy,隐私,конфиденциальность',
    },
    {
      title:
        lang === 'zh-CN'
          ? '网站地图'
          : lang === 'zh-TW'
            ? '網站地圖'
            : lang === 'fr'
              ? 'Plan du site'
              : lang === 'ru'
                ? 'Карта сайта'
                : 'Sitemap',
      url: p('/sitemap'),
      keywords: 'sitemap,网站地图,всё,all pages',
    },
    {
      title:
        lang === 'zh-CN'
          ? '博客'
          : lang === 'zh-TW'
            ? '部落格'
            : lang === 'fr'
              ? 'Blog'
              : lang === 'ru'
                ? 'Блог'
                : 'Blog',
      url: 'https://blog.alexander.xin',
      keywords: 'blog,博客,部落格,блог,write,writing',
    },
    {
      title:
        lang === 'zh-CN'
          ? '工具中台'
          : lang === 'zh-TW'
            ? '工具中台'
            : lang === 'fr'
              ? 'Hub Outils'
              : lang === 'ru'
                ? 'Хаб инструментов'
                : 'Tool Hub',
      url: 'https://tools.alexander.xin',
      keywords: 'tools,tool hub,工具,实用工具,outils,инструменты',
    },
    {
      title:
        lang === 'zh-CN'
          ? 'Linux 指令查询'
          : lang === 'zh-TW'
            ? 'Linux 指令查詢'
            : lang === 'fr'
              ? 'Commandes Linux'
              : lang === 'ru'
                ? 'Linux команды'
                : 'Linux Commands',
      url: 'https://linux-command.alexander.xin',
      keywords: 'linux,command,bash,shell,终端,命令,команды',
    },
    {
      title:
        lang === 'zh-CN'
          ? '做饭菜谱'
          : lang === 'zh-TW'
            ? '做飯菜譜'
            : lang === 'fr'
              ? 'Recettes'
              : lang === 'ru'
                ? 'Рецепты'
                : 'Cooking Recipes',
      url: 'https://cook.alexander.xin',
      keywords: 'cook,recipe,菜谱,做饭,howtocook,food',
    },
    {
      title:
        lang === 'zh-CN'
          ? 'NetQ 网络排查'
          : lang === 'zh-TW'
            ? 'NetQ 網路排查'
            : lang === 'fr'
              ? 'NetQ CLI'
              : lang === 'ru'
                ? 'NetQ CLI'
                : 'NetQ CLI',
      url: 'https://netq.alexander.xin',
      keywords: 'netq,network,dns,ping,traceroute,tcp,http,排查',
    },
  ];

  function openSearchModal() {
    if (searchModal) {
      searchModal.classList.remove('hidden');
      searchInput?.focus();
    }
  }

  function closeSearchModal() {
    if (searchModal) {
      searchModal.classList.add('hidden');
      if (searchInput) searchInput.value = '';
      if (searchResults) searchResults.innerHTML = '';
    }
  }

  function performSearch(query) {
    if (!searchResults || !query.trim()) {
      if (searchResults) searchResults.innerHTML = '';
      return;
    }

    const results = pageIndex.filter(
      (page) =>
        page.title.toLowerCase().includes(query.toLowerCase()) ||
        page.keywords.toLowerCase().includes(query.toLowerCase())
    );

    const noResultsMsg =
      lang === 'zh-CN'
        ? '未找到结果'
        : lang === 'zh-TW'
          ? '未找到結果'
          : lang === 'fr'
            ? 'Aucun résultat'
            : lang === 'ru'
              ? 'Ничего не найдено'
              : 'No results found';

    if (results.length === 0) {
      searchResults.innerHTML = `<p class="text-center text-[rgb(var(--color-text-secondary))] py-8 text-sm">${noResultsMsg}</p>`;
      return;
    }

    searchResults.innerHTML = results
      .map(
        (page) => `
      <a href="${page.url}" onclick="closeSearchModal()" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-[rgb(var(--color-bg-secondary))] hover:bg-primary-500/10 hover:text-primary-500 transition-colors group">
        <div class="font-medium text-[rgb(var(--color-text-primary))] group-hover:text-primary-500 text-sm leading-tight">${page.title}</div>
        <svg class="w-4 h-4 text-[rgb(var(--color-text-tertiary))] group-hover:text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    `
      )
      .join('');
  }

  // Event listeners
  quickSearchBtn?.addEventListener('click', openSearchModal);
  searchInput?.addEventListener('input', (e) => {
    performSearch(e.target.value);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearchModal();
    }
    // Open with Ctrl+K or Cmd+K
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearchModal();
    }
  });

  // Make functions global for onclick handlers
  window.closeSearchModal = closeSearchModal;
</script>

<style>
  /* 搜索按钮：左侧固定，与右侧音乐/分享/回到顶部错开，移动端留足触控区域 */
  #quick-actions {
    left: 1rem;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1.25rem);
  }

  @media (min-width: 768px) {
    #quick-actions {
      left: 1.5rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
    }
  }

  @media (max-width: 640px) {
    #quick-actions {
      bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    }
    #quick-search-btn {
      width: 2.75rem;
      height: 2.75rem;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>
