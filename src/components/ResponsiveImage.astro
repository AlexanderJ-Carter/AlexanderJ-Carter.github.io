---
/**
 * 响应式图片组件
 * 自动生成 srcset、sizes 和懒加载
 */

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'
} = Astro.props;

// 判断是否为外部图片
const isExternal = src.startsWith('http');

// 生成本地图片的响应式路径（如果存在优化版本）
function getResponsiveSrc(baseSrc: string): string[] {
  if (isExternal) return [];

  // 从 /img/gallery/xxx.jpg 转换为 /img/gallery-optimized/xxx.webp
  const webpSrc = baseSrc.replace('/img/gallery/', '/img/gallery-optimized/').replace('.jpg', '.webp');

  return [
    webpSrc.replace('.webp', '-sm.webp'),
    webpSrc.replace('.webp', '-md.webp'),
    webpSrc.replace('.webp', '-lg.webp'),
    webpSrc.replace('.webp', '-xl.webp'),
  ];
}

const responsiveSrcs = getResponsiveSrc(src);
---

<picture>
  {responsiveSrcs.length > 0 && (
    <>
      <source
        type="image/webp"
        srcset={responsiveSrcs.map((s, i) => {
          const widths = [400, 800, 1200, 1920];
          return `${s} ${widths[i]}w`;
        }).join(', ')}
        sizes={sizes}
      />
    </>
  )}
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    referrerpolicy={isExternal ? 'no-referrer' : undefined}
  />
</picture>

<style>
  picture {
    display: contents;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>
