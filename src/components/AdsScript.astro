---
/**
 * Loads the AdSense bootstrap script once when a publisher id is configured.
 */
import { adsEnabled, adsenseClient } from '../config/site';

if (!adsEnabled) return;
---

<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
  crossorigin="anonymous"></script>
