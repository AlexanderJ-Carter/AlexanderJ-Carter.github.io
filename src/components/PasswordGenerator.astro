---
/**
 * 密码生成器组件
 * 生成安全的随机密码
 */

interface Props {
  lang?: string;
}

const { lang = 'zh-CN' } = Astro.props;

const pwdText = {
  'zh-CN': {
    title: '密码生成器',
    generate: '生成密码',
    copy: '复制',
    copied: '已复制！',
    length: '密码长度',
    uppercase: '大写字母',
    lowercase: '小写字母',
    numbers: '数字',
    symbols: '特殊符号',
    strength: '强度',
    weak: '弱',
    medium: '中等',
    strong: '强',
    veryStrong: '非常强',
  },
  'zh-TW': {
    title: '密碼產生器',
    generate: '產生密碼',
    copy: '複製',
    copied: '已複製！',
    length: '密碼長度',
    uppercase: '大寫字母',
    lowercase: '小寫字母',
    numbers: '數字',
    symbols: '特殊符號',
    strength: '強度',
    weak: '弱',
    medium: '中等',
    strong: '強',
    veryStrong: '非常強',
  },
  'en-GB': {
    title: 'Password Generator',
    generate: 'Generate',
    copy: 'Copy',
    copied: 'Copied!',
    length: 'Length',
    uppercase: 'Uppercase',
    lowercase: 'Lowercase',
    numbers: 'Numbers',
    symbols: 'Symbols',
    strength: 'Strength',
    weak: 'Weak',
    medium: 'Medium',
    strong: 'Strong',
    veryStrong: 'Very Strong',
  },
  fr: {
    title: 'Générateur de Mot de Passe',
    generate: 'Générer',
    copy: 'Copier',
    copied: 'Copié!',
    length: 'Longueur',
    uppercase: 'Majuscules',
    lowercase: 'Minuscules',
    numbers: 'Chiffres',
    symbols: 'Symboles',
    strength: 'Force',
    weak: 'Faible',
    medium: 'Moyen',
    strong: 'Fort',
    veryStrong: 'Très Fort',
  },
  ru: {
    title: 'Генератор Паролей',
    generate: 'Сгенерировать',
    copy: 'Копировать',
    copied: 'Скопировано!',
    length: 'Длина',
    uppercase: 'Заглавные',
    lowercase: 'Строчные',
    numbers: 'Цифры',
    symbols: 'Символы',
    strength: 'Надёжность',
    weak: 'Слабый',
    medium: 'Средний',
    strong: 'Надёжный',
    veryStrong: 'Очень надёжный',
  },
};

const t = pwdText[lang as keyof typeof pwdText] || pwdText['zh-CN'];
---

<div
  id="password-generator"
  class="password-widget glass-card p-6 max-w-md"
>
  <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
    {t.title}
  </h3>

  <!-- 生成的密码 -->
  <div class="mb-6">
    <div class="relative">
      <input
        type="text"
        id="password-output"
        readonly
        class="w-full px-4 py-3 pr-24 bg-[rgb(var(--color-bg-secondary))] border border-[rgb(var(--color-border))] rounded-lg font-mono text-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
        placeholder="点击生成按钮"
      />
      <button
        id="copy-btn"
        type="button"
        class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-primary-500 hover:bg-primary-600 text-white rounded text-sm font-medium transition-colors"
      >
        {t.copy}
      </button>
    </div>

    <!-- 强度指示器 -->
    <div class="mt-3 flex items-center gap-2">
      <span class="text-sm text-[rgb(var(--color-text-secondary))]"
        >{t.strength}:</span
      >
      <div
        class="flex-1 h-2 bg-[rgb(var(--color-bg-accent))] rounded-full overflow-hidden"
      >
        <div
          id="strength-bar"
          class="h-full transition-all duration-300"
          style="width: 0%"
        >
        </div>
      </div>
      <span id="strength-text" class="text-sm font-medium"></span>
    </div>
  </div>

  <!-- 长度滑块 -->
  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <label class="text-sm font-medium">{t.length}</label>
      <span
        id="length-value"
        class="text-sm font-mono font-bold text-primary-500">16</span
      >
    </div>
    <input
      type="range"
      id="length-slider"
      min="8"
      max="64"
      value="16"
      class="w-full h-2 bg-[rgb(var(--color-bg-accent))] rounded-lg appearance-none cursor-pointer"
    />
    <div
      class="flex justify-between text-xs text-[rgb(var(--color-text-tertiary))] mt-1"
    >
      <span>8</span>
      <span>64</span>
    </div>
  </div>

  <!-- 字符类型选项 -->
  <div class="grid grid-cols-2 gap-3 mb-6">
    <label class="flex items-center gap-2 cursor-pointer">
      <input
        type="checkbox"
        id="uppercase"
        checked
        class="w-4 h-4 text-primary-500 rounded"
      />
      <span class="text-sm">{t.uppercase} (A-Z)</span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <input
        type="checkbox"
        id="lowercase"
        checked
        class="w-4 h-4 text-primary-500 rounded"
      />
      <span class="text-sm">{t.lowercase} (a-z)</span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <input
        type="checkbox"
        id="numbers"
        checked
        class="w-4 h-4 text-primary-500 rounded"
      />
      <span class="text-sm">{t.numbers} (0-9)</span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <input
        type="checkbox"
        id="symbols"
        checked
        class="w-4 h-4 text-primary-500 rounded"
      />
      <span class="text-sm">{t.symbols} (!@#$)</span>
    </label>
  </div>

  <!-- 生成按钮 -->
  <button
    id="generate-btn"
    type="button"
    class="w-full py-3 px-6 bg-primary-600 hover:bg-primary-700 text-white rounded-sm font-medium transition-all active:scale-95"
  >
    {t.generate}
  </button>
</div>

<style>
  .password-widget {
    background: linear-gradient(
      135deg,
      rgba(14, 165, 233, 0.05) 0%,
      rgba(139, 92, 246, 0.05) 100%
    );
  }

  #strength-bar.weak {
    @apply bg-red-500;
  }
  #strength-bar.medium {
    @apply bg-yellow-500;
  }
  #strength-bar.strong {
    @apply bg-green-500;
  }
  #strength-bar.very-strong {
    @apply bg-primary-500;
  }

  input[type='range']::-webkit-slider-thumb {
    @apply appearance-none w-5 h-5 bg-primary-500 rounded-full cursor-pointer;
  }
</style>

<script is:inline>
  const output = document.getElementById('password-output');
  const lengthSlider = document.getElementById('length-slider');
  const lengthValue = document.getElementById('length-value');
  const generateBtn = document.getElementById('generate-btn');
  const copyBtn = document.getElementById('copy-btn');
  const strengthBar = document.getElementById('strength-bar');
  const strengthText = document.getElementById('strength-text');

  const uppercase = document.getElementById('uppercase');
  const lowercase = document.getElementById('lowercase');
  const numbers = document.getElementById('numbers');
  const symbols = document.getElementById('symbols');

  // 字符集
  const charSets = {
    uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lowercase: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?',
  };

  // 生成密码
  function generatePassword() {
    const length = parseInt(lengthSlider.value);
    let chars = '';

    if (uppercase.checked) chars += charSets.uppercase;
    if (lowercase.checked) chars += charSets.lowercase;
    if (numbers.checked) chars += charSets.numbers;
    if (symbols.checked) chars += charSets.symbols;

    if (!chars) {
      alert('请至少选择一种字符类型！');
      return;
    }

    let password = '';
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);

    for (let i = 0; i < length; i++) {
      password += chars[array[i] % chars.length];
    }

    output.value = password;
    updateStrength(password);
  }

  // 更新强度指示
  function updateStrength(password) {
    let score = 0;

    // 长度评分
    if (password.length >= 8) score++;
    if (password.length >= 12) score++;
    if (password.length >= 16) score++;
    if (password.length >= 24) score++;

    // 字符类型评分
    if (/[a-z]/.test(password)) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^a-zA-Z0-9]/.test(password)) score++;

    // 更新UI
    const strength = {
      weak: { width: '25%', class: 'weak', text: '弱' },
      medium: { width: '50%', class: 'medium', text: '中等' },
      strong: { width: '75%', class: 'strong', text: '强' },
      veryStrong: { width: '100%', class: 'very-strong', text: '非常强' },
    };

    let current;
    if (score <= 3) current = strength.weak;
    else if (score <= 5) current = strength.medium;
    else if (score <= 7) current = strength.strong;
    else current = strength.veryStrong;

    strengthBar.style.width = current.width;
    strengthBar.className = `h-full transition-all duration-300 ${current.class}`;
    strengthText.textContent = current.text;
  }

  // 复制密码
  copyBtn.addEventListener('click', async () => {
    if (!output.value) return;

    try {
      await navigator.clipboard.writeText(output.value);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = '已复制！';
      copyBtn.classList.add('bg-green-500');

      setTimeout(() => {
        copyBtn.textContent = originalText;
        copyBtn.classList.remove('bg-green-500');
      }, 2000);
    } catch (err) {
      console.error('复制失败:', err);
    }
  });

  // 更新长度显示
  lengthSlider.addEventListener('input', () => {
    lengthValue.textContent = lengthSlider.value;
  });

  // 生成按钮
  generateBtn.addEventListener('click', generatePassword);

  // 复选框改变时自动重新生成
  [uppercase, lowercase, numbers, symbols].forEach((checkbox) => {
    checkbox.addEventListener('change', generatePassword);
  });

  // 初始生成
  generatePassword();
</script>
