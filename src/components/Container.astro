---
/**
 * 统一内容区容器：最大宽度 + 水平内边距，保证各页一致。
 */
interface Props {
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { class: className = '', size = 'default' } = Astro.props;
const sizeClass =
  size === 'narrow' ? 'max-w-3xl' : size === 'wide' ? 'max-w-6xl' : 'max-w-5xl';
---

<div class:list={['container mx-auto px-4 lg:px-8', sizeClass, className]}>
  <slot />
</div>
