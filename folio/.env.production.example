# Folio production env example — copy to .env.production on the server (never commit)

DATABASE_URL=file:/app/data/folio.db
PAYLOAD_SECRET=replace-with-long-random
CRON_SECRET=replace-with-long-random
PREVIEW_SECRET=replace-with-long-random

# 公网与品牌（构建 args 也会读这些）
NEXT_PUBLIC_SERVER_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Folio
NEXT_PUBLIC_SITE_MARK=FO
# compose 插值用：须写进被 --env-file 读到的文件；仅 Tailscale/内网 IP，勿绑公网
FOLIO_PUBLISH=100.x.x.x:3040

# OIDC（Pocket ID 等）
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://example.com/api/oidc/callback
OIDC_CREATE_USER=false
OIDC_ALLOWED_EMAILS=admin@example.com
NEXT_PUBLIC_OIDC_LOGIN_URL=/api/oidc/login
NEXT_PUBLIC_OIDC_DISPLAY_HOST=id.example.com

# Turnstile（站点公钥可公开；密钥仅服务器）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 生产环境不要设置 NEXT_PUBLIC_SKIP_VERIFY（否则关于/联系门禁失效）

# 可选：Cloudflare Web Analytics token（需访客同意「统计」后才加载）
# Dashboard → Analytics & logs → Web Analytics → 站点 → JS snippet 里的 token
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# 可选：EthicalAds 发布者 id（文字赞助，默认不渲染；需先申请通过）
# NEXT_PUBLIC_ETHICALADS_PUBLISHER=

# Resend（表单通知 + 邮件订阅；域名须已在 Resend 验证）
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Folio
CONTACT_NOTIFY_EMAIL=hello@example.com
# Resend Dashboard → Segments → Folio（或自建）的 ID
RESEND_SEGMENT_ID=

# OmniRoute（站点助手 LLM；密钥只放服务器 .env.production）
# OMNI_URL=http://100.111.222.66:8180
# OMNI_KEY=sk-...
# OMNI_MODEL=auto/cheap
