# Copy to .env.production on the server (do not commit secrets).
DATABASE_URL=file:/app/data/folio.db
PAYLOAD_SECRET=replace-with-long-random
CRON_SECRET=replace-with-long-random
PREVIEW_SECRET=replace-with-long-random
NEXT_PUBLIC_SERVER_URL=https://www.alexander.xin

# Pocket ID OIDC（后台「使用 Pocket ID 登录」）
OIDC_ISSUER=https://id.alexander.xin
OIDC_CLIENT_ID=folio-admin
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://www.alexander.xin/api/oidc/callback
NEXT_PUBLIC_OIDC_LOGIN_URL=/api/oidc/login
# 仅当 Pocket ID 邮箱在 Folio 用户表里不存在时自动建号
OIDC_CREATE_USER=true
