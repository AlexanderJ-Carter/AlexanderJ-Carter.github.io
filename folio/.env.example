# Folio local / example env — copy to .env (do not commit secrets)

DATABASE_URL=file:./folio.db
PAYLOAD_SECRET=replace-with-long-random
CRON_SECRET=replace-with-long-random
PREVIEW_SECRET=replace-with-long-random
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# Pocket ID OIDC（后台唯一登录）
# OIDC_ISSUER=https://id.alexander.xin
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/oidc/callback
# NEXT_PUBLIC_OIDC_LOGIN_URL=/api/oidc/login
# OIDC_CREATE_USER=true

# Cloudflare Turnstile（/about /contact）
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_SKIP_VERIFY=true
