# Local / deploy public env (copy to `.env` — never commit secrets)
# https://docs.astro.build/en/guides/environment-variables/

# Skip human verification (About / Contact). Dev already skips unless FORCE is set.
# PUBLIC_SKIP_VERIFY=true

# Force Turnstile even in `astro dev`
# PUBLIC_FORCE_VERIFY=true

# Cloudflare Turnstile site key (defaults: test key in dev, production key in build)
# PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABdh_m4Oroh5Egsy

# Google AdSense — leave empty to keep ad slots inert (recommended until approved)
# PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# PUBLIC_ADSENSE_SLOT_HOME=1234567890
# PUBLIC_ADSENSE_SLOT_ARTICLE=1234567890
# PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567890

# Mainland China filings — leave empty to hide (no placeholder shown)
# PUBLIC_ICP_NUMBER=京ICP备xxxxxxxx号
# PUBLIC_ICP_URL=https://beian.miit.gov.cn/
# PUBLIC_POLICE_BEIAN_NUMBER=京公网安备xxxxxxxxxxxx号
# PUBLIC_POLICE_BEIAN_URL=https://www.beian.gov.cn/portal/registerSystemInfo?recordcode=xxxxxxxxxxxx

# Afdian sponsorship page (Support)
# PUBLIC_AFDIAN_URL=https://afdian.com/a/alexanderjc

# Site notices are configured in src/config/notice.ts (enabled: false by default)
