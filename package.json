{
  "name": "alexander-portfolio",
  "type": "module",
  "version": "3.2.1",
  "license": "BSD-3-Clause",
  "overrides": {
    "lodash": ">=4.17.22",
    "vite": ">=6.4.3",
    "yaml": "2.8.3",
    "fast-uri": ">=3.1.4",
    "svgo": ">=4.0.2",
    "brace-expansion": "5.0.8",
    "astro": {
      "sharp": "$sharp"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate-music": "node scripts/generate-music-manifest.js",
    "optimize-images": "node scripts/optimize-images.js",
    "build": "node scripts/generate-music-manifest.js && astro check && astro build && node scripts/ensure-well-known.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts,css,js}\" \"public/sw.js\" \"*.{mjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,js}\" \"public/sw.js\" \"*.{mjs,md,json}\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.35.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
