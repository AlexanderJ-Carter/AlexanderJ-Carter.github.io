{
  "name": "alexander-portfolio",
  "type": "module",
  "version": "3.2.1",
  "license": "BSD-3-Clause",
  "overrides": {
    "lodash": ">=4.17.22",
    "vite": ">=6.4.3",
    "yaml": ">=2.8.3",
    "fast-uri": ">=4.2.1",
    "svgo": ">=4.1.0",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "postcss-selector-parser": ">=6.1.4",
    "devalue": "5.9.4",
    "astro": {
      "sharp": "$sharp"
    }
  },
  "scripts": {
    "dev": "npm run folio",
    "folio": "PATH=\"$PWD/.tools/node/bin:$PATH\" pnpm --dir folio dev --hostname 127.0.0.1 --port 3000",
    "folio:migrate": "PATH=\"$PWD/.tools/node/bin:$PATH\" pnpm --dir folio migrate:site",
    "folio:admin": "PATH=\"$PWD/.tools/node/bin:$PATH\" pnpm --dir folio seed:admin",
    "folio:build": "PATH=\"$PWD/.tools/node/bin:$PATH\" pnpm --dir folio build",
    "legacy:dev": "astro dev",
    "legacy:start": "astro dev",
    "legacy:build": "node scripts/generate-music-manifest.js && node --experimental-strip-types scripts/generate-help-kb.mjs && node --experimental-strip-types scripts/generate-fleet-changelog.mjs && astro check && astro build && node scripts/ensure-well-known.mjs",
    "legacy:preview": "astro preview",
    "start": "npm run folio",
    "generate-music": "node scripts/generate-music-manifest.js",
    "optimize-images": "node scripts/optimize-images.js",
    "build": "npm run folio:build",
    "preview": "npm run legacy:preview",
    "astro": "astro",
    "encode:help": "node ops-portal/scripts/encode-site-help.cjs",
    "check:help": "node ops-portal/scripts/encode-site-help.cjs && node ops-portal/scripts/check-help-payload.cjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts,css,js}\" \"public/sw.js\" \"workers/**/*.js\" \"ops-portal/src/**/*.{ts,js}\" \"scripts/**/*.{js,mjs}\" \"*.{mjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,js}\" \"public/sw.js\" \"workers/**/*.js\" \"ops-portal/src/**/*.{ts,js}\" \"scripts/**/*.{js,mjs}\" \"*.{mjs,md,json}\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
